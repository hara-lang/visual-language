---
import TabStrip from "./TabStrip.astro";

type Section = {
  id: string;
  label: string;
  tabId?: string;
  panelId?: string;
  active?: boolean;
  disabled?: boolean;
  badge?: string | number;
  description?: string;
};

interface Props {
  sections?: Section[];
  activeSection?: string;
  label?: string;
  idPrefix?: string;
  density?: "regular" | "dense";
  mode?: "tabs" | "dropdown";
  class?: string;
}

const DEFAULT_SECTIONS: Section[] = [
  { id: "nav", label: "Nav" },
  { id: "frontmatter", label: "Frontmatter" },
  { id: "graphics", label: "Graphics" },
  { id: "code", label: "Code" }
];

const {
  sections = DEFAULT_SECTIONS,
  activeSection = "code",
  label = "Environment sections",
  idPrefix = "hara-environment",
  density = "regular",
  mode = "tabs",
  class: className = ""
} = Astro.props;

const requested = sections.find((section: Section) => section.active)?.id ?? activeSection;
const selected = sections.some((section: Section) => section.id === requested && !section.disabled)
  ? requested
  : sections.find((section: Section) => !section.disabled)?.id;
const tabs = sections.map((section: Section) => ({
  id: section.tabId ?? `${idPrefix}-${section.id}-tab`,
  label: section.label,
  active: section.id === selected,
  disabled: section.disabled,
  controls: section.panelId ?? `${idPrefix}-${section.id}-panel`,
  value: section.id,
  badge: section.badge,
  description: section.description
}));
---
<nav
  class:list={["hara-tool-section-navigator", className]}
  aria-label={label}
  data-active-section={selected}
  data-navigation-mode={mode}
>
  {mode === "dropdown" ? (
    <div class="hara-tool-section-select-wrap">
      <label class="hara-tool-section-select-label">
        <span>View</span>
        <select class="hara-tool-section-select" data-environment-section-select aria-label={label}>
          {sections.map((section: Section) => (
            <option value={section.id} selected={section.id === selected} disabled={section.disabled}>
              {section.label}{section.badge !== undefined ? ` · ${section.badge}` : ""}
            </option>
          ))}
        </select>
      </label>
      {sections.map((section: Section) => <span id={section.tabId ?? `${idPrefix}-${section.id}-tab`} class="hara-tool-section-select-name">{section.label}</span>)}
    </div>
  ) : (
    <TabStrip
      tabs={tabs}
      label={label}
      density={density}
      variant="sections"
      class="hara-tool-section-tabs"
    />
  )}
</nav>
