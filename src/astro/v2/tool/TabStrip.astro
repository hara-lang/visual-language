---
type Tab = {
  id: string;
  label: string;
  active?: boolean;
  disabled?: boolean;
  command?: string;
};

interface Props {
  tabs?: Tab[];
  label?: string;
  orientation?: "horizontal" | "vertical";
  density?: "regular" | "dense";
  class?: string;
}

const {
  tabs = [] as Tab[],
  label = "Editor tabs",
  orientation = "horizontal",
  density = "regular",
  class: className = ""
} = Astro.props;
---
<div
  class:list={["hara-tool-tab-strip", className]}
  role="tablist"
  aria-label={label}
  aria-orientation={orientation}
  data-orientation={orientation}
  data-density={density}
>
  {tabs.map((tab: Tab) => (
    <button
      class="hara-tool-tab"
      type="button"
      id={tab.id}
      role="tab"
      aria-selected={tab.active ? "true" : "false"}
      aria-keyshortcuts={tab.command}
      tabindex={tab.active ? 0 : -1}
      disabled={tab.disabled}
    >
      <span>{tab.label}</span>
      {tab.command && <kbd class="hara-tool-command-hint">{tab.command}</kbd>}
    </button>
  ))}
</div>
