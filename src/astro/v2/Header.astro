---
import HaraMark from "../HaraMark.astro";

type NavItem = {
  href: string;
  label: string;
  current?: boolean;
  external?: boolean;
};

type AccountState = "logged-in" | "logged-out";

const {
  homeHref = "/",
  section,
  nav = [] as NavItem[],
  activePath = "",
  label = section ? `Hara ${section}` : "Hara",
  account = "logged-out" as AccountState,
  accountHref = "#account",
  accountLabel = "Sign in",
  menuLabel = "Open navigation",
  menuCloseLabel = "Close navigation"
} = Astro.props;

const current = (item: NavItem) => item.current ?? (
  item.href === "/" ? activePath === "/" : Boolean(activePath && activePath.startsWith(item.href))
);
const signInDialogId = "hara-v2-sign-in-dialog";
---
<header
  class="hara-v2-header"
  data-hara-shell-header
  data-account={account}
  data-navigation-open="false"
>
  <div class="hara-v2-header-row">
    <div class="hara-v2-header-left">
      {nav.length > 0 && (
        <button
          class="hara-v2-menu-button"
          type="button"
          data-hara-header-menu
          aria-expanded="false"
          aria-controls="hara-v2-mobile-navigation"
          aria-label={menuLabel}
          title={menuLabel}
          data-open-label={menuLabel}
          data-close-label={menuCloseLabel}
        >
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      )}
      <a class="hara-v2-brand" href={homeHref} aria-label={label}>
        <HaraMark size={28} title="Hara" />
        <span class="hara-v2-wordmark">Hara</span>
        {section && <span class="hara-v2-brand-divider" aria-hidden="true">/</span>}
        {section && <span class="hara-v2-brand-section">{section}</span>}
      </a>
    </div>

    <nav class="hara-v2-ecosystem-nav" data-hara-header-navigation aria-label="Hara ecosystem navigation">
      {nav.map((item: NavItem) => (
        <a
          href={item.href}
          aria-current={current(item) ? "page" : undefined}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="hara-v2-header-actions">
      <slot />
      {account === "logged-out" && (
        <button
          class="hara-v2-account-link"
          type="button"
          aria-controls={signInDialogId}
          aria-expanded="false"
          aria-haspopup="dialog"
          data-hara-sign-in-trigger
        >{accountLabel}</button>
      )}
    </div>
  </div>

  {nav.length > 0 && (
    <div class="hara-v2-mobile-navigation" id="hara-v2-mobile-navigation" data-hara-mobile-navigation hidden>
      <nav aria-label="Hara mobile navigation">
        {nav.map((item: NavItem) => (
          <a
            href={item.href}
            aria-current={current(item) ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >{item.label}</a>
        ))}
      </nav>
    </div>
  )}
</header>
{account === "logged-out" && (
  <div
    class="hara-v2-sign-in-modal"
    id={signInDialogId}
    data-hara-sign-in-modal
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    hidden
    aria-labelledby={`${signInDialogId}-title`}
    aria-describedby={`${signInDialogId}-description`}
  >
    <div class="hara-v2-sign-in-dialog">
      <header class="hara-v2-sign-in-dialog-header">
        <p class="hara-v2-kicker">Hara identity</p>
        <h2 id={`${signInDialogId}-title`}>Sign in to Hara</h2>
        <p id={`${signInDialogId}-description`}>Use your Hara identity to save work, publish changes, and keep your account connected across Hara products.</p>
      </header>
      <div class="hara-v2-sign-in-dialog-actions">
        <a class="hara-v2-button" data-variant="primary" href={accountHref}>Continue with GitHub</a>
        <button class="hara-v2-sign-in-dialog-close" type="button" data-hara-sign-in-close>Cancel</button>
      </div>
    </div>
  </div>
)}
<script>
  import { initialiseHaraSignIns } from "@hara-lang/ui/v2/header.js";

  const initialiseHaraHeader = () => {
    document.querySelectorAll("[data-hara-shell-header]").forEach((header) => {
      if (!(header instanceof HTMLElement) || header.dataset.haraHeaderReady === "true") return;
      const menu = header.querySelector("[data-hara-header-menu]");
      const navigation = header.querySelector("[data-hara-mobile-navigation]");
      if (!(menu instanceof HTMLButtonElement) || !(navigation instanceof HTMLElement)) return;
      header.dataset.haraHeaderReady = "true";
      const openLabel = menu.dataset.openLabel ?? "Open navigation";
      const closeLabel = menu.dataset.closeLabel ?? "Close navigation";
      const setOpen = (open, restoreFocus = false) => {
        header.dataset.navigationOpen = String(open);
        menu.setAttribute("aria-expanded", String(open));
        menu.setAttribute("aria-label", open ? closeLabel : openLabel);
        menu.title = open ? closeLabel : openLabel;
        navigation.hidden = !open;
        if (!open && restoreFocus) menu.focus();
      };
      menu.addEventListener("click", () => setOpen(header.dataset.navigationOpen !== "true"));
      navigation.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
      header.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && header.dataset.navigationOpen === "true") setOpen(false, true);
      });
      setOpen(false);
    });
  };
  initialiseHaraHeader();
  initialiseHaraSignIns();
  document.addEventListener("astro:page-load", initialiseHaraHeader);
  document.addEventListener("astro:page-load", initialiseHaraSignIns);
</script>
