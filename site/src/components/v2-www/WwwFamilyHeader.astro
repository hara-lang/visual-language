---
import CatalogueHeader from "../v2-catalogue/CatalogueHeader.astro";
import { familyRoutes } from "../../lib/v2-www.mjs";

const {
  basePath,
  activeRoute = "home",
  searchLabel = "Search",
  accountLabel = "Sign in",
  sectionNav = false
} = Astro.props;

const activeFamilyRoute = familyRoutes.find(({ id }) => id === activeRoute) ?? familyRoutes[0];
---
<CatalogueHeader
  basePath={basePath}
  activePath={activeFamilyRoute.path}
  label="Hara public language family"
  sectionNav={sectionNav}
  pageFooter={false}
>
  <Fragment slot="secondary-nav"><slot name="secondary-nav" /></Fragment>
  <Fragment slot="route-actions">
    <button
      class="www-family-search-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="www-family-search"
      data-www-search-trigger
    >
      <span aria-hidden="true">⌕</span>
      <span>{searchLabel}</span>
      <kbd>/</kbd>
    </button>
    <a class="www-family-account" href="#account">{accountLabel}</a>
  </Fragment>
</CatalogueHeader>

<div class="www-family-search" id="www-family-search" hidden data-www-search-panel>
  <label>
    <span>Search Home, Docs, and Benchmarks</span>
    <input class="hara-v2-field" type="search" placeholder="Try “work algebra”, “std.lib.fs”, or “parser-small”" data-www-search-input />
  </label>
  <div class="www-family-search__scope" aria-label="Search categories">
    <button type="button" aria-pressed="true">All</button>
    <button type="button" aria-pressed="false">Guides</button>
    <button type="button" aria-pressed="false">API</button>
    <button type="button" aria-pressed="false">Evidence</button>
  </div>
  <p>Search is represented as a family-owned interaction. Production adopters replace this fixture with their shared index.</p>
</div>

<script>
  const initialiseWwwFamilyHeader = () => {
    document.querySelectorAll("[data-www-search-trigger]").forEach((trigger) => {
      if (!(trigger instanceof HTMLButtonElement) || trigger.dataset.ready === "true") return;
      trigger.dataset.ready = "true";

      const panelId = trigger.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      const input = panel?.querySelector("[data-www-search-input]");
      if (!(panel instanceof HTMLElement)) return;

      const setOpen = (open, focus = false) => {
        panel.hidden = !open;
        trigger.setAttribute("aria-expanded", String(open));
        if (open && focus && input instanceof HTMLInputElement) input.focus();
      };

      trigger.addEventListener("click", () => setOpen(panel.hidden, true));
      panel.querySelectorAll("button").forEach((button) => {
        button.addEventListener("click", () => {
          panel.querySelectorAll("button").forEach((item) => item.setAttribute("aria-pressed", "false"));
          button.setAttribute("aria-pressed", "true");
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement)) {
          event.preventDefault();
          setOpen(true, true);
        }
        if (event.key === "Escape" && !panel.hidden) {
          setOpen(false);
          trigger.focus();
        }
      });
    });
  };

  initialiseWwwFamilyHeader();
  document.addEventListener("astro:page-load", initialiseWwwFamilyHeader);
</script>
