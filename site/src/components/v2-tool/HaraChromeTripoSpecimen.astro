---
import InspectorSection from "../../../../src/astro/v2/tool/InspectorSection.astro";
import RuntimeAppShell from "../../../../src/astro/v2/tool/RuntimeAppShell.astro";
import StatusBar from "../../../../src/astro/v2/tool/StatusBar.astro";
import StatusLamp from "../../../../src/astro/v2/tool/StatusLamp.astro";
import TabStrip from "../../../../src/astro/v2/tool/TabStrip.astro";
import ToolButton from "../../../../src/astro/v2/tool/ToolButton.astro";
import ToolGroup from "../../../../src/astro/v2/tool/ToolGroup.astro";
import ToolSelect from "../../../../src/astro/v2/tool/ToolSelect.astro";
import Toolbar from "../../../../src/astro/v2/tool/Toolbar.astro";

const apps = [
  { id: "tripo-app-runtime", label: "Runtime" },
  { id: "tripo-app-chatgpt", label: "ChatGPT", badge: 8 },
  { id: "tripo-app-tripo", label: "Tripo", active: true, badge: 18 },
  { id: "tripo-app-diagnostics", label: "Diagnostics" }
];

const assets = [
  { title: "Wooden chair", status: "Ready", type: "Smart mesh", current: true },
  { title: "Signal tower", status: "Texturing", type: "Generated" },
  { title: "Wombat hacker", status: "Ready", type: "Rigged" },
  { title: "Runtime console", status: "Draft", type: "Image to 3D" }
];

const formats = [
  { name: "GLB", detail: "Binary glTF · textures included", state: "ready" },
  { name: "FBX", detail: "Rig and animation", state: "ready" },
  { name: "OBJ", detail: "Geometry + material files", state: "ready" },
  { name: "STL", detail: "Unavailable for current workflow", state: "disabled" }
];
---

<section class="tool-lab-section hara-chrome-lab-section" id="tripo-app" data-section-label="Tripo" data-hara-chrome-screen="tripo">
  <header class="tool-lab-section-head">
    <div>
      <p class="hara-v2-kicker">Hara Chrome specimen 04 · Site application</p>
      <h2>Tripo Studio browser app</h2>
    </div>
    <p>Workspace, assets, visible export options, explicit download confirmation, progress, and safe local receipts are kept distinct from generation, credit spending, finance, deletion, and publication authority.</p>
  </header>

  <RuntimeAppShell idPrefix="tripo-screen" label="Tripo Hara application" title="Tripo Studio" activeApp="tripo" state="ready">
    <StatusLamp slot="header-actions" label="Signed in" state="ready" detail="Personal workspace" />
    <TabStrip slot="navigation" tabs={apps} label="Hara Chrome applications" density="dense" />

    <Toolbar slot="toolbar" label="Tripo application commands" density="dense">
      <ToolGroup label="Workspace">
        <ToolSelect label="Workspace" value="personal" inline options={[
          { value: "personal", label: "Personal · 18 assets" },
          { value: "team", label: "Greenways team · read only" }
        ]} />
      </ToolGroup>
      <ToolGroup label="Assets">
        <ToolButton label="Refresh" density="dense" />
        <ToolButton label="Open selected" active density="dense" />
        <ToolButton label="Export options" density="dense" />
      </ToolGroup>
    </Toolbar>

    <div class="hara-chrome-site-app hara-chrome-tripo">
      <aside class="hara-chrome-site-list" aria-label="Tripo assets">
        <div class="hara-chrome-list-heading"><strong>Assets</strong><span>18 visible</span></div>
        <div class="hara-chrome-asset-grid">
          {assets.map((asset) => (
            <button type="button" data-current={asset.current ? "true" : "false"}>
              <span class="hara-chrome-asset-preview" aria-hidden="true"></span>
              <strong>{asset.title}</strong><small>{asset.type}</small><b>{asset.status}</b>
            </button>
          ))}
        </div>
      </aside>

      <article class="hara-chrome-site-detail hara-chrome-export-detail">
        <header><div><span>Selected asset</span><h3>Wooden chair</h3></div><StatusLamp label="Ready" state="ready" detail="asset-chair" /></header>
        <section>
          <h4>Visible export options</h4>
          <div class="hara-chrome-format-list">
            {formats.map((format) => (
              <button type="button" data-state={format.state} disabled={format.state === "disabled"}>
                <strong>{format.name}</strong><span>{format.detail}</span><b>{format.state === "ready" ? "Available" : "Unavailable"}</b>
              </button>
            ))}
          </div>
        </section>
        <footer><ToolButton label="Download GLB" active /><ToolButton label="Cancel" /></footer>
      </article>
    </div>

    <div slot="inspector" class="hara-chrome-inspector">
      <InspectorSection title="Download confirmation" open>
        <dl class="hara-chrome-definition-list">
          <div><dt>Asset</dt><dd>asset-chair</dd></div>
          <div><dt>Format</dt><dd>GLB</dd></div>
          <div><dt>Directory</dt><dd>Greenways/Tripo</dd></div>
          <div><dt>Conflict</dt><dd>uniquify</dd></div>
          <div><dt>Confirmation</dt><dd>true</dd></div>
        </dl>
      </InspectorSection>
      <InspectorSection title="Authority boundary" open>
        <ul class="hara-chrome-boundary-list">
          <li data-state="ready">Visible export UI</li>
          <li data-state="ready">Safe browser receipt</li>
          <li data-state="disabled">Credit spending</li>
          <li data-state="disabled">Delete asset</li>
          <li data-state="disabled">Automatic publication</li>
        </ul>
      </InspectorSection>
    </div>

    <div slot="bottom" class="hara-chrome-download-receipt">
      <header><strong>Local download receipt</strong><StatusLamp label="Complete" state="ready" /></header>
      <dl>
        <div><dt>File</dt><dd>Greenways/Tripo/Wooden-chair.glb</dd></div>
        <div><dt>MIME</dt><dd>model/gltf-binary</dd></div>
        <div><dt>Bytes</dt><dd>1,832,412</dd></div>
        <div><dt>Danger</dt><dd>safe</dd></div>
      </dl>
    </div>

    <StatusBar slot="status" label="Tripo application status">
      <span>Personal workspace</span><span>18 assets</span><span>Download complete</span>
      <span slot="secondary">Local artifact · not published</span>
    </StatusBar>
  </RuntimeAppShell>
</section>
