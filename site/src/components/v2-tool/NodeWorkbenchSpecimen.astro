---
import WorkbenchShell from "../../../../src/astro/v2/tool/WorkbenchShell.astro";
import Toolbar from "../../../../src/astro/v2/tool/Toolbar.astro";
import ToolGroup from "../../../../src/astro/v2/tool/ToolGroup.astro";
import ToolButton from "../../../../src/astro/v2/tool/ToolButton.astro";
import ToolToggle from "../../../../src/astro/v2/tool/ToolToggle.astro";
import ToolSelect from "../../../../src/astro/v2/tool/ToolSelect.astro";
import ToolNumberField from "../../../../src/astro/v2/tool/ToolNumberField.astro";
import TabStrip from "../../../../src/astro/v2/tool/TabStrip.astro";
import IconRail from "../../../../src/astro/v2/tool/IconRail.astro";
import DockPanel from "../../../../src/astro/v2/tool/DockPanel.astro";
import InspectorSection from "../../../../src/astro/v2/tool/InspectorSection.astro";
import PanelHeader from "../../../../src/astro/v2/tool/PanelHeader.astro";
import StatusBar from "../../../../src/astro/v2/tool/StatusBar.astro";
import ThreeDViewportIsland from "./ThreeDViewportIsland.tsx";
import EditorTreeIsland from "./EditorTreeIsland.tsx";

const tabs = [
  { id: "material", label: "Command steel", active: true, command: "1" },
  { id: "signal", label: "Signal glass", command: "2" },
  { id: "rack", label: "Rack field", command: "3" }
];
---
<section class="tool-lab-section" id="node" data-section-label="Node" data-tool-layout="node">
  <header class="tool-lab-section-head">
    <div>
      <p class="hara-v2-kicker">Workbench specimen 02 · Graph tooling</p>
      <h2>Node / material editor</h2>
    </div>
    <p>A graph-centred surface with compact command tabs, a searchable node catalogue, shared property inspection, asset context, and a floating palette that uses the same material language as docked panels.</p>
  </header>

  <WorkbenchShell label="Hara node and material editor specimen" minHeight="690px" class="tool-lab-node-editor">
    <div slot="top">
      <Toolbar label="Node editor commands" density="dense" class="tool-lab-node-toolbar">
        <ToolGroup label="Graph commands" class="tool-lab-node-toolbar__primary">
          <ToolButton label="Add node" title="Add node · Shift+A" command="Shift+A" iconOnly active><span slot="icon">＋</span></ToolButton>
          <ToolButton label="Connect" title="Connect · C" command="C" iconOnly><span slot="icon">⌁</span></ToolButton>
          <ToolButton label="Frame all" title="Frame all · Home" command="Home" iconOnly><span slot="icon">⌗</span></ToolButton>
        </ToolGroup>
        <ToolGroup label="Graph view" class="tool-lab-node-toolbar__view">
          <ToolToggle label="Snap" pressed iconOnly><span slot="icon">⊙</span></ToolToggle>
          <ToolToggle label="Minimap" pressed iconOnly><span slot="icon">⊞</span></ToolToggle>
          <ToolSelect label="Graph" value="surface" options={[{ value: "surface", label: "Surface" }, { value: "volume", label: "Volume" }]} inline />
        </ToolGroup>
        <ToolGroup label="Compile material" class="tool-lab-node-toolbar__compile"><ToolButton label="Compile" title="Compile material · Ctrl+Enter" command="Ctrl+Enter" iconOnly><span slot="icon">✓</span></ToolButton></ToolGroup>
      </Toolbar>
      <TabStrip tabs={tabs} density="dense" variant="groups" label="Open material graphs" class="tool-lab-node-graph-tabs" />
    </div>

    <div slot="left" class="tool-lab-left-stack">
      <IconRail label="Node editor tools">
        <ToolButton label="Select" active iconOnly><span slot="icon">↖</span></ToolButton>
        <ToolButton label="Link" iconOnly><span slot="icon">⌁</span></ToolButton>
        <ToolButton label="Comment" iconOnly><span slot="icon">▱</span></ToolButton>
        <ToolButton label="Cut" iconOnly><span slot="icon">╱</span></ToolButton>
      </IconRail>
      <DockPanel label="Node catalogue" position="left" size="narrow">
        <PanelHeader title="Nodes" eyebrow="Catalogue" compact><span slot="metadata">28</span></PanelHeader>
        <label class="tool-lab-search"><span>Find node</span><input type="search" value="surface" aria-label="Find node" /></label>
        <EditorTreeIsland client:load variant="node" />
      </DockPanel>
    </div>

    <div slot="viewport" class="tool-lab-viewport tool-lab-viewport--node" aria-label="Material node graph viewport">
      <ThreeDViewportIsland client:load variant="node" />
    </div>

    <DockPanel slot="right" label="Node properties" position="right" size="regular" class="tool-lab-node-inspector">
      <PanelHeader title="Machined metal" eyebrow="Node / Surface" compact><span slot="metadata">07</span></PanelHeader>
      <InspectorSection title="Material" open>
        <ToolSelect label="Base layer" value="steel" options={[{ value: "steel", label: "Pale steel" }, { value: "graphite", label: "Graphite" }]} />
        <ToolNumberField label="Roughness" value="0.72" min={0} max={1} step="0.01" />
        <ToolNumberField label="Metallic" value="0.94" min={0} max={1} step="0.01" />
      </InspectorSection>
      <InspectorSection title="Signal response" open>
        <span slot="meta">Blue</span>
        <ToolNumberField label="Strength" value="0.08" min={0} max={4} step="0.01" />
        <ToolToggle label="Use state input" pressed />
      </InspectorSection>
      <InspectorSection title="Compilation" open>
        <dl class="tool-lab-ledger"><div><dt>Target</dt><dd>WebGPU</dd></div><div><dt>Passes</dt><dd>03</dd></div><div><dt>Digest</dt><dd>8D2A</dd></div></dl>
      </InspectorSection>
    </DockPanel>

    <DockPanel slot="bottom" label="Material assets" position="bottom" class="tool-lab-node-assets">
      <PanelHeader title="Material assets" eyebrow="Project / Surfaces" compact><span slot="metadata">06</span></PanelHeader>
      <div class="tool-lab-material-strip">
        {[
          ["Command steel", "linear-gradient(135deg,#d9dddc,#6f7880)"],
          ["Graphite hull", "linear-gradient(135deg,#1b2229,#07090c)"],
          ["Signal glass", "linear-gradient(135deg,#11243f,#4d9cff)"],
          ["Warning enamel", "linear-gradient(135deg,#31140d,#f06a3c)"],
          ["Paper grid", "linear-gradient(135deg,#f3f3f0,#c4c9c8)"]
        ].map(([name, swatch], index) => (
          <button type="button" data-active={index === 0 ? "true" : "false"}>
            <span style={`background:${swatch}`}></span><b>{name}</b><small>Surface</small>
          </button>
        ))}
      </div>
    </DockPanel>

    <StatusBar slot="status"><span>Graph compiled</span><span>0 warnings</span><span slot="secondary">WebGPU · 1.8 ms</span></StatusBar>
  </WorkbenchShell>

  <div class="tool-lab-notes">
    <article><b>One panel grammar</b><p>The floating command palette uses the same header, seams, and material tokens as docked catalogues and inspectors.</p></article>
    <article><b>Graph remains dominant</b><p>Node colour is semantic and sparse; the canvas and connections carry the content while chrome stays neutral.</p></article>
    <article><b>Keyboard density</b><p>Command hints and roving tab semantics support high-frequency editor use without relying on text-link navigation.</p></article>
  </div>
</section>
