---
import {
  discoveryFilters,
  discoveryStates,
  discoveryViews,
  packageCards,
  packagesSummary
} from "../../lib/v2-packages.mjs";

const { packageUrl = "#package" } = Astro.props;
const tone = (value) => ({ stable: "success", preview: "signal", deprecated: "warning", verified: "success", partial: "warning", unknown: "muted" }[value] ?? "muted");
---
<section class="packages-hero" id="discover" aria-labelledby="packages-title">
  <div class="packages-hero-copy">
    <p class="hara-v2-kicker">Application buildout · Packages</p>
    <h1 id="packages-title">Find the exact thing you can trust.</h1>
    <p>Search packages and namespaces together, then evaluate exact releases through compatibility, maintenance, ownership, artifacts, and reproducibility. Usage is useful context; it never replaces provenance.</p>
    <div class="packages-hero-actions">
      <a class="packages-primary-link" href="#package">Inspect a package</a>
      <a href="#publish">Publish a release</a>
      <a href="#maintain">Open maintainer tools</a>
    </div>
    <dl class="packages-hero-facts">
      <div><dt>Content contract</dt><dd>{packagesSummary.contentTypes} hara.packages@2.2.0 types</dd></div>
      <div><dt>Fixture packages</dt><dd>{packagesSummary.packages} exact coordinates</dd></div>
      <div><dt>Namespaces</dt><dd>{packagesSummary.namespaces} registry references</dd></div>
      <div><dt>Trust questions</dt><dd>{packagesSummary.provenanceQuestions} evidence-backed answers</dd></div>
    </dl>
  </div>

  <article class="packages-hero-registry" aria-label="Registry identity example">
    <header><span>Registry lookup</span><span class="packages-state" data-tone="success">Exact match</span></header>
    <div class="packages-coordinate" data-identity-kind="package"><small>Package coordinate</small><strong>hara/std.typed</strong><span>2.4.1 · stable</span></div>
    <div class="packages-identity-flow"><span data-identity-kind="package">package:hara/std.typed</span><i>contains</i><span data-identity-kind="namespace">namespace:std.typed</span></div>
    <dl>
      <div><dt>Release revision</dt><dd class="packages-mono">6a7f813ca41d227e</dd></div>
      <div><dt>Artifact digest</dt><dd class="packages-mono">sha256:8ad194f1764a…</dd></div>
      <div><dt>Publisher</dt><dd class="packages-mono">identity:github:hoebat</dd></div>
      <div><dt>Compatibility</dt><dd>3 verified · 1 partial</dd></div>
    </dl>
    <footer><a href={packageUrl}>Open exact package record →</a></footer>
  </article>
</section>

<section class="packages-section packages-discovery" aria-labelledby="packages-discovery-title">
  <header class="packages-section-heading">
    <div><p class="hara-v2-kicker">Package discovery</p><h2 id="packages-discovery-title">Search by coordinate, namespace, purpose, or capability.</h2></div>
    <p>Filters expose domain, runtime, stability, license, and compatibility independently. The result list retains exact release and maintenance state in every view.</p>
  </header>

  <form class="packages-search-panel" role="search" onsubmit="return false">
    <label class="packages-search-query"><span>Search packages and namespaces</span><input type="search" placeholder="hara/std.typed or std.typed/coerce" data-package-query /></label>
    <div class="packages-filter-grid">
      {Object.entries(discoveryFilters).map(([id, values]) => (
        <label><span>{id}</span><select data-package-filter={id}>{values.map((value) => <option value={value}>{value}</option>)}</select></label>
      ))}
    </div>
    <div class="packages-view-switch" role="group" aria-label="Discovery ordering">
      {discoveryViews.map((view, index) => <button type="button" data-package-view={view.id} aria-pressed={index === 0 ? "true" : "false"}><strong>{view.label}</strong><small>{view.description}</small></button>)}
    </div>
    <footer><output data-package-count>{packageCards.length} packages</output><button type="button" data-package-reset>Reset discovery</button></footer>
  </form>

  <div class="packages-discovery-states" role="group" aria-label="Discovery service states">
    {discoveryStates.map((state, index) => <button type="button" data-discovery-state={state.id} aria-pressed={index === 0 ? "true" : "false"}><span class="packages-state" data-tone={state.tone}>{state.label}</span></button>)}
  </div>
  <div class="packages-discovery-state-panels" aria-live="polite">
    {discoveryStates.map((state, index) => <article data-discovery-panel={state.id} hidden={index !== 0}><span class="packages-state" data-tone={state.tone}>{state.label}</span><p>{state.summary}</p><code>registry {state.id === "stale-index" ? "indexed 2026-08-20T04:00Z" : "71c4ef92"}</code></article>)}
  </div>

  <div class="packages-card-grid" data-package-grid>
    {packageCards.map((item) => (
      <article data-package-card={item.id} data-maintenance={item.maintenance}>
        <header>
          <div class="packages-coordinate" data-identity-kind="package"><small>Package</small><strong>{item.coordinate}</strong><span>{item.latestVersion}</span></div>
          <div class="packages-card-actions"><button type="button" data-package-save aria-pressed={item.saved ? "true" : "false"} data-inactive-label="Save" data-active-label="Saved">{item.saved ? "Saved" : "Save"}</button><button type="button" data-package-follow aria-pressed={item.followed ? "true" : "false"} data-inactive-label="Follow" data-active-label="Following">{item.followed ? "Following" : "Follow"}</button></div>
        </header>
        <h3>{item.title}</h3><p>{item.summary}</p>
        <div class="packages-card-states"><span class="packages-state" data-tone={tone(item.stability)}>{item.stability}</span><span class="packages-state" data-tone={tone(item.compatibility)}>{item.compatibility}</span><code>{item.license}</code></div>
        <div class="packages-namespace-chips" aria-label={`${item.coordinate} namespaces`}>{item.namespaces.slice(0, 3).map((namespace) => <span data-identity-kind="namespace">{namespace}</span>)}{item.namespaces.length > 3 && <span>+{item.namespaces.length - 3}</span>}</div>
        <dl><div><dt>Runtimes</dt><dd>{item.runtimes.join(" · ")}</dd></div><div><dt>Dependants</dt><dd>{item.dependants}</dd></div><div><dt>Updated</dt><dd><time datetime={item.updatedAt}>{item.updatedAt.slice(0, 10)}</time></dd></div><div><dt>Release revision</dt><dd class="packages-mono">{item.releaseRevision}</dd></div></dl>
        <footer><span>{item.maintenance}</span><a href={item.id === "package-hara-std-typed" ? packageUrl : "#package"}>Inspect package →</a></footer>
      </article>
    ))}
  </div>
  <div class="packages-empty" data-package-empty hidden><strong>No package matches this exact query and filter set.</strong><p>Reset one filter or keep the coordinate for a future registry refresh. No approximate result is substituted.</p><button type="button" data-package-reset>Reset discovery</button></div>
</section>
