---
const {
  label = "On this page",
  enabled = true
} = Astro.props;
const idSeed = String(label)
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "") || "sections";
const linksId = `v2-catalogue-${idSeed}-links`;
---
{enabled && (
  <nav
    class="v2-catalogue-section-nav"
    aria-label={label}
    hidden
    data-catalogue-section-nav
    data-catalogue-section-label={label}
    data-open="false"
  >
    <button
      class="v2-catalogue-section-trigger"
      type="button"
      aria-expanded="false"
      aria-controls={linksId}
      aria-label={`Show ${label.toLowerCase()} navigation`}
      data-catalogue-section-trigger
    >
      <span class="v2-catalogue-section-trigger-label">{label}</span>
      <span class="v2-catalogue-section-trigger-current" data-catalogue-section-current>Overview</span>
      <span class="v2-catalogue-section-trigger-chevron" aria-hidden="true"></span>
    </button>
    <div class="v2-catalogue-section-links" id={linksId} data-catalogue-section-links></div>
    <div class="v2-catalogue-section-progress" aria-hidden="true" data-catalogue-section-progress></div>
  </nav>
)}

<script>
  const ensureScrollProgress = () => {
    let progress = document.querySelector("[data-v2-scroll-progress]");
    if (!(progress instanceof HTMLElement)) {
      progress = document.createElement("div");
      progress.className = "v2-scroll-progress";
      progress.dataset.v2ScrollProgress = "true";
      progress.setAttribute("role", "progressbar");
      progress.setAttribute("aria-label", "Page scroll progress");
      progress.setAttribute("aria-valuemin", "0");
      progress.setAttribute("aria-valuemax", "100");
      progress.setAttribute("aria-valuenow", "0");
      const fill = document.createElement("span");
      fill.setAttribute("aria-hidden", "true");
      progress.append(fill);
      document.body.append(progress);
    }

    const update = () => {
      const maximum = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const value = maximum === 0 ? 1 : Math.min(1, Math.max(0, window.scrollY / maximum));
      const percentage = Math.round(value * 100);
      progress.style.setProperty("--v2-scroll-progress", String(value));
      progress.setAttribute("aria-valuenow", String(percentage));
      progress.setAttribute("aria-valuetext", `${percentage}%`);
    };

    if (progress.dataset.listener !== "true") {
      progress.dataset.listener = "true";
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update, { passive: true });
      document.addEventListener("astro:page-load", update);
    }
    update();
  };

  const initialiseCatalogueSections = () => {
    document.querySelectorAll("[data-catalogue-section-nav]").forEach((nav) => {
      if (!(nav instanceof HTMLElement) || nav.dataset.ready === "true") return;
      const main = document.querySelector("main");
      const links = nav.querySelector("[data-catalogue-section-links]");
      const sectionProgress = nav.querySelector("[data-catalogue-section-progress]");
      const trigger = nav.querySelector("[data-catalogue-section-trigger]");
      const currentLabel = nav.querySelector("[data-catalogue-section-current]");
      const shell = nav.closest("[data-catalogue-secondary-shell]");
      if (!(main instanceof HTMLElement) || !(links instanceof HTMLElement) || !(sectionProgress instanceof HTMLElement) || !(trigger instanceof HTMLButtonElement)) return;

      const directSections = [...main.querySelectorAll(":scope > section[id]:not([data-catalogue-section-ignore]), :scope > article[id]:not([data-catalogue-section-ignore])")];
      const candidates = directSections.length > 1
        ? directSections
        : [...main.querySelectorAll("section[id], article[id]")]
          .filter((section) => !section.closest("[data-prototype-frame]") && !section.hasAttribute("data-catalogue-section-ignore"))
          .slice(0, 14);
      const sections = candidates.filter((section) => section instanceof HTMLElement && section.id);
      if (sections.length < 2) return;

      const labelCandidates = new Map();
      document.querySelectorAll("nav:not([data-catalogue-section-nav]) a[href^='#']").forEach((anchor) => {
        if (!(anchor instanceof HTMLAnchorElement) || anchor.closest("[data-prototype-frame]")) return;
        const id = anchor.getAttribute("href")?.slice(1);
        const text = anchor.textContent?.trim().replace(/\s+/g, " ");
        if (!id || !text || text.length > 36 || !sections.some((section) => section.id === id)) return;
        const source = anchor.closest("nav");
        const aria = source?.getAttribute("aria-label") ?? "";
        const preferred = source?.matches(".foundations-section-nav, .components-section-nav, .ui-section-nav, .playground-local-nav, .start-journey")
          || /section|journey|reference/i.test(aria);
        const candidate = { text, score: preferred ? 0 : 1 };
        const existing = labelCandidates.get(id);
        if (!existing || candidate.score < existing.score || (candidate.score === existing.score && text.length < existing.text.length)) {
          labelCandidates.set(id, candidate);
        }
      });

      nav.dataset.ready = "true";
      links.replaceChildren();
      sectionProgress.replaceChildren();
      const linkById = new Map();
      const progressById = new Map();
      const navigationLabel = nav.dataset.catalogueSectionLabel || "On this page";

      const setOpen = (requestedOpen, restoreFocus = false) => {
        const open = Boolean(requestedOpen);
        nav.dataset.open = String(open);
        trigger.setAttribute("aria-expanded", String(open));
        trigger.setAttribute("aria-label", `${open ? "Hide" : "Show"} ${navigationLabel.toLowerCase()} navigation`);
        links.setAttribute("aria-hidden", String(!open));
        if (open && shell instanceof HTMLElement) {
          shell.dispatchEvent(new CustomEvent("hara:catalogue-secondary-disclosure", {
            bubbles: false,
            detail: { kind: "section", open: true }
          }));
        }
        if (!open && restoreFocus) trigger.focus();
      };

      const titleCaseId = (id) => id
        .split("-")
        .filter(Boolean)
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(" ");

      const labelFor = (section) => {
        const explicit = section.getAttribute("data-section-label");
        if (explicit) return explicit;
        const mapped = labelCandidates.get(section.id);
        if (mapped?.text) return mapped.text;
        return titleCaseId(section.id);
      };

      const setCurrent = (id) => {
        linkById.forEach((link, candidateId) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          if (candidateId === id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
        const currentIndex = sections.findIndex((section) => section.id === id);
        progressById.forEach((segment, candidateId) => {
          const segmentIndex = sections.findIndex((section) => section.id === candidateId);
          segment.dataset.state = segmentIndex < currentIndex ? "complete" : segmentIndex === currentIndex ? "current" : "upcoming";
        });
        const active = linkById.get(id);
        if (currentLabel instanceof HTMLElement && active instanceof HTMLAnchorElement) {
          currentLabel.textContent = active.textContent || "Overview";
        }
      };

      sections.forEach((section, index) => {
        const anchor = document.createElement("a");
        anchor.href = `#${section.id}`;
        anchor.textContent = labelFor(section);
        anchor.addEventListener("click", () => {
          setCurrent(section.id);
          setOpen(false);
        });
        links.append(anchor);
        linkById.set(section.id, anchor);
        const segment = document.createElement("span");
        segment.setAttribute("data-section-progress", section.id);
        segment.dataset.state = "upcoming";
        sectionProgress.append(segment);
        progressById.set(section.id, segment);
        if (index === 0) setCurrent(section.id);
      });

      nav.hidden = false;
      setOpen(false);
      document.body.dataset.catalogueSectionReady = "true";
      ensureScrollProgress();

      trigger.addEventListener("click", () => setOpen(nav.dataset.open !== "true"));
      shell?.addEventListener("hara:catalogue-secondary-disclosure", (event) => {
        if (!(event instanceof CustomEvent) || event.detail?.kind === "section" || !event.detail?.open) return;
        setOpen(false);
      });

      const observer = "IntersectionObserver" in window
        ? new IntersectionObserver((entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)[0];
            if (visible?.target instanceof HTMLElement) setCurrent(visible.target.id);
          }, { rootMargin: "-30% 0px -62% 0px", threshold: [0, .05, .25] })
        : null;
      sections.forEach((section) => observer?.observe(section));

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || nav.dataset.open !== "true") return;
        setOpen(false, true);
      });
    });
  };

  initialiseCatalogueSections();
  document.addEventListener("astro:page-load", initialiseCatalogueSections);
</script>
