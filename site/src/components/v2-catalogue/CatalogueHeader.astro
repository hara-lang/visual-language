---
import ThemeToggle from "../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../src/astro/HaraMark.astro";
import {
  catalogueGroups,
  catalogueGroupIsCurrent,
  catalogueHref,
  catalogueItemIsCurrent,
  catalogueLinkIsExternal,
  catalogueStatusLabels
} from "../../lib/v2-catalogue.mjs";
import "../../styles/v2-catalogue.css";
import "../../styles/v2-catalogue-disclosure.css";

const {
  basePath,
  activePath = "/v2/",
  label = "Hara visual language catalogue",
  sourceHref = "https://github.com/hara-lang/visual-language"
} = Astro.props;

const catalogueHome = `${basePath.endsWith("/") ? basePath : `${basePath}/`}v2/`;
const menuGroups = catalogueGroups.map((group) => ({
  ...group,
  current: catalogueGroupIsCurrent(group, activePath),
  items: group.items.map((item) => ({
    ...item,
    current: catalogueItemIsCurrent(item, activePath),
    external: catalogueLinkIsExternal(item),
    resolvedHref: catalogueHref(item, basePath),
    children: (item.children ?? []).map((child) => ({
      ...child,
      current: catalogueItemIsCurrent(child, activePath),
      external: catalogueLinkIsExternal(child),
      resolvedHref: catalogueHref(child, basePath)
    }))
  }))
}));
const fallbackItems = menuGroups.flatMap((group) => group.items.flatMap((item) => [item, ...item.children]));
---
<header class="v2-catalogue-header" data-catalogue-header data-menu-open="false">
  <a class="v2-catalogue-brand" href={catalogueHome} aria-label={label}>
    <HaraMark size={28} />
    <span>
      <b>Hara visual language</b>
      <small>Interface catalogue · V2</small>
    </span>
  </a>

  <button
    class="v2-catalogue-menu-button"
    type="button"
    aria-expanded="false"
    aria-controls="v2-catalogue-navigation"
    data-catalogue-menu-button
  >
    <span>Browse catalogue</span>
    <small>Foundations · Library · Applications</small>
  </button>

  <nav class="v2-catalogue-nav" id="v2-catalogue-navigation" aria-label="Visual language catalogue" data-catalogue-navigation>
    {menuGroups.map((group) => (
      <div class="v2-catalogue-group" data-catalogue-group data-current={group.current ? "true" : "false"} data-open="false">
        <button
          class="v2-catalogue-group-trigger"
          type="button"
          aria-expanded="false"
          aria-controls={`v2-catalogue-panel-${group.id}`}
          data-catalogue-group-trigger
        >
          <span>{group.label}</span>
          <small>{group.items.length}</small>
        </button>
        <div class="v2-catalogue-panel" id={`v2-catalogue-panel-${group.id}`}>
          <header>
            <p class="hara-v2-kicker">Catalogue group</p>
            <h2>{group.label}</h2>
            <p>{group.summary}</p>
          </header>
          <div class="v2-catalogue-panel-grid">
            {group.items.map((item) => (
              <article class="v2-catalogue-menu-item" data-status={item.status} data-current={item.current ? "true" : "false"}>
                <a
                  href={item.resolvedHref}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                  aria-current={item.current ? "page" : undefined}
                >
                  <span class="v2-catalogue-menu-eyebrow">{item.eyebrow ?? group.label}</span>
                  <b>{item.label}</b>
                  <p>{item.summary}</p>
                  <span class="v2-catalogue-status" data-status={item.status}>
                    {catalogueStatusLabels[item.status]}
                    {item.external && item.issue ? ` · #${item.issue}` : ""}
                  </span>
                </a>
                {item.children.length > 0 && (
                  <nav aria-label={`${item.label} routes`} class="v2-catalogue-children">
                    {item.children.map((child) => (
                      <a
                        href={child.resolvedHref}
                        target={child.external ? "_blank" : undefined}
                        rel={child.external ? "noreferrer" : undefined}
                        aria-current={child.current ? "page" : undefined}
                      >
                        <span>{child.label}</span>
                        <small data-status={child.status}>{catalogueStatusLabels[child.status]}</small>
                      </a>
                    ))}
                  </nav>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    ))}
  </nav>

  <noscript>
    <nav class="v2-catalogue-noscript" aria-label="Visual language catalogue without JavaScript">
      {fallbackItems.map((item) => (
        <a
          href={item.resolvedHref}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >{item.label}</a>
      ))}
    </nav>
  </noscript>

  <div class="v2-catalogue-actions">
    <a href={sourceHref}>Source</a>
    <ThemeToggle />
  </div>
</header>

<script>
  const initialiseCatalogueHeader = () => {
    document.querySelectorAll("[data-catalogue-header]").forEach((header) => {
      if (!(header instanceof HTMLElement) || header.dataset.ready === "true") return;
      header.dataset.ready = "true";
      header.dataset.enhanced = "true";
      header.dataset.menuOpen = "false";

      const menuButton = header.querySelector("[data-catalogue-menu-button]");
      const navigation = header.querySelector("[data-catalogue-navigation]");
      const groups = [...header.querySelectorAll("[data-catalogue-group]")];

      const closeMenu = (restoreFocus = false) => {
        header.dataset.menuOpen = "false";
        if (menuButton instanceof HTMLButtonElement) {
          menuButton.setAttribute("aria-expanded", "false");
          if (restoreFocus) menuButton.focus();
        }
      };

      const setGroupOpen = (group, open, restoreFocus = false) => {
        if (!(group instanceof HTMLElement)) return;
        group.dataset.open = String(open);
        const trigger = group.querySelector("[data-catalogue-group-trigger]");
        if (trigger instanceof HTMLButtonElement) {
          trigger.setAttribute("aria-expanded", String(open));
          if (restoreFocus) trigger.focus();
        }
      };

      const closeGroups = (except = null, restoreFocus = false) => {
        groups.forEach((group) => {
          if (group === except || !(group instanceof HTMLElement) || group.dataset.open !== "true") return;
          setGroupOpen(group, false, restoreFocus);
        });
      };

      if (menuButton instanceof HTMLButtonElement && navigation instanceof HTMLElement) {
        menuButton.addEventListener("click", () => {
          const open = header.dataset.menuOpen !== "true";
          header.dataset.menuOpen = String(open);
          menuButton.setAttribute("aria-expanded", String(open));
          if (!open) closeGroups();
        });
      }

      groups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        const trigger = group.querySelector("[data-catalogue-group-trigger]");
        if (!(trigger instanceof HTMLButtonElement)) return;
        trigger.addEventListener("click", () => {
          const open = group.dataset.open !== "true";
          closeGroups(group);
          setGroupOpen(group, open);
        });
      });

      header.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          closeGroups();
          closeMenu();
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const openGroup = groups.find((group) => group instanceof HTMLElement && group.dataset.open === "true");
        if (openGroup instanceof HTMLElement) {
          setGroupOpen(openGroup, false, true);
          return;
        }
        if (header.dataset.menuOpen === "true") closeMenu(true);
      });

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node) || header.contains(event.target)) return;
        closeGroups();
        closeMenu();
      });
    });
  };

  initialiseCatalogueHeader();
  document.addEventListener("astro:page-load", initialiseCatalogueHeader);
</script>
