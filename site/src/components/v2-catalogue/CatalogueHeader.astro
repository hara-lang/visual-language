---
import CatalogueMasthead from "./CatalogueMasthead.astro";
import CataloguePageFooter from "./CataloguePageFooter.astro";
import CatalogueRouteBar from "./CatalogueRouteBar.astro";
import CatalogueSectionNav from "./CatalogueSectionNav.astro";
import { ensureFoundationComponentInventory } from "../../lib/v2-foundation-component-inventory.mjs";
import { ensureSymbolComponentInventory } from "../../lib/v2-symbol-component-inventory.mjs";
import { ensureSymbolsCatalogueRoute } from "../../lib/v2-symbols-catalogue.mjs";
import "../../../../src/v2/catalogue-navigation.css";
import "../../styles/v2-navigation-tighten.css";
import "../../styles/v2-navigation-mobile-polish.css";
import "../../styles/v2-matrix-regression-fixes.css";
import "../../styles/v2-catalogue-secondary-one-line.css";

ensureFoundationComponentInventory();
ensureSymbolComponentInventory();
ensureSymbolsCatalogueRoute();

const {
  basePath,
  activePath,
  label = "Hara visual language catalogue",
  sectionNav = true,
  pageFooter = true
} = Astro.props;

const normalizedBasePath = basePath.endsWith("/") ? basePath : `${basePath}/`;
const pathname = Astro.url.pathname.startsWith(normalizedBasePath)
  ? `/${Astro.url.pathname.slice(normalizedBasePath.length)}`
  : Astro.url.pathname;
const resolvedActivePath = activePath ?? pathname;
const deepRoute = resolvedActivePath !== "/";
const componentCatalogue = resolvedActivePath.replace(/\/+$/, "") === "/components";
const RenderedComponentGallery = componentCatalogue
  ? (await import("./RenderedComponentGalleryEntry.astro")).default
  : null;
---
<CatalogueMasthead
  basePath={basePath}
  activePath={resolvedActivePath}
  label={label}
/>

{deepRoute && (
  <div class="v2-catalogue-secondary-shell" data-catalogue-secondary-shell>
    <CatalogueRouteBar basePath={basePath} activePath={resolvedActivePath}>
      <Fragment slot="actions"><slot name="route-actions" /></Fragment>
    </CatalogueRouteBar>
    {sectionNav && <CatalogueSectionNav label="Sections" />}
    <slot name="secondary-nav" />
  </div>
)}
{RenderedComponentGallery && (
  <section
    id="rendered-components"
    class="v2-component-showcase-section"
    data-section-label="Rendered components"
    data-components-showcase-mount
  >
    <RenderedComponentGallery />
  </section>
)}
<script is:inline>
  (() => {
    const initialShowcase = document.querySelector("[data-components-showcase-mount]");
    if (!(initialShowcase instanceof HTMLElement)) return;

    const mountComponentShowcase = () => {
      const showcase = document.querySelector("[data-components-showcase-mount]");
      const main = document.querySelector("main.components-main");
      const hero = main?.querySelector(":scope > .components-hero");
      if (!(showcase instanceof HTMLElement) || !(main instanceof HTMLElement) || !(hero instanceof HTMLElement)) return false;

      if (showcase.parentElement !== main || showcase.previousElementSibling !== hero) hero.after(showcase);

      const primary = hero.querySelector(".components-hero-actions a[data-variant='primary']");
      if (primary instanceof HTMLAnchorElement) {
        primary.setAttribute("href", "#rendered-components");
        primary.textContent = "See rendered components";
      }
      return true;
    };

    if (!mountComponentShowcase()) {
      const observer = new MutationObserver(() => {
        if (mountComponentShowcase()) observer.disconnect();
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
      document.addEventListener("DOMContentLoaded", () => {
        if (mountComponentShowcase()) observer.disconnect();
      }, { once: true });
      document.addEventListener("astro:page-load", () => {
        if (mountComponentShowcase()) observer.disconnect();
      });
    }
  })();
</script>
<CataloguePageFooter basePath={basePath} activePath={pageFooter ? resolvedActivePath : "/"} />
<span id="v2-catalogue-content" class="v2-catalogue-content-target" tabindex="-1" aria-label="Route content begins"></span>
