---
import ThemeToggle from "@hara-lang/ui-astro/astro/ThemeToggle.astro";
import Header from "@hara-lang/ui-astro/astro/v2/Header.astro";
import CatalogueFallback from "./CatalogueFallback.astro";
import CatalogueLauncher from "./CatalogueLauncher.astro";
import { catalogueRouteContext } from "../../lib/v2-catalogue.mjs";
import "../../styles/v2-catalogue.css";
import "../../styles/v2-catalogue-disclosure.css";
import "../../styles/v2-mobile-polish.css";
import "../../styles/v2-navigation-tighten.css";

const {
  basePath,
  activePath = "/",
  label = "Hara visual language catalogue"
} = Astro.props;

const normalizedBasePath = basePath.endsWith("/") ? basePath : `${basePath}/`;
const catalogueHome = `${normalizedBasePath}`;
const context = catalogueRouteContext(activePath);
const launcherContext = context?.group.label ?? "Catalogue";
const catalogueNav = [
  { href: `${normalizedBasePath}www/docs/`, label: "Docs", current: activePath.startsWith("/www/docs") },
  { href: `${normalizedBasePath}components/`, label: "Components", current: activePath.startsWith("/components") },
  { href: `${normalizedBasePath}ui/`, label: "Patterns", current: activePath.startsWith("/ui") }
];
---
<div class="v2-catalogue-shell" data-catalogue-masthead data-launcher-open="false">
  <a class="v2-catalogue-skip-link" href="#v2-catalogue-content">Skip to route content</a>
  <Header
    homeHref={catalogueHome}
    section="Visual language"
    nav={catalogueNav}
    activePath={activePath}
    label={label}
    account="logged-out"
    accountHref="#account"
  >
    <button
      class="v2-catalogue-launcher-trigger v2-catalogue-desktop-launcher"
      type="button"
      aria-expanded="false"
      aria-controls="v2-catalogue-launcher"
      data-catalogue-launcher-trigger
    >
      <span class="v2-catalogue-launcher-icon" aria-hidden="true">
        {Array.from({ length: 9 }, () => <i></i>)}
      </span>
      <span>Browse</span>
      <small>{launcherContext}</small>
    </button>
    <ThemeToggle />

    <div slot="mobile-navigation" class="v2-catalogue-mobile-navigation">
      <p class="v2-catalogue-mobile-navigation-label">Catalogue</p>
      <button
        class="v2-catalogue-launcher-trigger v2-catalogue-mobile-launcher"
        type="button"
        aria-expanded="false"
        aria-controls="v2-catalogue-launcher"
        data-catalogue-launcher-trigger
      >
        <span class="v2-catalogue-launcher-icon" aria-hidden="true">
          {Array.from({ length: 9 }, () => <i></i>)}
        </span>
        <span>Browse catalogue</span>
      </button>
    </div>
  </Header>

  <CatalogueLauncher basePath={basePath} activePath={activePath} />
  <CatalogueFallback basePath={basePath} />
</div>

<script>
  const initialiseCatalogueMastheads = () => {
    document.querySelectorAll("[data-catalogue-masthead]").forEach((header) => {
      if (!(header instanceof HTMLElement) || header.dataset.ready === "true") return;
      header.dataset.ready = "true";

      const triggers = Array.from(header.querySelectorAll("[data-catalogue-launcher-trigger]")).filter(
        (element) => element instanceof HTMLButtonElement
      );
      const launcher = header.querySelector("[data-catalogue-launcher]");
      const backdrop = header.querySelector("[data-catalogue-launcher-backdrop]");
      const close = header.querySelector("[data-catalogue-launcher-close]");
      if (triggers.length === 0 || !(launcher instanceof HTMLElement) || !(backdrop instanceof HTMLElement)) return;

      let activeTrigger = triggers[0];

      const setOpen = (open, restoreFocus = false) => {
        header.dataset.launcherOpen = String(open);
        triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(open)));
        launcher.hidden = !open;
        backdrop.hidden = !open;
        document.documentElement.dataset.catalogueLauncherOpen = String(open);

        if (open) {
          const firstLink = launcher.querySelector("a[aria-current], a");
          if (firstLink instanceof HTMLAnchorElement) requestAnimationFrame(() => firstLink.focus());
        } else if (restoreFocus) activeTrigger.focus();
      };

      triggers.forEach((trigger) => trigger.addEventListener("click", () => {
        activeTrigger = trigger;
        const mobileMenu = header.querySelector("[data-hara-header-menu]");
        if (trigger.closest("[data-hara-mobile-navigation]") && mobileMenu instanceof HTMLButtonElement && mobileMenu.getAttribute("aria-expanded") === "true") {
          mobileMenu.click();
        }
        setOpen(header.dataset.launcherOpen !== "true");
      }));
      backdrop.addEventListener("click", () => setOpen(false, true));
      if (close instanceof HTMLButtonElement) close.addEventListener("click", () => setOpen(false, true));
      launcher.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && header.dataset.launcherOpen === "true") setOpen(false, true);
      });
    });
  };

  initialiseCatalogueMastheads();
  document.addEventListener("astro:page-load", initialiseCatalogueMastheads);
</script>
