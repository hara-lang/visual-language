---
import {
  experienceEntrances,
  learnerStates,
  learnSummary,
  outcomeTracks
} from "../../lib/v2-learn.mjs";

const { playgroundUrl = "#lesson" } = Astro.props;
const initialEntrance = experienceEntrances[0];
---
<section class="learn-hero" id="start" aria-labelledby="learn-title">
  <div class="learn-hero-copy">
    <p class="hara-v2-kicker">Learning reference · Hara</p>
    <h1 id="learn-title">Learn the language one form at a time.</h1>
    <p>A form is a Hara data structure that can represent code or data and can be inspected before it is evaluated. The first lesson reads and runs one small form; later material introduces functions, namespaces, capabilities, packages, and runtime sessions.</p>
    <div class="learn-hero-actions">
      <a class="learn-primary-link" href="#lesson">Run the first form</a>
      <a href="#course">View the curriculum</a>
      <a href="#practice">Open a practice exercise</a>
    </div>
    <dl class="learn-hero-facts" aria-label="Learn fixture inventory">
      <div><dt>Entrances</dt><dd>{learnSummary.entrances} explanation levels</dd></div>
      <div><dt>Tracks</dt><dd>{learnSummary.tracks} project contexts</dd></div>
      <div><dt>Contract</dt><dd>{learnSummary.contentTypes} hara.learn@2.0.0 content types</dd></div>
      <div><dt>Account</dt><dd>Not required for local execution</dd></div>
    </dl>
  </div>

  <div class="learn-first-run" aria-label="First lesson source and result">
    <header>
      <div><span>First lesson</span><strong>lesson-01.hara</strong></div>
      <span class="learn-state" data-tone="success">Local Wasm · ready</span>
    </header>
    <pre><code><b>(defn</b> greet [name]
  &#123;<i>:message</i> (str "Hello, " name)
   <i>:next</i>    <i>:build-something</i>&#125;)

(greet "Hara")</code></pre>
    <div class="learn-first-run-output" data-first-run-output>
      <i></i><strong>Ready to run</strong><span>No account · editor remains unfocused</span><code>⌘ ↵</code>
    </div>
    <footer>
      <button type="button" data-first-run>Run form</button>
      <button type="button" data-first-edit>Edit source</button>
      <a href={playgroundUrl}>Open this revision in Playground →</a>
    </footer>
  </div>
</section>

<section class="learn-section learn-entrances" aria-labelledby="learn-entrances-title">
  <header class="learn-section-heading">
    <div><p class="hara-v2-kicker">Explanation level</p><h2 id="learn-entrances-title">Choose the background that best describes you.</h2></div>
    <p>The selected entrance changes explanation depth and the recommended first lesson. It does not create a separate version of Hara or remove prerequisites from the curriculum.</p>
  </header>

  <div class="learn-entrance-layout">
    <div class="learn-entrance-options" role="list" aria-label="Experience-level entrances">
      {experienceEntrances.map((entrance, index) => (
        <button type="button" role="listitem" data-learn-entrance={entrance.id} data-label={entrance.label} data-title={entrance.title} data-summary={entrance.summary} data-lesson={entrance.firstLesson} data-minutes={entrance.estimatedMinutes} data-evidence={entrance.evidence} aria-pressed={index === 0 ? "true" : "false"}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{entrance.label}</strong>
          <small>{entrance.estimatedMinutes} minute introduction</small>
        </button>
      ))}
    </div>

    <article class="learn-entrance-preview" data-learn-entrance-preview>
      <header><span>Selected entrance</span><strong data-entrance-label>{initialEntrance.label}</strong></header>
      <h3 data-entrance-title>{initialEntrance.title}</h3>
      <p data-entrance-summary>{initialEntrance.summary}</p>
      <dl>
        <div><dt>First lesson</dt><dd class="learn-mono" data-entrance-lesson>{initialEntrance.firstLesson}</dd></div>
        <div><dt>Estimated time</dt><dd data-entrance-minutes>{initialEntrance.estimatedMinutes} minutes</dd></div>
        <div><dt>Sequence</dt><dd data-entrance-evidence>{initialEntrance.evidence}</dd></div>
      </dl>
      <a href="#lesson">Open the selected lesson →</a>
    </article>
  </div>
</section>

<section class="learn-section" id="tracks" aria-labelledby="learn-tracks-title">
  <header class="learn-section-heading">
    <div><p class="hara-v2-kicker">Project contexts</p><h2 id="learn-tracks-title">Choose a context for the same language concepts.</h2></div>
    <p>Tracks reuse concepts and exact lesson revisions. A preview track remains labelled as a preview and does not imply that every project or runtime capability is implemented.</p>
  </header>

  <div class="learn-track-toolbar">
    <label><span>Filter paths</span><input type="search" placeholder="Web, agents, music, source…" data-track-query /></label>
    <output data-track-count>{outcomeTracks.length} tracks</output>
  </div>

  <div class="learn-track-grid">
    {outcomeTracks.map((track) => (
      <article data-track-card data-search={[track.label, track.title, track.summary, track.status].join(" ").toLowerCase()} data-status={track.status}>
        <header><span>{track.icon}</span><span class="learn-state" data-tone={track.status === "available" ? "success" : "warning"}>{track.status}</span></header>
        <p class="hara-v2-kicker">{track.label}</p><h3>{track.title}</h3><p>{track.summary}</p>
        <footer><span>{track.units} units</span><a href="#course">View path →</a></footer>
      </article>
    ))}
  </div>

  <div class="learn-track-empty" data-track-empty hidden>
    <strong>No matching path</strong><p>The query remains visible so it can be changed without leaving Learn.</p><button type="button" data-track-reset>Clear filter</button>
  </div>
</section>

<section class="learn-section learn-account-states" aria-labelledby="learn-account-title">
  <header class="learn-section-heading">
    <div><p class="hara-v2-kicker">Local and saved progress</p><h2 id="learn-account-title">Run locally before creating an account.</h2></div>
    <p>An identity is used only when the reader chooses to save progress, private notes, or selected project links. The first lesson and local practice remain available without one.</p>
  </header>
  <div class="learn-account-grid">
    {learnerStates.map((state) => (
      <article data-learner-state={state.id}>
        <header><span>{state.label}</span><strong>{state.primaryAction}</strong></header><p>{state.summary}</p>
        <div><span>Registry-controlled facts</span>{state.controlledFacts.map((fact) => <code>{fact}</code>)}</div>
        <div><span>Learner-owned data</span>{state.editableFacts.map((fact) => <code>{fact}</code>)}</div>
      </article>
    ))}
  </div>
  <article class="learn-continue-card" data-returning-state>
    <div><span>Saved position</span><h3>Namespaces give values a durable home</h3><p>Resume the exact lesson revision from the last verified unit. A newer curriculum exists, so migration remains an explicit choice.</p></div>
    <dl><div><dt>Completed</dt><dd>3 of 7 units</dd></div><div><dt>Revision</dt><dd class="learn-mono">6f3a91c2</dd></div><div><dt>Next check</dt><dd>qualified symbol check</dd></div></dl>
    <a href="#lesson">Open saved lesson revision →</a>
  </article>
</section>
