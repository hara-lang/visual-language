---
import CatalogueHeader from "../../components/v2-catalogue/CatalogueHeader.astro";
import GuideRouteMatrix from "../../components/v2-guide/GuideRouteMatrix.astro";
import GuideRegressionReport from "../../components/v2-guide/GuideRegressionReport.astro";
import GuideReviewDeck from "../../components/v2-guide/GuideReviewDeck.astro";
import GuideReviewEvidence from "../../components/v2-guide/GuideReviewEvidence.astro";
import GuideArchitecture from "../../components/v2-guide/GuideArchitecture.astro";
import GuideAdoption from "../../components/v2-guide/GuideAdoption.astro";
import { guideFixtureNotice, guideSummary } from "../../lib/v2-guide.mjs";
import "../../../../src/v2.css";
import "../../../../src/theme.js";
import "../../styles/v2-lab.css";
import "../../styles/v2-calm-lab.css";
import "../../styles/v2-guide.css";
import "../../styles/v2-matrix-regression-fixes.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}guide/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueUrl = `${basePath}`;
const guideIssueUrl = "https://github.com/hara-lang/visual-language/issues/90";
const closeoutIssueUrl = "https://github.com/hara-lang/visual-language/issues/44";
const localNav = [
  { href: "#overview", label: "Overview" },
  { href: "#routes", label: "Routes" },
  { href: "#regressions", label: "Regressions" },
  { href: "#review", label: "Live review" },
  { href: "#architecture", label: "Architecture" },
  { href: "#lifecycle", label: "Lifecycle" },
  { href: "#adding", label: "Add a route" },
  { href: "#procedure", label: "Procedure" },
  { href: "#adoption", label: "Adoption" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The Hara v2 catalogue guide: manifest-backed route inventory, live light/dark viewport review matrix, recorded regressions, navigation and ownership architecture, lifecycle, validation and downstream adoption." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 catalogue guide and review matrix" />
    <meta property="og:description" content="Review each Hara v2 route against the same theme, viewport, state, provenance, and adoption procedure." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 catalogue guide" />
    <meta name="twitter:description" content="One catalogue architecture and live route review matrix for the complete Hara v2 interface system." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 catalogue guide and review matrix</title>
  </head>
  <body class="hara-v2 guide-page">
    <CatalogueHeader basePath={basePath} activePath="/guide/" label="Catalogue guide">
      <a slot="route-actions" href="#review">Open live review</a>
    </CatalogueHeader>

    <nav class="guide-local-nav" aria-label="Catalogue guide sections">
      <span>Guide</span>
      <div>{localNav.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <a href={closeoutIssueUrl}>Issue 44 ↗</a>
    </nav>

    <main class="guide-main">
      <aside class="guide-fixture-notice" role="note">
        <strong>{guideFixtureNotice.label}</strong>
        <span>{guideFixtureNotice.summary}</span>
        <code>{guideFixtureNotice.id} · {guideFixtureNotice.sourceRevision}</code>
      </aside>

      <section class="guide-hero" id="overview" aria-labelledby="guide-title">
        <div>
          <p class="hara-v2-kicker">Architecture · validation · adoption</p>
          <h1 id="guide-title">One route catalogue and one review procedure.</h1>
          <p>The guide makes route relationships, navigation ownership, route states, provenance, themes, responsive behavior and downstream responsibility reviewable from one place—without flattening every Hara site and tool into the same information architecture.</p>
          <div class="guide-hero-actions"><a class="guide-primary-link" href="#review">Review a live route</a><a href="#regressions">Read first findings</a><a href="#adding">Add an application</a></div>
        </div>
        <aside class="guide-hero-ledger" aria-label="Catalogue closeout summary">
          <header><span>Review envelope</span><span class="guide-state" data-tone="signal">Manifest-backed</span></header>
          <div><p class="guide-mono">v2/catalogue-guide@1</p><h2>{guideSummary.requiredRoutes} routes</h2><p>Each required route is reviewed across {guideSummary.themes} themes, {guideSummary.viewports} exact viewport widths and {guideSummary.reviewChecks} common checks.</p><dl><div><dt>Matrix cells</dt><dd>{guideSummary.matrixCells}</dd></div><div><dt>Current extensions</dt><dd>{guideSummary.supplementaryRoutes}</dd></div><div><dt>Historical studies</dt><dd>{guideSummary.historicalRoutes}</dd></div><div><dt>Default decision</dt><dd>Review required</dd></div></dl></div>
          <footer><span>Fixture, not certification</span><span>Exact route · theme · viewport · state</span></footer>
        </aside>
      </section>

      <GuideRouteMatrix basePath={basePath} />
      <GuideRegressionReport />
      <GuideReviewDeck basePath={basePath} />
      <GuideReviewEvidence />
      <GuideArchitecture />
      <GuideAdoption basePath={basePath} />

      <footer class="v2-lab-footer guide-footer"><span>Hara v2 catalogue guide and live review matrix</span><span><a href={catalogueUrl}>Catalogue home</a> · <a href={guideIssueUrl}>Guide issue 90</a> · <a href={closeoutIssueUrl}>Closeout issue 44</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span></footer>
    </main>

    <script>
      import { initialiseGuide } from "../../scripts/v2-guide.js";
      import { initialiseGuideReviewExport } from "../../scripts/v2-guide-review-export.js";
      initialiseGuide();
      initialiseGuideReviewExport();
    </script>
  </body>
</html>
