---
import ThemeToggle from "../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../src/astro/HaraMark.astro";
import Motif from "../../../src/astro/Motif.astro";
import Backdrop from "../../../src/astro/Backdrop.astro";
import "../../../src/theme.css";
import "../../../src/motifs.css";
import "../../../src/effects.css";
import "../../../src/theme.js";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pagesUrl = "https://hara-lang.github.io/visual-language/";
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site).toString();
const fields = [
  { id: "evaluation", file: "evaluation-field.svg", title: "Armour seam", description: "Evaluation state held on an exact machined boundary." },
  { id: "syntax", file: "ast-field.svg", title: "Syntax conduits", description: "Compiler and AST paths routed through a lancet frame." },
  { id: "lattice", file: "symbol-lattice.svg", title: "Machined tracery", description: "Repeatable gothic structure for sections, covers, and large surfaces." },
  { id: "flow", file: "dataflow-orbit.svg", title: "Instrument aperture", description: "Observable state entering a calibrated inspection assembly." },
  { id: "kernel", file: "kernel-depth.svg", title: "Rack vault", description: "Runtime and stack depth expressed as receding engineered structure." },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara visual language: precision-engineered material, gothic structure, adaptive themes, motifs, and components." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara Visual Language" />
    <meta property="og:description" content="Alien precision grounded in frost, graphite, machined structure, and one functional signal." />
    <meta property="og:url" content={pagesUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2016" />
    <meta property="og:image:alt" content="Hara visual language — precision material and rack geometry" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara Visual Language" />
    <meta name="twitter:description" content="Precision material. Exact behavior." />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Hara visual language — precision material and rack geometry" />
    <link rel="canonical" href={pagesUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara Visual Language</title>
  </head>
  <body>
    <header>
      <a href="./"><HaraMark size={28} /><b>Hara visual language</b></a>
      <nav>
        <a href="#motifs">Motifs</a>
        <a href="#fields">Fields</a>
        <a href="#effects">Effects</a>
        <a href="#tokens">Tokens</a>
        <a href="https://github.com/hara-lang/visual-language">Source</a>
      </nav>
      <ThemeToggle />
    </header>

    <main>
      <Motif kind="rack" class="hero">
        <div class="hero-content">
          <p class="hara-kicker">Material system · Version 1</p>
          <h1>Precision<br />under load.</h1>
          <p>Alien, gothic structure grounded in engineered light and dark materials. One signal. No spectacle.</p>
          <div class="hero-actions">
            <a class="primary-action" href="#motifs">Inspect the system</a>
            <a href={pagesUrl}>Published Pages site ↗</a>
          </div>
        </div>
      </Motif>

      <section id="motifs">
        <p class="hara-kicker">Primary environments</p>
        <h2>Edge. Aperture. Rack.</h2>
        <p class="section-intro">The original three motifs define Hara's material world. Rack is the benchmark hero reference: exact, severe, and built around engineered depth.</p>
        <div class="motif-grid">
          <Motif kind="edge"><div><b>Edge</b><span>Boundary / tolerance / force</span></div></Motif>
          <Motif kind="aperture"><div><b>Aperture</b><span>Inspection / focus / instrument</span></div></Motif>
          <Motif kind="rack"><div><b>Rack</b><span>Structure / depth / runtime</span></div></Motif>
        </div>
      </section>

      <section id="fields">
        <p class="hara-kicker">Maximum-resolution material fields</p>
        <h2>Five engineered<br />environments.</h2>
        <p class="section-intro">Each background is an adaptive `4096 × 2304` SVG built from armour seams, routed conduits, machined tracery, instrument rings, and rack vaults.</p>
        <div class="field-grid">
          {fields.map((field) => (
            <article class="field-card">
              <img src={`${basePath}backgrounds/${field.file}`} alt={`${field.title} Hara vector background`} loading="lazy" />
              <div>
                <p class="hara-kicker">{field.id}</p>
                <h3>{field.title}</h3>
                <p>{field.description}</p>
                <code>4096 × 2304 · adaptive SVG</code>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="effects">
        <p class="hara-kicker">Restrained live effects</p>
        <h2>Instrumentation,<br />not animation.</h2>
        <p class="section-intro">The five fields are available as Astro backdrops. Motion is off by default and, when enabled, is limited to a small calibration scan and stepped indicators.</p>
        <div class="effect-grid">
          {fields.map((field) => (
            <article class="effect-card field-stage">
              <Backdrop effect={field.id} intensity="balanced" motion={false} />
              <div><b>{field.title}</b><code>{`effect="${field.id}"`}</code></div>
            </article>
          ))}
        </div>
      </section>

      <section id="tokens">
        <p class="hara-kicker">Stable interface</p>
        <h2>One signal.<br />Two material worlds.</h2>
        <div class="token-grid">
          <article><i style="background:var(--hara-bg)"></i><b>Ground</b><code>--hara-bg</code></article>
          <article><i style="background:var(--hara-surface-solid)"></i><b>Surface</b><code>--hara-surface-solid</code></article>
          <article><i style="background:var(--hara-metal)"></i><b>Metal</b><code>--hara-metal</code></article>
          <article><i style="background:var(--hara-metal-recess)"></i><b>Recess</b><code>--hara-metal-recess</code></article>
          <article><i style="background:var(--hara-signal)"></i><b>Signal</b><code>--hara-signal</code></article>
          <article><i style="background:var(--hara-text)"></i><b>Text</b><code>--hara-text</code></article>
        </div>
        <pre><code>import Backdrop from "@hara-lang/visual-language/astro/Backdrop.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/effects.css";

&lt;Backdrop effect="kernel" intensity="quiet" /&gt;</code></pre>
      </section>
    </main>

    <footer>
      <span>
        <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/hara-lang/visual-language/blob/main/LICENSE">MIT</a>
      </span>
      <a href={pagesUrl}>hara-lang.github.io/visual-language/</a>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 64px;
    padding: 0 var(--hara-space-page);
    border-bottom: 1px solid var(--hara-line);
    background: color-mix(in srgb, var(--hara-bg) 90%, transparent);
    backdrop-filter: blur(18px) saturate(108%);
  }
  header > a { display: flex; align-items: center; gap: .7rem; width: max-content; text-decoration: none; }
  nav { display: flex; gap: 1.35rem; }
  nav a { color: var(--hara-muted); font-size: .82rem; text-decoration: none; }
  header :global(.hara-theme-toggle) { justify-self: end; }

  .field-stage { position: relative; isolation: isolate; overflow: hidden; }
  .hero {
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: var(--hara-space-page);
    border-bottom: 1px solid var(--hara-line);
  }
  .hero::after { background: linear-gradient(90deg, var(--hara-bg) 0%, color-mix(in srgb, var(--hara-bg) 94%, transparent) 54%, transparent 82%); }
  .hero-content { position: relative; z-index: 1; width: min(var(--hara-content), 100%); margin: auto; }
  .hero h1 { max-width: 900px; margin: .2em 0; font-size: clamp(4rem, 10vw, 8.5rem); line-height: .82; letter-spacing: -.07em; }
  .hero-content > p:not(.hara-kicker) { max-width: 590px; color: var(--hara-muted); font-size: 1.18rem; line-height: 1.6; }
  .hero-actions { display: flex; align-items: center; gap: 1.2rem; margin-top: 2rem; }
  .hero-actions a { color: var(--hara-muted); font-size: .86rem; text-decoration: none; }
  .hero-actions .primary-action {
    padding: .82rem 1.05rem;
    color: white;
    border: 1px solid color-mix(in srgb, var(--hara-signal) 78%, black);
    border-radius: var(--hara-radius-sm);
    background: var(--hara-signal);
    box-shadow: inset 0 1px rgba(255,255,255,.28), 0 10px 24px color-mix(in srgb, var(--hara-signal) 18%, transparent);
  }

  section:not(.hero) { width: min(var(--hara-content), calc(100% - 2 * var(--hara-space-page))); margin: auto; padding: 110px 0; }
  h2 { margin: .25em 0 .45em; font-size: clamp(2.5rem, 6vw, 5rem); line-height: .94; letter-spacing: -.055em; }
  .section-intro { max-width: 760px; margin: 0 0 2.4rem; color: var(--hara-muted); font-size: 1.08rem; line-height: 1.65; }

  .motif-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .motif-grid > :global(.hara-motif) {
    aspect-ratio: 1;
    display: flex;
    align-items: flex-end;
    padding: 1.2rem;
    border: 1px solid var(--hara-line);
    border-radius: var(--hara-radius-md);
  }
  .motif-grid :global(.hara-motif)::after { background: linear-gradient(0deg, var(--hara-bg), transparent 58%); }
  .motif-grid div { position: relative; z-index: 1; display: grid; gap: .3rem; }
  .motif-grid span { color: var(--hara-muted); font: .7rem var(--hara-font-mono); text-transform: uppercase; letter-spacing: .05em; }

  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .field-card { overflow: hidden; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-md); background: var(--hara-surface-solid); box-shadow: var(--hara-shadow); }
  .field-card:first-child { grid-column: 1 / -1; }
  .field-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--hara-void); }
  .field-card > div { padding: 1.25rem; border-top: 1px solid var(--hara-line); }
  .field-card h3 { margin: .15rem 0 .45rem; font-size: 1.4rem; }
  .field-card p:not(.hara-kicker) { min-height: 2.8em; margin: 0 0 1rem; color: var(--hara-muted); line-height: 1.45; }
  .field-card code { color: var(--hara-signal); font-size: .72rem; }

  .effect-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .75rem; }
  .effect-card { min-height: 270px; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-sm); background: var(--hara-bg-clean); }
  .effect-card > div { position: relative; z-index: 1; display: grid; gap: .35rem; align-content: end; height: 100%; padding: 1rem; background: linear-gradient(0deg, var(--hara-bg-clean), transparent 58%); }
  .effect-card code { color: var(--hara-muted); font-size: .68rem; }

  .token-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; overflow: hidden; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-sm); background: var(--hara-line); }
  .token-grid article { display: grid; gap: .5rem; padding: 1rem; background: var(--hara-surface-solid); }
  .token-grid article i { height: 80px; border: 1px solid var(--hara-line); border-radius: 4px; }
  .token-grid article code { color: var(--hara-muted); font-size: .72rem; }
  pre { margin-top: 2rem; padding: 1.4rem; overflow: auto; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-sm); background: var(--hara-surface-solid); line-height: 1.55; }

  footer { display: flex; justify-content: space-between; gap: 1rem; padding: 2rem var(--hara-space-page); border-top: 1px solid var(--hara-line); color: var(--hara-muted); font-size: .82rem; }
  footer a { color: inherit; }

  @media (max-width: 940px) {
    .effect-grid { grid-template-columns: repeat(2, 1fr); }
    .effect-card:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    header { grid-template-columns: 1fr auto; }
    nav { display: none; }
    .hero { min-height: 650px; }
    .hero h1 { font-size: 4rem; }
    .hero-actions { align-items: flex-start; flex-direction: column; }
    .field-grid, .effect-grid, .motif-grid, .token-grid { grid-template-columns: 1fr; }
    .field-card:first-child, .effect-card:last-child { grid-column: auto; }
    footer { flex-direction: column; }
  }
</style>