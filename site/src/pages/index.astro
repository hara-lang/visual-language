---
import ThemeToggle from "../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../src/astro/HaraMark.astro";
import Motif from "../../../src/astro/Motif.astro";
import Backdrop from "../../../src/astro/Backdrop.astro";
import "../../../src/theme.css";
import "../../../src/motifs.css";
import "../../../src/effects.css";
import "../../../src/theme.js";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pagesUrl = "https://hara-lang.github.io/visual-language/";
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site).toString();
const fields = [
  { id: "evaluation", file: "evaluation-field.svg", title: "Evaluation field", description: "State, signal, and execution paths for heroes and launches." },
  { id: "syntax", file: "ast-field.svg", title: "Syntax tree", description: "AST, compiler, and macroexpansion structure." },
  { id: "lattice", file: "symbol-lattice.svg", title: "Symbol lattice", description: "A quiet repeatable texture for sections, covers, and posters." },
  { id: "flow", file: "dataflow-orbit.svg", title: "Dataflow orbit", description: "Observable state, agents, events, and orchestration." },
  { id: "kernel", file: "kernel-depth.svg", title: "Kernel depth", description: "Runtime, VM, WASM, and execution-stack material." },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara visual language: precision materials, maximum-resolution fields, effects, themes, motifs, and components." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara Visual Language" />
    <meta property="og:description" content="Precision materials, maximum-resolution imagery, and live effects for every Hara surface." />
    <meta property="og:url" content={pagesUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2016" />
    <meta property="og:image:alt" content="Hara visual language — inspectable computation in graphite and cyan-to-violet glass" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara Visual Language" />
    <meta name="twitter:description" content="Precision materials. Calm agency." />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Hara visual language — inspectable computation in graphite and cyan-to-violet glass" />
    <link rel="canonical" href={pagesUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara Visual Language</title>
  </head>
  <body>
    <header>
      <a href="./"><HaraMark size={28} /><b>Hara visual language</b></a>
      <nav>
        <a href="#fields">Fields</a>
        <a href="#effects">Effects</a>
        <a href="#motifs">Motifs</a>
        <a href="#tokens">Tokens</a>
        <a href="https://github.com/hara-lang/visual-language">Source</a>
      </nav>
      <ThemeToggle />
    </header>

    <main>
      <section class="hero field-stage">
        <Backdrop effect="evaluation" intensity="balanced" />
        <div class="hero-content">
          <p class="hara-kicker">Visual system · Version 1</p>
          <h1>Inspectable<br />computation.</h1>
          <p>Precision materials, maximum-resolution imagery, and live effects for every Hara surface.</p>
          <div class="hero-actions">
            <a class="primary-action" href="#fields">Explore fields</a>
            <a href={pagesUrl}>Published Pages site ↗</a>
          </div>
        </div>
      </section>

      <section id="fields">
        <p class="hara-kicker">Maximum-resolution imagery</p>
        <h2>Five fields.<br />One computational language.</h2>
        <p class="section-intro">Each background is an adaptive `4096 × 2304` SVG. The sources are vector, so 4K is a working canvas rather than a hard resolution ceiling.</p>
        <div class="field-grid">
          {fields.map((field) => (
            <article class="field-card">
              <img src={`${basePath}backgrounds/${field.file}`} alt={`${field.title} Hara vector background`} loading="lazy" />
              <div>
                <p class="hara-kicker">{field.id}</p>
                <h3>{field.title}</h3>
                <p>{field.description}</p>
                <code>4096 × 2304 · adaptive SVG</code>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="effects">
        <p class="hara-kicker">Live field effects</p>
        <h2>Structure that can move.</h2>
        <p class="section-intro">The same five ideas are available as CSS-first Astro backdrops with quiet, balanced, and dense intensity controls.</p>
        <div class="effect-grid">
          {fields.map((field) => (
            <article class="effect-card field-stage">
              <Backdrop effect={field.id} intensity="balanced" motion={false} />
              <div><b>{field.title}</b><code>{`effect="${field.id}"`}</code></div>
            </article>
          ))}
        </div>
      </section>

      <section id="motifs">
        <p class="hara-kicker">Matched environments</p>
        <h2>Three motifs.<br />Two material worlds.</h2>
        <div class="motif-grid">
          <Motif kind="edge"><b>Edge</b></Motif>
          <Motif kind="aperture"><b>Aperture</b></Motif>
          <Motif kind="rack"><b>Rack</b></Motif>
        </div>
      </section>

      <section id="tokens">
        <p class="hara-kicker">Stable interface</p>
        <h2>Quiet color.<br />Exact behavior.</h2>
        <div class="token-grid">
          <article><i style="background:var(--hara-bg)"></i><b>Background</b><code>--hara-bg</code></article>
          <article><i style="background:var(--hara-surface-solid)"></i><b>Surface</b><code>--hara-surface-solid</code></article>
          <article><i style="background:var(--hara-spectrum-cyan)"></i><b>Live state</b><code>--hara-spectrum-cyan</code></article>
          <article><i style="background:var(--hara-spectrum-blue)"></i><b>Evaluation</b><code>--hara-spectrum-blue</code></article>
          <article><i style="background:var(--hara-spectrum-violet)"></i><b>Emergence</b><code>--hara-spectrum-violet</code></article>
          <article><i style="background:var(--hara-text)"></i><b>Text</b><code>--hara-text</code></article>
        </div>
        <pre><code>import Backdrop from "@hara-lang/visual-language/astro/Backdrop.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/effects.css";

&lt;Backdrop effect="syntax" intensity="quiet" /&gt;</code></pre>
      </section>
    </main>

    <footer>
      <span>MIT licensed · Built for hara-lang.org</span>
      <a href={pagesUrl}>hara-lang.github.io/visual-language/</a>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 64px;
    padding: 0 var(--hara-space-page);
    border-bottom: 1px solid var(--hara-line);
    background: color-mix(in srgb, var(--hara-bg) 84%, transparent);
    backdrop-filter: blur(18px) saturate(120%);
  }
  header > a { display: flex; align-items: center; gap: .7rem; width: max-content; text-decoration: none; }
  nav { display: flex; gap: 1.35rem; }
  nav a { color: var(--hara-muted); font-size: .82rem; text-decoration: none; }
  header :global(.hara-theme-toggle) { justify-self: end; }

  .field-stage { position: relative; isolation: isolate; overflow: hidden; }
  .hero { min-height: 720px; display: flex; align-items: center; padding: var(--hara-space-page); border-bottom: 1px solid var(--hara-line); }
  .hero-content { position: relative; z-index: 1; width: min(var(--hara-content), 100%); margin: auto; }
  .hero h1 { margin: .2em 0; font-size: clamp(4rem, 10vw, 8.5rem); line-height: .82; letter-spacing: -.07em; }
  .hero-content > p:not(.hara-kicker) { max-width: 620px; color: var(--hara-muted); font-size: 1.2rem; line-height: 1.6; }
  .hero-actions { display: flex; align-items: center; gap: 1.2rem; margin-top: 2rem; }
  .hero-actions a { color: var(--hara-muted); font-size: .88rem; text-decoration: none; }
  .hero-actions .primary-action { padding: .85rem 1.15rem; color: white; border-radius: 999px; background: var(--hara-spectrum); box-shadow: 0 12px 32px color-mix(in srgb, var(--hara-spectrum-blue) 24%, transparent); }

  section:not(.hero) { width: min(var(--hara-content), calc(100% - 2 * var(--hara-space-page))); margin: auto; padding: 110px 0; }
  h2 { margin: .25em 0 .45em; font-size: clamp(2.5rem, 6vw, 5rem); line-height: .94; letter-spacing: -.055em; }
  .section-intro { max-width: 720px; margin: 0 0 2.4rem; color: var(--hara-muted); font-size: 1.08rem; line-height: 1.65; }

  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; }
  .field-card { overflow: hidden; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-lg); background: var(--hara-surface-solid); box-shadow: var(--hara-shadow); }
  .field-card:first-child { grid-column: 1 / -1; }
  .field-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--hara-void); }
  .field-card > div { padding: 1.3rem; }
  .field-card h3 { margin: .15rem 0 .45rem; font-size: 1.45rem; }
  .field-card p:not(.hara-kicker) { min-height: 2.8em; margin: 0 0 1rem; color: var(--hara-muted); line-height: 1.45; }
  .field-card code { color: var(--hara-spectrum-blue); font-size: .72rem; }

  .effect-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .8rem; }
  .effect-card { min-height: 270px; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-md); background: var(--hara-bg-clean); }
  .effect-card > div { position: relative; z-index: 1; display: grid; gap: .35rem; align-content: end; height: 100%; padding: 1rem; background: linear-gradient(0deg, var(--hara-bg-clean), transparent 58%); }
  .effect-card code { color: var(--hara-muted); font-size: .68rem; }

  .motif-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .motif-grid > :global(.hara-motif) { aspect-ratio: 1; display: flex; align-items: flex-end; padding: 1.2rem; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-lg); }
  .motif-grid :global(.hara-motif)::after { background: linear-gradient(0deg, var(--hara-bg), transparent 55%); }

  .token-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; overflow: hidden; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-md); background: var(--hara-line); }
  .token-grid article { display: grid; gap: .5rem; padding: 1rem; background: var(--hara-surface-solid); }
  .token-grid article i { height: 80px; border: 1px solid var(--hara-line); border-radius: 8px; }
  .token-grid article code { color: var(--hara-muted); font-size: .72rem; }
  pre { margin-top: 2rem; padding: 1.4rem; overflow: auto; border: 1px solid var(--hara-line); border-radius: var(--hara-radius-md); background: var(--hara-surface-solid); line-height: 1.55; }

  footer { display: flex; justify-content: space-between; gap: 1rem; padding: 2rem var(--hara-space-page); border-top: 1px solid var(--hara-line); color: var(--hara-muted); font-size: .82rem; }
  footer a { color: inherit; }

  @media (max-width: 940px) {
    .effect-grid { grid-template-columns: repeat(2, 1fr); }
    .effect-card:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    header { grid-template-columns: 1fr auto; }
    nav { display: none; }
    .hero { min-height: 650px; }
    .hero h1 { font-size: 4rem; }
    .hero-actions { align-items: flex-start; flex-direction: column; }
    .field-grid, .effect-grid, .motif-grid, .token-grid { grid-template-columns: 1fr; }
    .field-card:first-child, .effect-card:last-child { grid-column: auto; }
    footer { flex-direction: column; }
  }
</style>
