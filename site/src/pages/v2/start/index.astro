---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import StartHero from "../../../components/v2-start/StartHero.astro";
import StartDiscover from "../../../components/v2-start/StartDiscover.astro";
import StartChoose from "../../../components/v2-start/StartChoose.astro";
import StartHabitat from "../../../components/v2-start/StartHabitat.astro";
import StartMutate from "../../../components/v2-start/StartMutate.astro";
import StartGraduate from "../../../components/v2-start/StartGraduate.astro";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-lab.css";
import "../../../styles/v2-calm-lab.css";
import "../../../styles/v2-start.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/start/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const v2Lab = `${basePath}v2/`;
const toolLab = `${basePath}v2/tool/`;
const sourceRepo = "https://github.com/hara-lang/hara";

const journey = [
  { href: "#brief", label: "Brief" },
  { href: "#discover", label: "Inspect" },
  { href: "#choose", label: "Select" },
  { href: "#habitat", label: "Run" },
  { href: "#mutate", label: "Edit" },
  { href: "#graduate", label: "Next" }
];

const intents = [
  { id: "move", label: "Move", prompt: "find an existing example that makes something move" },
  { id: "automate", label: "Automate", prompt: "find an existing example that automates a repeated job" },
  { id: "inspect", label: "Inspect", prompt: "find an existing example that inspects a running program" },
  { id: "transform", label: "Transform", prompt: "find an existing example that transforms data or code" },
  { id: "coordinate", label: "Coordinate", prompt: "find an existing example that coordinates several pieces of work" },
  { id: "publish", label: "Publish", prompt: "find an existing example that publishes a small reusable package" }
];

const recipes = [
  {
    id: "habitat",
    label: "Selected example",
    status: "Browser prototype",
    title: "Hara Habitat",
    promise: "Run a small state map, observe its rendered scene, and change one numeric rule while the session remains identifiable.",
    why: "The example makes source, state, runtime session, capabilities, and one edit visible in a compact program.",
    time: "Local browser simulation",
    capabilities: ["session", "canvas", "clock"],
    edit: ":fear-radius 42 → 70"
  },
  {
    id: "receipts",
    label: "Work example",
    status: "Recipe candidate",
    title: "Work receipts",
    promise: "Represent a multi-step task as replayable work and checkpointed steps, then inspect its result records.",
    why: "This introduces the work algebra, store, executor, retries, and receipts without hiding effect boundaries.",
    time: "Requires a local runtime",
    capabilities: ["work", "store", "executor"],
    edit: ":retry-limit 2 → 4"
  },
  {
    id: "inspector",
    label: "Runtime example",
    status: "Recipe candidate",
    title: "Session inspector",
    promise: "Open a session, inspect state and events, make a source revision, and read the resulting receipt.",
    why: "This connects language forms to session identity, filesystem attachment, event sequence, and source revision.",
    time: "Repository-guided local build",
    capabilities: ["session", "events", "files"],
    edit: ":observation :summary → :trace"
  }
];

const agentBrief = `Open https://github.com/hara-lang/hara.

Read README.md, GETTING_STARTED.md, AGENTS.md, and inspect core/lib/examples plus the browser Studio capability surfaces. If BUILD_WITH_HARA.md or examples/catalog.edn exists, use it as the current example catalogue.

First summarise, in plain language, what a Hara form, runtime, session, namespace, package, and capability are according to the repository. Name the files used for each definition.

Ask me one question:
“Which kind of example would you like to inspect: move, automate, inspect, transform, coordinate, or publish?”

My initial interest: find an existing example that makes something move.

Return three examples grounded in files and capabilities that exist at the selected revision. For each option include:
- the exact files and revision;
- whether it is implemented, a prototype, experimental, or planned;
- the required runtime and capabilities;
- the command that verifies or runs it.

After comparing them, recommend one and explain the technical reason for the selection. Then provide the smallest runnable version, execute its verification command where the available tools permit it, and identify one value that can be changed while preserving the session and source boundaries. Do not invent an API or claim an unverified capability.`;

const initialSource = `(def world
  {:light     {:position [0.72 0.28]
               :strength 0.84}

   :rules     {:attraction   0.16
               :separation   18
               :fear-radius  42
               :night-speed  1.20}

   :creatures [{:id :moth-1 :kind :moth}
               {:id :moth-2 :kind :moth}
               {:id :bat-1  :kind :bat}]})`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="An optional repository-guided path for learning Hara: inspect exact source, choose a verified example, identify its runtime and capabilities, run it, and make one bounded edit." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Repository-guided start for Hara" />
    <meta property="og:description" content="Use an agent or read the repository directly to find a verified Hara example, run its documented command, and inspect one source change." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Repository-guided start for Hara" />
    <meta name="twitter:description" content="A source- and revision-aware path through one Hara example." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Repository-guided start for Hara</title>
  </head>
  <body class="hara-v2 hara-v2-start">
    <CatalogueHeader basePath={basePath} activePath="/v2/start/" label="Repository-guided start" />
    <nav class="start-journey" aria-label="Repository-guided example sequence">
      <span>Repository guide</span>
      <div>{journey.map((item) => <a href={item.href}>{item.label}</a>)}</div>
    </nav>

    <main class="start-main">
      <StartHero intents={intents} agentBrief={agentBrief} sourceRepo={sourceRepo} />
      <StartDiscover />
      <StartChoose recipes={recipes} />
      <StartHabitat initialSource={initialSource} />
      <StartMutate />
      <StartGraduate sourceRepo={sourceRepo} toolLab={toolLab} />

      <footer class="v2-lab-footer start-footer">
        <span>Repository-guided Hara example · Visual language v2 reference</span>
        <span><a href={v2Lab}>V2 reference</a> · <a href={toolLab}>Tool reference</a> · <a href="https://github.com/hara-lang/visual-language">Visual Language source</a> · <a href={sourceRepo}>Hara source</a></span>
      </footer>
    </main>

    <script>
      import { initialiseStart } from "../../../scripts/v2-start-ui.js";
      initialiseStart();
    </script>
  </body>
</html>
