---
import ThemeToggle from "../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../src/astro/HaraMark.astro";
import FleetField from "../../../../src/astro/v2/FleetField.astro";
import WwwSpecimen from "../../components/v2/WwwSpecimen.astro";
import DocsSpecimen from "../../components/v2/DocsSpecimen.astro";
import SpecsSpecimen from "../../components/v2/SpecsSpecimen.astro";
import BenchmarksSpecimen from "../../components/v2/BenchmarksSpecimen.astro";
import WorldSpecimen from "../../components/v2/WorldSpecimen.astro";
import "../../../../src/v2.css";
import "../../../../src/theme.js";
import "../../styles/v2-lab.css";
import "../../styles/v2-command-retune.css";
import "../../styles/v2-calm-lab.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const toolLab = `${basePath}v2/tool/`;
const worldLab = `${basePath}v2/world/`;
const ecosystem = [
  { href: "#www", label: "WWW" },
  { href: "#docs", label: "Docs" },
  { href: "#specs", label: "Specs" },
  { href: "#benchmarks", label: "Benchmarks" },
  { href: "#world", label: "World" },
  { href: toolLab, label: "Tools" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara interface language v2: calm, continuous command surfaces for WWW, Docs, Specs, Benchmarks, and World." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara interface language v2" />
    <meta property="og:description" content="Five interface families shaped by continuous surfaces, quiet hierarchy, and the existing Hara identity." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara interface language v2" />
    <meta name="twitter:description" content="Calm command surfaces for the Hara ecosystem." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara interface language v2</title>
  </head>
  <body class="hara-v2">
    <header class="v2-lab-header">
      <a class="v2-lab-brand" href={basePath}>
        <HaraMark size={28} />
        <b>Hara visual language</b>
        <small>V2 field test</small>
      </a>
      <nav aria-label="Layout families">
        {ecosystem.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main">
      <section class="v2-lab-hero">
        <div>
          <p class="hara-v2-kicker">Refined interface layer · Version 2</p>
          <h1>Precision, with room to breathe.</h1>
          <p>Hara's mark and type remain fixed. Around them, the interface now uses continuous steel and paper surfaces, quieter seams, comfortable controls, and one functional signal. Structure stays exact without making every edge compete for attention.</p>
          <div class="v2-lab-principles">
            <div><b>Continuous surfaces</b><span>Related regions flow together instead of becoming a stack of framed boxes.</span></div>
            <div><b>Quiet hierarchy</b><span>State is clear through tone, spacing, and one signal rather than heavy chrome.</span></div>
            <div><b>Gentle rhythm</b><span>Roomier controls, restrained rounding, and smoother transitions support long sessions.</span></div>
            <div><b>Same identity</b><span>The block H, signal dot, heading family, and light/dark contract do not move.</span></div>
          </div>
          <p><a href={worldLab}>Open the World community laboratory →</a> · <a href={toolLab}>Open the tool workbench laboratory →</a></p>
        </div>
        <div class="v2-lab-hero-art"><FleetField title="Hara calm command visual field" /></div>
      </section>

      <nav class="v2-lab-index" aria-label="V2 layout catalogue">
        <a href="#www"><strong>WWW</strong><span>Public narrative, proof bands, capability decks, and executable demos.</span><code>single-column / illustrated</code></a>
        <a href="#docs"><strong>Docs</strong><span>Persistent rail, prose column, outline, search, and live code surfaces.</span><code>rail / prose / inspector</code></a>
        <a href="#specs"><strong>Specs</strong><span>Registry, checker, publishing workflow, status, and digest inspection.</span><code>workflow / table / inspector</code></a>
        <a href="#benchmarks"><strong>Benchmarks</strong><span>Evidence tabs, metric strips, dense matrices, and selected-result detail.</span><code>data board / compact</code></a>
        <a href={worldLab}><strong>World</strong><span>Feed, Play, people, agents, projects, lessons, and lightweight community loops.</span><code>community / games / discovery</code></a>
      </nav>

      <WwwSpecimen />
      <DocsSpecimen />
      <SpecsSpecimen />
      <BenchmarksSpecimen />
      <WorldSpecimen />
      <footer class="v2-lab-footer">
        <span>Experimental v2 interface contract · Hara visual language</span>
        <span><a href={worldLab}>World community laboratory</a> · <a href={toolLab}>Tool workbench laboratory</a> · <a href="https://github.com/hara-lang/visual-language/blob/main/V2-THEME.md">Theme contract</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>
  </body>
</html>
