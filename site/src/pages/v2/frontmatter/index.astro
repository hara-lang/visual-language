---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import FleetField from "../../../../../src/astro/v2/FleetField.astro";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-frontmatter.css";
import {
  applicationContractMap,
  browserEditableFields,
  contentContracts,
  controlledFields,
  controlLabels,
  derivedFields,
  fieldInventoryForContract,
  frontmatterRepresentations,
  lifecycleStates,
  previewFromSpecimen,
  registryStats,
  relationships,
  specimenValidation,
  specimens
} from "../../../lib/v2-frontmatter.mjs";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/frontmatter/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);

const sectionLinks = [
  ["schema-registry", "Registry"],
  ["relationships", "Relationships"],
  ["authoring", "Authoring"],
  ["representations", "Representations"],
  ["preview", "Preview"],
  ["lifecycle", "Lifecycle"],
  ["provenance", "Provenance"],
  ["adoption", "Adoption"]
];

const authoringSpecimen = specimens.find(({ id }) => id === "valid-docs-guide");
const invalidSpecimen = specimens.find(({ id }) => id === "invalid-spec-proposal");
const importedSpecimen = specimens.find(({ id }) => id === "imported-world-clipping");
const migratedSpecimen = specimens.find(({ id }) => id === "migrated-package-release");

if (!authoringSpecimen || !invalidSpecimen || !importedSpecimen || !migratedSpecimen) {
  throw new Error("Front matter reference specimens are incomplete.");
}

const editable = browserEditableFields(authoringSpecimen.contentType);
const controlled = controlledFields(authoringSpecimen.contentType);
const derived = derivedFields(authoringSpecimen.contentType);
const authoringValues = { ...authoringSpecimen.author, ...authoringSpecimen.controlled, ...authoringSpecimen.derived };
const representations = frontmatterRepresentations(authoringSpecimen);
const preview = previewFromSpecimen(authoringSpecimen);
const importedPreview = previewFromSpecimen(importedSpecimen);
const invalidMessages = specimenValidation[invalidSpecimen.id];
const migratedMessages = specimenValidation[migratedSpecimen.id];
const valueText = (value) => Array.isArray(value) ? value.join(", ") : String(value ?? "");
const issueHref = (issue) => `https://github.com/hara-lang/visual-language/issues/${issue}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara v2 front matter and content contracts: schemas, controlled fields, authoring, previews, lifecycle, migration, and provenance." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 front matter reference" />
    <meta property="og:description" content="Inspectable content contracts for WWW, Docs, Benchmarks, Specs, Packages, World, and Learn." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 front matter reference" />
    <meta name="twitter:description" content="Content metadata becomes visible interface and durable publication evidence." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 front matter and content contracts</title>
  </head>
  <body class="hara-v2 frontmatter-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/frontmatter/" />

    <main class="frontmatter-main">
      <section class="frontmatter-hero" aria-labelledby="frontmatter-title">
        <div class="frontmatter-hero-copy">
          <p class="hara-v2-kicker">Shared foundation · Content contract</p>
          <h1 id="frontmatter-title">Front matter is typed content metadata.</h1>
          <p>
            One typed registry records author-editable, controlled, and derived fields for route identity, cards, feeds, search, social metadata, machine endpoints, migrations, and publication receipts.
          </p>
          <div class="frontmatter-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#schema-registry">Inspect schemas</a>
            <a class="hara-v2-button" href="#authoring">Open authoring contract</a>
            <a class="hara-v2-button" data-variant="ghost" href="#adoption">Application map</a>
          </div>
          <dl class="frontmatter-hero-ledger" aria-label="Front matter registry inventory">
            <div><dt>{registryStats.families}</dt><dd>route families</dd></div>
            <div><dt>{registryStats.types}</dt><dd>content types</dd></div>
            <div><dt>{registryStats.sharedFields}</dt><dd>shared fields</dd></div>
            <div><dt>{registryStats.lifecycleStates}</dt><dd>lifecycle states</dd></div>
          </dl>
        </div>
        <div class="frontmatter-hero-field" aria-label="Content contract relationship field">
          <FleetField title="Content contract field" />
          <div class="frontmatter-orbit frontmatter-orbit--identity">
            <HaraMark size={26} />
            <span>identity</span>
            <small>registry fact</small>
          </div>
          <div class="frontmatter-orbit frontmatter-orbit--author">
            <b>author</b>
            <small>editable intent</small>
          </div>
          <div class="frontmatter-orbit frontmatter-orbit--derived">
            <b>derived</b>
            <small>named source</small>
          </div>
          <div class="frontmatter-orbit frontmatter-orbit--receipt">
            <b>receipt</b>
            <small>exact revision</small>
          </div>
        </div>
      </section>

      <nav class="frontmatter-section-nav" aria-label="Front matter reference sections">
        {sectionLinks.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>

      <section class="frontmatter-section" id="schema-registry">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">01 · Schema registry</p>
            <h2>Shared metadata stays common while each route keeps its own semantics.</h2>
          </div>
          <p>
            Every type has an exact version, required and optional fields, a publication path, and a named registry owner.
            Deprecated fields remain visible so migration failures cannot disappear behind a successful render.
          </p>
        </header>

        <div class="frontmatter-registry-index" aria-label="Content contract families">
          {contentContracts.map((contract, index) => (
            <a href={`#schema-${contract.id}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <b>{contract.label}</b>
              <small>{contract.types.length} types · {contract.schemaVersion}</small>
            </a>
          ))}
        </div>

        <div class="frontmatter-contract-stack">
          {contentContracts.map((contract, index) => {
            const inventory = fieldInventoryForContract(contract.id);
            return (
              <article class="frontmatter-contract" id={`schema-${contract.id}`} data-family={contract.id}>
                <header>
                  <div>
                    <p class="hara-v2-kicker">{String(index + 1).padStart(2, "0")} · {contract.schemaNamespace}</p>
                    <h3>{contract.label}</h3>
                    <p>{contract.summary}</p>
                  </div>
                  <dl>
                    <div><dt>Schema</dt><dd><code>{contract.schemaVersion}</code></dd></div>
                    <div><dt>Owner</dt><dd>{contract.registryOwner}</dd></div>
                    <div><dt>Publication</dt><dd>{contract.publicationPaths.join(" · ")}</dd></div>
                  </dl>
                </header>

                <div class="frontmatter-type-grid">
                  {contract.types.map((entry) => (
                    <article data-content-type={entry.id}>
                      <header>
                        <span>{entry.label}</span>
                        <code>{entry.version}</code>
                      </header>
                      <p>{entry.summary}</p>
                      <dl>
                        <div><dt>Required</dt><dd>{entry.required.join(" · ")}</dd></div>
                        <div><dt>Optional</dt><dd>{entry.optional.join(" · ")}</dd></div>
                      </dl>
                    </article>
                  ))}
                </div>

                <details class="frontmatter-field-disclosure">
                  <summary>Inspect {inventory.length} shared + product fields</summary>
                  <div class="frontmatter-field-table" role="table" aria-label={`${contract.label} field inventory`}>
                    <div class="frontmatter-field-row frontmatter-field-row--head" role="row">
                      <span role="columnheader">Field</span>
                      <span role="columnheader">Requirement</span>
                      <span role="columnheader">Control</span>
                      <span role="columnheader">Source</span>
                    </div>
                    {inventory.map((field) => (
                      <div class="frontmatter-field-row" role="row" data-requirement={field.requirement} data-control={field.control}>
                        <span role="cell"><b>{field.label}</b><code>{field.id}</code></span>
                        <span role="cell">{field.requirement}</span>
                        <span role="cell">{controlLabels[field.control]}</span>
                        <span role="cell">{field.source}</span>
                      </div>
                    ))}
                  </div>
                </details>
              </article>
            );
          })}
        </div>

        <aside class="frontmatter-deprecation-note" aria-label="Deprecated field example">
          <div><span aria-hidden="true">!</span></div>
          <div>
            <p class="hara-v2-kicker">Deprecated field remains inspectable</p>
            <h3><code>legacyPermalink</code> → <code>canonicalUrl</code></h3>
            <p>The legacy field may be read by a migration, but new authoring cannot publish it. The replacement is derived from registered identity, route policy, and slug.</p>
          </div>
        </aside>
      </section>

      <section class="frontmatter-section" id="relationships">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">02 · Relationship boundaries</p>
            <h2>Reference the owner of truth. Do not copy its record.</h2>
          </div>
          <p>
            Authors, packages, namespaces, sources, evidence, specifications, and runtimes remain independent registries.
            Front matter owns relationships and presentation intent—not duplicated authority.
          </p>
        </header>

        <div class="frontmatter-relationship-grid">
          {relationships.map((relationship) => (
            <article data-relationship={relationship.id}>
              <header><b>{relationship.label}</b><code>{relationship.cardinality}</code></header>
              <p>{relationship.rule}</p>
              <footer><span>Truth owner</span><strong>{relationship.owner}</strong></footer>
            </article>
          ))}
        </div>
      </section>

      <section class="frontmatter-section" id="authoring">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">03 · Authoring form</p>
            <h2>Editable intent is visibly separated from controlled fact.</h2>
          </div>
          <p>
            Read-only facts stay selectable and inspectable. They are not disabled inputs. Derived fields name every input,
            and defaults explain whether they are provisional or durable.
          </p>
        </header>

        <div class="frontmatter-authoring-shell">
          <form class="frontmatter-editor" aria-labelledby="authoring-editor-title">
            <header>
              <div>
                <p class="hara-v2-kicker">Browser editable</p>
                <h3 id="authoring-editor-title">{authoringSpecimen.label}</h3>
              </div>
              <span class="hara-v2-badge" data-tone="signal">Draft editing surface</span>
            </header>

            <div class="frontmatter-form-grid">
              {editable.map((field) => (
                <label data-field={field.id} data-requirement={field.requirement}>
                  <span>{field.label}{field.requirement === "required" && <b aria-label="required"> *</b>}</span>
                  {field.id === "summary" ? (
                    <textarea class="hara-v2-field" rows="4" aria-describedby={`help-${field.id}`}>{valueText(authoringValues[field.id])}</textarea>
                  ) : field.id === "contentType" ? (
                    <select class="hara-v2-select" aria-describedby={`help-${field.id}`}>
                      <option>{valueText(authoringValues[field.id])}</option>
                    </select>
                  ) : (
                    <input class="hara-v2-field" value={valueText(authoringValues[field.id])} aria-describedby={`help-${field.id}`} />
                  )}
                  <small id={`help-${field.id}`}>{field.description}{field.defaultValue ? ` Default: ${field.defaultValue}.` : ""}</small>
                </label>
              ))}
            </div>

            <footer>
              <span>Local draft · not yet a durable revision</span>
              <div>
                <button class="hara-v2-button" type="button">Validate draft</button>
                <button class="hara-v2-button" data-variant="primary" type="button">Preview submission</button>
              </div>
            </footer>
          </form>

          <aside class="frontmatter-fact-stack" aria-label="Controlled and derived content facts">
            <section class="frontmatter-facts" data-fact-kind="controlled">
              <header>
                <div><p class="hara-v2-kicker">Server / reviewer controlled</p><h3>Durable facts</h3></div>
                <span>{controlled.length}</span>
              </header>
              {controlled.map((field) => (
                <label data-control={field.control}>
                  <span>{field.label}<small>{controlLabels[field.control]}</small></span>
                  <input class="hara-v2-field" readonly value={valueText(authoringValues[field.id]) || `Resolved by ${field.source}`} />
                  <small>{field.description}</small>
                </label>
              ))}
            </section>

            <section class="frontmatter-facts" data-fact-kind="derived">
              <header>
                <div><p class="hara-v2-kicker">Generated with provenance</p><h3>Derived fields</h3></div>
                <span>{derived.length}</span>
              </header>
              {derived.map((field) => (
                <div class="frontmatter-derived-row" data-control="derived">
                  <span><b>{field.label}</b><code>{field.id}</code></span>
                  <strong>{valueText(authoringValues[field.id])}</strong>
                  <small>Source: {field.source} · Inputs: {field.derivedFrom?.join(" + ")}</small>
                </div>
              ))}
            </section>
          </aside>
        </div>

        <div class="frontmatter-validation-grid">
          <article class="frontmatter-validation" data-validation-state="valid">
            <header><span aria-hidden="true">✓</span><div><p>Valid specimen</p><b>{authoringSpecimen.contentType}@{authoringSpecimen.schemaVersion}</b></div></header>
            <p>Required fields resolve, browser editing stays within author-owned fields, and every durable fact has a named authority.</p>
          </article>
          <article class="frontmatter-validation" data-validation-state="invalid" role="alert">
            <header><span aria-hidden="true">!</span><div><p>Invalid + deprecated specimen</p><b>{invalidSpecimen.contentType}@{invalidSpecimen.schemaVersion}</b></div></header>
            <ul>
              {invalidMessages.slice(0, 8).map((message) => <li data-level={message.level}><code>{message.field}</code> {message.message}</li>)}
            </ul>
          </article>
          <article class="frontmatter-validation" data-validation-state="migrated">
            <header><span aria-hidden="true">↗</span><div><p>Migrated specimen</p><b>{migratedSpecimen.contentType}@{migratedSpecimen.schemaVersion}</b></div></header>
            <p>{migratedMessages[0]?.message}</p>
            <dl>
              <div><dt>Input</dt><dd><code>{migratedSpecimen.migration?.inputRevision}</code></dd></div>
              <div><dt>Output</dt><dd><code>{migratedSpecimen.migration?.outputRevision}</code></dd></div>
            </dl>
          </article>
        </div>
      </section>

      <section class="frontmatter-section" id="representations">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">04 · Representations</p>
            <h2>One canonical object. Multiple inspectable authoring paths.</h2>
          </div>
          <p>
            YAML, JSON, and Hara forms are representations of the same resolved contract. Markdown and Hara publication
            paths differ in authoring syntax, not content identity, validation, or receipts.
          </p>
        </header>

        <div class="frontmatter-representation-grid">
          <details open>
            <summary><span>YAML front matter</span><code>text/yaml</code></summary>
            <pre><code>{representations.yaml}</code></pre>
          </details>
          <details>
            <summary><span>Canonical JSON</span><code>application/json</code></summary>
            <pre><code>{representations.json}</code></pre>
          </details>
          <details>
            <summary><span>Hara form</span><code>application/hara</code></summary>
            <pre><code>{representations.hara}</code></pre>
          </details>
        </div>

        <div class="frontmatter-publication-paths">
          <article>
            <header><span>Markdown publication path</span><code>.md</code></header>
            <pre><code>{representations.markdown.split("\n").slice(0, 12).join("\n")}\n…</code></pre>
          </article>
          <article>
            <header><span>Hara publication path</span><code>.hal</code></header>
            <pre><code>{representations.haraPublication}</code></pre>
          </article>
        </div>
      </section>

      <section class="frontmatter-section" id="preview">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">05 · Metadata-driven preview</p>
            <h2>The same facts must visibly drive every surface.</h2>
          </div>
          <p>
            Route, card, feed, search, social, and machine previews expose their input facts. Light, dark, and narrow frames
            demonstrate presentation parity without changing the canonical object.
          </p>
        </header>

        <div class="frontmatter-route-preview">
          <span>Canonical route</span>
          <code>{preview.route.path}</code>
          <small>{preview.route.contentId}</small>
        </div>

        <div class="frontmatter-preview-stage">
          <article class="frontmatter-device" data-preview-theme="light" data-preview-width="wide">
            <header><span>Card · light</span><code>1280</code></header>
            <div class="frontmatter-preview-card">
              <p class="hara-v2-kicker">{preview.card.eyebrow}</p>
              <h3>{preview.card.title}</h3>
              <p>{preview.card.summary}</p>
              <footer>{preview.card.meta}</footer>
            </div>
          </article>

          <article class="frontmatter-device" data-preview-theme="dark" data-preview-width="wide">
            <header><span>Feed · dark</span><code>1280</code></header>
            <div class="frontmatter-feed-card">
              <span class="frontmatter-source-mark">W</span>
              <div><b>{importedPreview.feed.title}</b><p>{importedPreview.feed.summary}</p><small>{importedPreview.feed.source}</small></div>
              <code>{importedPreview.feed.status}</code>
            </div>
          </article>

          <article class="frontmatter-device" data-preview-theme="light" data-preview-width="narrow">
            <header><span>Search · narrow</span><code>320</code></header>
            <div class="frontmatter-search-result">
              <span>{preview.search.type}</span>
              <h3>{preview.search.title}</h3>
              <p>{preview.search.description}</p>
              <small>{preview.search.revision}</small>
            </div>
          </article>
        </div>

        <div class="frontmatter-endpoint-grid">
          <article class="frontmatter-social-preview">
            <header><span>Social metadata</span><code>summary_large_image</code></header>
            <div class="frontmatter-social-field"><HaraMark size={34} /><span>HARA · CONTENT CONTRACT</span></div>
            <div><b>{preview.social.title}</b><p>{preview.social.description}</p><small>{preview.social.url}</small></div>
          </article>
          <article class="frontmatter-machine-preview">
            <header><span>Machine endpoint</span><code>application/ld+json</code></header>
            <pre><code>{JSON.stringify(preview.machine, null, 2)}</code></pre>
          </article>
        </div>
      </section>

      <section class="frontmatter-section" id="lifecycle">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">06 · Lifecycle and receipts</p>
            <h2>Status changes are durable relations, not coloured labels.</h2>
          </div>
          <p>
            Each transition names the actor and evidence boundary. Superseded and withdrawn content keeps history,
            while exact revisions and deterministic regeneration receipts make every published surface reproducible.
          </p>
        </header>

        <ol class="frontmatter-lifecycle" aria-label="Content lifecycle">
          {lifecycleStates.map((state, index) => (
            <li data-lifecycle-state={state.id}>
              <div class="frontmatter-lifecycle-index"><span>{String(index + 1).padStart(2, "0")}</span><i aria-hidden="true"></i></div>
              <div><b>{state.label}</b><p>{state.summary}</p><dl><div><dt>Actor</dt><dd>{state.actor}</dd></div><div><dt>Evidence</dt><dd>{state.durability}</dd></div></dl></div>
            </li>
          ))}
        </ol>

        <div class="frontmatter-receipt-grid">
          <article>
            <p class="hara-v2-kicker">Exact publication receipt</p>
            <h3><code>receipt:docs:pub-1098</code></h3>
            <dl>
              <div><dt>Content</dt><dd>hara:docs:guide:durable-work-pipeline</dd></div>
              <div><dt>Revision</dt><dd><code>sha256:72a194a3</code></dd></div>
              <div><dt>Schema</dt><dd>hara.docs/guide@2.1.0</dd></div>
              <div><dt>Actor</dt><dd>identity:github:hoebat</dd></div>
              <div><dt>Generator</dt><dd>content.publish@2.1.0</dd></div>
            </dl>
          </article>
          <article>
            <p class="hara-v2-kicker">Deterministic regeneration</p>
            <h3>Same inputs → same revision</h3>
            <ol>
              <li><span>01</span>Resolve schema and registry references.</li>
              <li><span>02</span>Canonicalize authored and controlled facts.</li>
              <li><span>03</span>Generate route and machine representations.</li>
              <li><span>04</span>Digest exact bytes and issue receipt.</li>
            </ol>
          </article>
          <article>
            <p class="hara-v2-kicker">Migration notice</p>
            <h3>{migratedSpecimen.migration?.from} → {migratedSpecimen.migration?.to}</h3>
            <ul>{migratedSpecimen.migration?.transforms.map((transform) => <li>{transform}</li>)}</ul>
            <footer><span>Receipt</span><code>{migratedSpecimen.migration?.receipt}</code></footer>
          </article>
        </div>
      </section>

      <section class="frontmatter-section" id="provenance">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">07 · Imported and syndicated provenance</p>
            <h2>A clipping never pretends to be the original.</h2>
          </div>
          <p>
            Source identity, retrieval, transformations, digests, permissions, and import receipts remain visible.
            World owns discussion context while the canonical article remains at its original destination.
          </p>
        </header>

        <div class="frontmatter-provenance-shell">
          <article class="frontmatter-provenance-preview">
            <header><span>Imported specimen</span><code>{importedSpecimen.contentType}</code></header>
            <h3>{importedPreview.feed.title}</h3>
            <p>{importedPreview.feed.summary}</p>
            <a href={String(importedSpecimen.provenance?.originalUrl)}>{String(importedSpecimen.provenance?.originalUrl)}</a>
          </article>
          <ol class="frontmatter-provenance-chain" aria-label="Provenance chain">
            <li><span>01</span><div><b>Original source</b><p>{String(importedSpecimen.provenance?.provider)} · {String(importedSpecimen.provenance?.originalDigest)}</p></div></li>
            <li><span>02</span><div><b>Retrieval</b><p>{String(importedSpecimen.provenance?.retrievedAt)}</p></div></li>
            <li><span>03</span><div><b>Transformations</b><p>{Array.isArray(importedSpecimen.provenance?.transformations) ? importedSpecimen.provenance?.transformations.join(" · ") : "none"}</p></div></li>
            <li><span>04</span><div><b>Import receipt</b><p>{String(importedSpecimen.provenance?.importReceipt)}</p></div></li>
            <li><span>05</span><div><b>World discussion object</b><p>{importedPreview.route.contentId} · {importedPreview.search.revision}</p></div></li>
          </ol>
        </div>
      </section>

      <section class="frontmatter-section" id="adoption">
        <header class="frontmatter-section-head">
          <div>
            <p class="hara-v2-kicker">08 · Ownership and adoption</p>
            <h2>Applications consume the contract; they do not fork it.</h2>
          </div>
          <p>
            Shared field semantics and control boundaries stay here. Each application owns realistic domain composition,
            business rules, and application-specific workflows while linking back to the exact content families it consumes.
          </p>
        </header>

        <div class="frontmatter-ownership-grid">
          <article>
            <p class="hara-v2-kicker">Shared content contract owns</p>
            <h3>Portable semantic boundaries</h3>
            <ul>
              <li>field identity, requirement, version, control, and source</li>
              <li>lifecycle vocabulary and immutable receipt shape</li>
              <li>canonical identity, route derivation, migration, and provenance rules</li>
              <li>representation and preview equivalence</li>
            </ul>
          </article>
          <article>
            <p class="hara-v2-kicker">Application owns</p>
            <h3>Domain policy and composition</h3>
            <ul>
              <li>who may submit, review, publish, moderate, or withdraw</li>
              <li>ranking, curriculum, compatibility, and conformance business rules</li>
              <li>page information architecture and workflow-specific evidence</li>
              <li>downstream storage and registry implementation</li>
            </ul>
          </article>
          <article>
            <p class="hara-v2-kicker">Catalogue-only annotation</p>
            <h3>Review framing, never production API</h3>
            <ul>
              <li>field callouts, device frames, relationship diagrams, and specimen ledgers</li>
              <li>invalid, deprecated, migrated, and imported comparison arrangements</li>
              <li>reference labels that explain ownership and responsive behaviour</li>
            </ul>
          </article>
        </div>

        <div class="frontmatter-adoption-map">
          {applicationContractMap.map((entry) => (
            <article data-application-issue={entry.issue}>
              <header><span>{entry.application}</span><a href={issueHref(entry.issue)}>#{entry.issue}</a></header>
              <div>{entry.families.map((family) => <code>{family}</code>)}</div>
              <p>{entry.contract}</p>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
