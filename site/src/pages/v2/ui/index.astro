        <section class="ui-adoption-note">
          <div><p class="hara-v2-kicker">Downstream rule</p><h3>Adopt merged contracts, then compose locally.</h3><p>Products should pin a merged Visual Language revision, reuse package components and state semantics, and keep business logic in the downstream application. Laboratory annotation CSS is not a product dependency.</p></div>
          <div><a class="hara-v2-button" data-variant="primary" href={catalogueHome}>Return to catalogue</a><a class="hara-v2-button" href={foundationsRoute}>Foundations</a><a class="hara-v2-button" href={componentsRoute}>Components</a><a class="hara-v2-button" href={toolRoute}>Tool workbenches</a></div>
        </section>
      </section>

      <footer class="ui-patterns-footer">
        <span>Hara v2 UI patterns · Issue #36</span>
        <span><a href={catalogueHome}>Catalogue</a> · <a href={componentsRoute}>Components</a> · <a href={issueRoute}>Implementation issue</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>

    <script>
      const initialiseUiPatterns = () => {
        document.querySelectorAll("[data-search-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          const buttons = [...root.querySelectorAll("[data-search-mode]")];
          const panels = [...root.querySelectorAll("[data-search-panel]")];
          const setMode = (mode) => {
            root.dataset.mode = mode;
            buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.getAttribute("data-search-mode") === mode)));
            panels.forEach((panel) => {
              if (panel instanceof HTMLElement) panel.hidden = panel.getAttribute("data-search-panel") !== mode;
            });
          };
          buttons.forEach((button) => button.addEventListener("click", () => setMode(button.getAttribute("data-search-mode") || "success")));
          root.querySelector("[data-search-form]")?.addEventListener("submit", () => setMode("loading"));
          root.querySelectorAll("[data-result]").forEach((row) => row.addEventListener("click", () => {
            root.querySelectorAll("[data-result]").forEach((item) => item.setAttribute("aria-pressed", String(item === row)));
          }));
        });

        document.querySelectorAll("[data-publish-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          const live = root.querySelector("[data-publish-live]");
          const revision = root.querySelector("[data-required-field='revision']");
          const revisionError = root.querySelector("#ui-revision-error");
          const validationSummary = root.querySelector("[data-validation-summary]");
          const panels = [...root.querySelectorAll("[data-publish-panel]")];
          const steps = [...root.querySelectorAll("[data-publish-step]")];

          const setPhase = (phase) => {
            root.dataset.phase = phase;
            panels.forEach((panel) => {
              if (panel instanceof HTMLElement) panel.hidden = panel.getAttribute("data-publish-panel") !== phase;
            });
            steps.forEach((step) => {
              if (step.getAttribute("data-publish-step") === phase) step.setAttribute("aria-current", "step");
              else step.removeAttribute("aria-current");
            });
            const activePanel = root.querySelector(`[data-publish-panel='${phase}']`);
            if (phase === "receipt" && activePanel instanceof HTMLElement) activePanel.focus();
          };

          const validate = () => {
            const missing = !(revision instanceof HTMLInputElement) || revision.value.trim() === "";
            if (revisionError instanceof HTMLElement) revisionError.hidden = !missing;
            if (validationSummary instanceof HTMLElement) validationSummary.hidden = !missing;
            if (revision instanceof HTMLInputElement) revision.setAttribute("aria-invalid", String(missing));
            if (missing) {
              setPhase("validate");
              if (validationSummary instanceof HTMLElement) validationSummary.focus();
              if (live instanceof HTMLElement) live.textContent = "Validation found one blocking issue. No proposal was submitted.";
              return false;
            }
            setPhase("preview");
            root.querySelectorAll("[data-preview-revision]").forEach((node) => { node.textContent = revision.value; });
            if (live instanceof HTMLElement) live.textContent = "Validation passed. Review the public and machine preview before submission.";
            return true;
          };

          root.querySelectorAll("[data-publish-action]").forEach((button) => button.addEventListener("click", () => {
            const action = button.getAttribute("data-publish-action") || "draft";
            if (action === "validate") { validate(); return; }
            if (action === "submit") {
              if (!validate()) return;
              setPhase("submit");
              if (live instanceof HTMLElement) live.textContent = "Submitting one revision-fenced proposal.";
              return;
            }
            setPhase(action);
            if (live instanceof HTMLElement) live.textContent = action === "draft" ? "New reversible draft ready." : `Workflow moved to ${action}.`;
          }));

          root.querySelectorAll("[data-publish-step]").forEach((button) => button.addEventListener("click", () => {
            const phase = button.getAttribute("data-publish-step") || "draft";
            if (phase === "preview" && !validate()) return;
            setPhase(phase);
          }));

          root.querySelector("[data-fill-revision]")?.addEventListener("click", () => {
            if (revision instanceof HTMLInputElement) revision.value = "637c14a";
            validate();
          });

          root.querySelectorAll("input, textarea, select").forEach((field) => field.addEventListener("input", () => {
            const autosave = root.querySelector("[data-autosave-state]");
            if (autosave instanceof HTMLElement) autosave.textContent = "Unsaved local change · autosaving…";
            window.setTimeout(() => { if (autosave instanceof HTMLElement) autosave.textContent = "Draft saved locally · just now"; }, 450);
          }));

          const dialog = root.querySelector("[data-destructive-dialog]");
          root.querySelector("[data-open-destructive]")?.addEventListener("click", () => {
            if (dialog instanceof HTMLDialogElement) dialog.showModal();
          });
          const checkbox = root.querySelector("[data-confirm-discard]");
          const confirmButton = root.querySelector("[data-confirm-discard-button]");
          checkbox?.addEventListener("change", () => {
            if (checkbox instanceof HTMLInputElement && confirmButton instanceof HTMLButtonElement) confirmButton.disabled = !checkbox.checked;
          });
        });

        document.querySelectorAll("[data-identity-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          const setAccount = (button) => {
            root.querySelectorAll("[data-account]").forEach((item) => item.setAttribute("aria-selected", String(item === button)));
            const role = button.getAttribute("data-role") || "Signed in";
            const authority = button.getAttribute("data-authority") || "";
            const account = button.getAttribute("data-account") || "";
            const roleNode = root.querySelector("[data-authority-role]");
            const copyNode = root.querySelector("[data-authority-copy]");
            const accountNode = root.querySelector("[data-authority-account]");
            const statusNode = root.querySelector("[data-identity-status]");
            if (roleNode) roleNode.textContent = role;
            if (copyNode) copyNode.textContent = authority;
            if (accountNode) accountNode.textContent = `@${account}`;
            if (statusNode) statusNode.textContent = account === "buildwatcher" ? "Owned bot" : "Signed in";
          };
          root.querySelectorAll("[data-account]").forEach((button) => button.addEventListener("click", () => setAccount(button)));
          root.querySelector("[data-account-anonymous]")?.addEventListener("click", () => {
            root.querySelectorAll("[data-account]").forEach((item) => item.setAttribute("aria-selected", "false"));
            const roleNode = root.querySelector("[data-authority-role]");
            const copyNode = root.querySelector("[data-authority-copy]");
            const accountNode = root.querySelector("[data-authority-account]");
            const statusNode = root.querySelector("[data-identity-status]");
            if (roleNode) roleNode.textContent = "Anonymous";
            if (copyNode) copyNode.textContent = "May read, run, and draft locally. Server mutation is paused until an identity is chosen.";
            if (accountNode) accountNode.textContent = "none";
            if (statusNode) statusNode.textContent = "No mutation identity";
          });
        });

        document.querySelectorAll("[data-runtime-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          const panels = [...root.querySelectorAll("[data-runtime-panel]")];
          const status = root.querySelector("[data-runtime-status-text]");
          const observation = root.querySelector("[data-runtime-observation-label]");
          const generation = root.querySelector("[data-runtime-generation]");
          const setState = (state) => {
            root.dataset.runtimeState = state;
            panels.forEach((panel) => {
              if (panel instanceof HTMLElement) panel.hidden = panel.getAttribute("data-runtime-panel") !== state;
            });
            const labels = {
              ready: ["Ready · source has local changes", "Ready · last success retained"],
              running: ["Running generation 8", "Compiling source rev-19"],
              failed: ["Compile failed · source preserved", "Failure · previous success retained"],
              offline: ["Disconnected · mutation disabled", "Offline · reconnect or read-only"],
              recovered: ["Recovered · sequence resumed", "Recovered · exact receipt available"]
            };
            const pair = labels[state] || labels.ready;
            if (status) status.textContent = pair[0];
            if (observation) observation.textContent = pair[1];
            if (state === "recovered" && generation) generation.textContent = "9";
          };
          root.querySelectorAll("[data-runtime-action]").forEach((button) => button.addEventListener("click", () => {
            const action = button.getAttribute("data-runtime-action");
            if (action === "run") setState("running");
            if (action === "fail") setState("failed");
            if (action === "offline") setState("offline");
            if (action === "recover") setState("recovered");
            if (action === "stop") setState("ready");
          }));
        });

        document.querySelectorAll("[data-community-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          const input = root.querySelector("[data-comment-input]");
          const preview = root.querySelector("[data-comment-preview]");
          const published = root.querySelector("[data-published-comment]");
          const pending = root.querySelector("[data-comment-pending]");
          const publishedCopy = root.querySelector("[data-published-copy]");
          const refresh = () => {
            if (input instanceof HTMLTextAreaElement && preview) preview.textContent = input.value;
          };
          root.querySelector("[data-comment-preview-action]")?.addEventListener("click", refresh);
          root.querySelector("[data-comment-publish]")?.addEventListener("click", () => {
            refresh();
            if (input instanceof HTMLTextAreaElement && publishedCopy) publishedCopy.textContent = input.value;
            if (pending instanceof HTMLElement) pending.hidden = true;
            if (published instanceof HTMLElement) { published.hidden = false; published.focus(); }
          });
        });

        document.querySelectorAll("[data-evidence-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          const tabs = [...root.querySelectorAll("[data-evidence-tab]")];
          const panels = [...root.querySelectorAll("[data-evidence-panel]")];
          const setView = (view) => {
            root.dataset.view = view;
            tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.getAttribute("data-evidence-tab") === view)));
            panels.forEach((panel) => { if (panel instanceof HTMLElement) panel.hidden = panel.getAttribute("data-evidence-panel") !== view; });
          };
          tabs.forEach((tab) => tab.addEventListener("click", () => setView(tab.getAttribute("data-evidence-tab") || "summary")));
          root.querySelectorAll("[data-copy-exact-view]").forEach((button) => button.addEventListener("click", () => {
            const status = root.querySelector("[data-exact-view-status]");
            if (status) status.textContent = `Copied exact ${root.dataset.view || "summary"} view · revision 637c14a`;
          }));
        });

        document.querySelectorAll("[data-mobile-editor-demo]").forEach((root) => {
          if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
          root.dataset.ready = "true";
          root.querySelector("[data-enter-edit]")?.addEventListener("click", () => {
            root.dataset.editing = "true";
            const status = root.querySelector("[data-mobile-edit-status]");
            if (status) status.textContent = "Edit mode entered explicitly. The editor may now receive focus.";
          });
        });

        document.querySelectorAll("[data-open-focus-dialog]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.ready === "true") return;
          button.dataset.ready = "true";
          const section = button.closest(".ui-focus-return");
          const dialog = section?.querySelector("[data-focus-dialog]");
          const status = section?.querySelector("[data-focus-return-status]");
          button.addEventListener("click", () => { if (dialog instanceof HTMLDialogElement) dialog.showModal(); });
          dialog?.addEventListener("close", () => {
            button.focus();
            if (status) status.textContent = dialog.returnValue === "copy" ? "Link copied. Focus returned to the trigger." : "Dialog closed. Focus returned to the trigger.";
          });
        });
      };

      initialiseUiPatterns();
      document.addEventListener("astro:page-load", initialiseUiPatterns);
    </script>
  </body>
</html>
