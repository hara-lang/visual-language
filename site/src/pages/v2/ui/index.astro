---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import PatternStateCard from "../../../components/v2-ui/PatternStateCard.astro";
import WorkflowRail from "../../../components/v2-ui/WorkflowRail.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import FleetField from "../../../../../src/astro/v2/FleetField.astro";
import Shell from "../../../../../src/astro/v2/Shell.astro";
import Header from "../../../../../src/astro/v2/Header.astro";
import ContextNav from "../../../../../src/astro/v2/ContextNav.astro";
import Sidebar from "../../../../../src/astro/v2/Sidebar.astro";
import PageHeader from "../../../../../src/astro/v2/PageHeader.astro";
import {
  identityStates,
  interfaceStates,
  ownershipBoundaries,
  responsiveContracts,
  uiPatternFamilies,
  workflowById,
  workflowStudies
} from "../../../lib/v2-ui-patterns.mjs";
import "../../../../../src/v2-tool.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-ui-patterns.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/ui/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueHome = `${basePath}v2/`;
const foundationsRoute = `${basePath}v2/foundations/`;
const componentsRoute = `${basePath}v2/components/`;
const toolRoute = `${basePath}v2/tool/`;
const issueRoute = "https://github.com/hara-lang/visual-language/issues/36";

const searchWorkflow = workflowById("search-inspect") ?? workflowStudies[0];
const publishWorkflow = workflowById("draft-publish") ?? workflowStudies[1];
const runtimeWorkflow = workflowById("session-recovery") ?? workflowStudies[2];
const feedWorkflow = workflowById("feed-comment") ?? workflowStudies[3];
const evidenceWorkflow = workflowById("evidence-share") ?? workflowStudies[4];

const sectionLinks = [
  ["contract", "Contract"],
  ["discovery", "Discovery"],
  ["mutation", "Mutation"],
  ["states", "State atlas"],
  ["identity", "Identity"],
  ["runtime", "Runtime"],
  ["community", "Community"],
  ["evidence", "Evidence"],
  ["responsive", "Responsive"],
  ["ownership", "Ownership"]
];

const exampleNav = [
  { href: "#discovery", label: "Browse", current: true },
  { href: "#mutation", label: "Publish" },
  { href: "#identity", label: "Maintainers" }
];

const discoveryContext = [
  { href: "#discovery", label: "Search", current: true },
  { href: "#discovery", label: "Recent" },
  { href: "#discovery", label: "Saved" }
];

const discoverySidebar = [
  { label: "Type", items: [
    { href: "#discovery", label: "Everything", current: true, badge: 18 },
    { href: "#discovery", label: "Packages", badge: 6 },
    { href: "#discovery", label: "Specifications", badge: 4 },
    { href: "#discovery", label: "Guides", badge: 5 },
    { href: "#discovery", label: "People", badge: 3 }
  ] },
  { label: "Status", items: [
    { href: "#discovery", label: "Current", badge: 13 },
    { href: "#discovery", label: "Experimental", badge: 3 },
    { href: "#discovery", label: "Superseded", badge: 2 }
  ] }
];

const adoptionTargets = [
  { issue: 38, label: "WWW · Docs · Benchmarks", consumes: "navigation, discovery, evidence sharing, stale and degraded content" },
  { issue: 39, label: "Playground", consumes: "session recovery, permissions, responsive collapse, explicit mobile editor focus" },
  { issue: 40, label: "Specs", consumes: "search/inspect, proposal mutation, checker states, exact receipts" },
  { issue: 41, label: "Packages", consumes: "registry discovery, publish validation, maintainer roles, provenance receipts" },
  { issue: 42, label: "World", consumes: "feed/thread mutation, moderation, partial sources, user-owned automation" },
  { issue: 43, label: "Learn", consumes: "anonymous execution, lesson progress, runtime recovery, mobile input behavior" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The detailed Hara v2 UI patterns laboratory: navigation, discovery, mutation, data states, identity, permissions, runtime recovery, community publishing, evidence sharing, responsive behavior, keyboard and touch contracts." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 UI patterns laboratory" />
    <meta property="og:description" content="Complete reusable workflows and state transitions for the Hara interface ecosystem." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 UI patterns laboratory" />
    <meta name="twitter:description" content="Discovery, mutation, recovery, community, evidence, permission, responsive and accessibility patterns." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 UI patterns laboratory</title>
  </head>
  <body class="hara-v2 hara-v2-tool ui-patterns-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/ui/" />

    <main class="ui-patterns-main">
      <section class="ui-patterns-hero" aria-labelledby="ui-patterns-title">
        <div>
          <p class="hara-v2-kicker">Shared library · Behaviour over time</p>
          <h1 id="ui-patterns-title">Interfaces are stories, not screenshots.</h1>
          <p>Components define reusable parts. This laboratory defines what happens before, during, and after a person acts: how focus moves, how uncertainty is shown, how failure preserves work, how permissions remain visible, and how every successful mutation produces evidence.</p>
          <div class="ui-patterns-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#discovery">Open a complete workflow</a>
            <a class="hara-v2-button" href={componentsRoute}>Review components</a>
            <a class="hara-v2-button" data-variant="ghost" href={issueRoute}>Issue #36 ↗</a>
          </div>
          <div class="ui-patterns-hero-stats" aria-label="UI pattern contract counts">
            <div><strong>{uiPatternFamilies.length}</strong><span>pattern families</span></div>
            <div><strong>{workflowStudies.length}</strong><span>end-to-end workflows</span></div>
            <div><strong>{interfaceStates.length}</strong><span>content and transport states</span></div>
            <div><strong>{identityStates.length}</strong><span>identity and authority states</span></div>
          </div>
        </div>
        <div class="ui-patterns-hero-art">
          <FleetField title="Hara interface state transition field" />
          <div class="ui-patterns-orbit ui-patterns-orbit--start"><span>Initial</span><small>intent visible</small></div>
          <div class="ui-patterns-orbit ui-patterns-orbit--active"><span>Active</span><small>work preserved</small></div>
          <div class="ui-patterns-orbit ui-patterns-orbit--receipt"><span>Receipt</span><small>result inspectable</small></div>
          <div class="ui-patterns-orbit ui-patterns-orbit--recover"><span>Recover</span><small>safe next action</small></div>
          <div class="ui-patterns-core"><HaraMark size={40} /><b>State contract</b></div>
        </div>
      </section>

      <nav class="ui-patterns-section-nav" aria-label="UI pattern laboratory sections">
        {sectionLinks.map(([href, label]) => <a href={`#${href}`}>{label}</a>)}
      </nav>

      <section class="ui-patterns-section" id="contract">
        <header class="ui-patterns-section-head">
          <div><p class="hara-v2-kicker">01 · Shared interaction contract</p><h2>Products share behavior, not business rules.</h2></div>
          <p>The package owns semantic state, focus, validation placement, receipts, responsive yielding, touch targets, and reduced-motion behavior. Products still own ranking, permissions, moderation, curriculum, compatibility, and runtime truth.</p>
        </header>

        <div class="ui-pattern-family-grid">
          {uiPatternFamilies.map((family, index) => (
            <article class="ui-pattern-family" id={`family-${family.id}`}>
              <header><span>{String(index + 1).padStart(2, "0")}</span><h3>{family.label}</h3></header>
              <p>{family.summary}</p>
              <div class="ui-pattern-tags">{family.patterns.map((pattern) => <code>{pattern}</code>)}</div>
              <footer>
                <b>Non-negotiable</b>
                <ul>{family.nonNegotiables.map((rule) => <li>{rule}</li>)}</ul>
              </footer>
            </article>
          ))}
        </div>

        <div class="ui-pattern-do-dont">
          <article data-guidance="do"><span>Do</span><strong>Model the full transition.</strong><p>Initial intent, active work, transport, failure, recovery, and receipt are one interface contract.</p></article>
          <article data-guidance="avoid"><span>Avoid</span><strong>Design only the successful screenshot.</strong><p>A blank pane, silent rollback, or invented success becomes downstream product behavior by accident.</p></article>
        </div>
      </section>

      <section class="ui-patterns-section" id="discovery">
        <header class="ui-patterns-section-head">
          <div><p class="hara-v2-kicker">02 · Navigation and discovery</p><h2>Search, filter, select, inspect.</h2></div>
          <p>The same choreography can serve a package registry, specification index, documentation search, World feed, or curriculum catalogue while each product retains its own ranking and object model.</p>
        </header>

        <WorkflowRail workflow={searchWorkflow} selected="inspect" />

        <div class="ui-pattern-canvas ui-discovery-demo" data-search-demo data-mode="success">
          <Shell embedded={true} sidebar={true} aside={true} mainId="ui-search-content">
            <Header slot="header" section="Registry" nav={exampleNav} homeHref="#discovery">
              <button class="hara-v2-icon-button" type="button" aria-label="Open account menu">MZ</button>
            </Header>
            <ContextNav slot="context" items={discoveryContext}>
              <button class="hara-v2-button" type="button">Saved views</button>
            </ContextNav>
            <Sidebar slot="sidebar" title="Discover" groups={discoverySidebar}>
              <span>Filters never erase the query or pretend an empty result means the registry is empty.</span>
            </Sidebar>

            <PageHeader
              kicker="Search contract"
              title="Find one exact Hara object."
              description="Results preserve type, source, status, exact identifier, and enough context to choose before opening the inspector."
              meta={["18 indexed objects", "3 source families", "revision 637c14a"]}
            >
              <div slot="illustration" class="ui-discovery-illustration"><FleetField title="Search and inspect field" /></div>
            </PageHeader>

            <form class="ui-search-command" data-search-form onsubmit="return false">
              <label>
                <span>Search packages, specs, guides, and people</span>
                <input class="hara-v2-field" type="search" value="schema" data-search-input />
              </label>
              <button class="hara-v2-button" data-variant="primary" type="submit">Search</button>
              <kbd>/</kbd>
            </form>

            <div class="ui-state-switcher" aria-label="Review discovery states">
              <span>Review state</span>
              <button type="button" data-search-mode="success" aria-pressed="true">Results</button>
              <button type="button" data-search-mode="loading" aria-pressed="false">Loading</button>
              <button type="button" data-search-mode="empty" aria-pressed="false">Filtered empty</button>
              <button type="button" data-search-mode="partial" aria-pressed="false">Partial</button>
              <button type="button" data-search-mode="error" aria-pressed="false">Error</button>
            </div>

            <section class="ui-search-panel" data-search-panel="success" aria-live="polite">
              <header class="ui-result-summary"><div><b>18 results for “schema”</b><span>Type: all · Status: current</span></div><button type="button">Sort: relevance</button></header>
              <div class="ui-result-list">
                <button class="ui-result-row" type="button" aria-pressed="true" data-result="std-typed">
                  <span class="hara-v2-badge" data-tone="success">Package</span>
                  <span><b>std.typed</b><small>Runtime Schema values, typed forms, validation, and portable evidence.</small></span>
                  <span><code>v1.4.0</code><small>current · 3h</small></span>
                </button>
                <button class="ui-result-row" type="button" aria-pressed="false" data-result="schema-values">
                  <span class="hara-v2-badge" data-tone="signal">Spec</span>
                  <span><b>HARA-TYPE-014 · Schema values</b><small>Normative runtime representation and conformance requirements.</small></span>
                  <span><code>accepted</code><small>rev 9c143d2</small></span>
                </button>
                <button class="ui-result-row" type="button" aria-pressed="false" data-result="schema-guide">
                  <span class="hara-v2-badge">Guide</span>
                  <span><b>Inspecting schemas as ordinary Hara</b><small>A task-oriented guide with runnable examples and exact package links.</small></span>
                  <span><code>8 min</code><small>docs · current</small></span>
                </button>
                <button class="ui-result-row" type="button" aria-pressed="false" data-result="mina">
                  <span class="hara-v2-badge">Person</span>
                  <span><b>@mina</b><small>Maintains std.typed and reviews schema conformance proposals.</small></span>
                  <span><code>maintainer</code><small>online</small></span>
                </button>
              </div>
            </section>

            <section class="ui-search-panel" data-search-panel="loading" hidden aria-live="polite">
              <div class="ui-loading-heading"><span class="ui-spinner" aria-hidden="true"></span><div><b>Searching 3 indexes…</b><small>Packages complete · Specs loading · Docs queued</small></div><button class="hara-v2-button" type="button">Cancel</button></div>
              <div class="ui-skeleton-list" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            </section>

            <section class="ui-search-panel" data-search-panel="empty" hidden aria-live="polite">
              <div class="ui-empty-state"><span>0</span><h3>No current packages match “schema” with runtime “Truffle”.</h3><p>The registry contains 18 results before the runtime filter. Your query is preserved.</p><button class="hara-v2-button" data-variant="primary" type="button">Clear runtime filter</button><button class="hara-v2-button" type="button">Save this search</button></div>
            </section>

            <section class="ui-search-panel" data-search-panel="partial" hidden aria-live="polite">
              <div class="hara-v2-callout" data-tone="warning"><div><b>Partial result set</b><p>Packages and Docs returned 14 objects. The Specs index has not refreshed since revision <code>51a7e6d</code>.</p></div><button class="hara-v2-button" type="button">Inspect coverage</button></div>
              <div class="ui-result-list ui-result-list--muted"><button class="ui-result-row" type="button"><span class="hara-v2-badge" data-tone="success">Package</span><span><b>std.typed</b><small>Available from the current package index.</small></span><span><code>v1.4.0</code><small>trusted</small></span></button></div>
            </section>

            <section class="ui-search-panel" data-search-panel="error" hidden aria-live="assertive">
              <div class="ui-error-state"><span>!</span><h3>The search service could not establish a consistent revision.</h3><p>No selection changed. The last complete result set from 10:42 remains available read-only.</p><div><button class="hara-v2-button" data-variant="primary" type="button">Retry exact search</button><button class="hara-v2-button" type="button">Use cached results</button><button class="hara-v2-button" type="button">Copy diagnostic</button></div><code>search-receipt: 18c2 · package=637c14a · specs=unavailable</code></div>
            </section>

            <div slot="aside" class="ui-inspector-stack">
              <section class="hara-v2-panel ui-result-inspector" aria-labelledby="selected-result-title">
                <header class="hara-v2-panel-header"><h2 id="selected-result-title">std.typed</h2><span class="hara-v2-badge" data-tone="success">Current</span></header>
                <div class="hara-v2-panel-body">
                  <p>Runtime Schema values, portable typed forms, conformance evidence, and lint integration.</p>
                  <dl><div><dt>Exact version</dt><dd>1.4.0</dd></div><div><dt>Revision</dt><dd><code>af6273c</code></dd></div><div><dt>Maintainers</dt><dd>@mina · @cora</dd></div><div><dt>Targets</dt><dd>JVM · Rust · Wasm</dd></div></dl>
                  <a class="hara-v2-button" data-variant="primary" href="#discovery">Open package</a>
                  <button class="hara-v2-button" type="button">Pin exact view</button>
                </div>
              </section>
              <section class="hara-v2-panel"><header class="hara-v2-panel-header"><h2>Focus contract</h2></header><div class="hara-v2-panel-body"><p>On wide screens selection updates this inspector. On narrow screens it becomes the next view, receives heading focus, and returns focus to the selected row when closed.</p></div></section>
            </div>
          </Shell>
        </div>
      </section>

      <section class="ui-patterns-section" id="mutation">
        <header class="ui-patterns-section-head">
          <div><p class="hara-v2-kicker">03 · Forms and mutation</p><h2>Drafts remain reversible until a named consequence.</h2></div>
          <p>Editable, generated, and reviewer-controlled facts remain visually distinct. Validation never destroys input; preview precedes mutation; the final state is a receipt rather than a green toast.</p>
        </header>

        <WorkflowRail workflow={publishWorkflow} selected="preview" />

        <div class="ui-mutation-board" data-publish-demo data-phase="draft">
          <nav class="ui-mutation-steps" aria-label="Publication workflow">
            <button type="button" data-publish-step="draft" aria-current="step"><span>01</span><b>Draft</b><small>editable</small></button>
            <button type="button" data-publish-step="validate"><span>02</span><b>Validate</b><small>2 checks</small></button>
            <button type="button" data-publish-step="preview"><span>03</span><b>Preview</b><small>public + machine</small></button>
            <button type="button" data-publish-step="submit"><span>04</span><b>Submit</b><small>named mutation</small></button>
            <button type="button" data-publish-step="receipt"><span>05</span><b>Receipt</b><small>exact result</small></button>
          </nav>

          <div class="ui-mutation-layout">
            <form class="ui-publish-form" data-publish-form onsubmit="return false">
              <header><div><p class="hara-v2-kicker">Package proposal</p><h3>Publish std.signal 0.3.0</h3></div><span class="ui-autosave-state" data-autosave-state>Draft saved locally · 10:58</span></header>

              <div class="hara-v2-form-grid">
                <div class="hara-v2-form-field" data-wide="true"><label for="ui-package-name">Package name</label><input class="hara-v2-field" id="ui-package-name" value="std.signal" aria-describedby="ui-package-name-note" /><small id="ui-package-name-note">Registry identity; changing this creates a different package.</small></div>
                <div class="hara-v2-form-field"><label for="ui-package-version">Version</label><input class="hara-v2-field" id="ui-package-version" value="0.3.0" data-required-field="version" /></div>
                <div class="hara-v2-form-field"><label for="ui-package-license">License</label><select class="hara-v2-select" id="ui-package-license"><option>EPL-2.0</option><option>MIT</option></select></div>
                <div class="hara-v2-form-field" data-wide="true"><label for="ui-package-summary">Release summary</label><textarea class="hara-v2-field" id="ui-package-summary" rows="4">Adds portable signal graphs, deterministic subscriptions, and runtime-neutral observation receipts.</textarea></div>
                <div class="hara-v2-form-field"><label for="ui-package-runtime">Runtime targets</label><input class="hara-v2-field" id="ui-package-runtime" value="jvm, rust, wasm" /></div>
                <div class="hara-v2-form-field"><label for="ui-package-revision">Source revision</label><input class="hara-v2-field" id="ui-package-revision" value="" placeholder="Required exact commit" data-required-field="revision" aria-describedby="ui-revision-error" /><small id="ui-revision-error" class="ui-field-error" hidden>Enter the exact source revision before preview.</small></div>
                <div class="hara-v2-form-field"><label for="ui-package-publisher">Publisher</label><input class="hara-v2-field" id="ui-package-publisher" value="@mina" readonly /><small>Identity-controlled from the signed-in subject.</small></div>
                <div class="hara-v2-form-field"><label for="ui-package-status">Registry status</label><input class="hara-v2-field" id="ui-package-status" value="Proposed after checks" readonly /><small>Server/reviewer-controlled generated fact.</small></div>
              </div>

              <div class="ui-validation-summary" data-validation-summary hidden tabindex="-1">
                <b>1 blocking issue</b><p>The source revision is required so the registry can reproduce the proposed artifacts.</p><a href="#ui-package-revision">Go to Source revision</a>
              </div>

              <footer class="ui-publish-actions">
                <button class="hara-v2-button" type="button" data-publish-action="save">Save draft</button>
                <button class="hara-v2-button" type="button" data-open-destructive>Discard draft</button>
                <span aria-live="polite" data-publish-live>Draft is editable. No server mutation has occurred.</span>
                <button class="hara-v2-button" data-variant="primary" type="button" data-publish-action="validate">Validate</button>
              </footer>
            </form>

            <aside class="ui-publish-preview" aria-live="polite">
              <section data-publish-panel="draft">
                <span class="hara-v2-badge">Draft</span><h3>Nothing has been submitted.</h3><p>Editable fields are preserved locally. Generated publisher and registry status fields remain locked.</p><div class="ui-preview-placeholder"><i></i><i></i><i></i></div>
              </section>
              <section data-publish-panel="validate" hidden>
                <span class="hara-v2-badge" data-tone="warning">Validation</span><h3>One exact fact is still missing.</h3><ul><li><b>Blocking:</b> source revision</li><li><b>Passed:</b> package identity</li><li><b>Passed:</b> semantic version</li><li><b>Passed:</b> runtime targets</li></ul><button class="hara-v2-button" type="button" data-fill-revision>Use current revision 637c14a</button>
              </section>
              <section data-publish-panel="preview" hidden>
                <span class="hara-v2-badge" data-tone="signal">Preview</span><h3>std.signal <code>0.3.0</code></h3><p>Portable signal graphs, deterministic subscriptions, and runtime-neutral observation receipts.</p><dl><div><dt>Publisher</dt><dd>@mina</dd></div><div><dt>Revision</dt><dd><code data-preview-revision>637c14a</code></dd></div><div><dt>Targets</dt><dd>JVM · Rust · Wasm</dd></div><div><dt>Next state</dt><dd>Proposal pending review</dd></div></dl><div class="ui-preview-tabs"><button type="button" aria-pressed="true">Registry card</button><button type="button">Install command</button><button type="button">Machine metadata</button></div><button class="hara-v2-button" data-variant="primary" type="button" data-publish-action="submit">Submit proposal</button>
              </section>
              <section data-publish-panel="submit" hidden aria-busy="true">
                <span class="hara-v2-badge" data-tone="signal">Submitting</span><h3>Creating one proposal…</h3><p>The action is fenced by package, version, source revision, and publisher. Duplicate requests return the same proposal receipt.</p><div class="ui-submit-progress"><i></i><span>Validating artifacts</span><span>Registering immutable proposal</span><span>Opening review record</span></div><button class="hara-v2-button" type="button" data-publish-action="receipt">Show simulated receipt</button>
              </section>
              <section data-publish-panel="receipt" hidden tabindex="-1">
                <span class="hara-v2-badge" data-tone="success">Proposal created</span><h3>std.signal 0.3.0 is awaiting review.</h3><p>Your draft is now represented by an immutable proposal receipt. Editing creates a new revision rather than silently changing the reviewed object.</p><dl><div><dt>Proposal</dt><dd><code>pkg-proposal-042</code></dd></div><div><dt>Source</dt><dd><code>637c14a</code></dd></div><div><dt>Status</dt><dd>review requested</dd></div><div><dt>Next actor</dt><dd>package reviewer</dd></div></dl><div><button class="hara-v2-button" data-variant="primary" type="button">Open review</button><button class="hara-v2-button" type="button">Copy receipt</button><button class="hara-v2-button" type="button" data-publish-action="draft">Create another draft</button></div>
              </section>
            </aside>
          </div>

          <dialog class="ui-confirm-dialog" data-destructive-dialog aria-labelledby="ui-discard-title">
            <form method="dialog"><p class="hara-v2-kicker">Destructive confirmation</p><h3 id="ui-discard-title">Discard this local draft?</h3><p>This removes unpublished local edits. It does not affect any registry proposal or package release.</p><label><input type="checkbox" data-confirm-discard /> I understand this draft cannot be recovered.</label><footer><button class="hara-v2-button" value="cancel">Keep draft</button><button class="hara-v2-button" data-variant="danger" value="confirm" disabled data-confirm-discard-button>Discard local draft</button></footer></form>
          </dialog>
        </div>
      </section>

      <section class="ui-patterns-section" id="states">
        <header class="ui-patterns-section-head">
          <div><p class="hara-v2-kicker">04 · Data and transport state atlas</p><h2>Nothing, late, stale, broken, and recovered all look different.</h2></div>
          <p>Every state carries a textual cue, object context, and safe next action. Colour reinforces state but never bears meaning alone.</p>
        </header>

        <div class="ui-state-atlas">
          {interfaceStates.map((state) => (
            <PatternStateCard
