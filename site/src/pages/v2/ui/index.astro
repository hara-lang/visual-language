---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import FleetField from "../../../../../src/astro/v2/FleetField.astro";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-ui-patterns.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/ui/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const componentsRoute = `${basePath}v2/components/`;
const foundationsRoute = `${basePath}v2/foundations/`;

const sectionLinks = [
  ["navigation-discovery", "Navigation"],
  ["forms-mutation", "Mutation"],
  ["data-content-states", "Data states"],
  ["identity-permission", "Identity"],
  ["responsive-input", "Responsive"],
  ["workflow-studies", "Workflows"],
  ["ownership", "Ownership"]
];

const dataStates = [
  ["loading", "Loading", "Fetching package index", "Keep the previous frame stable while new data resolves."],
  ["empty-first-use", "Empty · first use", "No saved views yet", "Explain the first meaningful action instead of showing a blank panel."],
  ["empty-filtered", "Empty · filtered", "No results for runtime:hbc", "Preserve the active query and offer a clear reset."],
  ["partial", "Partial data", "3 of 5 sources available", "Name the missing sources and keep verified rows usable."],
  ["stale", "Stale data", "Index is 18 minutes old", "Show age and provenance before offering a refresh."],
  ["success", "Success receipt", "Published · receipt gw_8421", "Return exact revision, actor, and durable result."],
  ["warning", "Warning", "Compatibility not verified", "Pair colour with a label and a concrete consequence."],
  ["recoverable-failure", "Recoverable failure", "Checker timed out", "Keep inputs intact and make retry explicit."],
  ["fatal", "Fatal error", "Registry unavailable", "Explain what is unavailable without manufacturing fallback data."],
  ["read-only", "Degraded · read only", "Writes paused", "Allow inspection while clearly disabling mutation."],
  ["offline", "Offline", "Working from local snapshot", "Differentiate cached evidence from current server truth."],
  ["reconnecting", "Reconnecting", "Attempt 2 · preserving edits", "Never discard local work while transport recovers."]
];

const roles = [
  ["anonymous", "Anonymous", "Inspect public evidence and try capability-free actions."],
  ["signed-in", "Signed in", "Save views, submit drafts, and receive durable receipts."],
  ["owner", "Owner", "Manage owned resources and accountable automations."],
  ["maintainer", "Maintainer", "Review package or namespace changes within delegated scope."],
  ["reviewer", "Reviewer", "Approve or request changes without gaining ownership rights."],
  ["contributor", "Contributor", "Propose changes and retain evidence of accepted work."],
  ["insufficient", "Insufficient permission", "Explain the required role and keep read access intact."],
  ["revoked", "Suspended / revoked", "Show scope, reason, and recovery path without hiding history."]
];

const workflows = [
  {
    id: "search-filter-select-inspect",
    title: "Search → filter → select → inspect",
    context: "Package discovery",
    states: [
      ["initial", "Initial", "Search is empty; useful recent packages remain visible."],
      ["active", "Active", "Runtime and stability filters narrow 128 records to 14."],
      ["success", "Success", "std.work is selected with exact version and provenance."],
      ["empty", "Empty", "No package matches all filters; query remains editable."],
      ["failure", "Failure", "Registry search failed; previous verified selection remains inspectable."]
    ]
  },
  {
    id: "draft-validate-preview-submit",
    title: "Draft → validate → preview → submit → receipt",
    context: "Publication form",
    states: [
      ["initial", "Initial", "A local draft starts with controlled fields clearly separated."],
      ["active", "Active", "Validation reports one inline error and a summary link."],
      ["success", "Success", "Submission returns revision 7f2c1d and receipt pub_1098."],
      ["empty", "Empty", "Preview has no optional release note; required metadata still renders."],
      ["failure", "Failure", "Submit failed; draft, validation results, and preview are preserved."]
    ]
  },
  {
    id: "session-edit-run-observe-recover",
    title: "Load session → edit → run → observe → recover",
    context: "Live workbench",
    states: [
      ["initial", "Initial", "Session 42 loads at source revision 18 without editor autofocus."],
      ["active", "Active", "Generation 6 is running; stop and observation controls are available."],
      ["success", "Success", "Generation 6 completes with monotonic event sequence 218."],
      ["empty", "Empty", "No diagnostics were emitted; observation pane explains the clean run."],
      ["failure", "Failure", "Run failed; source stays editable and restart creates generation 7."]
    ]
  },
  {
    id: "feed-thread-comment-publish",
    title: "Browse feed → open thread → comment → published",
    context: "Community discussion",
    states: [
      ["initial", "Initial", "Feed items expose source, age, submitter, and discussion count."],
      ["active", "Active", "Composer preview shows mention resolution and canonical thread target."],
      ["success", "Success", "Comment is published with author identity and stable permalink."],
      ["empty", "Empty", "A thread with no comments offers context before the composer."],
      ["failure", "Failure", "Publish failed; the local comment remains available to retry."]
    ]
  },
  {
    id: "compare-tab-share-view",
    title: "Compare evidence → change tab → share exact view",
    context: "Benchmark evidence",
    states: [
      ["initial", "Initial", "Default comparison names workload, baseline, and revision."],
      ["active", "Active", "Changing tabs preserves filters and updates the selected evidence panel."],
      ["success", "Success", "Share action produces an exact, reproducible view URL."],
      ["empty", "Empty", "An incomparable workload explains why a cell has no value."],
      ["failure", "Failure", "Evidence fetch failed; cached values are visibly marked stale."]
    ]
  }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara v2 interaction patterns: navigation, mutation, loading, failure, permission, responsive behaviour, and complete workflow states." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 UI pattern reference" />
    <meta property="og:description" content="Reusable interaction contracts across workflow state, viewport, input, identity, and failure conditions." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 UI pattern reference" />
    <meta name="twitter:description" content="Behaviour over time for the Hara interface ecosystem." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 UI pattern reference</title>
  </head>
  <body class="hara-v2 ui-pattern-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/ui/" />

    <main class="ui-main">
      <section class="ui-hero" aria-labelledby="ui-title">
        <div class="ui-hero-copy">
          <p class="hara-v2-kicker">Shared library · Behaviour over time</p>
          <h1 id="ui-title">Interaction patterns define transitions between interface states.</h1>
          <p>This reference records how shared Hara interfaces move through search, mutation, loading, permission, failure, recovery, and responsive collapse. Application repositories retain their domain rules and authoritative state.</p>
          <div class="ui-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#workflow-studies">Inspect workflows</a>
            <a class="hara-v2-button" href={componentsRoute}>Component inventory</a>
            <a class="hara-v2-button" data-variant="ghost" href={foundationsRoute}>Foundation rules</a>
          </div>
          <dl class="ui-hero-ledger" aria-label="UI pattern scope">
            <div><dt>5</dt><dd>end-to-end workflows</dd></div>
            <div><dt>12</dt><dd>data and degraded states</dd></div>
            <div><dt>8</dt><dd>identity / permission states</dd></div>
            <div><dt>320px+</dt><dd>responsive contract</dd></div>
          </dl>
        </div>
        <div class="ui-hero-field" aria-label="Workflow state field">
          <FleetField title="Interaction state field" />
          <div class="ui-state-node ui-state-node--one"><HaraMark size={28} /><span>initial</span></div>
          <div class="ui-state-node ui-state-node--two"><b>active</b><small>work in progress</small></div>
          <div class="ui-state-node ui-state-node--three"><b>success</b><small>durable receipt</small></div>
          <div class="ui-state-node ui-state-node--four"><b>failure</b><small>recoverable context</small></div>
        </div>
      </section>

      <nav class="ui-section-nav" aria-label="UI pattern sections">
        {sectionLinks.map(([href, label]) => <a href={`#${href}`}>{label}</a>)}
      </nav>

      <section class="ui-section" id="navigation-discovery">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">01 · Navigation and discovery</p><h2>Scope stays visible while the result set changes.</h2></div>
          <p>Global catalogue, application context, local tabs, search filters, selection, and result counts each keep one job. Keyboard users can traverse the same hierarchy without hover-only controls.</p>
        </header>

        <div class="ui-pattern-grid ui-pattern-grid--navigation">
          <article class="ui-specimen ui-search-specimen">
            <header><span>Search + filter + inspect</span><span class="hara-v2-badge" data-tone="signal">14 results</span></header>
            <form class="ui-search-row" role="search">
              <label for="ui-search">Packages</label>
              <input id="ui-search" class="hara-v2-field" value="work" aria-describedby="ui-search-help" />
              <select class="hara-v2-select" aria-label="Runtime filter"><option>HBC</option><option>Interpreter</option></select>
              <button class="hara-v2-button" type="button">Clear</button>
            </form>
            <p id="ui-search-help" class="ui-help">2 active filters · runtime:HBC · status:stable</p>
            <div class="ui-result-layout">
              <nav aria-label="Package results" class="ui-result-list">
                <a href="#navigation-discovery" aria-current="page"><b>std.work</b><span>Replayable work algebra</span></a>
                <a href="#navigation-discovery"><b>std.task</b><span>Task execution and orchestration</span></a>
                <a href="#navigation-discovery"><b>code.migrate</b><span>Migration ledger and regeneration</span></a>
              </nav>
              <aside class="ui-inspector" aria-label="Selected result">
                <p class="hara-v2-kicker">Selected · exact result</p>
                <h3>std.work <span>v0.8.4</span></h3>
                <p>6 runtimes · verified revision <code>7f2c1d</code></p>
                <a href="#workflow-studies">Open workflow contract →</a>
              </aside>
            </div>
            <footer class="ui-pagination" aria-label="Search pagination"><button type="button" disabled>Previous</button><span>1–14 of 14</span><button type="button">Next</button></footer>
          </article>

          <article class="ui-specimen">
            <header><span>Tabs, breadcrumbs, command palette</span><code>keyboard-first</code></header>
            <nav class="ui-breadcrumbs" aria-label="Breadcrumb"><a href="#navigation-discovery">Packages</a><span>/</span><a href="#navigation-discovery">std.work</a><span>/</span><span aria-current="page">Releases</span></nav>
            <div class="hara-v2-tabs" role="tablist" aria-label="Package views">
              <button type="button" role="tab">Overview</button><button type="button" role="tab" aria-selected="true">Releases</button><button type="button" role="tab">Dependents</button>
            </div>
            <div class="ui-command-palette" role="group" aria-label="Command palette example">
              <div><kbd>⌘</kbd><kbd>K</kbd><span>Search commands</span></div>
              <ul><li><b>Open exact revision</b><span>↵</span></li><li><b>Copy package coordinate</b><span>⌘C</span></li><li><b>Show compatibility</b><span>G C</span></li></ul>
            </div>
            <p class="ui-note"><b>Focus return:</b> closing the command palette returns focus to the control that opened it.</p>
          </article>
        </div>
      </section>

      <section class="ui-section" id="forms-mutation">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">02 · Forms and mutation</p><h2>Never trade recoverability for speed.</h2></div>
          <p>Drafts distinguish editable, derived, and identity-controlled fields. Validation is both inline and summarized. Optimistic updates always expose rollback, destructive actions explain scope, and preview precedes publication.</p>
        </header>

        <div class="ui-mutation-layout">
          <form class="ui-specimen ui-draft-form">
            <header><span>Draft → validate → preview</span><span class="hara-v2-badge" data-tone="warning">Unsaved changes</span></header>
            <div class="ui-validation-summary" role="alert"><b>1 issue needs attention</b><a href="#ui-version">Version must be explicit.</a></div>
            <label>Package <input class="hara-v2-field" value="std.work" /></label>
            <label id="ui-version">Version <input class="hara-v2-field" aria-invalid="true" value="latest" /><small>Use an exact semantic version, for example 0.8.4.</small></label>
            <label>Release note <textarea class="hara-v2-field" rows="3">Clarifies replayable work and explicit effect boundaries.</textarea></label>
            <div class="ui-controlled-field"><span>Publisher</span><b>hara-lang · verified GitHub identity</b><small>Identity-controlled · not browser editable</small></div>
            <footer><span aria-live="polite">Autosave paused until validation passes.</span><div><button type="button" class="hara-v2-button">Save draft</button><button type="button" class="hara-v2-button" data-variant="primary">Preview</button></div></footer>
          </form>

          <div class="ui-mutation-stack">
            <article class="ui-specimen" data-mutation-state="optimistic">
              <header><span>Optimistic update</span><b>Following std.work</b></header>
              <p>The local state updates immediately while the durable request is pending.</p>
              <div class="ui-inline-receipt"><span>Pending sync</span><button type="button">Undo</button></div>
            </article>
            <article class="ui-specimen" data-mutation-state="rollback">
              <header><span>Rollback</span><b>Follow failed</b></header>
              <p>The previous server state is restored. The reason and retry action stay adjacent.</p>
              <div class="ui-inline-receipt"><span>Network request failed</span><button type="button">Retry</button></div>
            </article>
            <details class="ui-specimen ui-destructive">
              <summary>Destructive confirmation · revoke release</summary>
              <p><b>Revoke std.work 0.8.4?</b> Existing receipts remain in history. New installs will be blocked.</p>
              <label>Type <code>std.work@0.8.4</code> <input class="hara-v2-field" /></label>
              <button type="button" class="hara-v2-button" data-variant="danger">Revoke release</button>
            </details>
          </div>
        </div>
      </section>

      <section class="ui-section" id="data-content-states">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">03 · Data and content states</p><h2>Degraded truth is labelled, not polished away.</h2></div>
          <p>Every state names what is known, what is missing, whether the user can act, and how old the evidence is. Colour is supplementary; labels, icons, text, and action affordances carry the meaning.</p>
        </header>
        <div class="ui-state-grid">
          {dataStates.map(([state, label, title, detail]) => (
            <article class="ui-state-card" data-state={state}>
              <span class="ui-state-marker" aria-hidden="true"></span>
              <div><p>{label}</p><h3>{title}</h3><span>{detail}</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="ui-section" id="identity-permission">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">04 · Identity and permission</p><h2>Authority is explicit at the point of action.</h2></div>
          <p>Identity state changes capability, never history. Owner, maintainer, reviewer, contributor, anonymous, and revoked states remain legible without forcing products into one permissions model.</p>
        </header>
        <div class="ui-role-grid">
          {roles.map(([state, label, detail]) => (
            <article data-role-state={state}><span class="ui-avatar" aria-hidden="true">H</span><div><h3>{label}</h3><p>{detail}</p></div></article>
          ))}
        </div>
        <article class="ui-specimen ui-automation-card">
          <div><span class="hara-v2-badge" data-tone="signal">BOT</span><b>release-notes-bot</b><small>owned by hoebat · package: std.work</small></div>
          <p>User-owned automation is attributed to an accountable owner, scoped capability, and inspectable receipt. A bot never appears as an unowned system actor.</p>
          <dl><div><dt>Owner</dt><dd>hoebat</dd></div><div><dt>Capability</dt><dd>draft release notes</dd></div><div><dt>Status</dt><dd>owner present</dd></div><div><dt>Receipt</dt><dd>bot_7782</dd></div></dl>
        </article>
      </section>

      <section class="ui-section" id="responsive-input">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">05 · Responsive and input behaviour</p><h2>Collapse supporting context before primary work.</h2></div>
          <p>Desktop, tablet, 680px, 390px, and 320px all preserve the primary task. Inspectors collapse before sidebars; horizontal context becomes scrollable; touch targets grow; editor focus is always explicit on mobile.</p>
        </header>
        <div class="ui-responsive-grid">
          <article class="ui-viewport-contract" data-viewport="desktop"><b>Desktop · 1280+</b><span>primary + sidebar + inspector</span><i>1</i><i>2</i><i>3</i></article>
          <article class="ui-viewport-contract" data-viewport="tablet"><b>Tablet · ≤ 1120</b><span>inspector collapses first</span><i>1</i><i>2</i></article>
          <article class="ui-viewport-contract" data-viewport="rail"><b>Compact · ≤ 820</b><span>sidebar becomes disclosure</span><i>1</i></article>
          <article class="ui-viewport-contract" data-viewport="mobile"><b>Mobile · 390 / 320</b><span>primary work first · no editor autofocus</span><i>1</i></article>
        </div>
        <div class="ui-input-grid">
          <article><b>Keyboard</b><p>Visible focus, logical traversal, Escape to close disclosures, and focus return to the opener.</p><kbd>Tab</kbd><kbd>Shift Tab</kbd><kbd>Esc</kbd></article>
          <article><b>Touch</b><p>Controls keep a minimum 44px target in touch-first compositions and do not depend on hover.</p><button type="button" class="hara-v2-button">Touch target</button></article>
          <article><b>Reduced motion</b><p>Ambient movement is removed; functional state changes use instant or low-distance substitutions.</p><span class="ui-motion-sample">state transition</span></article>
        </div>
      </section>

      <section class="ui-section" id="workflow-studies">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">06 · End-to-end studies</p><h2>Every workflow proves the complete state envelope.</h2></div>
          <p>These are deliberately cross-product specimens. They demonstrate shared interaction contracts while leaving package rules, publication policy, runtime semantics, moderation policy, and benchmark methodology to the owning product.</p>
        </header>
        <div class="ui-workflow-list">
          {workflows.map((workflow, index) => (
            <article class="ui-workflow" id={workflow.id}>
              <header><div><span>{String(index + 1).padStart(2, "0")}</span><p>{workflow.context}</p><h3>{workflow.title}</h3></div><a href="#ownership">Shared contract</a></header>
              <ol aria-label={`${workflow.title} states`}>
                {workflow.states.map(([state, label, detail]) => (
                  <li data-workflow-state={state}><span class="ui-workflow-dot" aria-hidden="true"></span><div><b>{label}</b><p>{detail}</p></div></li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </section>

      <section class="ui-section" id="ownership">
        <header class="ui-section-head">
          <div><p class="hara-v2-kicker">07 · Ownership boundary</p><h2>Share behaviour; keep business semantics local.</h2></div>
          <p>The UI reference is an acceptance surface, not a replacement application framework. Downstream products consume the shared geometry, components, and state grammar without copying catalogue-only framing.</p>
        </header>
        <div class="ui-ownership-grid">
          <article><span>Shared interaction contract</span><h3>Visual Language owns</h3><ul><li>focus and keyboard behaviour</li><li>loading, empty, success, warning, and failure envelopes</li><li>responsive collapse order</li><li>validation presentation and recovery affordances</li><li>identity and automation attribution patterns</li></ul></article>
          <article><span>Product-owned business rules</span><h3>Applications own</h3><ul><li>which actions a role may perform</li><li>package, spec, runtime, feed, or benchmark semantics</li><li>moderation and publication policy</li><li>durability and server-side receipt meaning</li><li>domain-specific navigation and information architecture</li></ul></article>
        </div>
        <p class="ui-closing-note"><b>Rule:</b> consume shared components from the component catalogue; do not turn a application-specific state machine into a new global primitive until more than one application proves the need.</p>
      </section>
    </main>
  </body>
</html>
