---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import FleetField from "../../../../../src/astro/v2/FleetField.astro";
import Motif from "../../../../../src/astro/Motif.astro";
import "../../../../../src/v2.css";
import "../../../../../src/motifs.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-foundations.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/foundations/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueHome = `${basePath}v2/`;
const v1Reference = basePath;
const themeContract = "https://github.com/hara-lang/visual-language/blob/main/V2-THEME.md";
const tokenSource = "https://github.com/hara-lang/visual-language/blob/main/src/v2/tokens.css";
const calmSource = "https://github.com/hara-lang/visual-language/blob/main/src/v2/calm-surfaces.css";

const identitySizes = [
  { size: 64, label: "Primary", note: "Headers, launch surfaces, and identity specimens" },
  { size: 40, label: "Product", note: "Application headers and account surfaces" },
  { size: 24, label: "Minimum", note: "Smallest supported interface mark" }
];

const withSwatchStyle = ([name, value, role]) => ({
  name,
  value,
  role,
  style: `background:${value}`
});

const lightTokens = [
  ["--hara-v2-canvas", "#eef0ef", "Page field"],
  ["--hara-v2-canvas-clean", "#f8f8f5", "Reading field"],
  ["--hara-v2-panel", "#f3f3f0", "Ordinary surface"],
  ["--hara-v2-panel-raised", "#fbfbf8", "Raised surface"],
  ["--hara-v2-panel-recess", "#e4e7e6", "Recessed surface"],
  ["--hara-v2-ink", "#13171c", "Primary content"],
  ["--hara-v2-muted", "#5d656e", "Secondary content"],
  ["--hara-v2-faint", "#8a9299", "Tertiary metadata"]
].map(withSwatchStyle);

const darkTokens = [
  ["--hara-v2-canvas", "#090b0e", "Page field"],
  ["--hara-v2-canvas-clean", "#06080b", "Reading field"],
  ["--hara-v2-panel", "#101419", "Ordinary surface"],
  ["--hara-v2-panel-raised", "#151a20", "Raised surface"],
  ["--hara-v2-panel-recess", "#0b0e12", "Recessed surface"],
  ["--hara-v2-ink", "#eef1f4", "Primary content"],
  ["--hara-v2-muted", "#a1aab3", "Secondary content"],
  ["--hara-v2-faint", "#6e7882", "Tertiary metadata"]
].map(withSwatchStyle);

const tokenFamilies = [
  {
    name: "Identity and type",
    variables: ["--hara-v2-font-heading", "--hara-v2-font-body", "--hara-v2-font-code", "--hara-v2-signal", "--hara-v2-signal-soft"],
    contract: "Aliases the existing Hara families and reserves blue for identity, focus, selection, and measured state."
  },
  {
    name: "Shell dimensions",
    variables: ["--hara-v2-header-height", "--hara-v2-context-height", "--hara-v2-context-offset", "--hara-v2-rail-width", "--hara-v2-inspector-width"],
    contract: "Keeps ecosystem chrome and product-local chrome measurable, composable, and independently collapsible."
  },
  {
    name: "Reading widths",
    variables: ["--hara-v2-page", "--hara-v2-column", "--hara-v2-prose"],
    contract: "Separates page breathing room, broad application content, and readable prose measure."
  },
  {
    name: "Geometry and controls",
    variables: ["--hara-v2-cut", "--hara-v2-cut-small", "--hara-v2-radius", "--hara-v2-radius-large", "--hara-v2-row", "--hara-v2-control"],
    contract: "Uses restrained radii for repetition and reserves clipped geometry for rare identity or hero moments."
  },
  {
    name: "Surfaces and content",
    variables: ["--hara-v2-canvas", "--hara-v2-canvas-clean", "--hara-v2-panel", "--hara-v2-panel-raised", "--hara-v2-panel-recess", "--hara-v2-ink", "--hara-v2-muted", "--hara-v2-faint"],
    contract: "Builds hierarchy through tonal fields before borders, bevels, or shadows."
  },
  {
    name: "Seams and atmosphere",
    variables: ["--hara-v2-line", "--hara-v2-line-strong", "--hara-v2-grid", "--hara-v2-sketch", "--hara-v2-hover", "--hara-v2-shadow", "--hara-v2-paper"],
    contract: "Separates functional seams, construction lines, ambient texture, hover state, and depth."
  },
  {
    name: "Functional state",
    variables: ["--hara-v2-success", "--hara-v2-warning", "--hara-v2-danger"],
    contract: "Green, orange, and red communicate outcomes and risk only; they are not decorative palette choices."
  },
  {
    name: "Motion refinement",
    variables: ["--hara-v2-motion", "--hara-v2-ease", "--hara-v2-calm-line", "--hara-v2-calm-line-strong", "--hara-v2-calm-grid", "--hara-v2-calm-sketch", "--hara-v2-calm-hover", "--hara-v2-calm-shadow"],
    contract: "The calm layer softens common boundaries and settles functional transitions without changing identity."
  }
];

const spacingSteps = [4, 8, 12, 16, 24, 32, 48, 64].map((value) => ({
  value,
  style: `width:${value}px;height:${value}px`
}));

const selectedExample = [
  "(defn selected? [node]",
  "  (= :active (:state node)))"
].join("\n");

const workflowExample = [
  "(def.workflow",
  "  lint",
  "  [:task] {:main {:fn lint-project",
  "                  :argcount 1}})"
].join("\n");

const productRoutePattern = "site/src/pages/v2/{product}";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The detailed Hara v2 foundations catalogue: identity, colour, material, typography, geometry, imagery, motion, state, and accessibility." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 foundations" />
    <meta property="og:description" content="A visual source of truth for the shared interface language beneath every Hara product." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 foundations" />
    <meta name="twitter:description" content="Identity, material, typography, geometry, imagery, motion, and accessibility foundations." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 foundations</title>
  </head>
  <body class="hara-v2 foundations-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/foundations/" />

    <main class="foundations-main">
      <section class="foundations-hero" aria-labelledby="foundations-title">
        <div class="foundations-hero-copy">
          <p class="hara-v2-kicker">Shared language · Foundations</p>
          <h1 id="foundations-title">The interface before the interface.</h1>
          <p>Hara products may have different information architectures, but they should feel related before a user reads a label. This catalogue makes the protected identity, material, rhythm, image, state, and accessibility contracts visible in one place.</p>
          <div class="foundations-hero-actions">
            <a class="hara-v2-button hara-v2-button--primary" href="#identity">Start with identity</a>
            <a class="hara-v2-button" href={themeContract}>Read the written contract</a>
          </div>
          <dl class="foundations-hero-facts">
            <div><dt>Scope</dt><dd>Shared v2 document layer</dd></div>
            <div><dt>Applies to</dt><dd>WWW · Docs · Specs · Packages · World · Learn</dd></div>
            <div><dt>Does not replace</dt><dd>Product information architecture or tool-only chrome</dd></div>
          </dl>
        </div>
        <div class="foundations-hero-field">
          <FleetField title="Hara foundations construction field" />
          <div class="foundations-hero-mark" aria-hidden="true"><HaraMark size={76} /></div>
        </div>
      </section>

      <nav class="foundations-section-nav" aria-label="Foundation families">
        <a href="#identity">Identity</a>
        <a href="#colour-material">Colour & material</a>
        <a href="#typography">Typography</a>
        <a href="#geometry-rhythm">Geometry & rhythm</a>
        <a href="#imagery-motifs">Imagery & motifs</a>
        <a href="#motion-state">Motion & state</a>
        <a href="#composed-examples">Composed examples</a>
        <a href="#ownership">Ownership</a>
      </nav>

      <section class="foundations-section" id="identity">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">01 · Identity</p><h2>One block H. One signal.</h2></div>
          <p>The mark is not a flexible logo system. The block-H silhouette, its internal proportions, and the single blue signal square are invariants across the ecosystem.</p>
        </header>

        <div class="foundations-identity-grid">
          <article class="foundations-specimen foundations-mark-scale">
            <header><span>Mark scale</span><code>HaraMark.astro</code></header>
            <div class="foundations-mark-sizes">
              {identitySizes.map((item) => (
                <div>
                  <span class="foundations-mark-stage"><HaraMark size={item.size} /></span>
                  <b>{item.label} · {item.size}px</b>
                  <small>{item.note}</small>
                </div>
              ))}
            </div>
            <p class="foundations-specimen-note">Below 24px, use a text label or a larger touch target rather than simplifying the mark.</p>
          </article>

          <article class="foundations-specimen foundations-lockups">
            <header><span>Approved lockups</span><code>identity / product</code></header>
            <div class="foundations-lockup-row"><HaraMark size={48} /><div><strong>Hara</strong><small>Programming language</small></div></div>
            <div class="foundations-lockup-row foundations-lockup-row--section"><HaraMark size={38} /><div><strong>Hara visual language</strong><small>Foundations · Version 2</small></div></div>
            <div class="foundations-lockup-row foundations-lockup-row--product"><HaraMark size={34} /><div><strong>Packages</strong><small>A Hara application</small></div></div>
          </article>

          <article class="foundations-specimen foundations-clear-space">
            <header><span>Clear space</span><code>1 signal unit</code></header>
            <div class="foundations-clear-space-stage">
              <span class="foundations-clear-space-label foundations-clear-space-label--top">x</span>
              <span class="foundations-clear-space-label foundations-clear-space-label--right">x</span>
              <div><HaraMark size={92} /></div>
            </div>
            <p>Keep at least one signal-square width clear on every side. Product names align to the mark; they do not enter its protected field.</p>
          </article>
        </div>

        <div class="foundations-rule-grid">
          <article class="foundations-rule foundations-rule--do"><span>Do</span><div class="foundations-rule-mark"><HaraMark size={48} /></div><p>Use current text colour for the H and the shared signal token for the square.</p></article>
          <article class="foundations-rule foundations-rule--avoid"><span>Avoid · stretch</span><div class="foundations-rule-mark foundations-rule-mark--stretched"><HaraMark size={48} /></div><p>Do not alter proportions to fill a container.</p></article>
          <article class="foundations-rule foundations-rule--avoid"><span>Avoid · rotate</span><div class="foundations-rule-mark foundations-rule-mark--rotated"><HaraMark size={48} /></div><p>Do not turn the identity into an ornamental glyph.</p></article>
          <article class="foundations-rule foundations-rule--avoid"><span>Avoid · outline</span><div class="foundations-rule-mark foundations-rule-mark--outline"><HaraMark size={48} /></div><p>Do not redraw, outline, bevel, or add a second signal.</p></article>
        </div>

        <div class="foundations-relationship">
          <div><p class="hara-v2-kicker">Ecosystem identity</p><h3>Hara remains the parent signal.</h3></div>
          <div class="foundations-relationship-map" aria-label="Identity relationship map">
            <span class="foundations-relationship-root"><HaraMark size={30} /> Hara</span>
            <span>WWW</span><span>Playground</span><span>Specs</span><span>Packages</span><span>World</span><span>Learn</span>
          </div>
          <p>Applications own names, information architecture, and task-specific imagery. They do not replace the block H, invent product colours, or fork the theme contract.</p>
        </div>
      </section>

      <section class="foundations-section" id="colour-material">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">02 · Colour and material</p><h2>Pale steel. Deep graphite. Quiet seams.</h2></div>
          <p>Light and dark modes are equal products. Both use continuous fields, restrained contrast steps, one primary blue signal, and state colours that remain functional.</p>
        </header>

        <div class="foundations-theme-pair" aria-label="Light and dark token tables">
          <article class="foundations-theme-preview" data-foundation-theme="light">
            <header><div><span>Light</span><strong>Pale steel and paper</strong></div><code>data-theme="light"</code></header>
            <div class="foundations-theme-surface foundations-theme-surface--raised"><small>Raised</small><strong>Evidence panel</strong><p>Bright enough to separate, never white enough to glare.</p></div>
            <div class="foundations-theme-surface foundations-theme-surface--panel"><small>Panel</small><span>Ordinary working surface</span></div>
            <div class="foundations-theme-surface foundations-theme-surface--recess"><small>Recess</small><span>Input, rail, or nested field</span></div>
            <ul>{lightTokens.map((token) => <li><i style={token.style}></i><code>{token.name}</code><b>{token.value}</b><span>{token.role}</span></li>)}</ul>
          </article>

          <article class="foundations-theme-preview" data-foundation-theme="dark">
            <header><div><span>Dark</span><strong>Graphite and cool ink</strong></div><code>data-theme="dark"</code></header>
            <div class="foundations-theme-surface foundations-theme-surface--raised"><small>Raised</small><strong>Evidence panel</strong><p>Depth comes from tone, not a brighter border around every region.</p></div>
            <div class="foundations-theme-surface foundations-theme-surface--panel"><small>Panel</small><span>Ordinary working surface</span></div>
            <div class="foundations-theme-surface foundations-theme-surface--recess"><small>Recess</small><span>Input, rail, or nested field</span></div>
            <ul>{darkTokens.map((token) => <li><i style={token.style}></i><code>{token.name}</code><b>{token.value}</b><span>{token.role}</span></li>)}</ul>
          </article>
        </div>

        <div class="foundations-material-grid">
          <article class="foundations-specimen">
            <header><span>Seam hierarchy</span><code>line / grid / sketch / shadow</code></header>
            <div class="foundations-seam-scale">
              <div data-seam="strong"><span>Strong seam</span><code>--hara-v2-line-strong</code></div>
              <div data-seam="line"><span>Ordinary seam</span><code>--hara-v2-line</code></div>
              <div data-seam="grid"><span>Layout grid</span><code>--hara-v2-grid</code></div>
              <div data-seam="sketch"><span>Construction line</span><code>--hara-v2-sketch</code></div>
              <div data-seam="shadow"><span>Ambient elevation</span><code>--hara-v2-shadow</code></div>
            </div>
          </article>

          <article class="foundations-specimen">
            <header><span>Functional colour</span><code>State, not decoration</code></header>
            <div class="foundations-state-palette">
              <div data-state="signal"><i></i><b>Signal</b><code>#4d9cff</code><span>Identity, focus, selection</span></div>
              <div data-state="success"><i></i><b>Success</b><code>#3e9d6f</code><span>Completed or verified</span></div>
              <div data-state="warning"><i></i><b>Warning</b><code>#f06a3c</code><span>Attention or recoverable risk</span></div>
              <div data-state="danger"><i></i><b>Danger</b><code>#d84f58</code><span>Destructive or failed state</span></div>
            </div>
          </article>
        </div>

        <div class="foundations-contrast-grid">
          <article data-contrast="pass"><span>Pass</span><strong>Primary ink on ordinary panel</strong><p>Use full ink for reading, labels, and critical values.</p><button class="hara-v2-button" type="button">Visible action</button></article>
          <article data-contrast="pass"><span>Pass</span><strong>State plus text and shape</strong><p><i class="foundations-status-symbol">✓</i> Verified release · exact revision recorded</p></article>
          <article data-contrast="fail"><span>Forbidden</span><strong>Faint text as body copy</strong><p>Metadata contrast is not a substitute for readable prose.</p></article>
          <article data-contrast="fail"><span>Forbidden</span><strong>Colour-only selection</strong><p>A blue wash without text, marker, or current-state semantics is ambiguous.</p></article>
        </div>

        <article class="foundations-token-ledger">
          <header><div><p class="hara-v2-kicker">Protected inventory</p><h3>Every token belongs to a semantic family.</h3></div><a href={tokenSource}>Open token source →</a></header>
          <div class="foundations-token-ledger-rows">
            {tokenFamilies.map((family) => (
              <section>
                <div><strong>{family.name}</strong><p>{family.contract}</p></div>
                <div class="foundations-token-list">{family.variables.map((variable) => <code>{variable}</code>)}</div>
              </section>
            ))}
          </div>
        </article>
      </section>

      <section class="foundations-section" id="typography">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">03 · Typography</p><h2>One family for language. One for exactness.</h2></div>
          <p>Hara uses the existing sans family for identity, headings, controls, and reading. Monospace is reserved for code, exact identifiers, telemetry, and compact status.</p>
        </header>

        <div class="foundations-type-family-grid">
          <article><span>Heading and body</span><strong>Geist / Helvetica Neue / Arial</strong><code>--hara-v2-font-heading · --hara-v2-font-body</code></article>
          <article><span>Code and telemetry</span><strong class="foundations-mono">Geist Mono / SFMono-Regular / Consolas</strong><code>--hara-v2-font-code</code></article>
        </div>

        <div class="foundations-type-scale">
          <div data-type="display"><span>Display · 72 / .88</span><strong>Portable programs, visible systems.</strong></div>
          <div data-type="section"><span>Section · 48 / .94</span><strong>Evidence before ornament.</strong></div>
          <div data-type="title"><span>Title · 28 / 1.05</span><strong>Schema values enter the ordinary runtime.</strong></div>
          <div data-type="body"><span>Body · 16 / 1.65</span><p>Long-form text uses a calm line length and generous leading. Dense product interfaces may reduce spacing, but not until the task genuinely benefits from comparison or repeated manipulation.</p></div>
          <div data-type="meta"><span>Metadata · 11 / 1.4</span><code>REVISION af6273c · RUNTIME wasm · VERIFIED</code></div>
        </div>

        <div class="foundations-type-contexts">
          <article class="foundations-editorial-sample">
            <p class="hara-v2-kicker">Editorial prose</p>
            <h3>A shared language should disappear into the task.</h3>
            <p>The visual system is successful when a reader can move from a guide to a specification, a package record, and a community thread without relearning what hierarchy, state, or provenance look like.</p>
            <blockquote>Precision is alignment, rhythm, and exact state—not extra chrome around every fact.</blockquote>
          </article>
          <article class="foundations-telemetry-sample">
            <p class="hara-v2-kicker">Telemetry and data</p>
            <dl><div><dt>session</dt><dd>live/8f24</dd></div><div><dt>generation</dt><dd>042</dd></div><div><dt>source revision</dt><dd>9d7b…e21</dd></div><div><dt>backend</dt><dd>hbc-wasm</dd></div></dl>
            <pre><code>{selectedExample}</code></pre>
          </article>
        </div>

        <div class="foundations-text-behaviour">
          <article><span>Wrap naturally</span><p>Package compatibility and provenance remain readable even when the title spans two or three lines.</p></article>
          <article><span>Truncate identifiers deliberately</span><code title="hara-lang/visual-language@af6273c16e9c58fa7f11e9effab0227e1658e77e">hara-lang/visual-language@af6273c…</code><p>Keep the full value available through title, copy, or detail view.</p></article>
          <article><span>Never compress body copy</span><p class="foundations-bad-density">Readable text should not become tiny telemetry merely because a panel is narrow.</p></article>
        </div>
      </section>

      <section class="foundations-section" id="geometry-rhythm">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">04 · Geometry and rhythm</p><h2>Comfortable repetition. Exact alignment.</h2></div>
          <p>Geometry follows task frequency. Common controls use calm radii and reliable dimensions; clipped corners remain rare identity accents rather than the default card shape.</p>
        </header>

        <div class="foundations-spacing-scale" aria-label="Spacing scale">
          {spacingSteps.map((step) => <div><span style={step.style}></span><code>{step.value}px</code></div>)}
        </div>

        <div class="foundations-layout-metrics">
          <article><span>Page breathing room</span><strong>clamp(16px, 2.6vw, 38px)</strong><code>--hara-v2-page</code></article>
          <article><span>Application column</span><strong>1240px</strong><code>--hara-v2-column</code></article>
          <article><span>Reading measure</span><strong>760px</strong><code>--hara-v2-prose</code></article>
          <article><span>Rail and inspector</span><strong>248px / 248px</strong><code>--hara-v2-rail-width · --hara-v2-inspector-width</code></article>
        </div>

        <div class="foundations-geometry-grid">
          <article class="foundations-geometry-card" data-geometry="common"><span>Common surface</span><div></div><code>7px radius</code><p>Panels, fields, tabs, cards, and repeated controls.</p></article>
          <article class="foundations-geometry-card" data-geometry="large"><span>Large calm surface</span><div></div><code>12px radius</code><p>Workbench frames, major previews, and large composed examples.</p></article>
          <article class="foundations-geometry-card" data-geometry="cut"><span>Rare cut accent</span><div></div><code>4px cut</code><p>Identity or hero moments only; never every container.</p></article>
          <article class="foundations-control-rhythm"><span>Control rhythm</span><button type="button">34px regular</button><button class="is-dense" type="button">30px dense</button><div class="foundations-row-sample">38px data row</div><p>Dense mode is earned by repeated comparison, not used as the default visual tone.</p></article>
        </div>

        <article class="foundations-responsive-order">
          <header><div><p class="hara-v2-kicker">Responsive collapse</p><h3>Protect the primary task first.</h3></div><code>1120 → 820 → phone</code></header>
          <div class="foundations-responsive-diagram">
            <div data-viewport="desktop"><span>Header</span><span>Rail</span><strong>Main task</strong><span>Inspector</span></div>
            <div data-viewport="tablet"><span>Header</span><span>Rail</span><strong>Main task</strong><em>Inspector removed</em></div>
            <div data-viewport="mobile"><span>Header + drawer</span><strong>Main task</strong><em>Rail collapsed · actions stack</em></div>
          </div>
          <ol><li>Remove the inspector below 1120px.</li><li>Collapse the rail below 820px.</li><li>Preserve horizontal context navigation as a reachable scroll row.</li><li>Keep phone controls at least 34px high and preserve source order.</li></ol>
        </article>
      </section>

      <section class="foundations-section" id="imagery-motifs">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">05 · Imagery and motif language</p><h2>Technical atmosphere, never borrowed mythology.</h2></div>
          <p>Edge, Aperture, Rack, and Fleet Field create a recognisable material world through original technical imagery. They support hierarchy and mood; they never obscure text or impersonate another franchise.</p>
        </header>

        <div class="foundations-motif-grid">
          <Motif kind="edge" class="foundations-motif"><div><span>Edge</span><strong>Directional transition</strong><p>Use for arrival, movement, and a broad product proposition.</p></div></Motif>
          <Motif kind="aperture" class="foundations-motif"><div><span>Aperture</span><strong>Inspection and focus</strong><p>Use around evidence, selection, checking, or a central concept.</p></div></Motif>
          <Motif kind="rack" class="foundations-motif"><div><span>Rack</span><strong>Systems and inventory</strong><p>Use for packages, runtimes, resources, and operational composition.</p></div></Motif>
        </div>

        <div class="foundations-fleet-study">
          <div><p class="hara-v2-kicker">Fleet Field</p><h3>Original monochrome command illustration.</h3><p>The field follows the current theme through text and signal tokens. It may carry a hero or section transition, but content remains first in source and reading order.</p><dl><div><dt>Density</dt><dd>Low behind copy · medium in a dedicated art field</dd></div><div><dt>Colour</dt><dd>Current ink plus one signal</dd></div><div><dt>Motion</dt><dd>None required for meaning</dd></div></dl></div>
          <div class="foundations-fleet-frame"><FleetField title="Fleet Field motif specimen" /></div>
        </div>

        <div class="foundations-imagery-boundary">
          <article data-imagery="product"><span>Product imagery</span><strong>Explains a task or state.</strong><p>Show the package graph, editor viewport, benchmark evidence, or contributor relationship the interface is actually about.</p><div class="foundations-imagery-product-demo"><i></i><i></i><i></i><b>namespace → package → runtime</b></div></article>
          <article data-imagery="atmosphere"><span>Decorative atmosphere</span><strong>Supports a transition.</strong><p>Keep contrast quiet, avoid placing detailed linework under prose, and do not make ambient movement necessary for comprehension.</p><div class="foundations-imagery-atmosphere-demo"></div></article>
        </div>
      </section>

      <section class="foundations-section" id="motion-state">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">06 · Motion and state</p><h2>Motion confirms change. State survives without it.</h2></div>
          <p>Functional transitions settle around 190ms with the shared easing curve. Reduced motion removes animation without removing status, hierarchy, or feedback.</p>
        </header>

        <div class="foundations-state-grid" aria-label="Interface state specimens">
          <button class="foundations-state-control" data-state="default" type="button"><span>Default</span><small>Available action</small></button>
          <button class="foundations-state-control" data-state="selected" aria-pressed="true" type="button"><span>Selected</span><small>Text + marker + signal</small></button>
          <button class="foundations-state-control" data-state="pressed" type="button"><span>Pressed</span><small>Immediate tactile response</small></button>
          <button class="foundations-state-control" data-state="loading" aria-busy="true" type="button"><span>Loading</span><small><i></i> Fetching exact revision</small></button>
          <button class="foundations-state-control" data-state="success" type="button"><span>Success</span><small>✓ Receipt recorded</small></button>
          <button class="foundations-state-control" data-state="warning" type="button"><span>Warning</span><small>! Review required</small></button>
          <button class="foundations-state-control" data-state="danger" type="button"><span>Danger</span><small>× Publication blocked</small></button>
          <button class="foundations-state-control" data-state="disabled" type="button" disabled><span>Disabled</span><small>Capability unavailable</small></button>
        </div>

        <div class="foundations-motion-grid">
          <article><span>Functional motion</span><strong>190ms · cubic-bezier(.2, .8, .2, 1)</strong><p>Use for hover, focus, disclosure, selection, and state changes where continuity helps orientation.</p><div class="foundations-motion-demo"><i></i><b>Selected row</b></div></article>
          <article><span>Ambient motion</span><strong>Optional and subordinate</strong><p>Use only when it does not compete with reading, data, or repeated manipulation. Never animate geometry merely to look technical.</p><div class="foundations-ambient-demo"><i></i><i></i><i></i></div></article>
          <article><span>Reduced motion</span><strong>State remains explicit</strong><p>Animations collapse to effectively zero duration. Loading retains text and a static progress marker; focus and selection remain visible.</p><div class="foundations-reduced-demo"><span>Loading revision</span><b>•••</b></div></article>
        </div>

        <div class="foundations-accessibility-grid">
          <article><button class="foundations-focus-demo" type="button">Keyboard focus specimen</button><p>Every interactive control has a visible focus ring with sufficient offset.</p></article>
          <article><div class="foundations-noncolour-state"><i>✓</i><span><b>Verified</b><small>Green, icon, label, and receipt</small></span></div><p>State is never encoded by colour alone.</p></article>
          <article><div class="foundations-touch-target"><button type="button" aria-label="Previous item">←</button><button type="button" aria-label="Next item">→</button></div><p>Touch controls retain a minimum 34px height and accessible names.</p></article>
        </div>
      </section>

      <section class="foundations-section" id="composed-examples">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">07 · Composed examples</p><h2>Foundations under realistic load.</h2></div>
          <p>Isolated swatches are not enough. These compact studies show the same contracts supporting navigation, prose, data, code, workbench chrome, and community content.</p>
        </header>

        <div class="foundations-composition-grid">
          <article class="foundations-composition" id="composition-navigation"><header><span>Navigation</span><code>identity · current state · quiet seam</code></header><div class="foundations-mini-nav"><div><HaraMark size={24} /><b>Hara Docs</b></div><nav><a href="#composition-navigation">Guide</a><a href="#composition-navigation" aria-current="page">Reference</a><a href="#composition-navigation">Packages</a></nav><button type="button">⌕</button></div></article>
          <article class="foundations-composition" id="composition-editorial"><header><span>Editorial prose</span><code>760px measure · calm hierarchy</code></header><div class="foundations-mini-prose"><p class="hara-v2-kicker">Runtime model</p><h3>One lifecycle contract, multiple backends.</h3><p>Interpreter and HBC execution share session, generation, and source-revision fencing while preserving backend-specific observations.</p><a href={themeContract}>Read the exact contract →</a></div></article>
          <article class="foundations-composition" id="composition-data"><header><span>Dense data</span><code>38px rows · selection is not colour-only</code></header><table><thead><tr><th>Runtime</th><th>Status</th><th>Median</th></tr></thead><tbody><tr aria-selected="true"><td><i></i> HBC Wasm</td><td>selected</td><td>4.8 ms</td></tr><tr><td>Interpreter</td><td>verified</td><td>13.2 ms</td></tr><tr><td>JVM</td><td>baseline</td><td>6.1 ms</td></tr></tbody></table></article>
          <article class="foundations-composition" id="composition-code"><header><span>Code</span><code>stable dark frame · exact identifiers</code></header><pre><code>{workflowExample}</code></pre><footer><span>hara/main · af6273c</span><button type="button">Run</button></footer></article>
          <article class="foundations-composition" id="composition-workbench"><header><span>Workbench panel</span><code>v2 document around scoped tool chrome</code></header><div class="foundations-mini-workbench"><nav><button type="button" aria-pressed="true">Code</button><button type="button">Files</button><button type="button">Canvas</button></nav><main><code>supersonic-live/main.hal</code><div></div></main><aside><span>Session</span><b>live/8f24</b><span>Backend</span><b>hbc-wasm</b></aside></div></article>
          <article class="foundations-composition" id="composition-community"><header><span>Community content</span><code>paper surface · provenance first</code></header><div class="foundations-mini-story"><div class="foundations-mini-avatar">M</div><div><span>Package release · 41 min</span><h3>Schema values move into the ordinary Hara runtime</h3><p>Submitted by @mina · hara-lang/hara · exact release revision</p><footer><b>94 hot</b><a href="#composition-community">11 comments</a><a href="#composition-community">Open source</a></footer></div></div></article>
        </div>
      </section>

      <section class="foundations-section foundations-ownership" id="ownership">
        <header class="foundations-section-head">
          <div><p class="hara-v2-kicker">08 · Ownership</p><h2>Shared contract, product composition, laboratory annotation.</h2></div>
          <p>The catalogue must make it obvious which rules downstream products inherit and which presentation exists only to explain the system.</p>
        </header>

        <div class="foundations-ownership-grid">
          <article data-owner="shared"><span>Shared package contract</span><h3>Protected</h3><ul><li>Block-H identity and signal</li><li>Theme, colour, state, type, and motion tokens</li><li>Shell and component geometry</li><li>Focus, responsive, and reduced-motion behavior</li></ul><code>src/v2/* · src/astro/v2/*</code></article>
          <article data-owner="product"><span>Product-owned composition</span><h3>Flexible</h3><ul><li>Information architecture and local navigation</li><li>Real data, workflows, and product terminology</li><li>Screen composition and task prioritisation</li><li>Product-specific imagery that explains the task</li></ul><code>{productRoutePattern}</code></article>
          <article data-owner="lab"><span>Catalogue-only framing</span><h3>Not exported</h3><ul><li>Specimen labels and measurement overlays</li><li>Do/avoid comparisons</li><li>Side-by-side theme previews</li><li>Annotation grids used for review</li></ul><code>site/src/styles/v2-foundations.css</code></article>
        </div>

        <div class="foundations-closeout">
          <div><p class="hara-v2-kicker">Adoption rule</p><h3>Consume the contract. Do not copy the laboratory.</h3><p>Downstream products import `v2.css` and shared Astro components, then own their application composition. They should never copy catalogue CSS or redefine protected Hara tokens locally.</p></div>
          <div><a class="hara-v2-button hara-v2-button--primary" href={catalogueHome}>Return to catalogue</a><a class="hara-v2-button" href={v1Reference}>View the v1 historical reference</a></div>
        </div>
      </section>

