---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import WorldSpecimen from "../../../components/v2/WorldSpecimen.astro";
import LearnLanding from "../../../components/v2-learn/LearnLanding.astro";
import LearnCourse from "../../../components/v2-learn/LearnCourse.astro";
import LearnLesson from "../../../components/v2-learn/LearnLesson.astro";
import LearnPractice from "../../../components/v2-learn/LearnPractice.astro";
import LearnProject from "../../../components/v2-learn/LearnProject.astro";
import LearnProgress from "../../../components/v2-learn/LearnProgress.astro";
import LearnTeaching from "../../../components/v2-learn/LearnTeaching.astro";
import { contentContractById, contentTypeById } from "../../../lib/v2-frontmatter.mjs";
import { learnContentTypes, learnFixtureNotice } from "../../../lib/v2-learn.mjs";
import "../../../../../src/v2.css";
import "../../../../../src/v2-tool.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-lab.css";
import "../../../styles/v2-command-retune.css";
import "../../../styles/v2-calm-lab.css";
import "../../../styles/v2-learn.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/learn/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueHome = `${basePath}v2/`;
const playgroundUrl = `${basePath}v2/playground/?repo=hara-lang%2Fhara-playground&branch=main&path=samples%2Fnamespaces%2Fmain.hara&revision=9f3c2ab7&backend=interpreter`;
const worldDiscussionLab = `${basePath}v2/world/discussion/`;
const worldAroundLab = `${basePath}v2/world/around/`;
const communityStudy = `${basePath}v2/world/community/`;
const onboardingStudy = `${basePath}v2/world/onboarding/`;
const frontmatterLab = `${basePath}v2/frontmatter/`;
const toolLab = `${basePath}v2/tool/`;

const learnContract = contentContractById("learn");
const lessonType = contentTypeById("learn.lesson");
const conceptType = contentTypeById("learn.concept");
const exerciseType = contentTypeById("learn.exercise");
const projectType = contentTypeById("learn.project");
const progressType = contentTypeById("learn.progress");

const localNav = [
  { href: "#start", label: "Start" },
  { href: "#tracks", label: "Tracks" },
  { href: "#course", label: "Course" },
  { href: "#lesson", label: "Lesson" },
  { href: "#practice", label: "Practice" },
  { href: "#project", label: "Project" },
  { href: "#progress", label: "Progress" },
  { href: "#teaching", label: "Teaching" },
  { href: "#world-examples", label: "World boundary" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Detailed Hara Learn v2 application laboratory covering experience-aware arrival, curriculum graphs, lesson reading, executable practice, projects, progress, teaching metadata, and the World/Learn boundary." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 Learn application laboratory" />
    <meta property="og:description" content="Learn Hara through visible outcomes, exact curriculum revisions, executable practice, complete projects, and meaningful progress evidence." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 Learn application laboratory" />
    <meta name="twitter:description" content="Runnable lessons, curriculum, koans, projects, progress, and teaching contracts for learn.hara-lang.org." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 Learn application laboratory</title>
  </head>
  <body class="hara-v2 hara-v2-tool learn-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/learn/" label="Learn laboratory">
      <a slot="route-actions" href="#lesson">Run first lesson</a>
    </CatalogueHeader>

    <nav class="learn-local-nav" aria-label="Learn laboratory sections">
      <span>Learn</span>
      <div>{localNav.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <a href="https://github.com/hara-lang/visual-language/issues/43">Issue 43 ↗</a>
    </nav>

    <main class="learn-main">
      <aside class="learn-fixture-notice" role="note">
        <strong>{learnFixtureNotice.label}</strong>
        <span>{learnFixtureNotice.summary}</span>
        <code>{learnFixtureNotice.id} · {learnFixtureNotice.sourceRevision}</code>
      </aside>

      <div class="learn-contract-strip" aria-label="Consumed hara.learn content contracts">
        <span>{lessonType?.id}<b>@{lessonType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{conceptType?.id}<b>@{conceptType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{exerciseType?.id}<b>@{exerciseType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{projectType?.id}<b>@{projectType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{progressType?.id}<b>@{progressType?.version ?? learnContract?.schemaVersion}</b></span>
      </div>

      <LearnLanding playgroundUrl={playgroundUrl} />
      <LearnCourse />
      <LearnLesson playgroundUrl={playgroundUrl} />
      <LearnPractice />
      <LearnProject playgroundUrl={playgroundUrl} worldUrl={worldDiscussionLab} />
      <LearnProgress />
      <LearnTeaching />

      <section class="learn-section learn-world-boundary" id="world-examples" aria-labelledby="learn-world-title">
        <header class="learn-section-heading">
          <div><p class="hara-v2-kicker">World / Learn boundary</p><h2 id="learn-world-title">Discussion can surround a lesson without owning its progress.</h2></div>
          <p>World owns articles, clippings, comments, contributor identity, presence, and accountable bots. Learn owns structured explanation, exercises, projects, attempts, and curriculum state.</p>
        </header>

        <div class="learn-world-boundary-grid">
          <article><span>Learn owns</span><p>Objectives, prerequisite sequence, runnable lesson placement, practice contracts, project milestones, private notes, attempts, completion evidence, and exact curriculum revisions.</p><a href="#course">Inspect curriculum →</a></article>
          <article><span>World owns</span><p>Public discussion, canonical source links, comments, participants, clippings, package release conversation, and Snippet of the day as a social object.</p><a href={worldDiscussionLab}>Open focused World →</a></article>
          <article><span>Shared identity, separate navigation</span><p>The same Hara or GitHub identity may connect both products. Learn progress never becomes a World profile score and World popularity never unlocks a lesson.</p><a href={worldAroundLab}>Open Around Hara →</a></article>
        </div>

        <div class="learn-world-examples">
          <a href={onboardingStudy}><small>Programmer onboarding</small><strong>Earlier executable-feed study</strong><span>Retained as a Learn teaching comparison →</span></a>
          <a href={communityStudy}><small>Earlier community reader</small><strong>Historical World interface study</strong><span>Open community study →</span></a>
          <a href={worldDiscussionLab}><small>Active product</small><strong>Focused World discussion</strong><span>Read articles, clippings, comments, profiles, and presence →</span></a>
          <a href={worldAroundLab}><small>Open web</small><strong>Around Hara</strong><span>Inspect provenance, ranking, moderation, and relay receipts →</span></a>
        </div>
      </section>

      <WorldSpecimen />

      <section class="learn-section learn-adoption" id="adoption" aria-labelledby="learn-adoption-title">
        <header class="learn-section-heading">
          <div><p class="hara-v2-kicker">Ownership and downstream adoption</p><h2 id="learn-adoption-title">Visual Language composes. Learn, registries, and runtimes remain authoritative.</h2></div>
          <p>The future `learn.hara-lang.org` implementation can adopt these surfaces without copying another product’s navigation or turning the catalogue into a production learner database.</p>
        </header>
        <div class="learn-adoption-grid">
          <article><span>Shared visual-language package</span><p>Shell geometry, typography, state, form, workbench, focus, responsive, and receipt presentation.</p></article>
          <article><span>Learn application</span><p>Experience entrances, curriculum browsing, lesson composition, practice commands, project milestones, notes, privacy, and teaching workflows.</p></article>
          <article><span>Curriculum and progress registries</span><p>Content identities, concept graph, revisions, attempts, completion evidence, migration relations, and account-scoped progress.</p></article>
          <article><span>Playground and runtimes</span><p>Sessions, source fences, backends, capabilities, observations, checks, execution receipts, and exact share links.</p></article>
          <article><span>World</span><p>Public discussion, clippings, comments, contributors, presence, and social discovery around learning material.</p></article>
        </div>
        <p>Review the <a href={frontmatterLab}>front-matter contract</a>, <a href={toolLab}>shared workbenches</a>, <a href={playgroundUrl}>exact Playground handoff</a>, and <code>V2-LEARN.md</code> before downstream adoption. The fixture exposes {learnContentTypes.length} hara.learn content types and does not contain production learner data.</p>
      </section>

      <footer class="v2-lab-footer learn-footer">
        <span>Detailed Learn application laboratory · Hara visual language v2</span>
        <span><a href={catalogueHome}>V2 catalogue</a> · <a href={worldDiscussionLab}>World</a> · <a href={playgroundUrl}>Playground</a> · <a href="https://github.com/hara-lang/visual-language/issues/43">Issue 43</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>

    <script>
      import { initialiseLearn } from "../../../scripts/v2-learn.js";
      initialiseLearn();
    </script>
  </body>
</html>
