---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import WorldSpecimen from "../../../components/v2/WorldSpecimen.astro";
import LearnLanding from "../../../components/v2-learn/LearnLanding.astro";
import LearnCourse from "../../../components/v2-learn/LearnCourse.astro";
import LearnLesson from "../../../components/v2-learn/LearnLesson.astro";
import LearnPractice from "../../../components/v2-learn/LearnPractice.astro";
import LearnProject from "../../../components/v2-learn/LearnProject.astro";
import LearnProgress from "../../../components/v2-learn/LearnProgress.astro";
import LearnTeaching from "../../../components/v2-learn/LearnTeaching.astro";
import { contentContractById, contentTypeById } from "../../../lib/v2-frontmatter.mjs";
import { learnContentTypes, learnFixtureNotice } from "../../../lib/v2-learn.mjs";
import "../../../../../src/v2.css";
import "../../../../../src/v2-tool.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-lab.css";
import "../../../styles/v2-command-retune.css";
import "../../../styles/v2-calm-lab.css";
import "../../../styles/v2-learn.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/learn/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueHome = `${basePath}v2/`;
const playgroundUrl = `${basePath}v2/playground/?repo=hara-lang%2Fhara-playground&branch=main&path=samples%2Fnamespaces%2Fmain.hara&revision=9f3c2ab7&backend=interpreter`;
const worldDiscussionLab = `${basePath}v2/world/discussion/`;
const worldAroundLab = `${basePath}v2/world/around/`;
const communityStudy = `${basePath}v2/world/community/`;
const onboardingStudy = `${basePath}v2/world/onboarding/`;
const frontmatterLab = `${basePath}v2/frontmatter/`;
const toolLab = `${basePath}v2/tool/`;

const learnContract = contentContractById("learn");
const lessonType = contentTypeById("learn.lesson");
const conceptType = contentTypeById("learn.concept");
const exerciseType = contentTypeById("learn.exercise");
const projectType = contentTypeById("learn.project");
const progressType = contentTypeById("learn.progress");

const localNav = [
  { href: "#start", label: "Start" },
  { href: "#tracks", label: "Tracks" },
  { href: "#course", label: "Course" },
  { href: "#lesson", label: "Lesson" },
  { href: "#practice", label: "Practice" },
  { href: "#project", label: "Project" },
  { href: "#progress", label: "Progress" },
  { href: "#teaching", label: "Teaching" },
  { href: "#world-examples", label: "World boundary" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Introductory Hara material covering forms, values, functions, namespaces, capabilities, runnable exercises, projects, progress records, and teaching metadata." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Learn the Hara programming language" />
    <meta property="og:description" content="Read and run a first Hara form, then continue through functions, namespaces, capabilities, packages, exercises, and projects." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Learn the Hara programming language" />
    <meta name="twitter:description" content="Lessons, exercises, projects, curriculum revisions, and explicit runtime states for learning Hara." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Learn the Hara programming language</title>
  </head>
  <body class="hara-v2 hara-v2-tool learn-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/learn/" label="Learn Hara">
      <a slot="route-actions" href="#lesson">Run the first form</a>
    </CatalogueHeader>

    <nav class="learn-local-nav" aria-label="Learn sections">
      <span>Learn</span>
      <div>{localNav.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <a href="https://github.com/hara-lang/visual-language/issues/43">Implementation record ↗</a>
    </nav>

    <main class="learn-main">
      <aside class="learn-fixture-notice" role="note">
        <strong>{learnFixtureNotice.label}</strong>
        <span>{learnFixtureNotice.summary}</span>
        <code>{learnFixtureNotice.id} · {learnFixtureNotice.sourceRevision}</code>
      </aside>

      <div class="learn-contract-strip" aria-label="Consumed hara.learn content contracts">
        <span>{lessonType?.id}<b>@{lessonType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{conceptType?.id}<b>@{conceptType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{exerciseType?.id}<b>@{exerciseType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{projectType?.id}<b>@{projectType?.version ?? learnContract?.schemaVersion}</b></span>
        <span>{progressType?.id}<b>@{progressType?.version ?? learnContract?.schemaVersion}</b></span>
      </div>

      <LearnLanding playgroundUrl={playgroundUrl} />
      <LearnCourse />
      <LearnLesson playgroundUrl={playgroundUrl} />
      <LearnPractice />
      <LearnProject playgroundUrl={playgroundUrl} worldUrl={worldDiscussionLab} />
      <LearnProgress />
      <LearnTeaching />

      <section class="learn-section learn-world-boundary" id="world-examples" aria-labelledby="learn-world-title">
        <header class="learn-section-heading">
          <div><p class="hara-v2-kicker">World and Learn</p><h2 id="learn-world-title">Lessons and public discussion keep separate records.</h2></div>
          <p>World records articles, clippings, comments, contributor identity, presence, and owner-attributed bots. Learn records explanations, exercises, projects, attempts, and curriculum state.</p>
        </header>

        <div class="learn-world-boundary-grid">
          <article><span>Learn records</span><p>Objectives, prerequisite sequence, runnable lesson placement, practice contracts, project milestones, private notes, attempts, completion evidence, and exact curriculum revisions.</p><a href="#course">View the curriculum →</a></article>
          <article><span>World records</span><p>Public discussion, canonical source links, comments, participants, clippings, package-release discussion, and shared code examples.</p><a href={worldDiscussionLab}>Read World discussion →</a></article>
          <article><span>Shared identity, separate navigation</span><p>The same Hara or GitHub identity may appear in both routes. Learn progress does not become a public profile score, and World activity does not unlock a lesson.</p><a href={worldAroundLab}>View Around Hara references →</a></article>
        </div>

        <div class="learn-world-examples">
          <a href={onboardingStudy}><small>Historical onboarding study</small><strong>Earlier executable-feed example</strong><span>Read the retained teaching comparison →</span></a>
          <a href={communityStudy}><small>Historical community study</small><strong>Earlier World interface example</strong><span>Open the retained study →</span></a>
          <a href={worldDiscussionLab}><small>Implemented route</small><strong>World discussion</strong><span>Read articles, clippings, comments, profiles, and presence →</span></a>
          <a href={worldAroundLab}><small>External references</small><strong>Around Hara</strong><span>Inspect provenance, moderation, and relay records →</span></a>
        </div>
      </section>

      <WorldSpecimen />

      <section class="learn-section learn-adoption" id="adoption" aria-labelledby="learn-adoption-title">
        <header class="learn-section-heading">
          <div><p class="hara-v2-kicker">Ownership and adoption</p><h2 id="learn-adoption-title">The interface reference does not own curriculum or learner data.</h2></div>
          <p>A future `learn.hara-lang.org` implementation may use these interface specimens while keeping curriculum, progress, runtime, and identity records in their authoritative systems.</p>
        </header>
        <div class="learn-adoption-grid">
          <article><span>Visual Language</span><p>Shell geometry, typography, state, form, workbench, focus, responsive, and receipt presentation.</p></article>
          <article><span>Learn application</span><p>Experience entrances, curriculum browsing, lesson composition, practice commands, project milestones, notes, privacy, and teaching workflows.</p></article>
          <article><span>Curriculum and progress registries</span><p>Content identities, concept graph, revisions, attempts, completion evidence, migration relations, and account-scoped progress.</p></article>
          <article><span>Playground and runtimes</span><p>Sessions, source fences, backends, capabilities, observations, checks, execution receipts, and exact share links.</p></article>
          <article><span>World</span><p>Public discussion, clippings, comments, contributors, presence, and references around learning material.</p></article>
        </div>
        <p>Review the <a href={frontmatterLab}>front-matter contract</a>, <a href={toolLab}>workbench reference</a>, <a href={playgroundUrl}>exact Playground handoff</a>, and <code>V2-LEARN.md</code> before adoption. This fixture contains {learnContentTypes.length} hara.learn content types and no production learner data.</p>
      </section>

      <footer class="v2-lab-footer learn-footer">
        <span>Hara learning reference · Visual language v2</span>
        <span><a href={catalogueHome}>V2 reference</a> · <a href={worldDiscussionLab}>World</a> · <a href={playgroundUrl}>Playground</a> · <a href="https://github.com/hara-lang/visual-language/issues/43">Implementation record</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>

    <script>
      import { initialiseLearn } from "../../../scripts/v2-learn.js";
      initialiseLearn();
    </script>
  </body>
</html>
