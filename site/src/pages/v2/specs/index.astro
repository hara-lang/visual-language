---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import SpecsRegistry from "../../../components/v2-specs/SpecsRegistry.astro";
import SpecsChecker from "../../../components/v2-specs/SpecsChecker.astro";
import SpecsProposal from "../../../components/v2-specs/SpecsProposal.astro";
import { contentContractById, contentTypeById } from "../../../lib/v2-frontmatter.mjs";
import {
  conformanceForSpecification,
  specificationById,
  specifications,
  specsFixtureNotice
} from "../../../lib/v2-specs.mjs";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-lab.css";
import "../../../styles/v2-calm-lab.css";
import "../../../styles/v2-specs.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/specs/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueUrl = `${basePath}v2/`;
const frontmatterUrl = `${basePath}v2/frontmatter/`;
const componentsUrl = `${basePath}v2/components/`;
const uiUrl = `${basePath}v2/ui/`;

const specsContract = contentContractById("specs");
const proposalType = contentTypeById("specs.proposal");
const versionType = contentTypeById("specs.version");
const conformanceType = contentTypeById("specs.conformance");
const receiptType = contentTypeById("specs.publication-receipt");
const selected = specificationById("HSP-0008");
const selectedConformance = conformanceForSpecification("runtime.session@1.2.0");

const localNav = [
  { href: "#registry", label: "Registry" },
  { href: "#detail", label: "Specification" },
  { href: "#checker", label: "Checker" },
  { href: "#proposal", label: "Proposal" },
  { href: "#digest", label: "Changes" },
  { href: "#adoption", label: "Ownership" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara specifications reference covering identifiers, versions, normative requirements, explanatory notes, source revisions, conformance results, proposals, publication records, and supersession." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara specifications" />
    <meta property="og:description" content="Versioned statements of required Hara language and interface behaviour, with source revisions, conformance results, proposals, and publication records." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara specifications" />
    <meta name="twitter:description" content="Read exact specification revisions, inspect normative requirements, check inputs, and review conformance and change history." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara specifications</title>
  </head>
  <body class="hara-v2 specs-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/specs/" label="Specifications">
      <a slot="route-actions" href="#proposal">Review proposal fields</a>
    </CatalogueHeader>

    <nav class="specs-local-nav" aria-label="Specification sections">
      <span>Specifications</span>
      <div>{localNav.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <a href="https://github.com/hara-lang/visual-language/issues/40">Implementation record ↗</a>
    </nav>

    <main class="specs-main">
      <aside class="specs-fixture-notice" role="note">
        <strong>{specsFixtureNotice.label}</strong>
        <span>{specsFixtureNotice.summary}</span>
        <code>{specsFixtureNotice.id} · {specsFixtureNotice.sourceRevision}</code>
      </aside>

      <section class="specs-hero" aria-labelledby="specs-title">
        <div class="specs-hero-copy">
          <p class="hara-v2-kicker">Versioned required behaviour</p>
          <h1 id="specs-title">A specification states what an implementation must, should, or may do.</h1>
          <p>The registry records a specification identifier, semantic version, exact source revision, status, authority, normative requirements, explanatory notes, related implementations, conformance results, and publication receipt. It complements documentation; it is not a replacement for it.</p>
          <div class="specs-hero-actions">
            <a class="specs-primary-link" href="#registry">View the registry</a>
            <a href="#checker">Check an exact input</a>
            <a href="#proposal">Read the proposal workflow</a>
          </div>
          <div class="specs-contract-strip" aria-label="Consumed hara.specs content contracts">
            <span>{proposalType?.id}<b>@{proposalType?.version ?? specsContract?.schemaVersion}</b></span>
            <span>{versionType?.id}<b>@{versionType?.version ?? specsContract?.schemaVersion}</b></span>
            <span>{conformanceType?.id}<b>@{conformanceType?.version ?? specsContract?.schemaVersion}</b></span>
            <span>{receiptType?.id}<b>@{receiptType?.version ?? specsContract?.schemaVersion}</b></span>
          </div>
        </div>

        <aside class="specs-hero-ledger" aria-label="Selected specification authority record">
          <header><span>Registry record</span><span class="specs-state" data-tone="success">Accepted</span></header>
          <div>
            <p class="specs-mono">{selected?.id}</p>
            <h2>{selected?.identifier}</h2>
            <p>{selected?.title}</p>
            <dl>
              <div><dt>Version</dt><dd class="specs-mono">{selected?.version}</dd></div>
              <div><dt>Exact revision</dt><dd class="specs-mono">{selected?.revision}</dd></div>
              <div><dt>Machine identity</dt><dd class="specs-mono">{selected?.machineContract}</dd></div>
              <div><dt>Publication receipt</dt><dd class="specs-mono">{selected?.receipt}</dd></div>
            </dl>
          </div>
          <footer><span>{specifications.length} fixture specifications</span><span>{selectedConformance.length} selected claims</span></footer>
        </aside>
      </section>

      <SpecsRegistry />

      <section class="specs-section" id="detail" aria-labelledby="specs-detail-title">
        <header class="specs-section-heading">
          <div>
            <p class="hara-v2-kicker">Specification document</p>
            <h2 id="specs-detail-title">Normative requirements and explanatory material remain distinct.</h2>
          </div>
          <p>The reader retains access to the outline, status, version, source revision, supersession chain, machine representation, related implementations, and conformance records.</p>
        </header>

        <article class="specs-detail-shell">
          <aside class="specs-detail-outline" aria-label="Specification outline">
            <header><span>{selected?.id}</span><strong>Outline</strong></header>
            <nav>
              <a href="#detail-overview" aria-current="page">Overview</a>
              {selected?.normativeSections.map((section, index) => <a href={`#normative-${index + 1}`}>{index + 1}. {section}</a>)}
              {selected?.explanatorySections.map((section, index) => <a href={`#explanatory-${index + 1}`}>E{index + 1}. {section}</a>)}
              <a href="#detail-conformance">Conformance</a>
              <a href="#detail-history">History</a>
            </nav>
          </aside>

          <div class="specs-detail-document" id="detail-overview">
            <header class="specs-detail-header">
              <div>
                <p class="specs-mono">{selected?.id} · {selected?.identifier}@{selected?.version}</p>
                <h3>{selected?.title}</h3>
                <p>{selected?.summary}</p>
              </div>
              <div>
                <span class="specs-state" data-tone="success">{selected?.status}</span>
                <button type="button" data-copy-value={selected?.machineContract}>Copy machine ID</button>
                <button type="button">Download representation</button>
              </div>
            </header>

            <section class="specs-authority-bar" aria-label="Specification authority facts">
              <div><span>Version</span><strong class="specs-mono">{selected?.version}</strong></div>
              <div><span>Revision</span><strong class="specs-mono">{selected?.revision}</strong></div>
              <div><span>Updated</span><strong>{selected?.updatedAt}</strong></div>
              <div><span>Source</span><strong>{selected?.canonicalSource}</strong></div>
            </section>

            <section class="specs-normative-block" id="normative-1">
              <header><span>Normative</span><strong>Requirements</strong></header>
              <p>The following statements are compatibility requirements. “Must”, “should”, and “may” express their defined normative levels.</p>
              <ol>
                {selected?.requirements.map((requirement) => (
                  <li id={requirement.id.toLowerCase()}>
                    <span class="specs-state" data-tone={requirement.level === "must" ? "error" : requirement.level === "should" ? "warning" : "signal"}>{requirement.level}</span>
                    <strong>{requirement.id}</strong>
                    <p>{requirement.text}</p>
                  </li>
                ))}
              </ol>
            </section>

            <section class="specs-grammar-block" id="normative-2">
              <header><span>Normative grammar</span><button type="button" data-copy-value={selected?.grammar}>Copy</button></header>
              <pre><code>{selected?.grammar}</code></pre>
            </section>

            <section class="specs-explanatory-block" id="explanatory-1">
              <header><span>Explanatory</span><strong>Why the envelope is shared</strong></header>
              <p>Browser, interpreter, compiled, and embedded implementations may expose different observations. They still require one lifecycle vocabulary so replacement, cancellation, backend availability, and receipt evidence have consistent meanings across hosts.</p>
              <aside><strong>Non-normative note.</strong> An application may simplify its visible controls, but it cannot rewrite the backend, capability, revision, or lifecycle facts returned by the runtime.</aside>
            </section>

            <section class="specs-related-grid" id="detail-conformance">
              <article><span>Packages</span><div>{selected?.packages.map((item) => <code>{item}</code>)}</div></article>
              <article><span>Namespaces</span><div>{selected?.namespaces.map((item) => <code>{item}</code>)}</div></article>
              <article><span>Implementations</span><div>{selected?.implementations.map((item) => <code>{item}</code>)}</div></article>
              <article><span>Tests</span><div>{selected?.tests.map((item) => <code>{item}</code>)}</div></article>
            </section>

            <section class="specs-version-history" id="detail-history">
              <header><span>Version and supersession chain</span><strong>Persistent identities</strong></header>
              <ol>
                <li data-state="accepted"><span>1.2.0</span><strong>Current accepted version</strong><code>7107147d</code></li>
                <li data-state="superseded"><span>1.1.0</span><strong>Superseded by 1.2.0</strong><code>53c31d8e</code></li>
                <li data-state="superseded"><span>1.0.0</span><strong>First accepted lifecycle envelope</strong><code>4ac7e09c</code></li>
              </ol>
            </section>
          </div>

          <aside class="specs-detail-inspector" aria-label="Specification relationships">
            <section><span>Machine representation</span><code>{selected?.machineContract}</code><button type="button">Open JSON</button><button type="button">Open Hara form</button></section>
            <section><span>Conformance</span>{selectedConformance.map((claim) => <article data-state={claim.state}><strong>{claim.implementation}</strong><small>{claim.passed}/{claim.total} · {claim.revision}</small></article>)}</section>
            <section><span>Related</span><a href="#checker">Check an input</a><a href="#proposal">Read proposal workflow</a><a href="#digest">Read change digest</a></section>
          </aside>
        </article>
      </section>

      <SpecsChecker />
      <SpecsProposal />

      <section class="specs-section specs-adoption" id="adoption" aria-labelledby="specs-adoption-title">
        <header class="specs-section-heading">
          <div>
            <p class="hara-v2-kicker">Ownership and adoption</p>
            <h2 id="specs-adoption-title">Visual Language presents specifications; hara-specs owns their authority.</h2>
          </div>
          <p>An implementation may use these compositions without moving canonical source, version history, proposal review, or conformance records into this repository.</p>
        </header>
        <div class="specs-adoption-grid">
          <article><span>Visual Language</span><p>Table, form, inspector, status, navigation, focus, responsive, and receipt presentation contracts.</p></article>
          <article><span>Specifications application</span><p>Registry search, checker transport, proposal entry, review queue, change subscriptions, and route-local information architecture.</p></article>
          <article><span>hara-specs repository</span><p>Canonical source, identifiers, versions, normative text, Git history, review decisions, supersession, and machine representations.</p></article>
          <article><span>Runtime and conformance systems</span><p>Checker implementations, exact result receipts, implementation revisions, test vectors, and supported-target claims.</p></article>
        </div>
        <div class="specs-adoption-checklist">
          <h3>Adoption checklist</h3>
          <ol>
            <li>Pin a merged Visual Language revision rather than an unmerged branch.</li>
            <li>Resolve every registry card to an exact specification version and revision.</li>
            <li>Keep normative and explanatory regions semantically and visually distinct.</li>
            <li>Never convert checker unavailable into pass, warning, or failure.</li>
            <li>Preserve GitHub as canonical proposal and review history.</li>
            <li>Verify keyboard, touch, reduced-motion, light/dark, and narrow-width behaviour.</li>
          </ol>
        </div>
        <p>Review the <a href={frontmatterUrl}>front-matter contract</a>, <a href={componentsUrl}>component reference</a>, <a href={uiUrl}>interaction-state reference</a>, and <code>V2-SPECS.md</code> before adoption into <code>hara-lang/hara-specs</code>.</p>
      </section>

      <footer class="v2-lab-footer specs-footer">
        <span>Hara specifications reference · Visual language v2</span>
        <span><a href={catalogueUrl}>V2 reference</a> · <a href="https://github.com/hara-lang/visual-language/issues/40">Implementation record</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>

    <script>
      import { initialiseSpecs } from "../../../scripts/v2-specs.js";
      initialiseSpecs();
    </script>
  </body>
</html>
