---
import FleetField from "../../../../../src/astro/v2/FleetField.astro";
import LiveHaraExample from "../../../components/v2-www/LiveHaraExample.astro";
import StateSpecimen from "../../../components/v2-www/StateSpecimen.astro";
import ViewportSpecimen from "../../../components/v2-www/ViewportSpecimen.astro";
import WwwFamilyHeader from "../../../components/v2-www/WwwFamilyHeader.astro";
import WwwSubnav from "../../../components/v2-www/WwwSubnav.astro";
import {
  adoptionNotes,
  capabilitySections,
  ecosystemMap,
  gettingStartedChoices,
  handoffs,
  homeNarrative,
  homeProofLedger,
  homeSectionNavigation,
  projectProof,
  releaseSummary,
  sharedOwnership,
  withBasePath,
  wwwContracts
} from "../../../lib/v2-www.mjs";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-www.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/www/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const docsHref = withBasePath(basePath, "/v2/www/docs/");
const benchmarksHref = withBasePath(basePath, "/v2/www/benchmarks/");
const source = `;; static source is readable before a runtime attaches
(defn describe [system]
  {:language :hara
   :runtime  (runtime/name system)
   :portable (runtime/capability? system :portable-forms)
   :result   (map inc [1 2 3])})

(describe *session*)`;
const expectedOutput = `{:language :hara
 :runtime :wasm
 :portable true
 :result [2 3 4]}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A technical overview of the Hara programming language: readable forms, explicit runtimes, namespaces, libraries, interop, source records, documentation, and benchmark methods." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara" />
    <meta property="og:title" content="Hara programming language overview" />
    <meta property="og:description" content={homeNarrative.summary} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara programming language overview" />
    <meta name="twitter:description" content={homeNarrative.summary} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara programming language overview</title>
  </head>
  <body class="hara-v2 www-family-page www-home-page">
    <WwwFamilyHeader basePath={basePath} activeRoute="home" />
    <WwwSubnav label="Overview" items={homeSectionNavigation} activeId="first-example">
      <span slot="identity">{homeNarrative.schema} · {homeNarrative.schemaVersion}</span>
      <a class="hara-v2-button" href={docsHref}>Read documentation</a>
      <a class="hara-v2-button" data-variant="primary" href="#first-example">Run the first form</a>
    </WwwSubnav>

    <main class="www-main">
      <section class="www-hero" aria-labelledby="www-home-title">
        <div class="www-hero__copy">
          <p class="hara-v2-kicker">{homeNarrative.eyebrow}</p>
          <h1 id="www-home-title">{homeNarrative.title}</h1>
          <p class="www-hero__summary">{homeNarrative.summary}</p>
          <div class="www-hero__actions">
            <a class="hara-v2-button" data-variant="primary" href="#first-example">Read and run a form <span aria-hidden="true">→</span></a>
            <a class="hara-v2-button" href={benchmarksHref}>Compare benchmark results</a>
            <a class="hara-v2-button" data-variant="ghost" href="#capabilities">Read the language model</a>
          </div>
          <div class="www-contract-line" aria-label="Content contract">
            <span>{homeNarrative.contentType}</span>
            <code>{homeNarrative.revision}</code>
            <span>{homeNarrative.proofRefs.length} reference records</span>
          </div>
        </div>
        <div class="www-hero__field" aria-label="Hara runtime and package field">
          <FleetField title="Hara runtime and package reference" />
          <div class="www-hero-orbit" data-orbit="forms"><b>forms</b><small>readable code and data</small></div>
          <div class="www-hero-orbit" data-orbit="runtime"><b>runtime</b><small>explicit evaluation host</small></div>
          <div class="www-hero-orbit" data-orbit="proof"><b>records</b><small>revision and method</small></div>
          <div class="www-hero-orbit" data-orbit="package"><b>packages</b><small>versioned namespaces</small></div>
        </div>
      </section>

      <section class="www-proof-ledger" aria-label="Language and runtime summary">
        {homeProofLedger.map((proof) => (
          <article>
            <span>{proof.label}</span>
            <strong>{proof.value}</strong>
            <p>{proof.detail}</p>
          </article>
        ))}
      </section>

      <section class="www-section" id="first-example">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">01 · First form</p>
            <h2>Read the source, note the runtime boundary, then evaluate it.</h2>
          </div>
          <p>
            The form remains readable documentation before a runtime is attached. Evaluation is a separate state with a named backend, session, capabilities, source revision, and expected result.
          </p>
        </header>

        <div class="www-three-part-argument" aria-label="First example reading order">
          <article data-kind="explanation"><span>Definition</span><h3>A form represents code or data</h3><p>The source can be read, copied, transformed, or checked without executing it.</p></article>
          <article data-kind="proof"><span>Runtime</span><h3>Evaluation has an explicit host</h3><p>The example identifies its Wasm session and denies network and filesystem access.</p></article>
          <article data-kind="action"><span>Result</span><h3>Input and output remain beside each other</h3><p>Run the bounded example or open the exact revision in the Playground.</p></article>
        </div>

        <LiveHaraExample
          id="home-first-example"
          label="First form · browser Wasm example"
          file="first-system.hal"
          source={source}
          expectedOutput={expectedOutput}
          state="ready"
          runtime="Wasm · isolated"
          session="www-first-01"
          generation={1}
          capabilities={["pure", "portable-forms", "network:none", "filesystem:none"]}
          revision="hara@9b6c10e + wasm@7ae1"
          openHref={withBasePath(basePath, "/v2/start/")}
          exactRevisionHref="#home-adoption"
          controlPane={false}
        />
      </section>

      <section class="www-section" id="capabilities">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">02 · Language and runtime model</p>
            <h2>Four boundaries organise the introductory reference.</h2>
          </div>
          <p>Forms, libraries and tools, runtime sessions, and host interop are described as concrete language or system contracts. Each section points to the corresponding source, package, specification, or runtime record.</p>
        </header>

        <div class="www-capability-stack">
          {capabilitySections.map((capability) => (
            <article id={`capability-${capability.id}`}>
              <header><span>{capability.number}</span><div><p class="hara-v2-kicker">{capability.id}</p><h3>{capability.title}</h3></div></header>
              <div class="www-capability-stack__body">
                <p>{capability.summary}</p>
                <ul>{capability.items.map((item) => <li>{item}</li>)}</ul>
              </div>
              <footer><span>Reference record</span><p>{capability.proof}</p></footer>
            </article>
          ))}
        </div>
      </section>

      <section class="www-section" id="proof">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">03 · Projects and records</p>
            <h2>Language concepts connect to maintained packages and source.</h2>
          </div>
          <p>The map identifies the main parts of Hara. The project records then name concrete packages, repositories, specifications, and revisions rather than using an undifferentiated list of features.</p>
        </header>

        <div class="www-ecosystem-map" aria-label="Hara language and ecosystem map">
          {ecosystemMap.map((entry, index) => (
            <article data-map-node={entry.id}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p class="hara-v2-kicker">{entry.label}</p>
              <h3>{entry.title}</h3>
              <p>{entry.summary}</p>
            </article>
          ))}
        </div>

        <div class="www-project-grid">
          {projectProof.map((project) => (
            <article>
              <header><code>{project.package}</code><span>{project.project}</span></header>
              <p>{project.summary}</p>
              <footer><span>Reference</span><strong>{project.evidence}</strong><a href={`#project-${project.id}`}>View project record →</a></footer>
            </article>
          ))}
        </div>
      </section>

      <section class="www-section" id="changes">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">04 · Recent changes</p>
            <h2>Each change names its scope, effect, and revision.</h2>
          </div>
          <p>This summary links language, runtime, content, migration, and compatibility questions to their detailed records in Docs and Packages.</p>
        </header>

        <div class="www-release-list">
          {releaseSummary.map((release) => (
            <article>
              <time>{release.date}</time>
              <span class="hara-v2-badge">{release.kind}</span>
              <div><h3>{release.title}</h3><p>{release.impact}</p></div>
              <code>{release.revision}</code>
            </article>
          ))}
        </div>

        <div class="www-handoff-grid">
          {handoffs.map((handoff) => (
            <article data-handoff={handoff.id}>
              <p class="hara-v2-kicker">{handoff.label}</p>
              <h3>{handoff.title}</h3>
              <p>{handoff.summary}</p>
              <a class="hara-v2-button" href={withBasePath(basePath, handoff.href)}>{handoff.action}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="www-section" id="start">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">05 · Run or install</p>
            <h2>Choose a browser, local, or repository-guided path.</h2>
          </div>
          <p>The three paths are alternatives. Each states its runtime assumptions and the source or verification record to inspect before continuing.</p>
        </header>

        <div class="www-start-grid">
          {gettingStartedChoices.map((choice, index) => (
            <article data-start={choice.id}>
              <header><span>{String(index + 1).padStart(2, "0")}</span><p class="hara-v2-kicker">{choice.label}</p></header>
              <h3>{choice.title}</h3>
              <p>{choice.summary}</p>
              <pre><code>{choice.command}</code></pre>
              <a href={choice.id === "browser" ? "#first-example" : choice.id === "agent" ? withBasePath(basePath, "/v2/start/") : docsHref}>Open this path →</a>
            </article>
          ))}
        </div>
      </section>

      <section class="www-section" id="states">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">06 · First arrival and unavailable states</p>
            <h2>Static language material remains readable without the runtime.</h2>
          </div>
          <p>Source and explanation remain available during runtime failure, constrained bandwidth, small-screen use, or anonymous reading. Disabled actions state why they are unavailable.</p>
        </header>

        <div class="www-state-grid">
          <StateSpecimen
            id="demo-unavailable"
            tone="warning"
            eyebrow="Live example unavailable"
            title="The Wasm runtime could not attach"
            summary="The source, capability contract, expected result, and exact revision remain visible. Run is disabled and retry is bounded."
            details={["Static documentation retained", "Open-in-Playground remains revision-pinned", "No inferred result"]}
            actionLabel="Read the static example"
            actionHref="#first-example"
          />
          <StateSpecimen
            id="low-bandwidth"
            tone="notice"
            eyebrow="Low-bandwidth request"
            title="Text and records load before runtime assets"
            summary="The header field becomes a quiet placeholder, executable code remains plain text, and large runtime payloads wait for a deliberate action."
            details={["Core HTML first", "No autoplay shader", "Runtime download is opt-in"]}
            actionLabel="Read the loading contract"
            actionHref="#responsive-home"
          />
          <StateSpecimen
            id="anonymous-arrival"
            tone="success"
            eyebrow="Anonymous reader"
            title="Reading and local execution do not require an account"
            summary="Sign-in is used for saved sessions, progress, subscriptions, and publication; it is not required for the language overview."
            details={["Search available", "Examples available", "Receipts remain local until saved"]}
            actionLabel="Choose a run or install path"
            actionHref="#start"
          />
        </div>
      </section>

      <section class="www-section" id="responsive-home">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">07 · Desktop, tablet, and mobile specimens</p>
            <h2>The reading order remains stable as the layout changes.</h2>
          </div>
          <p>These specimens record navigation reduction, source and revision visibility, and the point at which executable controls move into a deliberate drawer.</p>
        </header>

        <div class="www-viewport-grid">
          <ViewportSpecimen viewport="desktop" label="Desktop" width="1440" note="Definition, form, and reference records remain adjacent">
            <div class="www-mini-home" data-size="wide"><span>Hara</span><h3>Readable forms and explicit runtimes.</h3><div><b>Define</b><b>Run</b><b>Reference</b></div><small>Four language-model sections follow</small></div>
          </ViewportSpecimen>
          <ViewportSpecimen viewport="tablet" label="Tablet" width="900" note="Family routes remain; records become two columns">
            <div class="www-mini-home" data-size="medium"><span>Hara / Overview</span><h3>Readable forms and explicit runtimes.</h3><div><b>Define</b><b>Run</b></div><small>References remain next in reading order</small></div>
          </ViewportSpecimen>
          <ViewportSpecimen viewport="mobile" label="Mobile" width="390" note="Text first; runtime opt-in">
            <div class="www-mini-home" data-size="narrow"><span>Hara</span><h3>Readable forms and explicit runtimes.</h3><b>Run first form</b><small>Runtime and revision remain directly below</small></div>
          </ViewportSpecimen>
        </div>
      </section>

      <section class="www-section www-adoption" id="home-adoption">
        <header class="www-section-head">
          <div>
            <p class="hara-v2-kicker">08 · Ownership and adoption</p>
            <h2>The reference separates shared presentation from authoritative data.</h2>
          </div>
          <p>This route is an interface specimen. A public Hara site replaces fixture data and providers while preserving the readable order, explicit runtime state, and source and evidence links.</p>
        </header>

        <div class="www-ownership-table" role="table" aria-label="WWW ownership boundaries">
          <div class="www-ownership-row www-ownership-row--head" role="row"><span role="columnheader">Layer</span><span role="columnheader">Owns</span><span role="columnheader">Source</span></div>
          {sharedOwnership.map((entry) => (
            <div class="www-ownership-row" role="row"><strong role="cell">{entry.layer}</strong><span role="cell">{entry.owns}</span><code role="cell">{entry.source}</code></div>
          ))}
        </div>

        <div class="www-adoption-grid">
          {adoptionNotes.map((note) => (
            <article>
              <header><p class="hara-v2-kicker">Downstream implementation</p><h3>{note.product}</h3></header>
              <dl>
                <div><dt>Consume</dt><dd>{note.consume.join(" · ")}</dd></div>
                <div><dt>Replace</dt><dd>{note.replace.join(" · ")}</dd></div>
                <div><dt>Preserve</dt><dd>{note.preserve}</dd></div>
              </dl>
            </article>
          ))}
        </div>

        <aside class="www-contract-note">
          <div><p class="hara-v2-kicker">Content contract</p><h3>{wwwContracts.www.schemaNamespace}@{wwwContracts.www.schemaVersion}</h3></div>
          <p>{wwwContracts.www.summary}</p>
          <code>{wwwContracts.www.types.map(({ id }) => id).join(" · ")}</code>
        </aside>
      </section>
    </main>

    <footer class="www-family-footer">
      <div><strong>Hara</strong><span>Programming language · forms, runtimes, libraries, and source records.</span></div>
      <nav aria-label="WWW family footer"><a href={docsHref}>Docs</a><a href={benchmarksHref}>Benchmarks</a><a href="#home-adoption">Interface ownership</a></nav>
      <code>{homeNarrative.revision}</code>
    </footer>
  </body>
</html>
