---
import ThemeToggle from "../../../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../../../src/astro/HaraMark.astro";
import ClipScreen from "../../../../components/v2-world-around/ClipScreen.astro";
import ModerationScreen from "../../../../components/v2-world-around/ModerationScreen.astro";
import RadarScreen from "../../../../components/v2-world-around/RadarScreen.astro";
import RelayScreen from "../../../../components/v2-world-around/RelayScreen.astro";
import SignalScreen from "../../../../components/v2-world-around/SignalScreen.astro";
import SourceProfileScreen from "../../../../components/v2-world-around/SourceProfileScreen.astro";
import StoryScreen from "../../../../components/v2-world-around/StoryScreen.astro";
import SubmitSourceScreen from "../../../../components/v2-world-around/SubmitSourceScreen.astro";
import "../../../../../../src/v2.css";
import "../../../../../../src/theme.js";
import "../../../../styles/v2-lab.css";
import "../../../../styles/v2-calm-lab.css";
import "../../../../styles/v2-world-lab.css";
import "../../../../styles/v2-world-around.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/world/around/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const documentLab = `${basePath}v2/`;
const worldLab = `${basePath}v2/world/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Around Hara reference for external source records, related-story grouping, narrow quotations, source registration, moderation, and owner-attributed relay drafts." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Around Hara external references" />
    <meta property="og:description" content="Inspect how external Hara articles and discussions retain their authors, canonical links, provider context, relation evidence, moderation state, and relay receipts." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Around Hara external references" />
    <meta name="twitter:description" content="External source records, related stories, quotations, moderation, and reviewed relay drafts around Hara." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Around Hara external references</title>
  </head>
  <body class="hara-v2">
    <header class="v2-lab-header around-lab-header">
      <a class="v2-lab-brand" href={worldLab}><HaraMark size={28} /><b>Hara visual language</b><small>Around Hara reference</small></a>
      <nav aria-label="Around Hara reference screens"><a href="#radar">Sources</a><a href="#story">Related story</a><a href="#signal">Item</a><a href="#clip">Quotation</a><a href="#submit">Register</a><a href="#source">Profile</a><a href="#moderation">Review</a><a href="#relay">Relay</a></nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main world-lab-main around-lab-main">
      <section class="world-lab-hero around-lab-hero">
        <div>
          <p class="hara-v2-kicker">External source reference · Prototype data</p>
          <h1>External Hara material retains its original source and authorship.</h1>
          <p>Around Hara records narrow public references from X, Reddit, Hacker News, Substack, GitHub, RSS, and other feeds. Related items may be grouped when the evidence supports it, but the original platform continues to own the post, identity, discussion measures, and canonical URL.</p>
          <div class="world-lab-hero-actions"><a class="hara-v2-button" data-variant="primary" href="#radar">View source records</a><a class="hara-v2-button" href="#relay">Review relay records</a><a class="world-lab-back-link" href={worldLab}>← World community reference</a></div>
          <div class="around-contract"><span>Original source owns the item</span><span>World records relationships and notes</span><span>Ranking and moderation are inspectable</span></div>
        </div>
        <div class="around-radar-art" aria-hidden="true"><i></i><i></i><b>H<em></em></b><span data-source="x">X</span><span data-source="reddit">r/</span><span data-source="hn">Y</span><span data-source="substack">S</span><span data-source="github">◇</span></div>
      </section>

      <nav class="world-lab-index around-lab-index" aria-label="Around Hara reference index">
        <a href="#radar"><strong>Source index</strong><span>Source-relative activity, publication time, discussion, and curation records.</span><code>fetch / rank / explain</code></a>
        <a href="#story"><strong>Related-story record</strong><span>One Hara update with the evidence connecting its external coverage.</span><code>relate / review / discuss</code></a>
        <a href="#signal"><strong>External item</strong><span>Original preview, author, canonical URL, matched entities, and local notes.</span><code>attribute / verify / annotate</code></a>
        <a href="#clip"><strong>Quotation record</strong><span>A narrow excerpt with canonical provenance and Hara-specific context.</span><code>quote / source / context</code></a>
        <a href="#submit"><strong>Register source</strong><span>Add a feed, account, community, newsletter, or repository with matching rules.</span><code>identify / match / preview</code></a>
        <a href="#source"><strong>Source profile</strong><span>Provenance, ownership, availability, inclusion rules, and discovered items.</span><code>provenance / claim / audit</code></a>
        <a href="#moderation"><strong>Relation review</strong><span>Resolve ambiguous matches with explicit evidence and a recorded disposition.</span><code>retain / reject / separate</code></a>
        <a href="#relay"><strong>Owner-attributed relay</strong><span>Channel-specific drafts with source links, human review, and delivery receipts.</span><code>select / approve / publish</code></a>
      </nav>

      <RadarScreen home={documentLab} world={worldLab} />
      <StoryScreen home={documentLab} world={worldLab} />
      <SignalScreen home={documentLab} world={worldLab} />
      <ClipScreen home={documentLab} world={worldLab} />
      <SubmitSourceScreen home={documentLab} world={worldLab} />
      <SourceProfileScreen home={documentLab} world={worldLab} />
      <ModerationScreen home={documentLab} world={worldLab} />
      <RelayScreen home={documentLab} world={worldLab} />

      <section class="world-lab-conclusion around-conclusion"><div><p class="hara-v2-kicker">Around Hara record types</p><h2>External item · Quotation · Related story · Source · Discussion · Relay</h2><p>The original platform remains authoritative for the item. Hara World records resolved Hara entities, contributor notes, local discussion, moderation decisions, and reviewed outbound effects around it.</p></div><div><a class="hara-v2-button" href={worldLab}>Return to World</a><a class="hara-v2-button" data-variant="primary" href="#radar">View source index</a></div></section>
      <footer class="v2-lab-footer"><span>Around Hara external-reference specimen · Visual language v2 · prototype data</span><span><a href={worldLab}>World reference</a> · <a href={documentLab}>V2 reference</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span></footer>
    </main>
  </body>
</html>
