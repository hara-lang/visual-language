    <script>
      const revealRunResult = (button) => {
        const key = button.getAttribute("data-onboarding-run");
        if (!key) return;
        const result = document.querySelector(`[data-onboarding-result="${key}"]`);
        if (result instanceof HTMLElement) result.hidden = false;
        button.textContent = "Ran locally ✓";
      };

      document.querySelectorAll("[data-onboarding-run]").forEach((button) => {
        button.addEventListener("click", () => revealRunResult(button));
      });

      document.querySelectorAll("[data-save-trigger]").forEach((button) => {
        button.addEventListener("click", () => {
          const key = button.getAttribute("data-save-trigger");
          const gate = document.querySelector(`[data-save-gate="${key}"]`);
          if (gate instanceof HTMLElement) gate.hidden = !gate.hidden;
        });
      });

      const updateInterestSummary = () => {
        const active = [...document.querySelectorAll("[data-interest][aria-pressed='true']")]
          .map((button) => button.getAttribute("data-interest"))
          .filter(Boolean);
        const summary = document.querySelector("[data-interest-summary]");
        if (summary) summary.textContent = active.length ? active.join(", ") : "anything interesting";
      };

      document.querySelectorAll("[data-interest]").forEach((button) => {
        button.addEventListener("click", () => {
          button.setAttribute("aria-pressed", button.getAttribute("aria-pressed") === "true" ? "false" : "true");
          updateInterestSummary();
        });
      });

      document.querySelectorAll("[data-experience]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-experience]").forEach((choice) => choice.setAttribute("aria-pressed", "false"));
          button.setAttribute("aria-pressed", "true");
          const summary = document.querySelector("[data-experience-summary]");
          if (summary) summary.textContent = button.getAttribute("data-experience") || "Programmed before";
        });
      });

      document.querySelectorAll("[data-follow-button]").forEach((button) => {
        button.addEventListener("click", () => {
          const following = button.getAttribute("aria-pressed") === "true";
          button.setAttribute("aria-pressed", following ? "false" : "true");
          button.textContent = following ? (button.textContent?.includes("project") ? "Follow project" : "Follow") : "Following ✓";
        });
      });
    </script>
