---
import ThemeToggle from "../../../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../../../src/astro/HaraMark.astro";
import Shell from "../../../../../../src/astro/v2/Shell.astro";
import Header from "../../../../../../src/astro/v2/Header.astro";
import ContextNav from "../../../../../../src/astro/v2/ContextNav.astro";
import Sidebar from "../../../../../../src/astro/v2/Sidebar.astro";
import "../../../../../../src/v2.css";
import "../../../../../../src/theme.js";
import "../../../../styles/v2-lab.css";
import "../../../../styles/v2-calm-lab.css";
import "../../../../styles/v2-world-lab.css";
import "../../../../styles/v2-world-onboarding.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/world/onboarding/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const worldLab = `${basePath}v2/world/`;

const ecosystemNav = [
  { href: "#arrival", label: "Home" },
  { href: "#arrival", label: "World", current: true },
  { href: "#arrival", label: "Specs" },
  { href: "#arrival", label: "Packages" },
  { href: "#arrival", label: "Identity" }
];

const worldNav = (current) => [
  { href: "#arrival", label: "Feed", current: current === "feed" },
  { href: "#first-run", label: "Play", current: current === "play" },
  { href: "#community-path", label: "People", current: current === "people" },
  { href: "#community-path", label: "Agents", current: current === "agents" },
  { href: "#first-run", label: "Learn", current: current === "learn" },
  { href: "#for-you", label: "Sources", current: current === "sources" }
];

const arrivalSidebar = [
  { label: "Start here", items: [
    { href: "#arrival", label: "For you", current: true },
    { href: "#first-run", label: "30-second Hara" },
    { href: "#for-you", label: "Things people made" },
    { href: "#community-path", label: "Meet programmers" }
  ] },
  { label: "Browse", items: [
    { href: "#for-you", label: "Games" },
    { href: "#for-you", label: "Graphics" },
    { href: "#for-you", label: "Agents" },
    { href: "#for-you", label: "Web" }
  ] }
];

const learningSidebar = [
  { label: "Your first minutes", items: [
    { href: "#arrival", label: "01 · See code" },
    { href: "#first-run", label: "02 · Run it", current: true },
    { href: "#first-run", label: "03 · Change it" },
    { href: "#interests", label: "04 · Find your path" }
  ] },
  { label: "No account required", items: [
    { href: "#first-run", label: "Run locally" },
    { href: "#first-run", label: "Edit freely" },
    { href: "#newcomer", label: "Save when ready" }
  ] }
];

const discoverySidebar = [
  { label: "For you", items: [
    { href: "#for-you", label: "Everything", current: true },
    { href: "#for-you", label: "Runnable" },
    { href: "#for-you", label: "Projects" },
    { href: "#for-you", label: "Questions" },
    { href: "#for-you", label: "Challenges" }
  ] },
  { label: "Your interests", items: [
    { href: "#interests", label: "Graphics" },
    { href: "#interests", label: "Games" },
    { href: "#interests", label: "Language tools" }
  ] }
];

const communitySidebar = [
  { label: "Community", items: [
    { href: "#community-path", label: "Projects", current: true, badge: 14 },
    { href: "#community-path", label: "People", badge: 46 },
    { href: "#community-path", label: "Help wanted", badge: 7 },
    { href: "#community-path", label: "Questions", badge: 12 }
  ] },
  { label: "New programmers", items: [
    { href: "#community-path", label: "Just joined", badge: 5 },
    { href: "#community-path", label: "First programs", badge: 8 },
    { href: "#community-path", label: "Good first tasks", badge: 6 }
  ] }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Detailed Hara World v2 programmer onboarding study: executable feed, first run, interest selection, personalized discovery, newcomer identity, and project participation." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara World programmer onboarding reference" />
    <meta property="og:description" content="A detailed first-session journey from seeing Hara code to joining a programming community." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara World programmer onboarding reference" />
    <meta name="twitter:description" content="See code, run it, change it, find people, and make something with Hara." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara World programmer onboarding reference</title>
  </head>
  <body class="hara-v2">
    <header class="v2-lab-header">
      <a class="v2-lab-brand" href={worldLab}>
        <HaraMark size={28} />
        <b>Hara visual language</b>
        <small>World onboarding field test</small>
      </a>
      <nav aria-label="Onboarding prototype screens">
        <a href="#arrival">Arrival</a>
        <a href="#first-run">First run</a>
        <a href="#interests">Intent</a>
        <a href="#for-you">Feed</a>
        <a href="#newcomer">Newcomer</a>
        <a href="#community-path">Community</a>
      </nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main world-lab-main">
      <section class="world-onboarding-hero">
        <div>
          <p class="hara-v2-kicker">Programmer acquisition study · World v2</p>
          <h1>Don't explain the language first. Let people use it.</h1>
          <p>The brand promise is expressed through interaction: see an interesting Hara program, run it immediately, change it, discover who made it, and find a path toward making something of your own. Account creation happens only when there is something worth keeping.</p>
          <div class="world-lab-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#arrival">Start the journey</a>
            <a class="hara-v2-button" href={worldLab}>Back to World overview</a>
          </div>
        </div>
        <div class="world-onboarding-loop" aria-label="Onboarding loop">
          <span>See code</span><b>→</b><span>Run</span><b>→</b><span>Change</span><b>→</b><span>Make</span><b>→</b><span>Share</span><b>→</b><span>Meet people</span>
        </div>
      </section>

      <nav class="world-onboarding-index" aria-label="Programmer onboarding journey">
        <a href="#arrival"><strong>01 · First arrival</strong><span>Anonymous visitor lands directly in an executable programming feed.</span></a>
        <a href="#first-run"><strong>02 · First success</strong><span>The interface celebrates running and changing code before teaching terminology.</span></a>
        <a href="#interests"><strong>03 · Find intent</strong><span>Ask what they want to make and how much programming context they already have.</span></a>
        <a href="#for-you"><strong>04 · For-you feed</strong><span>Programming-native feed objects replace generic social posts.</span></a>
        <a href="#newcomer"><strong>05 · Save identity</strong><span>Sign-in appears when a solution, remix, or project is worth keeping.</span></a>
        <a href="#community-path"><strong>06 · Join the work</strong><span>Projects, people, questions, and beginner-friendly tasks turn learning into belonging.</span></a>
      </nav>

      <section class="world-lab-screen" id="arrival">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 01 · Anonymous first arrival</p><h2>The first feed item is a program, not a pitch.</h2></div>
          <p>A visitor should cross the psychological threshold of “I can operate this language” before World asks for identity, preferences, or commitment.</p>
        </header>
        <div class="world-lab-canvas world-onboarding-canvas">
          <Shell embedded={true} sidebar={true} aside={true} mainId="onboarding-arrival-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("feed")}>
              <a class="hara-v2-button" href="#community-path">Explore projects</a>
              <a class="hara-v2-button" data-variant="primary" href="#first-run">Try Hara</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="Welcome" groups={arrivalSidebar}>
              <span>No account, download, or project setup required.</span>
            </Sidebar>

            <div class="world-first-visit-heading">
              <div><p class="hara-v2-kicker">Hara World</p><h1>See what people make. Try the language while you read.</h1></div>
              <span class="hara-v2-badge" data-tone="success">No account needed</span>
            </div>

            <article class="world-executable-post" data-executable-post>
              <header>
                <div class="hara-v2-avatar">H</div>
                <div><b>30-second Hara</b><span>First program · executable</span></div>
                <small>About 10 seconds</small>
              </header>
              <div class="world-executable-copy">
                <p>What does this program return?</p>
                <pre><code>(+ 20 22)</code></pre>
              </div>
              <div class="world-executable-actions">
                <button class="hara-v2-button" data-variant="primary" data-onboarding-run="arrival">Run</button>
                <button class="hara-v2-button" data-prototype-edit>Change it</button>
                <button class="hara-v2-button" data-variant="ghost">Explain</button>
                <button class="hara-v2-button" data-save-trigger="arrival">Save</button>
              </div>
              <div class="world-run-result" data-onboarding-result="arrival" hidden>
                <div><span>Result</span><strong>42</strong></div>
                <p>You just ran Hara. Change either number and run it again.</p>
              </div>
              <div class="world-save-gate" data-save-gate="arrival" hidden>
                <b>Want to keep this?</b><span>Continue with GitHub only when you have something worth saving.</span><button class="hara-v2-button">Continue with GitHub</button>
              </div>
              <footer><span>128 people tried this</span><span>Nothing is stored until you choose to save.</span></footer>
            </article>

            <div class="world-feed-object-strip">
              <article><span class="hara-v2-badge" data-tone="signal">Showcase</span><div class="world-mini-visual" aria-hidden="true"><i></i><i></i><i></i><i></i></div><b>Procedural garden</b><p>See the result first, then reveal the Hara behind it.</p><a href="#for-you">Run demo →</a></article>
              <article><span class="hara-v2-badge">Question</span><pre><code>(map inc [1 2 3])</code></pre><b>Why is a list executable?</b><p>A question can carry the smallest runnable reproduction.</p><a href="#community-path">Answer with code →</a></article>
              <article><span class="hara-v2-badge" data-tone="success">Project</span><div class="world-project-mark">LW</div><b>Little World</b><p>A programmable simulation made by two community members.</p><a href="#community-path">Meet the builders →</a></article>
            </div>

            <div slot="aside" class="world-aside-stack">
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>First-visit rule</h2></header>
                <div class="hara-v2-panel-body world-onboarding-rule"><strong>Program before profile.</strong><p>World should prove that Hara is approachable before asking who the visitor is.</p></div>
              </section>
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>What can I make?</h2></header>
                <div class="hara-v2-panel-body world-interest-links"><a href="#interests">Games</a><a href="#interests">Graphics</a><a href="#interests">Agents</a><a href="#interests">Web</a><a href="#interests">Music</a><a href="#interests">Tools</a></div>
              </section>
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>Brand signal</h2></header>
                <div class="hara-v2-panel-body"><p class="world-aside-copy">“People here make strange, interesting, programmable things.” The feed should demonstrate that sentence continuously.</p></div>
              </section>
            </div>
          </Shell>
        </div>
        <div class="world-lab-notes">
          <article><b>Zero-friction execution</b><p>The first meaningful button is Run. No sign-in, download, tutorial wizard, or project scaffolding comes first.</p></article>
          <article><b>Programming objects</b><p>Showcases, questions, projects, snippets, challenges, and releases each expose different programming-native actions.</p></article>
          <article><b>Output before abstraction</b><p>Interesting results attract people who want to make things; language concepts can be explained after curiosity exists.</p></article>
        </div>
      </section>

      <section class="world-lab-screen" id="first-run">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 02 · First successful run</p><h2>Turn one click into “I can change this.”</h2></div>
          <p>The post-run state should not congratulate the visitor and stop. It immediately exposes editable source and a second tiny success.</p>
        </header>
        <div class="world-lab-canvas world-onboarding-canvas">
          <Shell embedded={true} sidebar={true} aside={true} mainId="onboarding-first-run-content">
            <Header slot="header" section="World" nav={ecosystemNav}><button class="hara-v2-icon-button" aria-label="Account">◎</button><ThemeToggle /></Header>
            <ContextNav slot="context" items={worldNav("play")}><a class="hara-v2-button" href="#arrival">Back to feed</a><a class="hara-v2-button" data-variant="primary" href="#interests">Keep going →</a></ContextNav>
            <Sidebar slot="sidebar" title="First minutes" groups={learningSidebar}><span>Progress is local until the visitor chooses to save it.</span></Sidebar>

            <div class="world-success-banner"><span class="world-success-check">✓</span><div><p class="hara-v2-kicker">First run complete</p><h1>You just ran Hara.</h1><p>Now make the program yours.</p></div><strong>42</strong></div>

            <div class="world-first-change-grid">
              <section class="hara-v2-panel world-editable-program">
                <header class="hara-v2-panel-header"><h2>Change one thing</h2><span class="hara-v2-badge" data-tone="signal">Local session</span></header>
                <div class="hara-v2-panel-body">
                  <label for="first-change-source">Try changing 22 to another number</label>
                  <textarea id="first-change-source" spellcheck="false">(+ 20 22)</textarea>
                  <div class="world-program-output" data-onboarding-result="change"><span>Output</span><code>42</code></div>
                  <div class="world-executable-actions"><button class="hara-v2-button" data-variant="primary" data-onboarding-run="change">Run change</button><button class="hara-v2-button">Reset</button><button class="hara-v2-button" data-save-trigger="change">Save this version</button></div>
                  <div class="world-save-gate" data-save-gate="change" hidden><b>This version is worth keeping.</b><span>Sign in now to save the source and pick it up later.</span><button class="hara-v2-button">Continue with GitHub</button></div>
                </div>
              </section>
              <section class="world-progress-path">
                <article data-done="true"><span>01</span><div><b>Run something</b><p>Done. You executed Hara in the browser.</p></div></article>
                <article data-current="true"><span>02</span><div><b>Change something</b><p>Edit one value and see the result change.</p></div></article>
                <article><span>03</span><div><b>Make something</b><p>Choose a direction that looks interesting.</p></div></article>
              </section>
            </div>

            <article class="world-next-program">
              <div><p class="hara-v2-kicker">Next from the feed</p><h2>Square a few numbers.</h2><p>Hara becomes recognizable through repetition, not a syntax lecture.</p></div>
              <pre><code>(map #(* % %) [1 2 3 4])</code></pre>
              <div><button class="hara-v2-button" data-variant="primary">Run</button><a class="hara-v2-button" href="#interests">Show me things to make →</a></div>
            </article>

            <div slot="aside" class="world-aside-stack">
              <section class="hara-v2-panel"><header class="hara-v2-panel-header"><h2>What just happened?</h2></header><div class="hara-v2-panel-body world-plain-explanation"><p><b>Source</b> is the text you changed.</p><p><b>Run</b> evaluates it in a capability-free browser session.</p><p><b>Result</b> is an ordinary Hara value.</p></div></section>
              <section class="hara-v2-panel"><header class="hara-v2-panel-header"><h2>Still anonymous</h2></header><div class="hara-v2-panel-body"><p class="world-aside-copy">The visitor has already learned three important things without surrendering identity or leaving the page.</p></div></section>
            </div>
          </Shell>
        </div>
        <div class="world-lab-notes">
          <article><b>Second success immediately</b><p>After Run, the next action is Change. Momentum is more valuable than a celebratory modal.</p></article>
          <article><b>Explain on demand</b><p>Terminology stays available in the inspector, but the primary surface remains an editable program and visible result.</p></article>
          <article><b>Save creates the auth moment</b><p>Authentication is contextual: “keep this thing you made,” not “create an account to begin.”</p></article>
        </div>
      </section>

      <section class="world-lab-screen" id="interests">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 03 · Intent selection</p><h2>Ask what they want to make, not why they joined.</h2></div>
          <p>Two lightweight choices are enough to transform the experience: creative intent and existing programming context. Everything remains skippable.</p>
        </header>
        <div class="world-lab-canvas world-onboarding-canvas world-onboarding-canvas--intent">
          <Shell embedded={true} sidebar={false} aside={false} mainId="onboarding-intent-content">
            <Header slot="header" section="World" nav={ecosystemNav}><button class="hara-v2-icon-button" aria-label="Account">◎</button><ThemeToggle /></Header>
            <ContextNav slot="context" items={worldNav("feed")}><a class="hara-v2-button" href="#for-you">Skip for now</a></ContextNav>

            <div class="world-intent-layout">
              <section class="world-intent-form">
                <p class="hara-v2-kicker">Make World useful to you</p>
                <h1>What do you want to make?</h1>
                <p>Choose as many as feel interesting. This changes what World shows first; it does not lock you into a track.</p>
                <div class="world-intent-choices" aria-label="Programming interests">
                  <button aria-pressed="true" data-interest="Graphics"><span>◌</span><b>Graphics</b><small>Generative visuals, animation, 3D</small></button>
                  <button aria-pressed="true" data-interest="Games"><span>◇</span><b>Games</b><small>Worlds, simulations, mechanics</small></button>
                  <button aria-pressed="false" data-interest="Agents"><span>◎</span><b>Agents</b><small>Tools, workflows, autonomous systems</small></button>
                  <button aria-pressed="false" data-interest="Web"><span>⌁</span><b>Web</b><small>Apps, services, live interfaces</small></button>
                  <button aria-pressed="false" data-interest="Music"><span>≋</span><b>Music</b><small>Sound, sequencing, performance</small></button>
                  <button aria-pressed="true" data-interest="Language tools"><span>λ</span><b>Language tools</b><small>Macros, compilers, editors</small></button>
                </div>

                <fieldset class="world-experience-choices">
                  <legend>How familiar are you with programming?</legend>
                  <button aria-pressed="false" data-experience="New programmer"><b>I'm new</b><span>Show more guided examples and visual results.</span></button>
                  <button aria-pressed="true" data-experience="Programmed before"><b>I've programmed before</b><span>Move quickly from examples into real projects and APIs.</span></button>
                  <button aria-pressed="false" data-experience="Lisp programmer"><b>I know Lisp</b><span>Surface macros, language internals, semantics, and libraries.</span></button>
                </fieldset>
                <div class="world-intent-actions"><a class="hara-v2-button" data-variant="primary" href="#for-you">Build my feed →</a><span>No account required.</span></div>
              </section>

              <aside class="world-intent-preview">
                <p class="hara-v2-kicker">Preview</p>
                <h2>Your World starts with <span data-interest-summary>Graphics, Games, Language tools</span>.</h2>
                <div class="world-preview-stack">
                  <article><span class="hara-v2-badge" data-tone="signal">Showcase</span><b>Particle garden</b><p>Runnable graphics demo with source reveal.</p></article>
                  <article><span class="hara-v2-badge">Project</span><b>Little World</b><p>Simulation project looking for a contributor.</p></article>
                  <article><span class="hara-v2-badge" data-tone="success">People</span><b>Maya + Jin</b><p>Programmers working on graphics and compiler tooling.</p></article>
                </div>
                <p class="world-preview-context">Experience: <b data-experience-summary>Programmed before</b></p>
              </aside>
            </div>
          </Shell>
        </div>
        <div class="world-lab-notes">
          <article><b>Intent over demographics</b><p>“What do you want to make?” directly improves programming discovery and reinforces Hara as a creative tool.</p></article>
          <article><b>One brand, different entrances</b><p>New programmers, experienced programmers, and Lisp programmers can share World while receiving different levels of explanation.</p></article>
          <article><b>Always skippable</b><p>Personalization should feel like a useful shortcut, not an onboarding tollbooth.</p></article>
        </div>
      </section>

      <section class="world-lab-screen" id="for-you">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 04 · Personalized programming feed</p><h2>Replace Like and Comment with Run, Remix, Use, and Answer with code.</h2></div>
          <p>The feed becomes a catalogue of things a programmer can do. Social signals describe participation in the work rather than generic engagement.</p>
        </header>
        <div class="world-lab-canvas world-onboarding-canvas">
          <Shell embedded={true} sidebar={true} aside={true} mainId="onboarding-for-you-content">
            <Header slot="header" section="World" nav={ecosystemNav}><button class="hara-v2-icon-button" aria-label="Account">◎</button><ThemeToggle /></Header>
            <ContextNav slot="context" items={worldNav("feed")}><a class="hara-v2-button" href="#interests">Tune interests</a><a class="hara-v2-button" data-variant="primary" href="#newcomer">Save something</a></ContextNav>
            <Sidebar slot="sidebar" title="For you" groups={discoverySidebar}><span>Personalization can remain local until a visitor signs in.</span></Sidebar>

            <div class="world-personal-feed-head"><div><p class="hara-v2-kicker">For you · Graphics + Games + Language tools</p><h1>Things you can run, change, and join.</h1></div><button class="hara-v2-button">Why am I seeing this?</button></div>
            <div class="hara-v2-tabs world-feed-tabs" role="tablist" aria-label="Personal feed filters"><button class="hara-v2-tab" aria-selected="true">For you</button><button class="hara-v2-tab">Following</button><button class="hara-v2-tab">New</button><button class="hara-v2-tab">Challenges</button><button class="hara-v2-tab">Help wanted</button></div>

            <div class="world-programming-feed">
              <article class="world-rich-post world-rich-post--showcase">
                <header><div class="hara-v2-avatar">ML</div><div><b>Maya L.</b><span>showcase · graphics</span></div><button class="world-follow-button" data-follow-button aria-pressed="false">Follow</button></header>
                <div class="world-showcase-stage" aria-label="Procedural particle garden preview"><i></i><i></i><i></i><i></i><i></i><i></i><span>live canvas</span></div>
                <div class="world-rich-copy"><h2>Particle garden in 34 lines of Hara</h2><p>I wanted to see how far a tiny dataflow loop could go before adding an engine.</p></div>
                <pre><code>(watch particles
  (fn [state]
    (map step-particle state)))</code></pre>
                <footer><div><button class="hara-v2-button" data-variant="primary">Run demo</button><button class="hara-v2-button">View Hara</button><button class="hara-v2-button">Remix</button></div><span>312 tried · 41 remixed</span></footer>
              </article>

              <article class="world-rich-post world-rich-post--snippet">
                <header><div class="hara-v2-avatar">JN</div><div><b>Jin N.</b><span>snippet · language tools</span></div><button class="world-follow-button" data-follow-button aria-pressed="false">Follow</button></header>
                <div class="world-rich-copy"><h2>A tiny state transition reads almost like data.</h2><p>Can this be made smaller without hiding the shape?</p></div>
                <pre><code>(defn step [state event]
  (get-in transitions [state event] state))</code></pre>
                <footer><div><button class="hara-v2-button" data-variant="primary">Run</button><button class="hara-v2-button">Remix</button><button class="hara-v2-button" data-save-trigger="snippet">Save</button></div><span>84 tried · 17 remixed · 9 saved</span></footer>
