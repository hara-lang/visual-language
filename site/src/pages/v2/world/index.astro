---
import ThemeToggle from "../../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import Shell from "../../../../../src/astro/v2/Shell.astro";
import Header from "../../../../../src/astro/v2/Header.astro";
import ContextNav from "../../../../../src/astro/v2/ContextNav.astro";
import Sidebar from "../../../../../src/astro/v2/Sidebar.astro";
import FeedExplorer from "./_components/FeedExplorer.astro";
import SourceManager from "./_components/SourceManager.astro";
import ConversationCluster from "./_components/ConversationCluster.astro";
import RelayConsole from "./_components/RelayConsole.astro";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-lab.css";
import "../../../styles/v2-calm-lab.css";
import "../../../styles/v2-world-feed.css";
import "../../../styles/v2-world-feed-explorer.css";
import "../../../styles/v2-world-feed-sources.css";
import "../../../styles/v2-world-feed-conversation.css";
import "../../../styles/v2-world-feed-relay.css";
import "../../../styles/v2-world-feed-responsive.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/world/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const documentLab = `${basePath}v2/`;
const onboardingLab = `${basePath}v2/learn/`;

const ecosystemNav = [
  { href: "#feed-explorer", label: "Overview" },
  { href: "#feed-explorer", label: "World", current: true },
  { href: `${basePath}v2/specs/`, label: "Specifications" },
  { href: `${basePath}v2/packages/`, label: "Packages" },
  { href: "#conversation", label: "People" }
];

const worldNav = (current) => [
  { href: "#feed-explorer", label: "Articles", current: current === "feed" },
  { href: "#feed-explorer", label: "Recent", current: current === "new" },
  { href: "#conversation", label: "Discussions", current: current === "conversation" },
  { href: "#conversation", label: "People", current: current === "people" },
  { href: "#sources", label: "Sources", current: current === "sources" }
];

const feedSidebar = [
  { label: "Read", items: [
    { href: "#feed-explorer", label: "Current", current: true, badge: 42 },
    { href: "#feed-explorer", label: "Recent", badge: 18 },
    { href: "#feed-explorer", label: "Following", badge: 9 },
    { href: "#feed-explorer", label: "Releases", badge: 6 },
    { href: "#feed-explorer", label: "Example of the day" }
  ] },
  { label: "Sources", items: [
    { href: "#sources", label: "Hara World", badge: 8 },
    { href: "#sources", label: "GitHub", badge: 11 },
    { href: "#sources", label: "Reddit", badge: 6 },
    { href: "#sources", label: "X / Twitter", badge: 9 },
    { href: "#sources", label: "Hacker News", badge: 3 },
    { href: "#sources", label: "Substack", badge: 5 }
  ] }
];

const sourceSidebar = [
  { label: "Source records", items: [
    { href: "#sources", label: "Providers", current: true, badge: 7 },
    { href: "#sources", label: "Inclusion rules", badge: 12 },
    { href: "#sources", label: "Feeds", badge: 12 },
    { href: "#sources", label: "Review queue", badge: 4 }
  ] },
  { label: "Portability", items: [
    { href: "#sources", label: "Import OPML" },
    { href: "#sources", label: "Export OPML" },
    { href: "#sources", label: "JSON Feed" }
  ] }
];

const conversationSidebar = [
  { label: "Discussion", items: [
    { href: "#conversation", label: "Canonical article", current: true },
    { href: "#conversation", label: "All discussion", badge: 69 },
    { href: "#conversation", label: "World context", badge: 4 },
    { href: "#conversation", label: "Related Hara work", badge: 4 }
  ] },
  { label: "Sources", items: [
    { href: "#conversation", label: "X / Twitter", badge: 18 },
    { href: "#conversation", label: "Hacker News", badge: 36 },
    { href: "#conversation", label: "Reddit", badge: 11 }
  ] }
];

const relaySidebar = [
  { label: "Hara Bot", items: [
    { href: "#relay", label: "Review queue", current: true, badge: 6 },
    { href: "#relay", label: "Scheduled", badge: 2 },
    { href: "#relay", label: "Published", badge: 128 },
    { href: "#relay", label: "Blocked", badge: 3 }
  ] },
  { label: "Control", items: [
    { href: "#relay", label: "Destinations", badge: 5 },
    { href: "#relay", label: "Selection policy" },
    { href: "#relay", label: "Delivery receipts" }
  ] }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara World community reader for attributed articles, discussions, package changes, external references, contributor profiles, source subscriptions, moderation, and owner-attributed bot relays." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara World community reader" />
    <meta property="og:description" content="Read Hara articles, releases, discussions, and external references while retaining original authorship, canonical links, provider context, and moderation records." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara World community reader" />
    <meta name="twitter:description" content="Attributed articles, discussions, package changes, people, sources, and reviewed bot relays around Hara." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara World community reader</title>
  </head>
  <body class="hara-v2 world-feed-lab">
    <header class="v2-lab-header">
      <a class="v2-lab-brand" href={documentLab}>
        <HaraMark size={28} />
        <b>Hara visual language</b>
        <small>World community reference</small>
      </a>
      <nav aria-label="World reference screens">
        <a href="#feed-explorer">Articles</a>
        <a href="#sources">Sources</a>
        <a href="#conversation">Discussion</a>
        <a href="#relay">Bot review</a>
      </nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main world-feed-lab-main">
      <section class="world-feed-lab-hero">
        <div>
          <p class="hara-v2-kicker">Hara community reader · Interface reference</p>
          <h1>World collects attributed articles, discussions, package changes, and external references.</h1>
          <p>Each item retains its author, canonical link, source provider, publication time, and moderation state. Readers can follow current work without creating an account; an identity is used only for saved sources, comments, submissions, or maintained profiles.</p>
          <div class="world-feed-lab-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#feed-explorer">Read current articles</a>
            <a class="hara-v2-button" href="#sources">View source records</a>
            <a class="hara-v2-button" href={onboardingLab}>Read Learn</a>
            <a class="world-feed-lab-back-link" href={documentLab}>← V2 reference</a>
          </div>
        </div>
        <div class="world-feed-radar" aria-label="Hara World source summary">
          <div class="world-feed-radar-core"><strong>World</strong><small>31 clusters</small></div>
          <span class="world-feed-radar-node world-feed-radar-node--github" data-source="github"><i></i>GitHub · 11</span>
          <span class="world-feed-radar-node world-feed-radar-node--reddit" data-source="reddit"><i></i>Reddit · 6</span>
          <span class="world-feed-radar-node world-feed-radar-node--x" data-source="x"><i></i>X · 9</span>
          <span class="world-feed-radar-node world-feed-radar-node--hn" data-source="hacker-news"><i></i>Hacker News · 3</span>
          <span class="world-feed-radar-node world-feed-radar-node--substack" data-source="substack"><i></i>Substack · 5</span>
          <span class="world-feed-radar-node world-feed-radar-node--rss" data-source="rss"><i></i>RSS · 12 feeds</span>
          <div class="world-feed-radar-pulse"><strong>42</strong><span>items today</span></div>
        </div>
      </section>

      <nav class="world-feed-lab-index" aria-label="World reference screen index">
        <a href="#feed-explorer"><strong>Article reader</strong><span>A front page for Hara World posts, repositories, external discussions, and independent feeds.</span><code>current / recent / following / releases</code></a>
        <a href="#sources"><strong>Source records</strong><span>Provider health, inclusion rules, review queues, RSS, JSON Feed, and OPML portability.</span><code>fetch / normalize / review</code></a>
        <a href="#conversation"><strong>Discussion cluster</strong><span>Relate one article across platforms while retaining each original author, link, and discussion context.</span><code>source / relation / discussion</code></a>
        <a href="#relay"><strong>Owner-attributed bot relay</strong><span>Candidate selection, attributed drafts, human review, cooldowns, deduplication, and delivery receipts.</span><code>select / review / receipt</code></a>
      </nav>

      <section class="world-feed-lab-screen" id="feed-explorer">
        <header class="world-feed-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 01 · Public reading</p><h2>Read current Hara activity without creating an account.</h2></div>
          <p>The first view answers what has changed, what is being discussed, and where the canonical material lives. External sources remain identified rather than being flattened into anonymous cards.</p>
        </header>
        <div class="world-feed-lab-canvas">
          <Shell embedded={true} sidebar={true} aside={true} mainId="world-feed-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Search">⌕</button>
              <button class="hara-v2-icon-button" aria-label="Account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("feed")}>
              <a class="hara-v2-button" href="#sources">Add source</a>
              <a class="hara-v2-button" data-variant="primary" href="#feed-explorer">Submit link ↗</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="World" groups={feedSidebar}>
              <span>RSS, JSON Feed, and OPML remain first-class. Structured lessons and progress remain in Learn.</span>
            </Sidebar>

            <FeedExplorer />

            <div slot="aside" class="world-feed-aside-stack">
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>Current discussions</h2><a href="#conversation">View all</a></header>
                <div class="hara-v2-panel-body world-feed-aside-list">
                  <a href="#conversation"><b>Schema becomes a runtime value</b><span>4 sources</span><small>69 responses · active 8 min ago</small></a>
                  <a href="#conversation"><b>What is bare-metal work?</b><span>3 sources</span><small>41 responses · active 21 min ago</small></a>
                  <a href="#conversation"><b>Browser sessions and Wasm</b><span>2 sources</span><small>28 responses · active 1 h ago</small></a>
                </div>
              </section>
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>New to Hara</h2></header>
                <div class="hara-v2-panel-body">
                  <p>Learn defines forms, values, runtimes, namespaces, packages, and capabilities before introducing larger projects.</p>
                  <a class="hara-v2-button" data-variant="primary" href={onboardingLab}>Read the first lesson</a>
                  <a class="hara-v2-button" href="#feed-explorer">View example of the day</a>
                </div>
              </section>
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>What’s New</h2><span class="hara-v2-badge">Weekly</span></header>
                <div class="hara-v2-panel-body">
                  <p>A weekly list of releases, discussions, projects, and community posts selected from the same attributed sources.</p>
                  <button class="hara-v2-button">Subscribe by email</button>
                </div>
              </section>
            </div>
          </Shell>
        </div>
        <div class="world-feed-lab-notes"><article><b>Read before signing in</b><p>Sign-in is used for saving, following, submitting, commenting, or adding World context; it is not required to read.</p></article><article><b>Source remains visible</b><p>Reddit, X, Hacker News, Substack, GitHub, and open feeds retain their own authorship and discussion context.</p></article><article><b>Ranking is inspectable</b><p>A rank can expose its inputs and revision. Popularity is a sorting signal, not an endorsement or authority claim.</p></article></div>
      </section>

      <section class="world-feed-lab-screen" id="sources">
        <header class="world-feed-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 02 · Source records</p><h2>Sources remain independent and portable.</h2></div>
          <p>“Hara” is an overloaded word, so inclusion requires explicit context, provider health, reviewable exclusions, and portable subscriptions rather than one opaque keyword query.</p>
        </header>
        <div class="world-feed-lab-canvas">
          <Shell embedded={true} sidebar={true} aside={true} mainId="world-source-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("sources")}>
              <a class="hara-v2-button" href="#sources">Import OPML</a>
              <a class="hara-v2-button" data-variant="primary" href="#sources">Add source ↗</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="Sources" groups={sourceSidebar}>
              <span>Provider payloads remain auditable. Ranking reads one normalized, attributed item envelope.</span>
            </Sidebar>

            <SourceManager />

            <div slot="aside" class="world-feed-aside-stack">
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>Normalization</h2></header>
                <div class="hara-v2-panel-body world-feed-aside-list">
                  <div><b>Identity</b><span>required</span><small>source, author, canonical URL, published time</small></div>
                  <div><b>Content</b><span>required</span><small>title, summary, kind, public state</small></div>
                  <div><b>Signals</b><span>derived</span><small>relevance, freshness, source confidence, discussion depth, novelty</small></div>
                  <div><b>Receipt</b><span>retained</span><small>provider snapshot and normalization version</small></div>
                </div>
              </section>
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>Source rule</h2></header>
                <div class="hara-v2-panel-body"><p>World links to canonical material. It does not create a permanent unattributed copy of another person’s post, comments, or newsletter.</p></div>
              </section>
            </div>
          </Shell>
        </div>
        <div class="world-feed-lab-notes"><article><b>Provider boundary</b><p>An API or feed adapter fetches and normalizes. It does not own ranking, clustering, or publication decisions.</p></article><article><b>False-positive review</b><p>Weak keyword matches require review. Strong language, package, and repository references may enter normally.</p></article><article><b>Portable subscriptions</b><p>RSS, JSON Feed, and OPML let community subscriptions outlive a World account or implementation.</p></article></div>
      </section>

      <section class="world-feed-lab-screen" id="conversation">
        <header class="world-feed-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 03 · Related discussions</p><h2>One article may have several original discussions.</h2></div>
          <p>A release can be linked from X, submitted to Hacker News, discussed on Reddit, and annotated in World. Clustering reduces duplicate entries without erasing the distinct communities or their source-local measures.</p>
        </header>
        <div class="world-feed-lab-canvas">
          <Shell embedded={true} sidebar={true} aside={false} mainId="world-conversation-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Search">⌕</button>
              <button class="hara-v2-icon-button" aria-label="Account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("conversation")}>
              <a class="hara-v2-button" href="#feed-explorer">← Articles</a>
              <a class="hara-v2-button" href="#conversation">Report relation</a>
              <a class="hara-v2-button" data-variant="primary" href="#conversation">Add World context ↗</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="Discussion" groups={conversationSidebar}>
              <span>World comments add Hara-specific context; they do not replace discussion on the canonical source.</span>
            </Sidebar>

            <ConversationCluster />
          </Shell>
        </div>
        <div class="world-feed-lab-notes"><article><b>Canonical material first</b><p>The underlying release or article remains the primary object. Cross-posts become related discussion records.</p></article><article><b>Source-local measures</b><p>Likes, points, upvotes, replies, and comments retain their original labels rather than becoming a universal count.</p></article><article><b>Relation receipts</b><p>Moderators can inspect why items were related and separate them when the evidence was incorrect.</p></article></div>
      </section>

      <section class="world-feed-lab-screen" id="relay">
        <header class="world-feed-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 04 · Bot review</p><h2>Bot contributions name their owner, source, and delivery receipt.</h2></div>
          <p>Public Hara releases or selected community material may be drafted for a digest or external channel. Community and third-party material remains human-reviewed; narrow Hara-owned facts may update World’s internal recent list automatically.</p>
        </header>
        <div class="world-feed-lab-canvas">
          <Shell embedded={true} sidebar={true} aside={false} mainId="world-relay-content">
            <Header slot="header" section="World operations" nav={ecosystemNav}>
              <span class="hara-v2-badge" data-tone="warning">Review mode</span>
              <button class="hara-v2-icon-button" aria-label="Operator account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("relay")}>
              <a class="hara-v2-button" href="#relay">Policy</a>
              <a class="hara-v2-button" href="#relay">Dry run</a>
              <a class="hara-v2-button" data-variant="primary" href="#relay">Review next ↗</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="Relay" groups={relaySidebar}>
              <span>Replies, comments, private or deleted content, unattributed quotations, and duplicate receipts are blocked.</span>
            </Sidebar>

            <RelayConsole />
          </Shell>
        </div>
        <div class="world-feed-lab-notes"><article><b>Attributed drafts</b><p>The bot drafts relays from public facts and names its owner. It does not invent opinions or autonomously join discussions.</p></article><article><b>Narrow automatic path</b><p>Hara-owned releases, advisories, and scheduled examples may enter World’s own recent module. External posts remain reviewable.</p></article><article><b>Idempotent delivery</b><p>Each destination receives one immutable publication receipt. A retry reuses it instead of creating a duplicate post.</p></article></div>
      </section>

      <section class="world-feed-lab-conclusion">
        <div><p class="hara-v2-kicker">World route structure</p><h2>Articles · Recent changes · Discussions · People · Sources</h2><p>World is a public reader for work around Hara. It preserves canonical sources, supports maintained profiles and package records, and provides contextual discussion without turning community activity into a popularity score. Structured learning remains in Learn; relay credentials remain outside Visual Language.</p></div>
        <a class="hara-v2-button" href={documentLab}>Return to V2 reference</a>
      </section>

      <footer class="v2-lab-footer">
        <span>Hara World community reference · Visual language v2</span>
        <span><a href={documentLab}>V2 reference</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>
  </body>
</html>
