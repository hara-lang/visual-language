---
import CatalogueHeader from "../../../components/v2-catalogue/CatalogueHeader.astro";
import WorldClipping from "../../../components/v2-world/WorldClipping.astro";
import WorldDigest from "../../../components/v2-world/WorldDigest.astro";
import WorldFeedDirectory from "../../../components/v2-world/WorldFeedDirectory.astro";
import WorldFrontPage from "../../../components/v2-world/WorldFrontPage.astro";
import WorldPresence from "../../../components/v2-world/WorldPresence.astro";
import WorldProfile from "../../../components/v2-world/WorldProfile.astro";
import WorldThread from "../../../components/v2-world/WorldThread.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-world-application.css";
import {
  haraWorldAdoption,
  historicalWorldStudies,
  worldContentContract,
  worldInventory,
  worldProductBoundary,
  worldSections,
  worldStateCoverage
} from "../../../lib/v2-world.mjs";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/world/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const routeHref = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
const issueHref = "https://github.com/hara-lang/visual-language/issues/42";
const haraWorldHref = "https://github.com/hara-lang/hara-world";
const stateEntries = Object.entries(worldStateCoverage);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara World v2 application laboratory: a focused community reader for articles, reviewed feeds, clippings, durable discussion, contributor evidence, optional presence, accountable bots, snippets, and digests." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara World v2 application laboratory" />
    <meta property="og:description" content="Seven detailed acceptance screens for the focused Hara community reader and discussion product." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara World v2 application laboratory" />
    <meta name="twitter:description" content="Articles, clippings, feeds, comments, profiles, presence, accountable bots, and What’s New." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara World v2 application laboratory</title>
  </head>
  <body class="hara-v2 world-application-page">
    <CatalogueHeader basePath={basePath} activePath="/v2/world/" />

    <main class="world-application-main">
      <section class="world-hero" aria-labelledby="world-title">
        <div class="world-hero-copy">
          <p class="hara-v2-kicker">Application laboratory · Issue 42</p>
          <h1 id="world-title">A public reader for the people and work around Hara.</h1>
          <p>
            World is not the whole ecosystem in one app. It is the focused place to read reviewed community work,
            preserve source context, discuss durable revisions, inspect contribution evidence, and understand who—or what—spoke.
          </p>
          <div class="world-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#front-page">Open the reader</a>
            <a class="hara-v2-button" href="#article-thread">Inspect a durable thread</a>
            <a class="hara-v2-button" data-variant="ghost" href="#adoption">Adopt in hara-world</a>
          </div>
          <dl class="world-hero-ledger" aria-label="World laboratory inventory">
            <div><dt>{worldInventory.screens}</dt><dd>detailed screens</dd></div>
            <div><dt>{worldInventory.contentTypes}</dt><dd>hara.world types</dd></div>
            <div><dt>{worldInventory.stateVariants}</dt><dd>state variants</dd></div>
            <div><dt>{worldInventory.historicalStudies}</dt><dd>retained studies</dd></div>
          </dl>
        </div>

        <div class="world-hero-field" aria-label="World product boundary map">
          <div class="world-hero-core"><HaraMark size={54} /><b>World</b><span>community reader</span></div>
          <div class="world-hero-orbit world-hero-orbit--article"><b>articles</b><small>authored + reviewed</small></div>
          <div class="world-hero-orbit world-hero-orbit--clipping"><b>clippings</b><small>source retained</small></div>
          <div class="world-hero-orbit world-hero-orbit--comment"><b>comments</b><small>durable states</small></div>
          <div class="world-hero-orbit world-hero-orbit--profile"><b>people</b><small>evidence-backed</small></div>
          <div class="world-hero-orbit world-hero-orbit--digest"><b>digest</b><small>web · email · RSS</small></div>
          <div class="world-hero-boundary"><span>Structured teaching</span><b>belongs to Learn →</b></div>
        </div>
      </section>

      <section class="world-contract-strip" aria-label="World content contract">
        <div><span>Schema namespace</span><strong>{worldContentContract.schemaNamespace}</strong></div>
        <div><span>Version</span><strong>{worldContentContract.schemaVersion}</strong></div>
        <div><span>Registry owner</span><strong>{worldContentContract.registryOwner}</strong></div>
        <div><span>Content types</span><strong>{worldContentContract.types.map(({ id }) => id).join(" · ")}</strong></div>
        <a href={routeHref("/v2/frontmatter/#schema-world")}>Inspect shared contract ↗</a>
      </section>

      <nav class="world-section-index" aria-label="World application laboratory screens">
        {worldSections.map((section, index) => (
          <a href={`#${section.id}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <b>{section.label}</b>
            <small>{section.detail}</small>
          </a>
        ))}
      </nav>

      <section class="world-lab-section" id="front-page">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 01 · Public front page</p><h2>Useful before sign-in. Precise about every source.</h2></div>
          <p>Hot, New, Following, and Clippings share one reading grammar. Each row distinguishes source type, original author, submitter, canonical URL, points, comments, age, provenance, and contribution evidence.</p>
        </header>
        <div class="world-lab-canvas"><WorldFrontPage /></div>
        <div class="world-screen-notes">
          <article><b>World-first discovery</b><p>Native articles, package releases, reviewed feeds, and clippings can coexist without pretending to be the same source.</p></article>
          <article><b>No hidden authority</b><p>Package and namespace facts are linked as evidence; story score never grants stewardship.</p></article>
          <article><b>States remain useful</b><p>Empty following, partial evidence, stale feeds, and moderated records all explain the next safe action.</p></article>
        </div>
      </section>

      <section class="world-lab-section" id="article-thread">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 02 · Article + durable thread</p><h2>The comment body can disappear. Its state and receipt cannot.</h2></div>
          <p>Published, collapsed, deleted, moderated, and offline-composer states retain addressable revisions. Owned bots show their BOT label, owner, owner presence, purpose, sources, policy, and comment receipt before they speak.</p>
        </header>
        <div class="world-lab-canvas world-lab-canvas--tall"><WorldThread /></div>
        <div class="world-screen-notes">
          <article><b>Canonical article</b><p>Authorship, exact revision, review, package evidence, and publication receipt remain separate from thread popularity.</p></article>
          <article><b>Accountable automation</b><p>A bot cannot reply while its owner is absent when policy requires live owner presence.</p></article>
          <article><b>Moderation is data</b><p>Tombstones and reasons preserve thread topology without republishing unsafe content.</p></article>
        </div>
      </section>

      <section class="world-lab-section" id="clipping">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 03 · Clipping workflow</p><h2>Add context without taking ownership of the source.</h2></div>
          <p>Capture fences the canonical URL, provider snapshot, source digest, permission, and retrieval time. The submitter can add a title, note, topics, and discussion prompt, but source-controlled facts stay locked through review and publication.</p>
        </header>
        <div class="world-lab-canvas"><WorldClipping /></div>
        <div class="world-screen-notes">
          <article><b>Source is controlled</b><p>The browser cannot overwrite original author, canonical URL, import receipt, or transformation history.</p></article>
          <article><b>Context is authored</b><p>The World note is visible as a separate contribution with its own identity and revision.</p></article>
          <article><b>Failure is bounded</b><p>Duplicate, unavailable-source, and unclear-permission states stop unsafe publication without discarding the draft.</p></article>
        </div>
      </section>

      <section class="world-lab-section" id="feeds">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 04 · Feed directory + submission</p><h2>Open syndication requires visible permission and source health.</h2></div>
          <p>Reviewed package, RSS, and Atom sources expose owner, cadence, lifecycle, last successful fetch, failure class, and review receipt. Submission verifies control before the first imported entry is eligible for World.</p>
        </header>
        <div class="world-lab-canvas"><WorldFeedDirectory /></div>
        <div class="world-screen-notes">
          <article><b>Portable follows</b><p>RSS, Atom, JSON Feed, and OPML remain first-class rather than account lock-in.</p></article>
          <article><b>Review before inclusion</b><p>A syntactically valid feed is not automatically relevant, permitted, or attributable.</p></article>
          <article><b>Degraded, not erased</b><p>Stale or failing sources retain last reviewed entries and exact fetch evidence.</p></article>
        </div>
      </section>

      <section class="world-lab-section" id="profile">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 05 · Contributor profile</p><h2>GitHub anchors identity. Registries substantiate contribution.</h2></div>
          <p>Profiles show activity, packages, namespace stewardship, badges, and owned bots, but each authority-like fact links to its source registry and receipt. A profile description cannot grant package, namespace, specification, or editorial power.</p>
        </header>
        <div class="world-lab-canvas"><WorldProfile /></div>
        <div class="world-screen-notes">
          <article><b>Stable subject</b><p>GitHub login may change; the reviewed numeric subject remains the identity anchor.</p></article>
          <article><b>Evidence-backed badges</b><p>Badges describe current registry facts and become stale when their evidence cannot be refreshed.</p></article>
          <article><b>Owned automation</b><p>Every bot appears on the accountable owner’s public profile with policy and source boundaries.</p></article>
        </div>
      </section>

      <section class="world-lab-section" id="presence">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 06 · Optional presence</p><h2>Ambient awareness should not become a permanent activity ledger.</h2></div>
          <p>Online, away, recent, offline, hidden, and unavailable states are account-scoped and opt-in. Presence never changes contribution evidence. When the service fails, discussion remains available and owner-present bots pause.</p>
        </header>
        <div class="world-lab-canvas"><WorldPresence /></div>
        <div class="world-screen-notes">
          <article><b>Hidden by default</b><p>Users choose visibility, activity disclosure, last-seen precision, and bot participation independently.</p></article>
          <article><b>No implied endorsement</b><p>Being present in a thread does not count as authorship, review, or agreement.</p></article>
          <article><b>Graceful degradation</b><p>A presence outage renders everyone offline without blocking reading, comments, or durable publication.</p></article>
        </div>
      </section>

      <section class="world-lab-section" id="digest">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Screen 07 · What’s New digest</p><h2>One reviewed edition, three portable projections.</h2></div>
          <p>The weekly digest selects already approved World objects and produces web, email, and RSS editions from one fenced revision. Each output has its own delivery receipt and idempotent retry state.</p>
        </header>
        <div class="world-lab-canvas"><WorldDigest /></div>
        <div class="world-screen-notes">
          <article><b>Selection is editorial</b><p>Popularity can inform the queue but cannot silently publish a digest edition.</p></article>
          <article><b>Canonical links survive</b><p>Every item points to the reviewed World object and, for clippings, onward to the original source.</p></article>
          <article><b>Partial delivery is explicit</b><p>Successful outputs remain valid while a failed destination retries from the same edition receipt.</p></article>
        </div>
      </section>

      <section class="world-governance-section" id="state-coverage">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Acceptance ledger</p><h2>Initial, active, empty, stale, failure, and moderation states are named.</h2></div>
          <p>These are product states, not decorative card variants. Downstream implementations should preserve the semantic identifier, explanation, evidence boundary, and available recovery action.</p>
        </header>
        <div class="world-state-ledger">
          {stateEntries.map(([family, states], index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{family}</h3><p>{states.join(" · ")}</p></div>
              <strong>{states.length} states</strong>
            </article>
          ))}
        </div>
      </section>

      <section class="world-governance-section" id="boundary">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Product boundary</p><h2>{worldProductBoundary.statement}</h2></div>
          <p>World owns public reading, discussion, contributor context, and accountable automation. It links to authoritative registries rather than absorbing their business rules.</p>
        </header>
        <div class="world-boundary-grid">
          <article>
            <h3>World owns</h3>
            <ol>{worldProductBoundary.owns.map((item) => <li>{item}</li>)}</ol>
          </article>
          <article>
            <h3>World routes outward</h3>
            {worldProductBoundary.excludes.map((item) => (
              <a href={routeHref(item.destination)}>
                <span>{item.capability}</span><b>{item.owner} →</b>
              </a>
            ))}
          </article>
        </div>
      </section>

      <section class="world-governance-section" id="historical-studies">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Retained references</p><h2>Earlier studies remain reachable without redefining the product.</h2></div>
          <p>The primary `/v2/world/` route is now the acceptance surface. Broader aggregation, onboarding, and experimental compositions remain useful design evidence and teaching material.</p>
        </header>
        <div class="world-study-grid">
          {historicalWorldStudies.map((study) => (
            <a href={routeHref(study.path)}>
              <span>{study.id}</span>
              <h3>{study.label}</h3>
              <p>{study.summary}</p>
              <b>Open study ↗</b>
            </a>
          ))}
        </div>
      </section>

      <section class="world-governance-section" id="adoption">
        <header class="world-lab-section-head">
          <div><p class="hara-v2-kicker">Downstream adoption · hara-lang/hara-world</p><h2>Map the visual contract onto the existing portable publication architecture.</h2></div>
          <p>The target repository already separates private Neon workflow state from reviewed Git content, keeps feed intake permission in a source registry, and uses a release algebra plus provider outbox. The next implementation should preserve those boundaries while adding durable discussion, evidence projections, and optional presence.</p>
        </header>
        <div class="world-adoption-ledger">
          {haraWorldAdoption.map((step, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step.label}</h3><code>{step.target}</code><p>{step.detail}</p></div>
            </article>
          ))}
        </div>
        <div class="world-adoption-actions">
          <a class="hara-v2-button" data-variant="primary" href={haraWorldHref}>Open hara-world ↗</a>
          <a class="hara-v2-button" href={issueHref}>Review issue #42 ↗</a>
          <a class="hara-v2-button" href={routeHref("/v2/frontmatter/#schema-world")}>Inspect hara.world contract</a>
        </div>
      </section>

      <footer class="world-application-footer">
        <span>Hara World v2 application laboratory · focused community reader</span>
        <span><a href={issueHref}>Issue #42</a> · <a href={haraWorldHref}>hara-world</a> · <a href={routeHref("/v2/")}>v2 catalogue</a></span>
      </footer>
    </main>
  </body>
</html>
