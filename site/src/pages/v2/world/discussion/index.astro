---
import ThemeToggle from "../../../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../../../src/astro/HaraMark.astro";
import Shell from "../../../../../../src/astro/v2/Shell.astro";
import Header from "../../../../../../src/astro/v2/Header.astro";
import ContextNav from "../../../../../../src/astro/v2/ContextNav.astro";
import Sidebar from "../../../../../../src/astro/v2/Sidebar.astro";
import "../../../../../../src/v2.css";
import "../../../../../../src/theme.js";
import "../../../../styles/v2-lab.css";
import "../../../../styles/v2-calm-lab.css";
import "../../../../styles/v2-world-lab.css";
import "../../../../styles/v2-world-discussion.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}v2/world/discussion/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const worldLab = `${basePath}v2/world/`;
const learnUrl = "https://learn.hara-lang.org/";

const ecosystemNav = [
  { href: "#front-page", label: "Home" },
  { href: "#front-page", label: "World", current: true },
  { href: "#profile", label: "Packages" },
  { href: "#front-page", label: "Specs" },
  { href: learnUrl, label: "Learn", external: true }
];

const worldNav = (current) => [
  { href: "#front-page", label: "Hot", current: current === "hot" },
  { href: "#front-page", label: "New", current: current === "new" },
  { href: "#front-page", label: "Following", current: current === "following" },
  { href: "#clipping", label: "Clippings", current: current === "clippings" },
  { href: "#profile", label: "Profiles", current: current === "profiles" }
];

const frontPageSidebar = [
  { label: "Front page", items: [
    { href: "#front-page", label: "All Hara", current: true, badge: 38 },
    { href: "#front-page", label: "Language", badge: 12 },
    { href: "#front-page", label: "Packages", badge: 9 },
    { href: "#front-page", label: "Projects", badge: 11 },
    { href: "#front-page", label: "Community", badge: 6 }
  ] },
  { label: "Your world", items: [
    { href: "#front-page", label: "Following", badge: 8 },
    { href: "#clipping", label: "Saved clippings", badge: 14 },
    { href: "#thread", label: "Saved threads", badge: 5 }
  ] }
];

const threadSidebar = [
  { label: "Discussion", items: [
    { href: "#thread", label: "Best comments", current: true, badge: 34 },
    { href: "#thread", label: "New comments", badge: 7 },
    { href: "#thread", label: "People here", badge: 9 }
  ] },
  { label: "Related", items: [
    { href: "#front-page", label: "std.typed" },
    { href: "#clipping", label: "Schema clippings", badge: 4 },
    { href: "#profile", label: "Contributors", badge: 6 }
  ] }
];

const clippingSidebar = [
  { label: "Create clipping", items: [
    { href: "#clipping", label: "01 · Source", current: true },
    { href: "#clipping", label: "02 · Excerpt" },
    { href: "#clipping", label: "03 · Context" },
    { href: "#clipping", label: "04 · Publish" }
  ] },
  { label: "Principles", items: [
    { href: "#clipping", label: "Keep canonical link" },
    { href: "#clipping", label: "Quote narrowly" },
    { href: "#clipping", label: "Add your context" }
  ] }
];

const presenceSidebar = [
  { label: "Online now", items: [
    { href: "#presence", label: "Everyone", current: true, badge: 22 },
    { href: "#presence", label: "Commenting", badge: 7 },
    { href: "#presence", label: "Reading", badge: 8 },
    { href: "#presence", label: "Maintaining", badge: 3 },
    { href: "#presence", label: "Accountable bots", badge: 4 }
  ] },
  { label: "Active threads", items: [
    { href: "#thread", label: "Schema values", badge: 9 },
    { href: "#front-page", label: "Hoplite release", badge: 5 },
    { href: "#front-page", label: "Snippet of the day", badge: 4 }
  ] }
];

const profileSidebar = [
  { label: "Profile", items: [
    { href: "#profile", label: "Overview", current: true },
    { href: "#profile", label: "Contributions", badge: 137 },
    { href: "#profile", label: "Packages", badge: 8 },
    { href: "#profile", label: "Comments", badge: 143 },
    { href: "#profile", label: "Clippings", badge: 12 }
  ] },
  { label: "Identity", items: [
    { href: "#profile", label: "Contribution badges", badge: 5 },
    { href: "#profile", label: "Owned bots", badge: 2 }
  ] }
];

const boundarySidebar = [
  { label: "World", items: [
    { href: "#scope", label: "Articles and feeds", current: true },
    { href: "#scope", label: "Clippings" },
    { href: "#scope", label: "Comments" },
    { href: "#scope", label: "Presence" },
    { href: "#scope", label: "Profiles" }
  ] },
  { label: "Separate product", items: [
    { href: learnUrl, label: "learn.hara-lang.org ↗" }
  ] }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Focused Hara World v2 discussion laboratory: ranked articles and feeds, clippings, threaded comments, online presence, accountable bots, contributor profiles, and a separate Learn product." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara World discussion and presence laboratory" />
    <meta property="og:description" content="A smaller Hara World focused on sources, clippings, comments, people, packages, and visible community presence." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara World discussion and presence laboratory" />
    <meta name="twitter:description" content="Articles, feeds, clippings, comments, presence, and contribution identity in Hara v2." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara World discussion and presence laboratory</title>
  </head>
  <body class="hara-v2">
    <header class="v2-lab-header">
      <a class="v2-lab-brand" href={worldLab}>
        <HaraMark size={28} />
        <b>Hara visual language</b>
        <small>Focused World field test</small>
      </a>
      <nav aria-label="Focused World prototype screens">
        <a href="#front-page">Front page</a>
        <a href="#thread">Thread</a>
        <a href="#clipping">Clipping</a>
        <a href="#presence">Online</a>
        <a href="#profile">Profile</a>
        <a href="#scope">Scope</a>
      </nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main world-lab-main">
      <section class="world-discussion-hero">
        <div>
          <p class="hara-v2-kicker">Focused product study · World v2</p>
          <h1>A front page for the Hara community.</h1>
          <p>World becomes deliberately smaller: a ranked index of articles and feeds, portable clippings, durable comment threads, visible community presence, and contributor profiles grounded in packages and reviewed work. Learning moves out to its own product.</p>
          <div class="world-lab-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#front-page">Open the front page</a>
            <a class="hara-v2-button" href="#thread">Inspect a discussion</a>
            <a class="world-lab-back-link" href={worldLab}>← Earlier broad World study</a>
          </div>
        </div>
        <div class="world-focus-map" aria-label="Focused World product map">
          <div class="world-focus-core"><span>World</span><small>discussion index</small></div>
          <span class="world-focus-node world-focus-node--articles">Articles</span>
          <span class="world-focus-node world-focus-node--clips">Clippings</span>
          <span class="world-focus-node world-focus-node--comments">Comments</span>
          <span class="world-focus-node world-focus-node--people">People</span>
          <span class="world-focus-node world-focus-node--online">Online</span>
          <a class="world-focus-learn" href={learnUrl}>Learn lives elsewhere ↗</a>
        </div>
      </section>

      <nav class="world-discussion-index" aria-label="Focused World screen catalogue">
        <a href="#front-page"><strong>Front page</strong><span>Ranked articles, syndicated feeds, clippings, package releases, snippet of the day, and online presence.</span><code>sources / ranking / discovery</code></a>
        <a href="#thread"><strong>Article thread</strong><span>Outbound source, linked users, nested comments, owner-present bot replies, and participants online.</span><code>article / comments / identity</code></a>
        <a href="#clipping"><strong>Clipping</strong><span>A narrow excerpt with canonical provenance, contributor context, topics, and its own discussion.</span><code>quote / source / context</code></a>
        <a href="#presence"><strong>Online presence</strong><span>People around active threads, package maintainers, and bots visibly connected to accountable owners.</span><code>presence / threads / bots</code></a>
        <a href="#profile"><strong>Contributor profile</strong><span>Packages, reviewed contributions, evidence-linked badges, comments, clippings, and owned bots.</span><code>work / packages / badges</code></a>
        <a href="#scope"><strong>World / Learn boundary</strong><span>World owns discussion and community identity. Learn owns tutorials, koans, courses, and progress.</span><code>focus / handoff / domains</code></a>
      </nav>

      <section class="world-discussion-screen" id="front-page">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 01 · Ranked community index</p><h2>Articles and feeds are the centre.</h2></div>
          <p>The home page behaves like a small technical Reddit: sources first, visible provenance, compact ranking, and discussion counts. It does not attempt to be a course, project manager, or game hub.</p>
        </header>
        <div class="world-discussion-canvas">
          <Shell embedded={true} sidebar={true} aside={true} mainId="world-front-page-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("hot")}>
              <a class="hara-v2-button" href="#clipping">Create clipping</a>
              <a class="hara-v2-button" data-variant="primary" href="#front-page">Submit article ↗</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="Hara World" groups={frontPageSidebar}>
              <span>RSS, Atom, JSON Feed, and canonical links remain first-class.</span>
            </Sidebar>

            <div class="world-front-heading">
              <div><p class="hara-v2-kicker">Front page</p><h1>What the Hara community is reading and discussing.</h1></div>
              <span class="hara-v2-badge" data-tone="success">22 online</span>
            </div>
            <div class="hara-v2-tabs world-sort-tabs" role="tablist" aria-label="Front page sorting">
              <button class="hara-v2-tab" role="tab" aria-selected="true">Hot</button>
              <button class="hara-v2-tab" role="tab">New</button>
              <button class="hara-v2-tab" role="tab">Top</button>
              <button class="hara-v2-tab" role="tab">Following</button>
            </div>

            <div class="world-post-list">
              <article class="world-post world-post--article">
                <div class="world-vote-rail">
                  <button type="button" aria-label="Upvote article" aria-pressed="false" data-vote="up">▲</button>
                  <strong data-vote-score>86</strong>
                  <button type="button" aria-label="Downvote article" aria-pressed="false" data-vote="down">▼</button>
                </div>
                <div class="world-post-body">
                  <div class="world-post-kicker"><span>Article</span><a href="#thread">hara-lang.org</a><small>submitted by <a href="#profile">@chris</a> · 42 min ago</small></div>
                  <h2><a href="#thread">Schema values are making the type system feel like ordinary Hara</a></h2>
                  <p>A field note on the boundary between typed values, portable forms, and the compiler.</p>
                  <footer><a href="#thread"><b>34 comments</b></a><button type="button">save</button><button type="button">clip</button><span>std.typed</span></footer>
                </div>
              </article>

              <article class="world-post world-post--clipping">
                <div class="world-vote-rail">
                  <button type="button" aria-label="Upvote clipping" aria-pressed="false" data-vote="up">▲</button>
                  <strong data-vote-score>52</strong>
                  <button type="button" aria-label="Downvote clipping" aria-pressed="false" data-vote="down">▼</button>
                </div>
                <div class="world-post-body">
                  <div class="world-post-kicker"><span>Clipping</span><a href="#clipping">github.com</a><small>clipped by <a href="#profile">@mina</a> · 1 hr ago</small></div>
                  <h2><a href="#clipping">“The executor and store can remain separate without inventing a runtime object.”</a></h2>
                  <blockquote>Execution asks what can happen now; storage answers what already happened. The ABI can remain ordinary data between them.</blockquote>
                  <footer><a href="#clipping"><b>18 comments</b></a><button type="button">save</button><button type="button">open source</button><span>work.*</span></footer>
                </div>
              </article>

              <article class="world-post world-post--release">
                <div class="world-vote-rail">
                  <button type="button" aria-label="Upvote package release" aria-pressed="false" data-vote="up">▲</button>
                  <strong data-vote-score>41</strong>
                  <button type="button" aria-label="Downvote package release" aria-pressed="false" data-vote="down">▼</button>
                </div>
                <div class="world-post-body">
                  <div class="world-post-kicker"><span>Package feed</span><a href="#profile">packages.hara-lang.org</a><small>published by <a href="#profile">@sara</a> · 2 hrs ago</small></div>
                  <h2><a href="#thread">std.graphics 0.8.0 adds portable scene and material forms</a></h2>
                  <p>Release notes, migration surface, and three source-linked examples.</p>
                  <footer><a href="#thread"><b>11 comments</b></a><button type="button">save</button><button type="button">open package</button><span>graphics</span></footer>
                </div>
              </article>

              <article class="world-post world-post--discussion">
                <div class="world-vote-rail">
                  <button type="button" aria-label="Upvote discussion" aria-pressed="false" data-vote="up">▲</button>
                  <strong data-vote-score>27</strong>
                  <button type="button" aria-label="Downvote discussion" aria-pressed="false" data-vote="down">▼</button>
                </div>
                <div class="world-post-body">
                  <div class="world-post-kicker"><span>Discussion</span><small>started by <a href="#profile">@ari</a> · 3 hrs ago</small></div>
                  <h2><a href="#thread">What belongs in std.lib.* versus a host-specific provider?</a></h2>
                  <p>Trying to keep the portable surface useful without hiding the native boundary.</p>
                  <footer><a href="#thread"><b>29 comments</b></a><button type="button">save</button><span>architecture</span></footer>
                </div>
              </article>
            </div>

            <div slot="aside" class="world-discussion-aside">
              <section class="hara-v2-panel world-snippet-card">
                <header class="hara-v2-panel-header"><h2>Snippet of the day</h2><span class="hara-v2-badge" data-tone="signal">#042</span></header>
                <div class="hara-v2-panel-body">
                  <p>Clippings, sorted by the source they point back to.</p>
                  <pre><code>(-&gt;&gt; clippings
     (group-by :source-id)
     (sort-by (comp count val) &gt;))</code></pre>
                  <div class="world-snippet-actions">
                    <a class="hara-v2-button" data-variant="primary" href="#thread">Discuss snippet</a>
                    <button class="hara-v2-button" type="button" data-copy-snippet>Copy</button>
                  </div>
                  <small>Shared by <a href="#profile">@noah</a> from <a href="#profile">std.world/feed</a>.</small>
                </div>
              </section>

              <section class="hara-v2-panel world-online-mini">
                <header class="hara-v2-panel-header"><h2>Online now</h2><a href="#presence">See everyone</a></header>
                <div class="hara-v2-panel-body">
                  <div class="world-online-bubbles" aria-label="People online">
                    <a href="#profile" title="@mina online"><span>MN</span><i></i></a>
                    <a href="#profile" title="@chris online"><span>CZ</span><i></i></a>
                    <a href="#profile" title="@sara online"><span>SV</span><i></i></a>
                    <a href="#profile" title="@ari online"><span>AK</span><i></i></a>
                    <a class="is-bot" href="#thread" title="@buildwatcher bot, owner present"><span>BW</span><i></i></a>
                  </div>
                  <p><b>22 people</b> and <b>4 accountable bots</b> are present across 9 active threads.</p>
                  <a class="world-text-link" href="#presence">Open presence view →</a>
                </div>
              </section>

              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>Feed sources</h2></header>
                <div class="hara-v2-panel-body world-source-list">
                  <div><b>Hara repositories</b><span>12 active feeds</span></div>
                  <div><b>Community blogs</b><span>17 active feeds</span></div>
                  <div><b>Package releases</b><span>8 active feeds</span></div>
                </div>
              </section>
            </div>
          </Shell>
        </div>
        <div class="world-lab-notes">
          <article><b>Source before platform</b><p>Every article and clipping keeps its canonical origin visible. World is the discussion index, not the owner of the source.</p></article>
          <article><b>Compact ranking</b><p>Votes, age, source, and comment count support discovery without replacing editorial provenance.</p></article>
          <article><b>No learning dashboard</b><p>The daily object is a community snippet with a thread. Structured instruction belongs to Learn.</p></article>
        </div>
      </section>

      <section class="world-discussion-screen" id="thread">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 02 · Article and comment thread</p><h2>The article stays external; the conversation gathers here.</h2></div>
          <p>Comments are durable, nested, and identity-rich. User mentions link to profiles. Bot comments are visibly labelled and permitted only while an accountable owner is present.</p>
        </header>
        <div class="world-discussion-canvas world-discussion-canvas--thread">
          <Shell embedded={true} sidebar={true} aside={true} mainId="world-thread-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Account">◎</button>
              <ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("hot")}>
              <a class="hara-v2-button" href="#front-page">← Front page</a>
              <a class="hara-v2-button" href="#clipping">Clip article</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="Thread" groups={threadSidebar}>
              <span>Comments can mention users, packages, bots, and source-linked clippings.</span>
            </Sidebar>

            <article class="world-thread-article">
              <div class="world-vote-rail">
                <button type="button" aria-label="Upvote article" aria-pressed="true" data-vote="up">▲</button>
                <strong data-vote-score>87</strong>
                <button type="button" aria-label="Downvote article" aria-pressed="false" data-vote="down">▼</button>
              </div>
              <div>
                <div class="world-post-kicker"><span>Article</span><a href="#thread">hara-lang.org ↗</a><small>submitted by <a href="#profile">@chris</a> · 42 min ago</small></div>
                <h1>Schema values are making the type system feel like ordinary Hara</h1>
                <p>The article remains on its canonical site. World carries the source facts, a short summary, related clippings, and the community conversation.</p>
                <div class="world-thread-actions"><a class="hara-v2-button" data-variant="primary" href="#thread">Open original ↗</a><button class="hara-v2-button" type="button">Save</button><a class="hara-v2-button" href="#clipping">Create clipping</a></div>
              </div>
            </article>

            <section class="world-comment-composer">
              <div class="hara-v2-avatar">CZ</div>
              <div>
                <label for="world-comment">Join the discussion as <a href="#profile">@chris</a></label>
                <textarea id="world-comment" class="hara-v2-field" rows="4" placeholder="Add context, link a user or package, or reply with a source…"></textarea>
                <footer><span>Markdown · user and package mentions resolve to profiles</span><button class="hara-v2-button" data-variant="primary" type="button">Comment</button></footer>
              </div>
            </section>

            <div class="world-comment-toolbar">
              <b>34 comments</b>
              <div><button aria-pressed="true">Best</button><button>New</button><button>Old</button></div>
            </div>

            <section class="world-comment-tree" aria-label="Comments">
              <article class="world-comment" data-comment>
                <div class="world-comment-line"><span class="world-presence-dot" data-status="online"></span></div>
                <div class="world-comment-main">
                  <header><a href="#profile">@mina</a><span class="world-contribution-mark">package maintainer</span><time>28 min ago</time></header>
                  <div class="world-comment-body"><p>The useful change is that tooling no longer needs a parallel schema registry. <a href="#profile">@chris</a>, does the compiler now receive the same value that a normal program can inspect?</p></div>
                  <footer class="world-comment-actions"><button type="button">▲ 21</button><button type="button">Reply</button><button type="button">Permalink</button><button type="button" data-comment-toggle>Collapse</button></footer>

                  <div class="world-comment-children">
                    <article class="world-comment" data-comment>
                      <div class="world-comment-line"><span class="world-presence-dot" data-status="online"></span></div>
                      <div class="world-comment-main">
                        <header><a href="#profile">@chris</a><span class="world-contribution-mark">core contributor</span><time>19 min ago</time></header>
                        <div class="world-comment-body"><p>Yes. The compile path can attach evidence, but the schema itself is still an ordinary Hara value. I clipped the exact boundary <a href="#clipping">here</a>.</p></div>
                        <footer class="world-comment-actions"><button type="button">▲ 14</button><button type="button">Reply</button><button type="button">Permalink</button><button type="button" data-comment-toggle>Collapse</button></footer>
                      </div>
                    </article>

                    <article class="world-comment world-comment--bot" data-comment data-bot-owner="@mina">
                      <div class="world-comment-line"><span class="world-presence-dot" data-status="bot"></span></div>
                      <div class="world-comment-main">
                        <header>
                          <a href="#profile">@buildwatcher</a>
                          <span class="world-bot-label">BOT</span>
                          <span>owned by <a href="#profile">@mina</a></span>
                          <span class="hara-v2-badge" data-tone="success">Owner present</span>
                          <time>12 min ago</time>
                        </header>
                        <div class="world-comment-body">
                          <p><code>std.typed 1.4.0</code> now exports 18 public schema forms. The release and package index agree at commit <code>5ce1…</code>.</p>
                          <div class="world-bot-receipt"><b>Automated source</b><span>packages registry · exact revision · no editorial endorsement</span></div>
                        </div>
                        <footer class="world-comment-actions"><button type="button">▲ 9</button><button type="button">Reply</button><button type="button">View bot profile</button><button type="button" data-comment-toggle>Collapse</button></footer>
                      </div>
                    </article>
                  </div>
                </div>
              </article>

              <article class="world-comment" data-comment>
                <div class="world-comment-line"><span class="world-presence-dot" data-status="away"></span></div>
                <div class="world-comment-main">
                  <header><a href="#profile">@ari</a><span class="world-contribution-mark">reviewer</span><time>9 min ago</time></header>
                  <div class="world-comment-body"><p>I would like the article to link one counterexample where metadata is still the better boundary. Otherwise the “ordinary value” claim reads broader than the current implementation.</p></div>
                  <footer class="world-comment-actions"><button type="button">▲ 7</button><button type="button">Reply</button><button type="button">Permalink</button><button type="button" data-comment-toggle>Collapse</button></footer>
                </div>
              </article>
            </section>

            <div slot="aside" class="world-discussion-aside">
              <section class="hara-v2-panel">
                <header class="hara-v2-panel-header"><h2>In this thread</h2><span class="hara-v2-badge" data-tone="success">9 present</span></header>
                <div class="hara-v2-panel-body world-thread-people">
                  <a href="#profile"><span class="hara-v2-avatar">MN</span><b>@mina</b><small>commenting</small></a>
                  <a href="#profile"><span class="hara-v2-avatar">CZ</span><b>@chris</b><small>replying</small></a>
                  <a href="#profile"><span class="hara-v2-avatar">AK</span><b>@ari</b><small>reading</small></a>
