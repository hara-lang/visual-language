                <a class="hara-v2-button" data-variant="primary" href={learnUrl} target="_blank" rel="noreferrer">Open Learn ↗</a>
              </section>
            </div>

            <section class="world-boundary-example">
              <div>
                <p class="hara-v2-kicker">Example handoff</p>
                <h2>Snippet of the day stays social.</h2>
                <p>World hosts the snippet, source attribution, votes, clippings, and comments. A reader who wants the underlying concept follows a deliberate link into Learn.</p>
              </div>
              <pre><code>(-&gt;&gt; entries
     (filter :published?)
     (sort-by :score &gt;))</code></pre>
              <div><a class="hara-v2-button" href="#thread">Discuss on World</a><a class="hara-v2-button" data-variant="primary" href={learnUrl}>Read the pipeline explanation on Learn ↗</a></div>
            </section>
          </Shell>
        </div>
        <div class="world-lab-notes">
          <article><b>World stays legible</b><p>Its navigation describes content and discussion rather than mixing in curriculum state.</p></article>
          <article><b>Learn can go deeper</b><p>Tutorial structure, execution, progress, and pedagogy can evolve without making World heavier.</p></article>
          <article><b>Identity can remain shared</b><p>The same Hara identity can link a contributor profile and a separate learning profile without merging the products.</p></article>
        </div>
      </section>

      <footer class="v2-lab-footer">
        <span>Focused World discussion study · Visual language v2</span>
        <span><a href={worldLab}>Broad World study</a> · <a href={learnUrl}>Learn boundary ↗</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>

    <script>
      const initWorldDiscussionPrototype = () => {
        document.querySelectorAll("[data-vote]").forEach((button) => {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            const rail = button.closest(".world-vote-rail");
            const score = rail?.querySelector("[data-vote-score]");
            if (!rail || !score) return;
            const current = Number(score.textContent || "0");
            const wasPressed = button.getAttribute("aria-pressed") === "true";
            rail.querySelectorAll("[data-vote]").forEach((peer) => peer.setAttribute("aria-pressed", "false"));
            if (wasPressed) {
              score.textContent = String(current + (button.dataset.vote === "up" ? -1 : 1));
              return;
            }
            button.setAttribute("aria-pressed", "true");
            score.textContent = String(current + (button.dataset.vote === "up" ? 1 : -1));
          });
        });

        document.querySelectorAll("[data-comment-toggle]").forEach((button) => {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            const comment = button.closest("[data-comment]");
            if (!comment) return;
            const body = comment.querySelector(":scope > .world-comment-main > .world-comment-body");
            const children = comment.querySelector(":scope > .world-comment-main > .world-comment-children");
            const collapsed = comment.dataset.collapsed === "true";
            comment.dataset.collapsed = collapsed ? "false" : "true";
            if (body instanceof HTMLElement) body.hidden = !collapsed;
            if (children instanceof HTMLElement) children.hidden = !collapsed;
            button.textContent = collapsed ? "Collapse" : "Expand";
          });
        });

        document.querySelectorAll("[data-presence-filter]").forEach((button) => {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            const filter = button.dataset.presenceFilter || "all";
            const shell = button.closest(".hara-v2-shell");
            shell?.querySelectorAll("[data-presence-filter]").forEach((peer) => peer.setAttribute("aria-selected", String(peer === button)));
            shell?.querySelectorAll("[data-presence-state]").forEach((node) => {
              if (node instanceof HTMLElement) node.hidden = filter !== "all" && node.dataset.presenceState !== filter;
            });
          });
        });

        document.querySelectorAll("[data-copy-snippet]").forEach((button) => {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            button.textContent = "Copied";
            setTimeout(() => { button.textContent = "Copy"; }, 1200);
          });
        });

        document.querySelectorAll("[data-clip-preview]").forEach((button) => {
          if (button.dataset.bound === "true") return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            const shell = button.closest(".hara-v2-shell");
            if (!shell) return;
            const title = shell.querySelector("[data-clip-title-input]");
            const excerpt = shell.querySelector("[data-clip-excerpt-input]");
            const note = shell.querySelector("[data-clip-note-input]");
            const setText = (selector, input) => {
              const target = shell.querySelector(selector);
              if (target && (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) target.textContent = input.value;
            };
            setText("[data-clip-title]", title);
            setText("[data-clip-excerpt]", excerpt);
            setText("[data-clip-note]", note);
            button.textContent = "Preview updated";
          });
        });
      };

      initWorldDiscussionPrototype();
      document.addEventListener("astro:page-load", initWorldDiscussionPrototype);
    </script>
  </body>
</html>
