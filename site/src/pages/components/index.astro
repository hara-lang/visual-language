---
import CatalogueHeader from "../../components/v2-catalogue/CatalogueHeader.astro";
import HaraMark from "@hara-lang/ui-astro/astro/HaraMark.astro";
import FleetField from "@hara-lang/ui-astro/astro/v2/FleetField.astro";
import {
  componentGroups,
  publicComponentInventory,
  supportComponentInventory,
  toolComponentInventory,
  v2ComponentInventory
} from "../../lib/v2-component-inventory.mjs";
import "@hara-lang/ui-tool/v2-tool.css";
import "@hara-lang/ui/theme.js";
import "../../styles/v2-components-catalogue.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}components/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueHome = `${basePath}`;
const foundationsRoute = `${basePath}foundations/`;
const toolRoute = `${basePath}tool/`;
const sourceRoot = "https://github.com/hara-lang/visual-language/blob/main/";

const codeExample = [
  "(defn publish-ready? [release]",
  "  (and (:verified release)",
  "       (seq (:artifacts release))))"
].join("\n");

const validationExample = [
  "title: Schema values enter the runtime",
  "status: reviewed",
  "runtime: hbc-wasm",
  "revision: af6273c"
].join("\n");

const cssFamilies = [
  {
    label: "Shell",
    source: "src/v2/shell.css",
    classes: [".hara-v2-shell", ".hara-v2-header", ".hara-v2-context-nav", ".hara-v2-sidebar", ".hara-v2-inspector", ".hara-v2-main"]
  },
  {
    label: "Controls and data",
    source: "src/v2/components.css",
    classes: [".hara-v2-page-header", ".hara-v2-button", ".hara-v2-icon-button", ".hara-v2-command-bar", ".hara-v2-field", ".hara-v2-select", ".hara-v2-panel", ".hara-v2-badge", ".hara-v2-tabs", ".hara-v2-table", ".hara-v2-matrix"]
  },
  {
    label: "Content",
    source: "src/v2/content.css",
    classes: [".hara-v2-code", ".hara-v2-prose", ".hara-v2-callout", ".hara-v2-outline", ".hara-v2-feed", ".hara-v2-story", ".hara-v2-profile-list", ".hara-v2-form-grid"]
  },
  {
    label: "Tool controls",
    source: "src/v2/tool-controls.css",
    classes: [".hara-tool-toolbar", ".hara-tool-group", ".hara-tool-button", ".hara-tool-toggle", ".hara-tool-field", ".hara-tool-select", ".hara-tool-number-input", ".hara-tool-tab-strip", ".hara-tool-icon-rail", ".hara-tool-status-bar"]
  },
  {
    label: "Workbench",
    source: "src/v2/tool-shell.css",
    classes: [".hara-tool-workbench", ".hara-tool-dock-panel", ".hara-tool-panel-header", ".hara-tool-inspector-section", ".hara-tool-floating-palette", ".hara-tool-viewport-overlay"]
  },
  {
    label: "Environment and runtime",
    source: "src/v2/tool-environment.css · src/v2/tool-runtime.css",
    classes: [".hara-tool-environment", ".hara-tool-capability-pane", ".hara-tool-runtime-shell", ".hara-tool-status-lamp", ".hara-tool-runtime-switch", ".hara-tool-connection-row"]
  }
];

const sectionLinks = [
  ["inventory", "Inventory"],
  ["shell-navigation", "Shell & navigation"],
  ["controls", "Controls & forms"],
  ["content-data", "Content & data"],
  ["tool-workbench", "Tool workbench"],
  ["compound-patterns", "Compound patterns"],
  ["states-accessibility", "States & accessibility"],
  ["ownership", "Ownership"]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The complete Hara v2 component inventory: document shell, controls, content, data, tool chrome, runtime, and compound workflow patterns." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 component catalogue" />
    <meta property="og:description" content="Every public v2 and v2-tool Astro export, major CSS family, state, density, accessibility contract, and composition boundary." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 component catalogue" />
    <meta name="twitter:description" content="Reusable Hara interface components and composition patterns." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 component catalogue</title>
  </head>
  <body class="hara-v2 hara-v2-tool components-page">
    <CatalogueHeader basePath={basePath} activePath="/components/" />

    <main class="components-main">
      <section class="components-hero" aria-labelledby="components-title">
        <div>
          <p class="hara-v2-kicker">Shared library · Components</p>
          <h1 id="components-title">Reusable components and their ownership boundaries.</h1>
          <p>For each component, this catalogue records its semantic role, export path, owned states, accessibility contract, responsive behaviour, and the point where application-specific composition begins.</p>
          <div class="components-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#inventory">Browse all exports</a>
            <a class="hara-v2-button" href={foundationsRoute}>Review foundations</a>
            <a class="hara-v2-button" data-variant="ghost" href={toolRoute}>Inspect tool workbenches</a>
          </div>
          <div class="components-hero-stats" aria-label="Component inventory counts">
            <div><strong>{publicComponentInventory.length}</strong><span>public Astro exports</span></div>
            <div><strong>{v2ComponentInventory.length}</strong><span>v2 and v2-tool exports</span></div>
            <div><strong>{toolComponentInventory.length}</strong><span>tool/environment/runtime exports</span></div>
            <div><strong>{supportComponentInventory.length}</strong><span>identity and support exports</span></div>
          </div>
        </div>
        <div class="components-hero-art">
          <FleetField title="Hara component relationship field" />
          <div class="components-hero-node components-hero-node--root"><HaraMark size={38} /><b>Shared contract</b></div>
          <div class="components-hero-node components-hero-node--one"><span>Shell</span><small>navigation</small></div>
          <div class="components-hero-node components-hero-node--two"><span>Content</span><small>data + prose</small></div>
          <div class="components-hero-node components-hero-node--three"><span>Tools</span><small>workbench</small></div>
        </div>
      </section>

      <nav class="components-section-nav" aria-label="Component catalogue sections">
        {sectionLinks.map(([href, label]) => <a href={`#${href}`}>{label}</a>)}
      </nav>

      <section class="components-section" id="inventory">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">01 · Public inventory</p><h2>Exports and semantics stay in sync.</h2></div>
          <p>The visible ledger is backed by a dedicated inventory module and tested directly against package exports. A component is not considered public merely because a class happens to exist in a reference.</p>
        </header>

        <div class="components-inventory-groups">
          {componentGroups.map((group) => (
            <article class="components-inventory-group" id={`inventory-${group.id}`}>
              <header><div><span>{group.label}</span><strong>{group.components.length}</strong></div><p>{group.summary}</p></header>
              <div class="components-inventory-grid">
                {group.components.map((component) => (
                  <section class="components-inventory-card" data-owner={component.owner}>
                    <div class="components-inventory-card-title"><h3>{component.name}</h3><span>{component.owner}</span></div>
                    <p>{component.role}</p>
                    <a href={`${sourceRoot}${component.sourcePath}`}><code>{component.exportPath}</code></a>
                    <dl>
                      <div><dt>States</dt><dd>{component.states.join(" · ")}</dd></div>
                      <div><dt>Density</dt><dd>{component.densities.join(" · ")}</dd></div>
                      <div><dt>Responsive</dt><dd>{component.responsive}</dd></div>
                      <div><dt>Accessibility</dt><dd>{component.accessibility}</dd></div>
                    </dl>
                  </section>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="components-section" id="shell-navigation">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">02 · Shell and navigation</p><h2>Global reference, application context, and local work remain distinct.</h2></div>
          <p>The global catalogue header identifies the design review surface. Product headers and context navigation sit below it. Sidebars and inspectors are optional supporting regions; they never redefine the global route inventory.</p>
        </header>

        <article class="components-specimen components-shell-specimen">
          <header class="components-specimen-head"><div><span>Document shell composition</span><code>Shell · Header · ContextNav · Sidebar · PageHeader</code></div><span class="hara-v2-badge" data-tone="signal">shared</span></header>
          <div class="components-demo-shell">
            <header class="hara-v2-header">
              <a class="hara-v2-brand" href="#shell-navigation"><HaraMark size={25} /><span><b>Hara Packages</b><small>Registry</small></span></a>
              <nav class="hara-v2-primary-nav" aria-label="Package application"><a href="#shell-navigation" aria-current="page">Browse</a><a href="#shell-navigation">Namespaces</a><a href="#shell-navigation">Publish</a></nav>
              <div class="hara-v2-header-actions"><button class="hara-v2-icon-button" type="button" aria-label="Search packages">⌕</button><button class="hara-v2-button" type="button">Sign in</button></div>
            </header>
            <nav class="hara-v2-context-nav" aria-label="Package context"><div class="hara-v2-context-items"><a href="#shell-navigation" aria-current="page">Overview</a><a href="#shell-navigation">Compatibility</a><a href="#shell-navigation">Releases</a><a href="#shell-navigation">Dependents</a></div></nav>
            <div class="components-demo-shell-body">
              <aside class="hara-v2-sidebar"><nav aria-label="Package sections"><a href="#shell-navigation" aria-current="page">Summary</a><a href="#shell-navigation">Namespaces</a><a href="#shell-navigation">Versions</a><a href="#shell-navigation">Provenance</a></nav></aside>
              <main class="hara-v2-main">
                <section class="hara-v2-page-header" data-illustrated="true">
                  <div class="hara-v2-page-copy"><p class="hara-v2-kicker">Package · std.work</p><h1>Replayable work, explicit effects.</h1><p>A package record foregrounds purpose, compatibility, stewardship, and exact publication provenance.</p><div class="hara-v2-page-actions"><button class="hara-v2-button" data-variant="primary" type="button">Install</button><button class="hara-v2-button" type="button">Open examples</button></div><div class="hara-v2-page-meta"><span>v0.8.4</span><span>verified</span><span>6 runtimes</span></div></div>
                  <div class="hara-v2-page-illustration"><FleetField title="Package shell illustration" /></div>
                </section>
              </main>
            </div>
          </div>
          <footer class="components-specimen-notes"><span><b>Landmarks</b> banner, navigation, complementary, main</span><span><b>Collapse</b> inspector → sidebar → horizontal context row</span><span><b>Ownership</b> product labels and routes; shared geometry and state</span></footer>
        </article>

        <div class="components-do-dont">
          <article data-guidance="do"><span>Do</span><strong>Keep route layers distinct.</strong><p>Catalogue navigation, route navigation, page tabs, and section outlines each have one scope.</p></article>
          <article data-guidance="avoid"><span>Avoid</span><strong>Put every destination in one top row.</strong><p>A flat global menu becomes crowded and removes the distinction between ecosystem, product, and document context.</p></article>
        </div>
      </section>

      <section class="components-section" id="controls">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">03 · Controls and forms</p><h2>State is visible before decoration.</h2></div>
          <p>Controls use semantic HTML first. Variants change emphasis or consequence, not meaning. Loading, selected, disabled, success, warning, and danger states retain text and non-colour cues.</p>
        </header>

        <div class="components-controls-grid">
          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Buttons</span><code>.hara-v2-button · .hara-v2-icon-button</code></div></header>
            <div class="components-control-stage">
              <button class="hara-v2-button" type="button">Default</button>
              <button class="hara-v2-button" data-variant="primary" type="button">Primary</button>
              <button class="hara-v2-button" data-variant="ghost" type="button">Ghost</button>
              <button class="hara-v2-button" data-variant="danger" type="button">Revoke</button>
              <button class="hara-v2-button components-loading-button" type="button" aria-busy="true"><i></i> Publishing</button>
              <button class="hara-v2-button" type="button" disabled>Unavailable</button>
              <button class="hara-v2-icon-button" type="button" aria-label="Copy exact revision">⧉</button>
              <button class="hara-v2-icon-button" type="button" aria-label="Saved" aria-pressed="true">✓</button>
            </div>
            <footer class="components-mini-notes"><span>One primary action per local decision</span><span>Icon-only controls require accessible names</span></footer>
          </article>

          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Fields and form groups</span><code>.hara-v2-form-grid · .hara-v2-form-field</code></div></header>
            <form class="hara-v2-form-grid components-form-stage">
              <div class="hara-v2-form-field"><label for="component-package">Package</label><input class="hara-v2-field" id="component-package" value="std.work" /></div>
              <div class="hara-v2-form-field"><label for="component-runtime">Runtime</label><select class="hara-v2-select" id="component-runtime"><option>HBC Wasm</option><option>Interpreter</option><option>JVM</option></select></div>
              <div class="hara-v2-form-field" data-wide="true"><label for="component-summary">Summary</label><textarea class="hara-v2-field" id="component-summary" rows="3">Replayable descriptions with explicit checkpointed effects.</textarea><small>Shown in registry search and package detail.</small></div>
              <div class="hara-v2-form-field components-field-error" data-wide="true"><label for="component-version">Version</label><input class="hara-v2-field" id="component-version" value="latest" aria-invalid="true" aria-describedby="component-version-error" /><small id="component-version-error">Use an exact semantic version, for example 0.8.4.</small></div>
            </form>
          </article>

          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Tabs and segmented choice</span><code>.hara-v2-tabs · .hara-v2-tab</code></div></header>
            <div class="components-tabs-stage">
              <div class="hara-v2-tabs" role="tablist" aria-label="Package views"><button class="hara-v2-tab" role="tab" aria-selected="true" type="button">Overview</button><button class="hara-v2-tab" role="tab" aria-selected="false" type="button">Versions</button><button class="hara-v2-tab" role="tab" aria-selected="false" type="button">Dependents</button><button class="hara-v2-tab" role="tab" aria-selected="false" type="button" disabled>Private audit</button></div>
              <div class="components-segmented" role="group" aria-label="Density"><button type="button" aria-pressed="true">Comfortable</button><button type="button" aria-pressed="false">Compact</button></div>
            </div>
          </article>

          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Panels, badges, and stats</span><code>.hara-v2-panel · .hara-v2-badge · .hara-v2-stat</code></div></header>
            <div class="hara-v2-panel components-panel-stage" data-sketch="true"><header class="hara-v2-panel-header"><h3>Publication receipt</h3><span class="hara-v2-badge" data-tone="success">verified</span></header><div class="hara-v2-panel-body"><div class="hara-v2-stat-grid"><div class="hara-v2-stat"><strong>12</strong><span>artifacts</span></div><div class="hara-v2-stat"><strong>6</strong><span>runtimes</span></div><div class="hara-v2-stat"><strong>0</strong><span>unexplained gaps</span></div><div class="hara-v2-stat"><strong>1</strong><span>exact revision</span></div></div></div><footer class="hara-v2-panel-footer">Receipt 9d7b…e21 · signed by hara-lang</footer></div>
          </article>
        </div>
      </section>

      <section class="components-section" id="content-data">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">04 · Content and data</p><h2>Reading, evidence, and community share one material system.</h2></div>
          <p>Prose, code, tables, matrices, feeds, and profiles use different density and semantics without inventing parallel typography, colour, or surface contracts.</p>
        </header>

        <div class="components-content-grid">
          <article class="components-specimen components-prose-specimen">
            <header class="components-specimen-head"><div><span>Prose, code, callout, outline</span><code>content.css</code></div></header>
            <div class="components-reading-layout">
              <article class="hara-v2-prose"><p class="hara-v2-kicker">Runtime model</p><h2>One lifecycle envelope.</h2><p>Interpreter and HBC execution share session, generation, source-revision fencing, cancellation, and disposal semantics while retaining backend-specific observations.</p><div class="hara-v2-callout"><div><b>Exact state</b><p>Claims expose the session, generation, source revision, and backend that produced them.</p></div></div><div class="hara-v2-code" data-label="Hara"><pre>{codeExample}</pre></div></article>
              <aside class="hara-v2-outline"><b>On this page</b><a href="#content-data" aria-current="true">Lifecycle</a><a href="#content-data">Capabilities</a><a href="#content-data">Cancellation</a><a href="#content-data">Observations</a></aside>
            </div>
          </article>

          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Tables and matrices</span><code>.hara-v2-table · .hara-v2-matrix</code></div></header>
            <div class="components-data-stage">
              <div class="hara-v2-table-wrap"><table class="hara-v2-table"><thead><tr><th>Runtime</th><th>Status</th><th>Median</th><th>Revision</th></tr></thead><tbody><tr data-selected="true"><td>HBC Wasm</td><td><span class="hara-v2-badge" data-tone="signal">selected</span></td><td>4.8 ms</td><td>9d7b…e21</td></tr><tr><td>JVM</td><td><span class="hara-v2-badge" data-tone="success">verified</span></td><td>6.1 ms</td><td>af62…77e</td></tr><tr><td>Interpreter</td><td><span class="hara-v2-badge">baseline</span></td><td>13.2 ms</td><td>9d7b…e21</td></tr></tbody></table></div>
              <div class="hara-v2-matrix"><b>Workload</b><b>HBC</b><b>JVM</b><b>Interp.</b><b>JS</b><b>Rust</b><b>maps</b><span data-win="true">1.0×</span><span>1.3×</span><span>2.7×</span><span>1.8×</span><span>1.1×</span><b>schemas</b><span data-win="true">1.0×</span><span>1.4×</span><span>3.1×</span><span data-warn="true">n/a</span><span>1.2×</span></div>
            </div>
          </article>

          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Feed and story</span><code>.hara-v2-feed · .hara-v2-story</code></div></header>
            <div class="hara-v2-feed components-feed-stage">
              <article class="hara-v2-story"><div class="hara-v2-avatar">M</div><div><h3>Schema values move into the ordinary runtime</h3><p>A release note with migration guidance, exact implementation revision, and runnable examples.</p><div class="hara-v2-story-meta"><span>GitHub</span><span>11 comments</span><span>verified source</span></div></div><time>41 min</time></article>
              <article class="hara-v2-story"><div class="hara-v2-avatar">Q</div><div><h3>I made my first small Hara graphics program</h3><p>A newcomer shares a runnable sketch and asks how browser sessions fit together.</p><div class="hara-v2-story-meta"><span>Reddit</span><span>29 comments</span><span>newcomer</span></div></div><time>3 h</time></article>
            </div>
          </article>

          <article class="components-specimen">
            <header class="components-specimen-head"><div><span>Profile and contribution evidence</span><code>.hara-v2-profile-list · .hara-v2-profile</code></div></header>
            <div class="hara-v2-profile-list components-profile-stage"><article class="hara-v2-profile"><div class="hara-v2-avatar">M</div><div><b>@mina</b><p>Maintains std.work and work.executor · 137 merged contributions · 4 evidence-linked badges.</p></div></article><article class="hara-v2-profile"><div class="hara-v2-avatar">J</div><div><b>@jo</b><p>Maintains hara-wasm-core · 28 accepted reviews · owner of @jo/release-relay.</p></div></article></div>
          </article>
        </div>
      </section>

      <section class="components-section" id="tool-workbench">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">05 · Tool and workbench</p><h2>Dense controls, viewport-first collapse.</h2></div>
          <p>The tool layer is additive to v2. It introduces editor-specific surface and control tokens, but still consumes the Hara identity, document themes, grid, state, focus, and responsive contracts.</p>
        </header>

        <article class="components-specimen components-workbench-specimen">
          <header class="components-specimen-head"><div><span>Editor + viewport + inspector</span><code>Toolbar · WorkbenchShell · DockPanel · InspectorSection · StatusBar</code></div><a href={toolRoute}>Full tool studies →</a></header>
          <div class="hara-tool-workbench components-demo-workbench">
            <div class="hara-tool-workbench-top"><div class="hara-tool-toolbar" data-density="dense"><div class="hara-tool-group"><button class="hara-tool-button" data-active="true" type="button">Run</button><button class="hara-tool-button" type="button">Stop</button><button class="hara-tool-toggle" aria-pressed="true" type="button">Live</button></div><div class="hara-tool-group"><label class="hara-tool-field" data-inline="true"><span>Backend</span><select class="hara-tool-select"><option>HBC Wasm</option><option>Interpreter</option></select></label><label class="hara-tool-field" data-inline="true"><span>Scale</span><span class="hara-tool-number-wrap"><input class="hara-tool-number-input" value="100" /><span class="hara-tool-number-unit">%</span></span></label></div></div></div>
            <div class="hara-tool-workbench-left"><div class="hara-tool-dock-panel" data-position="left" data-size="narrow"><header class="hara-tool-panel-header" data-compact="true"><div class="hara-tool-panel-heading"><span class="hara-tool-panel-eyebrow">Project</span><h3 class="hara-tool-panel-title">Files</h3></div></header><div class="components-file-tree"><button type="button" aria-current="page">main.hal</button><button type="button">scene.hal</button><button type="button">frontmatter.hal</button></div></div></div>
            <div class="hara-tool-workbench-viewport"><div class="components-viewport-code"><code>supersonic-live/main.hal</code><pre>{codeExample}</pre></div><div class="hara-tool-viewport-overlay" data-placement="top-right"><span>session live/8f24</span><span>generation 042</span></div><div class="hara-tool-floating-palette" data-placement="bottom-left"><header class="hara-tool-panel-header" data-compact="true"><div class="hara-tool-panel-heading"><span class="hara-tool-panel-eyebrow">Insert</span><h3 class="hara-tool-panel-title">Command palette</h3></div></header><div class="components-palette-list"><button type="button">Add canvas output</button><button type="button">Open runtime details</button></div></div></div>
            <div class="hara-tool-workbench-right"><div class="hara-tool-dock-panel" data-position="right" data-size="regular" data-selected="true"><header class="hara-tool-panel-header"><div class="hara-tool-panel-heading"><span class="hara-tool-panel-eyebrow">Selection</span><h3 class="hara-tool-panel-title">Runtime inspector</h3></div><span class="hara-tool-panel-metadata">HBC</span></header><details class="hara-tool-inspector-section" open><summary>Session <span class="hara-tool-inspector-summary-meta">ready</span></summary><div class="hara-tool-inspector-body"><label class="hara-tool-field"><span>Generation</span><input class="hara-tool-number-input" value="42" /></label><label class="hara-tool-field"><span>Source revision</span><input class="hara-tool-number-input" value="9d7b…e21" /></label></div></details><details class="hara-tool-inspector-section"><summary>Capabilities <span class="hara-tool-inspector-summary-meta">4</span></summary></details></div></div>
            <div class="hara-tool-workbench-bottom"><div class="hara-tool-dock-panel" data-position="bottom"><div class="hara-tool-tab-strip" role="tablist" aria-label="Observations"><button class="hara-tool-tab" role="tab" aria-selected="true" type="button">Output</button><button class="hara-tool-tab" role="tab" aria-selected="false" type="button">Diagnostics</button><button class="hara-tool-tab" role="tab" aria-selected="false" type="button">Events</button></div><pre class="components-output-log">ready · result registered · sequence 108</pre></div></div>
            <div class="hara-tool-workbench-status"><div class="hara-tool-status-bar"><div class="hara-tool-status-primary"><span>● ready</span><span>main.hal</span></div><div class="hara-tool-status-secondary"><span>rev 9d7b…e21</span><span>Ln 12, Col 4</span></div></div></div>
          </div>
          <footer class="components-specimen-notes"><span><b>Desktop</b> toolbar + left dock + viewport + inspector + output</span><span><b>Tablet</b> inspector yields</span><span><b>Phone</b> rail and bottom dock yield; viewport remains</span></footer>
        </article>
      </section>

      <section class="components-section" id="compound-patterns">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">06 · Compound patterns</p><h2>Components prove themselves in workflows.</h2></div>
          <p>Compound patterns compose existing primitives without creating a product-agnostic mega-component. The shared contract owns geometry and state; each application owns business rules and realistic content.</p>
        </header>

        <div class="components-pattern-grid">
          <article class="components-pattern" id="pattern-search-table"><header><span>Search + filters + result table</span><code>Packages</code></header><div class="hara-v2-command-bar"><strong>84 packages</strong><input class="hara-v2-field" type="search" value="work" aria-label="Search packages" /><select class="hara-v2-select" aria-label="Runtime filter"><option>All runtimes</option></select></div><div class="hara-v2-table-wrap"><table class="hara-v2-table"><tbody><tr><td>std.work</td><td>verified</td><td>6 runtimes</td></tr><tr><td>work.executor</td><td>active</td><td>3 runtimes</td></tr></tbody></table></div><footer><b>Shared</b> search, field, select, table, badges <b>Product</b> ranking and compatibility rules</footer></article>

          <article class="components-pattern" id="pattern-article-outline"><header><span>Article + metadata + outline</span><code>Docs</code></header><div class="components-pattern-reading"><article class="hara-v2-prose"><p class="hara-v2-kicker">Guide · 12 min</p><h2>Build a durable work program.</h2><p>Describe replayable work, isolate checkpointed effects, and expose capabilities explicitly.</p><div class="hara-v2-callout" data-tone="warning"><div><b>Version note</b><p>This guide targets std.work 0.8.</p></div></div></article><aside class="hara-v2-outline"><b>Outline</b><a href="#pattern-article-outline" aria-current="true">Describe</a><a href="#pattern-article-outline">Execute</a><a href="#pattern-article-outline">Checkpoint</a></aside></div><footer><b>Shared</b> prose, callout, outline <b>Product</b> guide sequence and version policy</footer></article>

          <article class="components-pattern" id="pattern-editor-inspector"><header><span>Editor + viewport + inspector</span><code>Playground</code></header><div class="components-pattern-editor"><nav><button type="button" aria-pressed="true">Code</button><button type="button">Canvas</button></nav><main><code>main.hal</code><pre>{codeExample}</pre></main><aside><b>Session</b><span>live/8f24</span><b>Backend</b><span>HBC Wasm</span></aside></div><footer><b>Shared</b> workbench chrome <b>Product</b> run lifecycle and capabilities</footer></article>

          <article class="components-pattern" id="pattern-profile-ledger"><header><span>Profile + contribution ledger</span><code>World / Packages</code></header><div class="components-pattern-profile"><div class="hara-v2-avatar">M</div><div><h3>@mina</h3><p>Package maintainer · helpful reviewer · accountable bot owner</p><div class="hara-v2-stat-grid"><div class="hara-v2-stat"><strong>137</strong><span>merged</span></div><div class="hara-v2-stat"><strong>4</strong><span>packages</span></div><div class="hara-v2-stat"><strong>3</strong><span>namespaces</span></div><div class="hara-v2-stat"><strong>2</strong><span>bots</span></div></div></div></div><footer><b>Shared</b> avatar, badges, stats, table <b>Product</b> evidence and badge qualification</footer></article>

          <article class="components-pattern" id="pattern-feed-discussion"><header><span>Feed item + discussion state</span><code>World</code></header><article class="hara-v2-story"><div class="hara-v2-avatar">H</div><div><h3>Schema values move into the ordinary runtime</h3><p>Canonical release note clustered with two external discussions.</p><div class="hara-v2-story-meta"><span>94 hot</span><span>11 comments</span><span>3 sources</span><span>owner online</span></div><div class="components-comment-row"><span>↳ @mina/build-bot</span><b>BOT</b><small>owned by @mina · owner present</small></div></div><time>41 min</time></article><footer><b>Shared</b> story, metadata, badge <b>Product</b> ranking, clustering, moderation, bot accountability</footer></article>

          <article class="components-pattern" id="pattern-form-preview"><header><span>Form + preview + validation summary</span><code>Specs / Publish</code></header><div class="components-pattern-form"><form class="hara-v2-form-grid"><div class="hara-v2-form-field"><label for="pattern-title">Title</label><input id="pattern-title" class="hara-v2-field" value="Schema argument conformance" /></div><div class="hara-v2-form-field"><label for="pattern-status">Status</label><select id="pattern-status" class="hara-v2-select"><option>Proposed</option></select></div><div class="hara-v2-form-field components-field-error" data-wide="true"><label for="pattern-id">Identifier</label><input id="pattern-id" class="hara-v2-field" value="schema arguments" aria-invalid="true" /><small>Use a stable hyphenated identifier.</small></div></form><aside><b>Rendered preview</b><pre>{validationExample}</pre><div class="hara-v2-callout" data-tone="danger"><div><b>1 blocking issue</b><p>The identifier cannot contain spaces.</p></div></div></aside></div><footer><b>Shared</b> form, fields, panel, callout <b>Product</b> controlled fields and publication workflow</footer></article>
        </div>
      </section>

      <section class="components-section" id="states-accessibility">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">07 · States and accessibility</p><h2>Every state has a word, shape, and semantic hook.</h2></div>
          <p>Colour and motion reinforce state; they do not carry it alone. Component notes expose keyboard behavior, focus return, touch dimensions, responsive yielding, and ownership of unavailable capabilities.</p>
        </header>

        <div class="components-state-matrix">
          <article data-state="default"><span>Default</span><button class="hara-v2-button" type="button">Run checks</button><p>Available, not yet active.</p></article>
          <article data-state="selected"><span>Selected</span><button class="hara-v2-button" type="button" aria-pressed="true">✓ HBC Wasm</button><p>Pressed semantics plus marker and signal.</p></article>
          <article data-state="loading"><span>Loading</span><button class="hara-v2-button components-loading-button" type="button" aria-busy="true"><i></i> Checking</button><p>Busy text remains under reduced motion.</p></article>
          <article data-state="success"><span>Success</span><div class="hara-v2-badge" data-tone="success">✓ verified</div><p>Outcome and receipt are named.</p></article>
          <article data-state="warning"><span>Warning</span><div class="hara-v2-badge" data-tone="warning">! review</div><p>Recoverable attention state.</p></article>
          <article data-state="danger"><span>Danger</span><div class="hara-v2-badge" data-tone="danger">× blocked</div><p>Destructive or failed state.</p></article>
          <article data-state="disabled"><span>Disabled</span><button class="hara-v2-button" type="button" disabled>Canvas unavailable</button><p>Capability absence is explicit.</p></article>
          <article data-state="focus"><span>Keyboard focus</span><button class="hara-v2-button components-forced-focus" type="button">Open exact view</button><p>Visible ring with offset.</p></article>
        </div>

        <div class="components-a11y-grid">
          <article><span>Semantic role</span><strong>Use the native element first.</strong><p>Links navigate, buttons mutate, tabs expose tab semantics, tables remain tables, and shell regions use landmarks.</p></article>
          <article><span>Focus and disclosure</span><strong>Return focus to the trigger.</strong><p>Menus, palettes, inspectors, and dialogs close with Escape and return keyboard users to a predictable location.</p></article>
          <article><span>Touch and density</span><strong>Dense does not mean untouchable.</strong><p>Phone controls retain at least 34px height; tool density is reserved for repeated desktop manipulation.</p></article>
          <article><span>Reduced motion</span><strong>Meaning survives zero-duration transitions.</strong><p>Loading text, current markers, status labels, and receipts remain visible without animation.</p></article>
        </div>
      </section>

      <section class="components-section components-ownership" id="ownership">
        <header class="components-section-head">
          <div><p class="hara-v2-kicker">08 · CSS and ownership</p><h2>Discoverable classes, narrow APIs, product-owned business rules.</h2></div>
          <p>Major class families remain visible for framework-free consumers. Astro exports wrap recurring structure where semantics and slots are stable; product-only compositions do not automatically expand the shared API.</p>
        </header>

        <div class="components-css-ledger">
          {cssFamilies.map((family) => (
            <article><header><div><span>{family.label}</span><code>{family.source}</code></div><strong>{family.classes.length}</strong></header><div>{family.classes.map((name) => <code>{name}</code>)}</div></article>
          ))}
        </div>

        <div class="components-ownership-grid">
          <article data-owner="package"><span>Package owns</span><h3>Geometry and semantic state</h3><ul><li>public Astro structures and slots</li><li>document and tool CSS class behavior</li><li>theme, focus, density, and responsive contracts</li><li>stable state attributes and accessible relationships</li></ul></article>
          <article data-owner="catalogue"><span>Catalogue owns</span><h3>Framing and explanation</h3><ul><li>component cards and inventory annotations</li><li>side-by-side do/avoid comparisons</li><li>measurement and ownership notes</li><li>realistic review-only specimen content</li></ul></article>
          <article data-owner="product"><span>Product owns</span><h3>Business rules and composition</h3><ul><li>information architecture and local terminology</li><li>ranking, validation, permission, and lifecycle rules</li><li>which shared components appear together</li><li>product data, provenance, and task-specific imagery</li></ul></article>
        </div>

        <div class="components-closeout"><div><p class="hara-v2-kicker">Adoption rule</p><h3>Import the primitive; compose the product.</h3><p>Do not copy catalogue CSS into downstream sites. Import <code>v2.css</code> or <code>v2-tool.css</code>, use the public Astro export when its structure matches, and keep application-specific workflow logic local.</p></div><div><a class="hara-v2-button" data-variant="primary" href={catalogueHome}>Return to catalogue</a><a class="hara-v2-button" href={foundationsRoute}>Review foundations</a></div></div>
      </section>

      <footer class="components-footer"><span>Hara v2 component catalogue · implementation issue <a href="https://github.com/hara-lang/visual-language/issues/35">#35</a></span><span><a href={`${sourceRoot}package.json`}>Package exports</a> · <a href={`${sourceRoot}src/v2/components.css`}>Document components</a> · <a href={`${sourceRoot}src/v2/tool-controls.css`}>Tool controls</a> · <a href={toolRoute}>Tool reference</a></span></footer>
    </main>
  </body>
</html>
