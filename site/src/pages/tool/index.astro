---
import ThemeToggle from "@hara-lang/ui-astro/astro/ThemeToggle.astro";
import HaraMark from "@hara-lang/ui-astro/astro/HaraMark.astro";
import EnvironmentWorkbenchSpecimen from "../../components/v2-tool/EnvironmentWorkbenchSpecimen.astro";
import ThreeDWorkbenchSpecimen from "../../components/v2-tool/ThreeDWorkbenchSpecimen.astro";
import NodeWorkbenchSpecimen from "../../components/v2-tool/NodeWorkbenchSpecimen.astro";
import AnimationWorkbenchSpecimen from "../../components/v2-tool/AnimationWorkbenchSpecimen.astro";
import "@hara-lang/ui-tool/v2-tool.css";
import "@hara-lang/ui/theme.js";
import "../../styles/v2-lab.css";
import "../../styles/v2-tool-lab.css";
import "../../styles/v2-calm-lab.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}tool/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const documentLab = `${basePath}`;
const haraChromeLab = `${basePath}tool/hara-chrome/`;
const sections = [
  { href: haraChromeLab, label: "Hara Chrome" },
  { href: "#environment", label: "Environment" },
  { href: "#three-d", label: "3D" },
  { href: "#node", label: "Node" },
  { href: "#animation", label: "Animation" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara v2 tool chrome: calm environment, browser runtime, toolbar, dock, inspector, viewport, timeline, and workbench primitives." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 tool workbench reference" />
    <meta property="og:description" content="Browser runtime, environment, 3D, node/material, and animation workbenches built from shared controls and layout contracts." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 tool workbench reference" />
    <meta name="twitter:description" content="Calm command surfaces for Hara browser runtimes, environments, editors, and workbenches." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 tool workbench reference</title>
  </head>
  <body class="hara-v2 hara-v2-tool">
    <header class="v2-lab-header">
      <a class="v2-lab-brand" href={documentLab}>
        <HaraMark size={28} />
        <b>Hara visual language</b>
        <small>V2 workbench reference</small>
      </a>
      <nav aria-label="Workbench specimens">
        {sections.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main">
      <section class="tool-lab-hero">
        <div>
          <p class="hara-v2-kicker">Refined workbench layer · Version 2</p>
          <h1>Shared workbench structures for Hara tools.</h1>
          <p>This page compares browser-runtime, environment, 3D, node/material, and animation workbenches. Each specimen identifies its toolbar, docks, inspector, viewport, capabilities, status, and responsive collapse order.</p>
          <p><a class="tool-lab-back-link" href={documentLab}>← Return to the v2 reference</a> · <a class="tool-lab-back-link" href={haraChromeLab}>Open Hara Chrome runtime screens →</a></p>
        </div>
        <div class="tool-lab-hero-frame" aria-hidden="true">
          <div class="tool-lab-hero-core">H<i></i></div>
          <div class="tool-lab-hero-telemetry"><span>Workbench / 02</span><span>Light + dark</span><span>State / ready</span></div>
        </div>
      </section>

      <nav class="tool-lab-index" aria-label="Tool layout catalogue">
        <a href={haraChromeLab}><strong>Hara Chrome</strong><span>Toolbar popup plus Runtime, ChatGPT, Tripo, and bounded CDP diagnostics applications.</span><code>browser runtime / compact</code></a>
        <a href="#environment"><strong>Live environment</strong><span>Nav, frontmatter, graphics, code, sessions, files, canvas, and optional 3D controls.</span><code>embedded / capability-aware</code></a>
        <a href="#three-d"><strong>3D editor</strong><span>Toolbar, transform rail, outliner, viewport, property inspector, assets, and runtime status.</span><code>spatial / docked</code></a>
        <a href="#node"><strong>Node / material</strong><span>Graph canvas, command tabs, catalogue, floating palette, properties, and surface assets.</span><code>graph / palette</code></a>
        <a href="#animation"><strong>Scene / animation</strong><span>Transport, rig hierarchy, viewport, animation properties, timeline, and motion receipt.</span><code>temporal / timeline</code></a>
      </nav>

      <EnvironmentWorkbenchSpecimen />
      <ThreeDWorkbenchSpecimen />
      <NodeWorkbenchSpecimen />
      <AnimationWorkbenchSpecimen />

      <footer class="v2-lab-footer">
        <span>Hara v2 workbench reference</span>
        <span><a href={documentLab}>V2 reference</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>
  </body>
</html>
