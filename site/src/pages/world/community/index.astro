    <script>
      const sortDescriptions = {
        hot: "Ranked by active discussion and recent community votes.",
        new: "Newest reviewed articles, clippings, releases, and snippets first.",
        clippings: "Short passages, links, notes, and code excerpts saved by the community.",
        following: "Items from feeds, contributors, packages, and namespaces you follow."
      };

      document.querySelectorAll("[data-feed-sort]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-feed-sort]").forEach((item) => item.setAttribute("aria-selected", "false"));
          button.setAttribute("aria-selected", "true");
          const status = document.querySelector("[data-feed-sort-status]");
          if (status) status.textContent = sortDescriptions[button.getAttribute("data-feed-sort")] || "";
        });
      });

      document.querySelectorAll("[data-thread-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const comment = button.closest(".world-comment");
          if (!comment) return;
          const collapsed = comment.toggleAttribute("data-collapsed");
          button.textContent = collapsed ? "+" : "−";
          button.setAttribute("aria-label", collapsed ? "Expand comment" : "Collapse comment");
        });
      });

      document.querySelectorAll("[data-digest-choice]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-digest-choice]").forEach((item) => item.setAttribute("aria-selected", "false"));
          button.setAttribute("aria-selected", "true");
          const status = document.querySelector("[data-digest-status]");
          if (status) status.textContent = button.getAttribute("data-digest-choice") === "hot"
            ? "Ranked discussions, most-saved clippings, and package activity drawing the most attention."
            : "Chronological updates from submitted feeds, packages, namespaces, and community threads.";
        });
      });

      document.querySelectorAll("[data-feed-probe]").forEach((button) => {
        button.addEventListener("click", () => {
          const status = document.querySelector("[data-feed-probe-status]");
          if (status) status.textContent = "RSS 2.0 found · 12 entries · canonical site verified.";
          const preview = document.querySelector("[data-feed-preview]");
          if (preview) preview.setAttribute("data-probed", "true");
        });
      });

      document.querySelectorAll("[data-copy-snippet]").forEach((button) => {
        button.addEventListener("click", () => { button.textContent = "copied"; });
      });

      document.querySelectorAll("[data-presence-person]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-presence-person]").forEach((item) => item.removeAttribute("data-selected"));
          button.setAttribute("data-selected", "true");
          const root = document.querySelector("[data-presence-detail]");
          if (!root) return;
          const setText = (selector, value) => {
            const node = root.querySelector(selector);
            if (node) node.textContent = value || "";
          };
          setText("[data-presence-avatar]", button.textContent.trim());
          setText("[data-presence-name]", button.getAttribute("data-name"));
          setText("[data-presence-handle]", button.getAttribute("data-handle"));
          setText("[data-presence-activity]", button.getAttribute("data-activity"));
          setText("[data-presence-extra]", button.getAttribute("data-detail"));
        });
      });
    </script>
  </body>
</html>
