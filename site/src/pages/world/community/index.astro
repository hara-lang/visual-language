---
import ThemeToggle from "../../../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../../../src/astro/HaraMark.astro";
import Shell from "../../../../../src/astro/v2/Shell.astro";
import Header from "../../../../../src/astro/v2/Header.astro";
import ContextNav from "../../../../../src/astro/v2/ContextNav.astro";
import Sidebar from "../../../../../src/astro/v2/Sidebar.astro";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-lab.css";
import "../../../styles/v2-calm-lab.css";
import "../../../styles/v2-world-lab.css";
import "../../../styles/v2-world-community.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}world/community/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const worldLab = `${basePath}world/`;

const ecosystemNav = [
  { href: "#hot", label: "Home" },
  { href: "#hot", label: "World", current: true },
  { href: "https://learn.hara-lang.org", label: "Learn", external: true },
  { href: "#profile", label: "Packages" },
  { href: "#profile", label: "Identity" }
];

const worldNav = (current) => [
  { href: "#hot", label: "Hot", current: current === "hot" },
  { href: "#whats-new", label: "New", current: current === "new" },
  { href: "#hot", label: "Clippings", current: current === "clippings" },
  { href: "#feeds", label: "Feeds", current: current === "feeds" },
  { href: "#online", label: "People", current: current === "people" }
];

const feedSidebar = [
  { label: "Read", items: [
    { href: "#hot", label: "Hot", current: true, badge: 18 },
    { href: "#whats-new", label: "What's new", badge: 31 },
    { href: "#hot", label: "Clippings", badge: 12 },
    { href: "#thread", label: "Comments", badge: 46 }
  ] },
  { label: "Sources", items: [
    { href: "#feeds", label: "Following", badge: 8 },
    { href: "#feeds", label: "All feeds", badge: 17 },
    { href: "#feeds", label: "Submit a feed" }
  ] }
];

const threadSidebar = [
  { label: "Thread", items: [
    { href: "#thread", label: "Best", current: true },
    { href: "#thread", label: "Newest" },
    { href: "#thread", label: "Oldest" },
    { href: "#thread", label: "Bots", badge: 2 }
  ] },
  { label: "Article", items: [
    { href: "#hot", label: "Back to feed" },
    { href: "#thread", label: "Save" },
    { href: "#thread", label: "Make a clipping" }
  ] }
];

const digestSidebar = [
  { label: "Digest", items: [
    { href: "#whats-new", label: "What's new", current: true },
    { href: "#whats-new", label: "What's hot" },
    { href: "#whats-new", label: "Package releases" },
    { href: "#whats-new", label: "Namespace changes" }
  ] },
  { label: "Delivery", items: [
    { href: "#whats-new", label: "Email" },
    { href: "#feeds", label: "RSS" },
    { href: "#feeds", label: "JSON Feed" }
  ] }
];

const sourceSidebar = [
  { label: "Feeds", items: [
    { href: "#feeds", label: "Directory", current: true, badge: 17 },
    { href: "#feeds", label: "Recently added", badge: 3 },
    { href: "#feeds", label: "Needs review", badge: 2 },
    { href: "#feeds", label: "Submit yours" }
  ] },
  { label: "Formats", items: [
    { href: "#feeds", label: "RSS" },
    { href: "#feeds", label: "Atom" },
    { href: "#feeds", label: "OPML" }
  ] }
];

const profileSidebar = [
  { label: "GitHub profile", items: [
    { href: "#profile", label: "Overview", current: true },
    { href: "#profile", label: "Packages", badge: 4 },
    { href: "#profile", label: "Namespaces", badge: 7 },
    { href: "#profile", label: "Contributions", badge: 86 }
  ] },
  { label: "World activity", items: [
    { href: "#profile", label: "Articles", badge: 12 },
    { href: "#profile", label: "Clippings", badge: 19 },
    { href: "#profile", label: "Comments", badge: 144 },
    { href: "#profile", label: "Owned bots", badge: 2 }
  ] }
];

const peopleSidebar = [
  { label: "People", items: [
    { href: "#online", label: "Online now", current: true, badge: 11 },
    { href: "#online", label: "Recently active", badge: 28 },
    { href: "#profile", label: "Contributors", badge: 46 },
    { href: "#online", label: "Bots online", badge: 4 }
  ] },
  { label: "Presence", items: [
    { href: "#online", label: "Reading" },
    { href: "#online", label: "Commenting" },
    { href: "#online", label: "Maintaining" }
  ] }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Focused Hara World v2 community reference for articles, feeds, clippings, comments, presence, contributor profiles, snippets, and email digests." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Focused Hara World community reference" />
    <meta property="og:description" content="A focused community reader for Hara articles, clippings, comments, feeds, profiles, presence, and digests." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Focused Hara World community reference" />
    <meta name="twitter:description" content="Hot, new, clippings, feeds, people, comments, and contributor identity." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Focused Hara World community reference</title>
  </head>
  <body class="hara-v2">
    <header class="v2-lab-header">
      <a class="v2-lab-brand" href={worldLab}>
        <HaraMark size={28} />
        <b>Hara visual language</b>
        <small>World community reference</small>
      </a>
      <nav aria-label="Focused World prototype screens">
        <a href="#hot">Feed</a>
        <a href="#thread">Thread</a>
        <a href="#whats-new">Digest</a>
        <a href="#feeds">Feeds</a>
        <a href="#profile">Profile</a>
        <a href="#online">Online</a>
      </nav>
      <ThemeToggle />
    </header>

    <main class="v2-lab-main world-lab-main">
      <section class="world-focused-hero">
        <div>
          <p class="hara-v2-kicker">Current product direction · World v2</p>
          <h1>One community reader, not an everything site.</h1>
          <p>World is the Hara community's shared front page: articles from submitted feeds, short clippings, ranked discussions, threaded comments, GitHub-backed contributor profiles, and a visible sense of who is around. Tutorials, courses, and learning progression live at <a href="https://learn.hara-lang.org">learn.hara-lang.org</a>.</p>
          <div class="world-focused-boundary" aria-label="World route boundary">
            <span>Articles</span><span>Feeds</span><span>Clippings</span><span>Comments</span><span>Profiles</span><span>Presence</span><span>Digest</span>
          </div>
          <div class="world-lab-hero-actions">
            <a class="hara-v2-button" data-variant="primary" href="#hot">Open focused feed</a>
            <a class="hara-v2-button" href="https://learn.hara-lang.org">Open Learn ↗</a>
            <a class="world-lab-back-link" href={worldLab}>Earlier World explorations</a>
          </div>
        </div>
        <div class="world-focused-diagram" aria-label="Articles and feeds flow into discussion and digest">
          <div class="world-focused-source"><b>Submitted feeds</b><span>RSS · Atom</span></div>
          <div class="world-focused-source"><b>Community clippings</b><span>Links · notes · snippets</span></div>
          <div class="world-focused-core"><strong>World</strong><small>Hot · New · Comments</small></div>
          <div class="world-focused-output"><b>Threads</b><span>People + owned bots</span></div>
          <div class="world-focused-output"><b>Digest</b><span>What's new · What's hot</span></div>
        </div>
      </section>

      <nav class="world-focused-index" aria-label="Focused World screen catalogue">
        <a href="#hot"><strong>Hot / New feed</strong><span>Articles, clippings, source provenance, comments, rankings, online presence, and snippet of the day.</span><code>read / rank / discuss</code></a>
        <a href="#thread"><strong>Article thread</strong><span>Nested comments linked to GitHub people, with user-owned bots carrying explicit owner attribution and presence.</span><code>article / comments / bots</code></a>
        <a href="#whats-new"><strong>What's new / hot</strong><span>A public digest page and email sign-up that does not require a World account.</span><code>digest / email / rss</code></a>
        <a href="#feeds"><strong>Feed directory</strong><span>Reviewed sources, latest posts, GitHub submitters, and a first-party feed proposal form.</span><code>sources / submit / preview</code></a>
        <a href="#profile"><strong>Contributor profile</strong><span>GitHub identity, deployed packages, maintained namespaces, contribution history, and earned badges.</span><code>github / packages / badges</code></a>
        <a href="#online"><strong>Who's online</strong><span>A compact presence map showing people, activity context, and bots linked back to accountable owners.</span><code>presence / people / ownership</code></a>
      </nav>

      <section class="world-lab-screen" id="hot">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 01 · Shared front page</p><h2>Articles, clippings, and discussion in one ranked feed.</h2></div>
          <p>The front page behaves like a focused Hara community board. Every item keeps source provenance and a clear path into its discussion.</p>
        </header>
        <div class="world-lab-canvas world-focused-canvas world-focused-canvas--feed">
          <Shell embedded={true} sidebar={true} aside={true} mainId="focused-hot-content">
            <Header slot="header" section="World" nav={ecosystemNav}>
              <button class="hara-v2-icon-button" aria-label="Account">CZ</button><ThemeToggle />
            </Header>
            <ContextNav slot="context" items={worldNav("hot")}>
              <a class="hara-v2-button" href="#feeds">Submit feed</a><a class="hara-v2-button" data-variant="primary" href="#hot">Post clipping</a>
            </ContextNav>
            <Sidebar slot="sidebar" title="World" groups={feedSidebar}>
              <span>Learning material has moved to <a href="https://learn.hara-lang.org">learn.hara-lang.org</a>.</span>
            </Sidebar>

            <div class="world-focused-page-heading"><div><p class="hara-v2-kicker">Hara community</p><h1>Hot right now.</h1></div><span class="hara-v2-badge" data-tone="success">11 online</span></div>
            <div class="hara-v2-tabs world-focused-sort" role="tablist" aria-label="Feed ranking">
              <button class="hara-v2-tab" role="tab" aria-selected="true" data-feed-sort="hot">Hot</button>
              <button class="hara-v2-tab" role="tab" aria-selected="false" data-feed-sort="new">New</button>
              <button class="hara-v2-tab" role="tab" aria-selected="false" data-feed-sort="clippings">Clippings</button>
              <button class="hara-v2-tab" role="tab" aria-selected="false" data-feed-sort="following">Following</button>
            </div>
            <p class="world-focused-sort-status" data-feed-sort-status>Ranked by active discussion and recent community votes.</p>

            <div class="world-focused-feed">
              <article class="world-focused-feed-item" data-kind="article">
                <div class="world-vote-column"><button type="button" aria-label="Upvote">↑</button><strong>86</strong><button type="button" aria-label="Downvote">↓</button></div>
                <div class="world-focused-feed-body">
                  <div class="world-focused-feed-meta"><span class="hara-v2-badge" data-tone="signal">Article</span><span>from hara.devlog.org</span><span>submitted by <a href="#profile">@mina</a></span><time>2h</time></div>
                  <h2><a href="#thread">Why work programs are becoming ordinary data</a></h2>
                  <p>A clear account of the executor/store boundary and why the runtime object can become a small capability map.</p>
                  <footer><a href="#thread">42 comments</a><button type="button">save</button><button type="button">make clipping</button><a href="#feeds">source</a></footer>
                </div>
              </article>

              <article class="world-focused-feed-item" data-kind="clipping">
                <div class="world-vote-column"><button type="button" aria-label="Upvote">↑</button><strong>54</strong><button type="button" aria-label="Downvote">↓</button></div>
                <div class="world-focused-feed-body">
                  <div class="world-focused-feed-meta"><span class="hara-v2-badge">Clipping</span><span>saved by <a href="#profile">@alex</a></span><time>4h</time></div>
                  <blockquote>“A protocol should describe the boundary, not become the thing doing the work.”</blockquote>
                  <p>Clipped from the new executor/store design note, with a short comment about native parity.</p>
                  <footer><a href="#thread">18 comments</a><button type="button">save</button><a href="#thread">open context</a></footer>
                </div>
              </article>

              <article class="world-focused-feed-item world-focused-feed-item--snippet" data-kind="snippet">
                <div class="world-vote-column"><button type="button" aria-label="Upvote">↑</button><strong>71</strong><button type="button" aria-label="Downvote">↓</button></div>
                <div class="world-focused-feed-body">
                  <div class="world-focused-feed-meta"><span class="hara-v2-badge" data-tone="success">Snippet of the day</span><span>selected by @world-relay</span><time>Today</time></div>
                  <h2>Publish a façade without repeating the definitions</h2>
                  <pre><code>(intern-all std.foundation
  [work-spec submit! complete!])</code></pre>
                  <p>A small example from the ongoing portable façade cleanup.</p>
                  <footer><button type="button" data-copy-snippet>copy</button><a href="#thread">27 comments</a><a href="#profile">maintainer</a></footer>
                </div>
              </article>

              <article class="world-focused-feed-item" data-kind="article">
                <div class="world-vote-column"><button type="button" aria-label="Upvote">↑</button><strong>33</strong><button type="button" aria-label="Downvote">↓</button></div>
                <div class="world-focused-feed-body">
                  <div class="world-focused-feed-meta"><span class="hara-v2-badge" data-tone="warning">Package release</span><span>std.typed 0.8.0</span><span>by <a href="#profile">@cora</a></span><time>6h</time></div>
                  <h2>Schema values graduate into the portable core</h2>
                  <p>Release notes, migration examples, and the maintained namespace list are attached to the contributor profile.</p>
                  <footer><a href="#thread">14 comments</a><button type="button">save</button><a href="#profile">package</a></footer>
                </div>
              </article>
            </div>

            <div slot="aside" class="world-aside-stack">
              <section class="hara-v2-panel world-online-mini"><header class="hara-v2-panel-header"><h2>Who's online</h2><a href="#online">Open map</a></header><div class="hara-v2-panel-body"><div class="world-online-orbit-mini" aria-label="11 people online"><a href="#profile" class="online-dot online-dot--one">MN</a><a href="#profile" class="online-dot online-dot--two">AX</a><a href="#profile" class="online-dot online-dot--three">CO</a><a href="#profile" class="online-dot online-dot--four">JO</a><span class="online-dot online-dot--bot">B</span></div><p><b>11 people</b> and <b>4 owned bots</b> are active. Presence is optional.</p></div></section>
              <section class="hara-v2-panel world-digest-mini"><header class="hara-v2-panel-header"><h2>What's new / what's hot</h2></header><div class="hara-v2-panel-body"><p>A public digest of posts, package releases, namespace changes, and active discussions.</p><label>Email <input class="hara-v2-field" type="email" placeholder="you@example.com" /></label><button class="hara-v2-button" data-variant="primary" type="button">Join mailing list</button><a href="#whats-new">Preview the digest →</a></div></section>
            </div>
          </Shell>
        </div>
        <div class="world-lab-notes"><article><b>Focused objects</b><p>World ranks articles, clippings, package releases, and one daily snippet.</p></article><article><b>Source stays visible</b><p>Syndicated articles retain their canonical publisher, submitter, and source link.</p></article><article><b>Discussion is primary</b><p>Every object leads into a thread rather than a separate social feature.</p></article></div>
      </section>

      <section class="world-lab-screen" id="thread">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 02 · Article and comments</p><h2>A readable article thread with accountable bot participation.</h2></div>
          <p>Comments link to GitHub-backed people. A bot may comment only through a visible owner relationship, and its owner's presence is shown beside the bot identity.</p>
        </header>
        <div class="world-lab-canvas world-focused-canvas world-focused-canvas--thread">
          <Shell embedded={true} sidebar={true} aside={true} mainId="focused-thread-content">
            <Header slot="header" section="World" nav={ecosystemNav}><button class="hara-v2-icon-button" aria-label="Account">CZ</button><ThemeToggle /></Header>
            <ContextNav slot="context" items={worldNav("hot")}><a class="hara-v2-button" href="#hot">Back to Hot</a><a class="hara-v2-button" data-variant="primary" href="#thread">Add comment</a></ContextNav>
            <Sidebar slot="sidebar" title="Discussion" groups={threadSidebar}><span>42 comments · 7 participants online</span></Sidebar>

            <article class="world-thread-article">
              <div class="world-thread-source"><span class="hara-v2-badge" data-tone="signal">Article</span><a href="#feeds">hara.devlog.org</a><span>submitted by <a href="#profile">@mina</a></span></div>
              <h1>Why work programs are becoming ordinary data</h1>
              <p class="world-thread-deck">The useful boundary is becoming surprisingly small: an algebra describing what should happen, an executor, a store, and a map of capabilities.</p>
              <div class="world-thread-author"><div class="hara-v2-avatar">MN</div><div><a href="#profile"><b>Mina N.</b> <span class="world-presence-dot"></span></a><small>@mina · namespace maintainer</small></div><time>Published 2 hours ago</time></div>
              <div class="world-thread-excerpt"><p>Once the runtime stops carrying identity of its own, the same work value can move between an ephemeral executor, a durable executor, and a browser evaluator without changing its public form.</p><pre><code>step :code/list
function list-code-units
boundary checkpointed</code></pre><p>The discussion below is about whether anything important is lost when runtime becomes ordinary data.</p></div>
              <footer><button type="button">↑ 86</button><button type="button">save</button><button type="button">clip passage</button><a href="#feeds">open canonical article ↗</a></footer>
            </article>

            <section class="world-comment-composer">
              <header><b>Join the discussion</b><span>Reply as a person or one of your registered bots.</span></header>
              <div><select class="hara-v2-select" aria-label="Comment identity"><option>@chris</option><option>@chris/review-bot · bot owned by @chris</option></select><textarea class="hara-v2-field" rows="3" placeholder="Add context, ask a question, or link to a relevant namespace…"></textarea><button class="hara-v2-button" data-variant="primary" type="button">Post comment</button></div>
            </section>

            <section class="world-comment-thread" aria-label="Threaded comments">
              <article class="world-comment" data-depth="0"><div class="world-comment-rail"><button type="button" data-thread-toggle aria-label="Collapse comment">−</button></div><div class="world-comment-body"><header><a href="#profile"><b>@alex</b></a><span class="world-presence-dot"></span><span>namespace contributor</span><time>1h</time></header><p>I like the smaller public boundary. Should capability lookup remain a plain map lookup before executor dispatch?</p><footer><button type="button">↑ 24</button><button type="button">reply</button><button type="button">save</button></footer></div></article>
              <article class="world-comment world-comment--bot" data-depth="1"><div class="world-comment-rail"><button type="button" data-thread-toggle aria-label="Collapse comment">−</button></div><div class="world-comment-body"><header><a href="#profile"><b>@mina/build-bot</b></a><span class="hara-v2-badge" data-tone="signal">Bot</span><span>bot by <a href="#profile">@mina</a></span><span class="world-presence-dot"></span><span>owner online</span><time>48m</time></header><p>I checked the current implementations. Three executors read capability keys before dispatch; two retain a runtime wrapper.</p><div class="world-bot-receipt"><span>Owned bot</span><a href="#profile">Owner: @mina</a><a href="#profile">Namespaces: work.ephemeral, work.sqlite</a></div><footer><button type="button">↑ 19</button><button type="button">reply</button><button type="button">inspect bot</button></footer></div></article>
              <article class="world-comment" data-depth="2"><div class="world-comment-rail"><button type="button" data-thread-toggle aria-label="Collapse comment">−</button></div><div class="world-comment-body"><header><a href="#profile"><b>@cora</b></a><span>package publisher</span><time>31m</time></header><p>That inventory makes the migration concrete. I would keep capability resolution outside IWorkExecutor.</p><footer><button type="button">↑ 12</button><button type="button">reply</button></footer></div></article>
              <article class="world-comment world-comment--bot" data-depth="0"><div class="world-comment-rail"><button type="button" data-thread-toggle aria-label="Collapse comment">−</button></div><div class="world-comment-body"><header><a href="#profile"><b>@jo/release-relay</b></a><span class="hara-v2-badge">Bot</span><span>bot by <a href="#profile">@jo</a></span><span class="world-presence-dot world-presence-dot--away"></span><span>owner away</span><time>18m</time></header><p>Related package release: std.work 0.4.2 includes the first executor/store split and migration notes.</p><footer><button type="button">↑ 8</button><button type="button">reply</button></footer></div></article>
            </section>

            <div slot="aside" class="world-aside-stack"><section class="hara-v2-panel"><header class="hara-v2-panel-header"><h2>In this thread</h2></header><div class="hara-v2-panel-body"><div class="world-thread-presence-list"><a href="#profile"><span class="world-presence-dot"></span>@mina</a><a href="#profile"><span class="world-presence-dot"></span>@alex</a><a href="#profile"><span class="world-presence-dot"></span>@chris</a><a href="#profile"><span class="world-presence-dot world-presence-dot--away"></span>@jo</a></div><a href="#online">See everyone online →</a></div></section><section class="hara-v2-panel"><header class="hara-v2-panel-header"><h2>Bot boundary</h2></header><div class="hara-v2-panel-body"><p>Every bot comment links to an accountable GitHub owner, registered purpose, and current owner presence.</p></div></section></div>
          </Shell>
        </div>
        <div class="world-lab-notes"><article><b>Linked identity</b><p>Usernames, maintainer roles, and bot owners resolve to a contributor profile.</p></article><article><b>Nested but readable</b><p>Thread depth is visible without becoming a narrow staircase.</p></article><article><b>Bot accountability</b><p>Bot attribution is part of the comment header and receipt.</p></article></div>
      </section>

      <section class="world-lab-screen" id="whats-new">
        <header class="world-lab-screen-head">
          <div><p class="hara-v2-kicker">Screen 03 · Public digest</p><h2>What's new and what's hot, on the web or by email.</h2></div>
          <p>Anyone can subscribe without creating a World profile. The digest combines community posts with package and namespace activity.</p>
        </header>
        <div class="world-lab-canvas world-focused-canvas world-focused-canvas--digest">
          <Shell embedded={true} sidebar={true} aside={true} mainId="focused-digest-content">
            <Header slot="header" section="World" nav={ecosystemNav}><button class="hara-v2-icon-button" aria-label="Account">◎</button><ThemeToggle /></Header>
            <ContextNav slot="context" items={worldNav("new")}><a class="hara-v2-button" href="#feeds">RSS / JSON</a><a class="hara-v2-button" data-variant="primary" href="#whats-new">Subscribe</a></ContextNav>
            <Sidebar slot="sidebar" title="What's happening" groups={digestSidebar}><span>Public archive · no account required</span></Sidebar>

            <div class="world-focused-page-heading"><div><p class="hara-v2-kicker">Wednesday · 19 August</p><h1>What's new in Hara.</h1></div><span class="hara-v2-badge" data-tone="success">31 updates</span></div>
            <div class="hara-v2-tabs" role="tablist" aria-label="Digest mode"><button class="hara-v2-tab" aria-selected="true" data-digest-choice="new">What's new</button><button class="hara-v2-tab" aria-selected="false" data-digest-choice="hot">What's hot</button></div>
            <p class="world-digest-status" data-digest-status>Chronological updates from submitted feeds, packages, namespaces, and community threads.</p>

            <div class="world-digest-layout">
              <div class="world-digest-stream">
