---
import CatalogueHeader from "../../components/v2-catalogue/CatalogueHeader.astro";
import MediaProjectionLab from "../../components/v2-media/MediaProjectionLab.astro";
import MediaEmail from "../../components/v2-media/MediaEmail.astro";
import MediaPrint from "../../components/v2-media/MediaPrint.astro";
import MediaSocial from "../../components/v2-media/MediaSocial.astro";
import MediaStatic from "../../components/v2-media/MediaStatic.astro";
import {
  deliveryFixtureNotice,
  deliveryFormats,
  deliverySummary,
  releaseStory
} from "../../lib/v2-media.mjs";
import "../../../../src/v2.css";
import "../../../../src/v2-media.css";
import "../../../../src/theme.js";
import "../../styles/v2-lab.css";
import "../../styles/v2-calm-lab.css";
import "../../styles/v2-media-guide.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}media/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const catalogueUrl = `${basePath}`;
const guideUrl = `${basePath}guide/`;
const dataUrl = `${basePath}data/`;
const issueUrl = "https://github.com/hara-lang/visual-language/issues/108";
const localNav = [
  { href: "#overview", label: "Overview" },
  { href: "#projection", label: "Projection" },
  { href: "#email", label: "Email" },
  { href: "#print", label: "Print / PDF" },
  { href: "#social", label: "Social" },
  { href: "#static", label: "Static" },
  { href: "#states", label: "States" },
  { href: "#contract", label: "Adoption" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The Hara v2 delivery-media guide for email, print and PDF, social cards, plain text, open feeds, low-bandwidth projections, artifact state and provenance." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 delivery media" />
    <meta property="og:description" content="One semantic artifact projected into email, print, social and low-bandwidth formats without losing source truth." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara v2 delivery media" />
    <meta name="twitter:description" content="Email, print, social and static delivery contracts for Hara products." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 delivery media</title>
  </head>
  <body class="hara-v2 hara-v2-media-guide">
    <CatalogueHeader basePath={basePath} activePath="/media/" label="Delivery-media guide">
      <a slot="route-actions" href="#projection">Compare formats</a>
    </CatalogueHeader>

    <nav class="media-guide-local-nav" aria-label="Delivery-media guide sections">
      <span>Delivery media</span>
      <div>{localNav.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <a href={issueUrl}>Issue 108 ↗</a>
    </nav>

    <main class="media-guide-main">
      <aside class="media-guide-fixture-notice" role="note">
        <strong>{deliveryFixtureNotice.label}</strong>
        <span>{deliveryFixtureNotice.summary}</span>
        <code>{deliveryFixtureNotice.id} · {releaseStory.fixtureRevision}</code>
      </aside>

      <section class="media-guide-hero" id="overview" aria-labelledby="media-guide-title">
        <div>
          <p class="hara-v2-kicker">Issue 108 · source truth survives the channel</p>
          <h1 id="media-guide-title">Hara outside the live application.</h1>
          <p>Email clients strip CSS. Printers remove backgrounds. Social platforms crop aggressively. Low-bandwidth readers disable images and JavaScript. The artifact still needs the same title, proof, source revision, authority, state and canonical destination.</p>
          <div class="media-guide-hero-actions">
            <a href="#projection">Project one story</a>
            <a href="#email">Review email fallbacks</a>
            <a href="#social">Inspect social safe zones</a>
          </div>
        </div>

        <aside class="media-guide-hero-board" aria-label="Delivery-media guide inventory">
          <header><span>Shared delivery inventory</span><span>Presentation contract only</span></header>
          <div>
            <div class="media-guide-channel-map" aria-label="Delivery channels">
              <span>Email</span><span>Print / PDF</span><span>Social</span><span>Plain / static</span>
            </div>
            <h2>{deliverySummary.formats} projections · one envelope</h2>
            <p>Each channel consumes supplied source facts. None may invent or silently rewrite the authoritative state.</p>
            <dl>
              <div><dt>Formats</dt><dd>{deliverySummary.formats}</dd></div>
              <div><dt>Artifact states</dt><dd>{deliverySummary.artifactStates}</dd></div>
              <div><dt>Email items</dt><dd>{deliverySummary.emailItems}</dd></div>
              <div><dt>Receipt checks</dt><dd>{deliverySummary.receiptChecks}</dd></div>
              <div><dt>Product cards</dt><dd>{deliverySummary.productCards}</dd></div>
              <div><dt>Safe zones</dt><dd>{deliverySummary.safeZones}</dd></div>
            </dl>
          </div>
          <footer><span>No JavaScript required by artifacts</span><span>Text equivalents mandatory</span><span>{deliveryFormats.length} channel shapes</span></footer>
        </aside>
      </section>

      <MediaProjectionLab />
      <MediaEmail />
      <MediaPrint />
      <MediaSocial />
      <MediaStatic />

      <footer class="v2-lab-footer">
        <span>Hara v2 delivery media · email, print, social and static</span>
        <span><a href={catalogueUrl}>Catalogue home</a> · <a href={guideUrl}>Catalogue guide</a> · <a href={dataUrl}>Data visualisation</a> · <a href={issueUrl}>Issue 108</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span>
      </footer>
    </main>

    <script>
      import { initialiseMediaGuide } from "../../scripts/v2-media.js";
      initialiseMediaGuide();
    </script>
  </body>
</html>
