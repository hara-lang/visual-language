---
import LiveHaraExample from "../../../components/v2-www/LiveHaraExample.astro";
import StateSpecimen from "../../../components/v2-www/StateSpecimen.astro";
import ViewportSpecimen from "../../../components/v2-www/ViewportSpecimen.astro";
import WwwFamilyHeader from "../../../components/v2-www/WwwFamilyHeader.astro";
import {
  apiReferences,
  docsArticle,
  docsOutline,
  docsSearchResults,
  docsSidebarGroups,
  docsTaskMap,
  runtimeStateSpecimens,
  withBasePath,
  wwwContracts
} from "../../../lib/v2-www.mjs";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-www.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}www/docs/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const homeHref = withBasePath(basePath, "/www/");
const benchmarksHref = withBasePath(basePath, "/www/benchmarks/");
const exampleSource = `;; orchestration is replayable
(def durable-import
  (work/chain
    (work/pure :resolve-input resolve-input)
    (work/step :fetch-source fetch-source [:network])
    (work/step :store-original store-original [:database])
    (work/pure :index-document index-document)))

(work/submit executor store durable-import)`;
const expectedOutput = `{:work/id :durable-import
 :status :complete
 :steps 2
 :receipts ["fetch-source:g4" "store-original:g4"]}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara documentation reference with task guides, language and API reference, search, versions, runtime assumptions, bounded executable examples, and explicit unavailable states." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Docs" />
    <meta property="og:title" content="Hara documentation" />
    <meta property="og:description" content="Guides explain how to complete a task, reference pages define symbols and contracts, and executable examples identify their exact source and runtime state." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara documentation" />
    <meta name="twitter:description" content="Task guides, language and API reference, versions, search, and revision-pinned executable examples for Hara." />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara documentation</title>
  </head>
  <body class="hara-v2 www-family-page www-docs-page">
    <WwwFamilyHeader basePath={basePath} activeRoute="docs" searchLabel="Search Docs" sectionNav />

    <main class="www-main">
      <div class="www-docs-page-controls" aria-label="Documentation reading controls">
        <div class="www-docs-page-controls__selectors">
          <label class="www-selector"><span>Version</span><select class="hara-v2-select" aria-label="Documentation version"><option>Hara 1.8 · current</option><option>Hara 1.7</option><option>1.9-next</option></select></label>
          <label class="www-selector"><span>Runtime</span><select class="hara-v2-select" aria-label="Documentation runtime"><option>All runtimes</option><option>Wasm</option><option>JVM</option><option>Rust native</option></select></label>
        </div>
      </div>
      <section class="www-docs-hero" aria-labelledby="docs-title">
        <div>
          <p class="hara-v2-kicker">Guides · Reference · Examples</p>
          <h1 id="docs-title">Hara documentation is organised by the kind of answer required.</h1>
          <p>A guide explains a task in sequence. A reference page defines a language form, namespace, symbol, or interface. An executable example adds a named runtime session to otherwise static source and explanation.</p>
          <div class="www-hero__actions">
            <a class="hara-v2-button" data-variant="primary" href="#start-map">Choose a task</a>
            <a class="hara-v2-button" href="#guide">Read a guide</a>
            <a class="hara-v2-button" data-variant="ghost" href="#reference">Open API reference</a>
          </div>
        </div>
        <dl class="www-docs-hero__ledger">
          <div><dt>Guide contract</dt><dd>{wwwContracts.docs.types.find(({ id }) => id === "docs.guide")?.version}</dd></div>
          <div><dt>Version range</dt><dd>{docsArticle.versionRange}</dd></div>
          <div><dt>Exact revision</dt><dd><code>{docsArticle.revision}</code></dd></div>
          <div><dt>Runtime example</dt><dd>{docsArticle.runtimeExample}</dd></div>
        </dl>
      </section>

      <section class="www-section" id="start-map" data-section-label="Start map">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">01 · Task index</p><h2>Start with the task or question you need to resolve.</h2></div>
          <p>Each path names its expected reading time, assumed background, version range, and likely runtime. The language and API hierarchy remains available in the reference.</p>
        </header>
        <div class="www-docs-task-grid">
          {docsTaskMap.map((task, index) => (
            <article>
              <header><span>{String(index + 1).padStart(2, "0")}</span><p class="hara-v2-kicker">{task.level} · {task.time}</p></header>
              <h3>{task.title}</h3>
              <p>{task.summary}</p>
              <a href={task.id === "work" ? "#guide" : `#task-${task.id}`}>Open path →</a>
            </article>
          ))}
        </div>
      </section>

      <section class="www-section" id="guide" data-section-label="Guide">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">02 · Guide document</p><h2>Navigation records location; prose explains the task.</h2></div>
          <p>The document uses a quiet guide rail, stable outline, version and runtime selectors, and one optional executable example. The article remains readable without the runtime.</p>
        </header>

        <div class="www-docs-shell">
          <aside class="www-docs-sidebar" aria-label="Documentation navigation">
            <header><p class="hara-v2-kicker">Hara guide</p><strong>Systems</strong><span class="hara-v2-badge" data-tone="success">1.8 current</span></header>
            {docsSidebarGroups.map((group, groupIndex) => (
              <section>
                <h3>{group.label}</h3>
                <nav aria-label={`${group.label} documentation`}>
                  {group.items.map((item, itemIndex) => (
                    <a href="#guide" aria-current={groupIndex === 2 && itemIndex === 1 ? "page" : undefined}>
                      <span>{item}</span>{groupIndex === 2 && itemIndex === 1 && <small>current</small>}
                    </a>
                  ))}
                </nav>
              </section>
            ))}
          </aside>

          <article class="www-docs-article">
            <div class="www-docs-breadcrumbs"><a href={homeHref}>Overview</a><span>/</span><a href="#guide">Systems</a><span>/</span><span>Work algebra</span></div>
            <header>
              <p class="hara-v2-kicker">Guide · {docsArticle.contentType}</p>
              <h2>{docsArticle.title}</h2>
              <p>{docsArticle.summary}</p>
              <dl>
                <div><dt>Applies to</dt><dd>{docsArticle.versionRange}</dd></div>
                <div><dt>Reading time</dt><dd>18 minutes</dd></div>
                <div><dt>Published revision</dt><dd><code>{docsArticle.revision}</code></dd></div>
              </dl>
            </header>

            <div class="hara-v2-prose www-docs-prose">
              <p>Work describes what should happen. The executor chooses how it runs. The store remembers completed boundaries. This separation keeps orchestration replayable without pretending that network, database, clock, or filesystem effects can be repeated invisibly.</p>
              <aside class="www-docs-callout">
                <span aria-hidden="true">i</span>
                <div><b>Static documentation boundary</b><p>The explanation, source, capability list, and expected observation are authored content. Runtime status and receipts are controlled facts.</p></div>
              </aside>

              <h3 id="model-work">Model the work</h3>
              <p>Start with a small algebra. Pure nodes may replay; step nodes checkpoint external observations; chain and branch nodes only compose work.</p>
              <div class="www-static-code" data-label="work-model.hal · static documentation">
                <div><span>Static example</span><small>Copyable without runtime</small></div>
                <pre><code>{`{:op :chain
 :id :document/import
 :work [{:op :pure :id :resolve-input}
        {:op :step :id :fetch-source :capabilities [:network]}
        {:op :step :id :store-original :capabilities [:database]}]}`}</code></pre>
              </div>

              <h3 id="checkpoint-effects">Checkpoint effects</h3>
              <p>A step boundary records input identity, fenced generation, output digest, declared capabilities, and a durable receipt. A replay reads the recorded output rather than quietly reissuing the effect.</p>

              <LiveHaraExample
                id="docs-work-example"
                label="Executable example · optional runtime surface"
                file="durable-import.hal"
                source={exampleSource}
                expectedOutput={expectedOutput}
                state="ready"
                runtime="Wasm · work.ephemeral"
                session="docs-work-01"
                generation={4}
                capabilities={["pure", "network", "database", "clock:none", "filesystem:none"]}
                revision="hara@9b6c10e + example@72a194a3"
                openHref={withBasePath(basePath, "/start/")}
                exactRevisionHref="#docs-contract"
                controls={["Sessions", "Files", "Canvas", "3D"]}
                controlPane={true}
              />

              <h3 id="attach-runtime">Attach a runtime</h3>
              <p>The guide selector changes explanatory compatibility context. It does not mutate the source revision. An executable surface must explicitly attach a compatible provider before Run becomes available.</p>

              <h3 id="inspect-receipt">Inspect the receipt</h3>
              <p>Completion evidence links work identity, source revision, executor, store, capability declaration, step outputs, and the final accepted result. The receipt belongs to the runtime registry, not editable front matter.</p>

              <nav class="www-docs-next" aria-label="Guide sequence">
                <a href="#model-work"><span>Previous</span><strong>Work algebra overview</strong></a>
                <a href="#reference"><span>Next</span><strong>IWorkExecutor reference</strong></a>
              </nav>
            </div>
          </article>

          <aside class="www-docs-outline" aria-label="On this guide page">
            <header><b>On this page</b><span>18 min</span></header>
            <nav>
              {docsOutline.map((item, index) => <a href={`#${item.id}`} aria-current={index === 0 ? "location" : undefined}>{item.label}</a>)}
            </nav>
            <section><p class="hara-v2-kicker">Page contract</p><code>{docsArticle.schemaVersion}</code><code>{docsArticle.publicationReceipt}</code></section>
          </aside>
        </div>
      </section>

      <section class="www-section" id="reference" data-section-label="Reference">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">03 · API and namespace reference</p><h2>Each symbol record names its namespace, signature, version, and definition.</h2></div>
          <p>Reference rows are canonical records rather than headings copied into prose. A production implementation resolves them from the symbol registry.</p>
        </header>

        <div class="www-reference-shell">
          <header>
            <div><p class="hara-v2-kicker">Namespace</p><h3><code>std.work</code></h3><p>Algebra, submission, checkpoint boundaries, stores, and executors.</p></div>
            <div class="www-reference-actions"><button class="hara-v2-button" type="button">Copy namespace</button><a class="hara-v2-button" href="#guide">Open guide</a></div>
          </header>
          <div class="www-reference-table" role="table" aria-label="std.work API reference">
            <div class="www-reference-row www-reference-row--head" role="row"><span role="columnheader">Symbol</span><span role="columnheader">Signature</span><span role="columnheader">Since</span><span role="columnheader">Definition</span></div>
            {apiReferences.map((entry) => (
              <article class="www-reference-row" role="row">
                <span role="cell"><code>{entry.namespace}/{entry.symbol}</code><small>{entry.kind}</small></span>
                <code role="cell">{entry.signature}</code>
                <span role="cell">{entry.since}</span>
                <p role="cell">{entry.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="www-section" id="search" data-section-label="Search" data-doc-search>
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">04 · Search results and filters</p><h2>Search distinguishes guides, reference, version notes, and executable examples.</h2></div>
          <p>Type, category, version, and runtime are visible filters. A result does not imply that a static guide is executable or that a live example applies to every runtime.</p>
        </header>

        <div class="www-doc-search-shell">
          <form class="www-doc-search-form" role="search" onsubmit="return false">
            <label><span>Search documentation</span><input class="hara-v2-field" type="search" value="work" data-doc-search-input /></label>
            <div class="www-doc-search-filter" aria-label="Content type filters">
              {['All', 'Guide', 'Reference', 'Version note', 'Live example'].map((type, index) => <button type="button" aria-pressed={index === 0 ? "true" : "false"} data-doc-filter={type}>{type}</button>)}
            </div>
            <div class="www-doc-search-selects">
              <label><span>Category</span><select class="hara-v2-select"><option>All categories</option><option>Systems</option><option>API</option><option>Migration</option></select></label>
              <label><span>Version</span><select class="hara-v2-select"><option>Hara 1.8</option><option>Hara 1.7</option></select></label>
              <label><span>Runtime</span><select class="hara-v2-select"><option>All runtimes</option><option>Wasm</option><option>JVM</option></select></label>
            </div>
          </form>

          <div class="www-doc-search-results" aria-live="polite">
            <header><span data-doc-result-count>{docsSearchResults.length} results</span><small>Index revision search@2a1f</small></header>
            {docsSearchResults.map((result) => (
              <article data-doc-result data-result-type={result.type}>
                <div><span class="hara-v2-badge">{result.type}</span><small>{result.category}</small></div>
                <h3>{result.title}</h3>
                <p>{result.excerpt}</p>
                <footer><span>Version {result.version}</span><span>Runtime {result.runtime}</span><a href={result.type === "Reference" ? "#reference" : "#guide"}>Open →</a></footer>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="www-section" id="runtime-states" data-section-label="Runtime states">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">05 · Runtime, compile, and version states</p><h2>An unavailable executable example does not erase its documentation.</h2></div>
          <p>Each state names what remains readable, which action is disabled, and which immutable source and runtime context can still be inspected.</p>
        </header>
        <div class="www-state-grid">
          {runtimeStateSpecimens.map((state) => (
            <StateSpecimen
              id={state.id}
              tone={state.tone}
              eyebrow={state.eyebrow}
              title={state.title}
              summary={state.summary}
              details={state.details}
              actionLabel="Read state contract"
              actionHref="#docs-contract"
            />
          ))}
        </div>

        <div class="www-live-state-strip">
          <LiveHaraExample id="docs-unavailable-example" label="Unavailable runtime specimen" file="static-only.hal" source={exampleSource} state="unavailable" revision="example@72a194a3" controlPane={false} compact={true} />
          <LiveHaraExample id="docs-error-example" label="Compile error specimen" file="missing-capability.hal" source={exampleSource} state="error" revision="example@72a194a3" controlPane={false} compact={true} />
          <LiveHaraExample id="docs-stale-example" label="Stale version specimen" file="migration-needed.hal" source={exampleSource} state="stale" revision="example@72a194a3" controlPane={false} compact={true} />
        </div>
      </section>

      <section class="www-section" id="responsive" data-section-label="Responsive">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">06 · Narrow and mobile reading behaviour</p><h2>The article remains a document at every viewport.</h2></div>
          <p>The outline folds first, the guide rail becomes a labelled drawer, selectors remain available, and the optional control pane moves below source rather than squeezing prose.</p>
        </header>
        <div class="www-viewport-grid">
          <ViewportSpecimen viewport="desktop" label="Desktop" width="1440" note="Rail + article + outline">
            <div class="www-mini-docs" data-size="wide"><aside>Guide rail</aside><main><span>Guide</span><h3>Build durable work</h3><p>Prose / source / bounded runtime</p></main><aside>Outline</aside></div>
          </ViewportSpecimen>
          <ViewportSpecimen viewport="tablet" label="Tablet" width="900" note="Rail + article; outline folded">
            <div class="www-mini-docs" data-size="medium"><aside>Guide rail</aside><main><span>Guide</span><h3>Build durable work</h3><p>Outline in article header</p></main></div>
          </ViewportSpecimen>
          <ViewportSpecimen viewport="mobile" label="Mobile" width="390" note="Article first; controls below source">
            <div class="www-mini-docs" data-size="narrow"><span>Guide menu · Hara 1.8</span><h3>Build durable work</h3><p>Prose remains first</p><b>Run example</b></div>
          </ViewportSpecimen>
        </div>
      </section>

      <section class="www-section www-contract-section" id="docs-contract" data-catalogue-section-ignore>
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">07 · Shared content contract</p><h2>Docs consumes <code>hara.docs</code>; it does not define a local front-matter dialect.</h2></div>
          <p>{wwwContracts.docs.summary}</p>
        </header>
        <div class="www-contract-inventory">
          {wwwContracts.docs.types.map((entry) => (
            <article><header><strong>{entry.label}</strong><code>{entry.id}@{entry.version}</code></header><p>{entry.summary}</p><footer><span>Required</span><small>{entry.required.join(" · ")}</small></footer></article>
          ))}
        </div>
      </section>
    </main>

    <footer class="www-family-footer">
      <div><strong>Hara Docs</strong><span>Guides, reference, and revision-pinned examples.</span></div>
      <nav aria-label="WWW family footer"><a href={homeHref}>Overview</a><a href={benchmarksHref}>Benchmarks</a><a href="#docs-contract">Content contract</a></nav>
      <code>{docsArticle.revision}</code>
    </footer>

    <script>
      const initialiseDocSearch = () => {
        document.querySelectorAll("[data-doc-search]").forEach((search) => {
          if (!(search instanceof HTMLElement) || search.dataset.ready === "true") return;
          search.dataset.ready = "true";
          const results = [...search.querySelectorAll("[data-doc-result]")];
          const count = search.querySelector("[data-doc-result-count]");
          search.querySelectorAll("[data-doc-filter]").forEach((button) => {
            button.addEventListener("click", () => {
              const filter = button.getAttribute("data-doc-filter") ?? "All";
              search.querySelectorAll("[data-doc-filter]").forEach((item) => item.setAttribute("aria-pressed", "false"));
              button.setAttribute("aria-pressed", "true");
              let visible = 0;
              results.forEach((result) => {
                if (!(result instanceof HTMLElement)) return;
                const show = filter === "All" || result.dataset.resultType === filter;
                result.hidden = !show;
                if (show) visible += 1;
              });
              if (count) count.textContent = `${visible} ${visible === 1 ? "result" : "results"}`;
            });
          });
        });
      };
      initialiseDocSearch();
      document.addEventListener("astro:page-load", initialiseDocSearch);
    </script>
  </body>
</html>
