---
import StateSpecimen from "../../../components/v2-www/StateSpecimen.astro";
import ViewportSpecimen from "../../../components/v2-www/ViewportSpecimen.astro";
import WwwFamilyHeader from "../../../components/v2-www/WwwFamilyHeader.astro";
import WwwSubnav from "../../../components/v2-www/WwwSubnav.astro";
import {
  benchmarkColumns,
  benchmarkFilters,
  benchmarkHistory,
  benchmarkInsights,
  benchmarkReport,
  benchmarkResultStates,
  benchmarkRows,
  benchmarkSectionNavigation,
  benchmarkSourceRows,
  benchmarkStateCounts,
  selectedBenchmark,
  withBasePath,
  wwwContracts
} from "../../../lib/v2-www.mjs";
import "../../../../../src/v2.css";
import "../../../../../src/theme.js";
import "../../../styles/v2-www.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}www/benchmarks/`, Astro.site);
const socialImage = new URL(`${basePath}og/cards/visual-language.jpg`, Astro.site);
const homeHref = withBasePath(basePath, "/www/");
const docsHref = withBasePath(basePath, "/www/docs/");
const selectedState = `runtime=all&category=dispatch&confidence=high&selected=integer-call:hara`;
const shareHref = `${pageUrl.pathname}?${selectedState}`;
const resultStateLabel = (state) => ({
  advantage: "comparable",
  selected: "selected",
  baseline: "baseline",
  comparable: "comparable",
  incomparable: "incomparable",
  missing: "missing",
  "low-confidence": "low confidence"
}[state] ?? state.replace("-", " "));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara benchmark reference with workload definitions, methods, environments, source revisions, samples, uncertainty, comparison limits, result history, and raw-evidence records." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Benchmarks" />
    <meta property="og:title" content="Hara benchmark results and methods" />
    <meta property="og:description" content={benchmarkReport.question} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hara benchmark results and methods" />
    <meta name="twitter:description" content={benchmarkReport.question} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara benchmark results and methods</title>
  </head>
  <body class="hara-v2 www-family-page www-benchmarks-page">
    <WwwFamilyHeader basePath={basePath} activeRoute="benchmarks" searchLabel="Search benchmark records" />
    <WwwSubnav label="Benchmarks" items={benchmarkSectionNavigation} activeId="insights">
      <span slot="identity">{benchmarkReport.schema} · {benchmarkReport.schemaVersion}</span>
      <a class="hara-v2-button" href="#selected-result">Selected result</a>
      <button class="hara-v2-button" data-copy-benchmark-view data-share-href={shareHref} type="button">Copy view link</button>
    </WwwSubnav>

    <main class="www-main">
      <aside class="www-fixture-banner" role="note">
        <span>Interface fixture</span>
        <p>The numbers on this route are realistic review data for the Visual Language specimen, not published Hara performance results. A production benchmark site must replace every value with registry-backed measurements.</p>
        <code>{benchmarkReport.comparability}</code>
      </aside>

      <section class="www-benchmark-hero" aria-labelledby="benchmarks-title">
        <div>
          <p class="hara-v2-kicker">Measurements · Methods · Limitations</p>
          <h1 id="benchmarks-title">A benchmark result is meaningful only within its workload, method, and environment.</h1>
          <p>{benchmarkReport.question}</p>
          <div class="www-contract-line">
            <span>{benchmarkReport.contentType}</span>
            <code>{benchmarkReport.revision}</code>
            <span>{benchmarkRows.length} workload fixtures</span>
          </div>
        </div>
        <dl>
          <div><dt>Report revision</dt><dd><code>{benchmarkReport.revision}</code></dd></div>
          <div><dt>Methodology</dt><dd>{benchmarkReport.methodology}</dd></div>
          <div><dt>Evidence bundle</dt><dd>{benchmarkReport.evidence}</dd></div>
          <div><dt>Comparability review</dt><dd>{benchmarkReport.comparability}</dd></div>
        </dl>
      </section>

      <section class="www-section" id="insights">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">01 · Result summary</p><h2>Begin with the measured observations and their confidence.</h2></div>
          <p>Each summary states the comparison, confidence, interpretation, and evidence reference. Missing or incomparable workloads remain visible and are not converted into a ranking.</p>
        </header>

        <div class="www-benchmark-insight-grid">
          {benchmarkInsights.map((insight, index) => (
            <article data-insight={insight.id}>
              <header><span>{String(index + 1).padStart(2, "0")}</span><small>{insight.confidence}</small></header>
              <p class="hara-v2-kicker">{insight.label}</p>
              <strong>{insight.value}</strong>
              <p>{insight.summary}</p>
              <footer><span>Evidence record</span><code>{insight.evidence}</code></footer>
            </article>
          ))}
        </div>
      </section>

      <section class="www-section" id="matrix" data-benchmark-matrix>
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">02 · Workload matrix</p><h2>Each value resolves to its exact comparison context.</h2></div>
          <p>Filters produce a shareable state. Cells preserve selected, baseline, comparable, missing, incomparable, and low-confidence meanings without relying on colour alone.</p>
        </header>

        <form class="www-benchmark-filters" onsubmit="return false" aria-label="Benchmark filters">
          <label><span>Runtime</span><select class="hara-v2-select" data-benchmark-filter="runtime">{benchmarkFilters.runtimes.map((item) => <option>{item}</option>)}</select></label>
          <label><span>Category</span><select class="hara-v2-select" data-benchmark-filter="category">{benchmarkFilters.categories.map((item) => <option>{item}</option>)}</select></label>
          <label><span>Confidence</span><select class="hara-v2-select" data-benchmark-filter="confidence">{benchmarkFilters.confidence.map((item) => <option>{item}</option>)}</select></label>
          <div><span>Shareable state</span><code data-benchmark-state>{selectedState}</code></div>
          <button class="hara-v2-button" type="button" data-copy-benchmark-view data-share-href={shareHref}>Copy filtered view</button>
        </form>

        <div class="www-benchmark-matrix-wrap">
          <table class="www-benchmark-matrix">
            <caption>Runtime dispatch and collection workload fixture. Lower values are better only within comparable rows.</caption>
            <thead>
              <tr><th scope="col">Workload</th><th scope="col">Category</th>{benchmarkColumns.map((column) => <th scope="col">{column.label}</th>)}</tr>
            </thead>
            <tbody>
              {benchmarkRows.map((row) => (
                <tr data-workload={row.id}>
                  <th scope="row"><button type="button" data-select-workload={row.id}>{row.label}</button><small>{row.unit}</small></th>
                  <td>{row.category}</td>
                  {benchmarkColumns.map((column) => {
                    const result = row.results[column.id];
                    const stateLabel = resultStateLabel(result.state);
                    return (
                      <td data-result-state={result.state} data-confidence={result.confidence}>
                        <button type="button" data-benchmark-cell={`${row.id}:${column.id}`} aria-label={`${row.label}, ${column.label}, ${result.display} ${row.unit}, ${stateLabel}`}>
                          <strong>{result.display}</strong>
                          <small>{stateLabel}</small>
                        </button>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="www-benchmark-mobile-cards" aria-label="Mobile workload summary">
          {benchmarkRows.map((row) => (
            <article>
              <header><div><p class="hara-v2-kicker">{row.category}</p><h3>{row.label}</h3></div><span>{row.unit}</span></header>
              <dl>{benchmarkColumns.map((column) => <div data-result-state={row.results[column.id].state}><dt>{column.label}</dt><dd>{row.results[column.id].display}<small>{resultStateLabel(row.results[column.id].state)}</small></dd></div>)}</dl>
              <a href="#selected-result">View method and source →</a>
            </article>
          ))}
        </div>

        <aside class="www-benchmark-legend" aria-label="Matrix state legend">
          <div><span data-legend="selected"></span><b>Selected</b><p>Current result detail.</p></div>
          <div><span data-legend="baseline"></span><b>Baseline</b><p>Named comparison configuration.</p></div>
          <div><span data-legend="missing"></span><b>Missing</b><p>No successful evidence receipt.</p></div>
          <div><span data-legend="incomparable"></span><b>Incomparable</b><p>Semantics or environment do not support a ratio.</p></div>
          <div><span data-legend="low-confidence"></span><b>Low confidence</b><p>Visible but excluded from summary conclusions.</p></div>
        </aside>
      </section>

      <section class="www-section" id="selected-result">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">03 · Selected result</p><h2>Samples, baseline, environment, revisions, and method remain adjacent.</h2></div>
          <p>A selected matrix cell resolves to a complete measurement record with source and harness revisions, raw path, confidence, environment, and methodology.</p>
        </header>

        <div class="www-selected-benchmark" data-selected-benchmark>
          <article class="www-selected-benchmark__summary">
            <header><div><p class="hara-v2-kicker">Selected workload</p><h3 data-selected-workload>{selectedBenchmark.workload}</h3><p>{selectedBenchmark.comparison}</p></div><span class="hara-v2-badge" data-tone="success">{selectedBenchmark.confidence} confidence</span></header>
            <div class="www-selected-benchmark__values">
              <div><span>Hara</span><strong>{selectedBenchmark.hara}</strong></div>
              <div><span>Baseline</span><strong>{selectedBenchmark.baseline}</strong></div>
              <div><span>Ratio</span><strong>{selectedBenchmark.ratio}</strong></div>
              <div><span>Samples</span><strong>{selectedBenchmark.samples}</strong></div>
              <div><span>Warmups</span><strong>{selectedBenchmark.warmups}</strong></div>
              <div><span>RSD</span><strong>{selectedBenchmark.rsd}</strong></div>
            </div>
            <dl class="www-selected-benchmark__ledger">
              <div><dt>Hara source</dt><dd><code>{selectedBenchmark.sourceRevision}</code></dd></div>
              <div><dt>Harness</dt><dd><code>{selectedBenchmark.harnessRevision}</code></dd></div>
              <div><dt>Evidence digest</dt><dd><code>{selectedBenchmark.evidenceDigest}</code></dd></div>
              <div><dt>Raw samples</dt><dd><code>{selectedBenchmark.rawPath}</code></dd></div>
            </dl>
            <footer><a class="hara-v2-button" data-variant="primary" href="#source-table">Open source record</a><button class="hara-v2-button" type="button">Download raw JSON</button></footer>
          </article>

          <aside class="www-selected-benchmark__method">
            <section>
              <header><p class="hara-v2-kicker">Environment</p><h3>Run context</h3></header>
              <ul>{selectedBenchmark.environment.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section>
              <header><p class="hara-v2-kicker">Baseline configuration</p><h3>Rust full</h3></header>
              <ul>{selectedBenchmark.baselineConfig.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section>
              <header><p class="hara-v2-kicker">Method</p><h3>runtime-shootout/v3</h3></header>
              <ol>{selectedBenchmark.method.map((item) => <li>{item}</li>)}</ol>
              <a href="#source-table">View full method and exclusions →</a>
            </section>
          </aside>
        </div>
      </section>

      <section class="www-section" id="history">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">04 · Revision history</p><h2>A result belongs to a sequence of source and harness revisions.</h2></div>
          <p>History separates measured movement from its proposed explanation. Each note remains tied to a commit and a method-compatible evidence bundle.</p>
        </header>

        <div class="www-benchmark-history">
          <div class="www-benchmark-history__chart" role="img" aria-label="integer-call fixture history from 19.2 to 18.4 nanoseconds per operation">
            {benchmarkHistory.map((entry, index) => (
              <div data-history-index={index}>
                <span>{entry.value}</span>
                <i></i>
                <small>{entry.date}</small>
              </div>
            ))}
          </div>
          <ol>
            {benchmarkHistory.map((entry) => (
              <li><code>{entry.revision}</code><time>{entry.date}</time><strong>{entry.value} ns/op</strong><span>{entry.delta}</span><p>{entry.note}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section class="www-section" id="result-states">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">05 · Missing, incomparable, and low-confidence results</p><h2>Incomplete evidence remains visible without producing a conclusion.</h2></div>
          <p>The matrix names why a ratio or comparison is withheld instead of assigning a placeholder value or removing the workload.</p>
        </header>
        <div class="www-state-grid">
          {benchmarkResultStates.map((state) => (
            <StateSpecimen id={`benchmark-${state.id}`} tone={state.tone} eyebrow={state.eyebrow} title={state.title} summary={state.summary} details={state.details} actionLabel="Open review record" actionHref="#source-table" />
          ))}
        </div>
        <dl class="www-benchmark-state-counts">
          {Object.entries(benchmarkStateCounts).map(([state, count]) => <div><dt>{resultStateLabel(state)}</dt><dd>{count}</dd></div>)}
        </dl>
      </section>

      <section class="www-section" id="responsive-benchmarks">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">06 · Desktop, tablet, and mobile layouts</p><h2>Narrow layouts preserve the accessible comparison table.</h2></div>
          <p>The desktop matrix remains the canonical table. Narrow screens add workload cards for scanning while the table remains available to assistive technology and horizontal inspection.</p>
        </header>
        <div class="www-viewport-grid">
          <ViewportSpecimen viewport="desktop" label="Desktop" width="1440" note="Matrix + selected result">
            <div class="www-mini-benchmark" data-size="wide"><header>Summary</header><main><span>5 × 4 matrix</span><b>Selected: integer-call</b></main><aside>Method</aside></div>
          </ViewportSpecimen>
          <ViewportSpecimen viewport="tablet" label="Tablet" width="900" note="Matrix scroll + method below">
            <div class="www-mini-benchmark" data-size="medium"><header>Summary</header><main><span>Scrollable matrix</span><b>Method below</b></main></div>
          </ViewportSpecimen>
          <ViewportSpecimen viewport="mobile" label="Mobile" width="390" note="Workload cards + table alternative">
            <div class="www-mini-benchmark" data-size="narrow"><span>Dispatch</span><h3>integer-call</h3><b>18.4 ns/op</b><small>High confidence · view context</small></div>
          </ViewportSpecimen>
        </div>
      </section>

      <section class="www-section" id="source-table">
        <header class="www-section-head">
          <div><p class="hara-v2-kicker">07 · Source and evidence table</p><h2>The complete record follows the readable summary and selected result.</h2></div>
          <p>This table provides exact source, Hara revision, baseline version, methodology, evidence digest, and review state for every workload.</p>
        </header>
        <div class="www-source-table-wrap">
          <table class="www-source-table">
            <caption>Benchmark source and evidence registry fixture.</caption>
            <thead><tr><th scope="col">Workload</th><th scope="col">Source</th><th scope="col">Hara revision</th><th scope="col">Baseline</th><th scope="col">Method</th><th scope="col">Evidence</th><th scope="col">State</th></tr></thead>
            <tbody>{benchmarkSourceRows.map((row) => <tr><th scope="row">{row.workload}</th><td><code>{row.source}</code></td><td><code>{row.hara}</code></td><td>{row.baseline}</td><td>{row.method}</td><td><code>{row.evidence}</code></td><td>{row.state}</td></tr>)}</tbody>
          </table>
        </div>

        <aside class="www-contract-note" id="benchmarks-contract">
          <div><p class="hara-v2-kicker">Content contract</p><h3>{wwwContracts.benchmarks.schemaNamespace}@{wwwContracts.benchmarks.schemaVersion}</h3></div>
          <p>{wwwContracts.benchmarks.summary}</p>
          <code>{wwwContracts.benchmarks.types.map(({ id }) => id).join(" · ")}</code>
        </aside>
      </section>
    </main>

    <footer class="www-family-footer">
      <div><strong>Hara Benchmarks</strong><span>Measurements, methods, revisions, and stated comparison limits.</span></div>
      <nav aria-label="WWW family footer"><a href={homeHref}>Overview</a><a href={docsHref}>Docs</a><a href="#benchmarks-contract">Content contract</a></nav>
      <code>{benchmarkReport.revision}</code>
    </footer>

    <script>
      const initialiseBenchmarkPage = () => {
        document.querySelectorAll("[data-copy-benchmark-view]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.ready === "true") return;
          button.dataset.ready = "true";
          button.addEventListener("click", async () => {
            const href = button.dataset.shareHref ?? window.location.href;
            const url = new URL(href, window.location.origin);
            try {
              await navigator.clipboard.writeText(url.href);
              button.textContent = "View link copied";
            } catch {
              button.textContent = url.search;
            }
            window.setTimeout(() => { button.textContent = "Copy filtered view"; }, 1400);
          });
        });

        document.querySelectorAll("[data-benchmark-matrix]").forEach((matrix) => {
          if (!(matrix instanceof HTMLElement) || matrix.dataset.ready === "true") return;
          matrix.dataset.ready = "true";
          const state = matrix.querySelector("[data-benchmark-state]");
          matrix.querySelectorAll("[data-benchmark-cell]").forEach((cell) => {
            cell.addEventListener("click", () => {
              matrix.querySelectorAll("[data-benchmark-cell]").forEach((item) => item.removeAttribute("aria-current"));
              cell.setAttribute("aria-current", "true");
              const selected = cell.getAttribute("data-benchmark-cell") ?? "integer-call:hara";
              if (state) state.textContent = `runtime=all&category=all&confidence=all&selected=${selected}`;
              document.querySelector("#selected-result")?.scrollIntoView({ behavior: "smooth", block: "start" });
            });
          });
          matrix.querySelectorAll("[data-benchmark-filter]").forEach((select) => {
            select.addEventListener("change", () => {
              const values = [...matrix.querySelectorAll("[data-benchmark-filter]")].map((item) => item instanceof HTMLSelectElement ? item.value.toLowerCase().replaceAll(" ", "-") : "all");
              if (state) state.textContent = `runtime=${values[0]}&category=${values[1]}&confidence=${values[2]}&selected=integer-call:hara`;
            });
          });
        });
      };
      initialiseBenchmarkPage();
      document.addEventListener("astro:page-load", initialiseBenchmarkPage);
    </script>
  </body>
</html>
