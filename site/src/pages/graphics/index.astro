---
import CatalogueHeader from "../../components/v2-catalogue/CatalogueHeader.astro";
import ShaderField from "../../../../src/astro/v2/ShaderField.astro";
import cinematic from "../../../../assets/cinematic/manifest.json";
import "../../../../src/v2.css";
import "../../../../src/v2/graphics.css";
import "../../../../src/theme.js";
import "../../styles/v2-lab.css";
import "../../styles/v2-graphics-lab.css";
import "../../styles/v2-calm-lab.css";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(`${basePath}graphics/`, Astro.site);
const rasterUrl = (file) => `${basePath}cinematic/${file}`;
const backgrounds = cinematic.raster.backgrounds;
const textures = cinematic.raster.textures;
const socialImage = new URL(rasterUrl(backgrounds[0].file), Astro.site);
const shaderModes = [
  { id: "strata", label: "Strata", atmosphere: "silica", fallback: "raster/backgrounds/desert-foundry.webp", copy: "Warped mineral layers and a measured route across a long technical horizon." },
  { id: "ink", label: "Ink flux", atmosphere: "foundry", fallback: "raster/backgrounds/ink-conduit.webp", copy: "Domain-warped carbon constrained by a vertical execution rail." },
  { id: "monolith", label: "Monolith", atmosphere: "monolith", fallback: "raster/backgrounds/monolith-gate.webp", copy: "Signed-distance masses, structural fog, and one isolated central seam." },
  { id: "lattice", label: "Lattice", atmosphere: "nocturne", fallback: "raster/backgrounds/nocturne-lattice.webp", copy: "Calibrated cells, braces, and stepped selection without decorative particles." },
  { id: "shimmer", label: "Heat shear", atmosphere: "reliquary", fallback: "raster/backgrounds/reliquary-engine.webp", copy: "Dry optical displacement over layered ridges and a fixed instrument gate." },
  { id: "field", label: "Vector field", atmosphere: "storm", fallback: "raster/backgrounds/storm-archive.webp", copy: "Directional conduits tighten around a pointer-responsive inspection aperture." }
];
const themeImages = Object.fromEntries(backgrounds.map((asset) => [asset.theme, asset.file]));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Hara v2 graphics reference: six 4K raster backgrounds, four 4K raster textures, six material atmospheres, and six WebGL shader fields." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Visual Language" />
    <meta property="og:title" content="Hara v2 graphics reference" />
    <meta property="og:description" content="Raster backgrounds, material textures, and WebGL fields with documented fallbacks, motion, and theme behaviour." />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml" />
    <title>Hara v2 graphics reference</title>
  </head>
  <body class="hara-v2 hara-v2-graphics graphics-lab" data-atmosphere="monolith">
    <CatalogueHeader basePath={basePath} activePath="/graphics/" />

    <main class="v2-lab-main">
      <section class="graphics-lab-hero">
        <div class="graphics-lab-hero-copy">
          <p class="hara-v2-kicker">Raster and shader reference · Version 2</p>
          <h1>Raster backgrounds, material textures, and WebGL fields.</h1>
          <p>The reference contains six 4096 × 2304 WebP backgrounds and four 4096 × 4096 material textures for page headers, editor canvases, covers, documentation, fallbacks, and long-running tools.</p>
          <p class="graphics-lab-hero-links"><a href={`${basePath}`}>← Interface catalogue</a><a href={`${basePath}tool/`}>Tool workbenches →</a></p>
        </div>
        <div class="graphics-lab-stage">
          <ShaderField
            class="graphics-lab-stage-field"
            mode="monolith"
            atmosphere="monolith"
            motion={true}
            interactive={true}
            fallback={rasterUrl("raster/backgrounds/monolith-gate.webp")}
            label="Interactive monumental Hara shader over a 4K raster background"
            plate="monolith / live"
          />
          <div class="graphics-lab-stage-controls" role="group" aria-label="Choose hero shader field">
            {shaderModes.map((shader, index) => (
              <button
                type="button"
                data-graphics-mode={shader.id}
                data-atmosphere={shader.atmosphere}
                data-fallback={rasterUrl(shader.fallback)}
                aria-pressed={index === 2 ? "true" : "false"}
              ><span>{String(index + 1).padStart(2, "0")}</span>{shader.label}</button>
            ))}
          </div>
        </div>
      </section>

      <nav class="graphics-lab-index" aria-label="Graphics catalogue">
        <a href="#atmospheres"><strong>6 atmospheres</strong><span>Material pressure and lighting without replacing the Hara identity.</span><code>theme / token / surface</code></a>
        <a href="#imagery"><strong>6 raster backgrounds</strong><span>Wide WebP masters for page headers, application surfaces, and documentation imagery.</span><code>4096 × 2304 / WebP</code></a>
        <a href="#textures"><strong>4 raster textures</strong><span>Square mineral, metal, carbon, and optical material masters.</span><code>4096 × 4096 / WebP</code></a>
        <a href="#shaders"><strong>6 WebGL effects</strong><span>Real fragment shaders with motion, pointer input, visibility pausing, and raster fallbacks.</span><code>webgl / progressive</code></a>
      </nav>

      <section id="atmospheres" class="graphics-lab-section">
        <header class="graphics-lab-section-head"><div><p class="hara-v2-kicker">Theme system</p><h2>Six material atmospheres.</h2></div><p>Each atmosphere is demonstrated by an actual raster background. Signal blue, typography, the block H, and the light/dark contract remain invariant.</p></header>
        <div class="graphics-lab-atmospheres">
          {cinematic.themes.map((theme, index) => (
            <article data-atmosphere={theme.id}>
              <img src={rasterUrl(themeImages[theme.id])} alt="" loading={index > 1 ? "lazy" : "eager"} decoding="async" width="4096" height="2304" />
              <div><span>{String(index + 1).padStart(2, "0")} / {theme.id}</span><h3>{theme.label}</h3><p>{theme.character}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section id="imagery" class="graphics-lab-section">
        <header class="graphics-lab-section-head"><div><p class="hara-v2-kicker">Raster backgrounds</p><h2>Six 4K cinematic backgrounds.</h2></div><p>These are real high-resolution WebP image masters rather than vector illustrations. Each file is 4096 × 2304 and can be opened directly for full-resolution review or used as a cover, hero, editor surround, or shader fallback.</p></header>
        <div class="graphics-lab-gallery">
          {backgrounds.map((asset, index) => (
            <figure>
              <a href={rasterUrl(asset.file)} aria-label={`Open ${asset.label} at 4096 by 2304 pixels`}>
                <img src={rasterUrl(asset.file)} alt={asset.alt} loading={index > 2 ? "lazy" : "eager"} decoding="async" width={asset.width} height={asset.height} />
              </a>
              <figcaption><span>{String(index + 1).padStart(2, "0")} · {asset.theme} · {asset.width} × {asset.height}</span><strong>{asset.label}</strong><p>{asset.use}</p></figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section id="textures" class="graphics-lab-section">
        <header class="graphics-lab-section-head"><div><p class="hara-v2-kicker">Raster textures</p><h2>Four 4K material textures.</h2></div><p>Each square master is 4096 × 4096 and carries real surface variation for panels, editor surrounds, document covers, state treatments, and close editorial crops.</p></header>
        <div class="graphics-lab-textures">
          {textures.map((texture, index) => (
            <figure>
              <a href={rasterUrl(texture.file)} aria-label={`Open ${texture.label} at 4096 by 4096 pixels`}>
                <img src={rasterUrl(texture.file)} alt={texture.alt} loading={index > 1 ? "lazy" : "eager"} decoding="async" width={texture.width} height={texture.height} />
              </a>
              <figcaption><span>{String(index + 1).padStart(2, "0")} · {texture.width} × {texture.height}</span><strong>{texture.label}</strong><p>{texture.use}</p></figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section id="shaders" class="graphics-lab-section">
        <header class="graphics-lab-section-head"><div><p class="hara-v2-kicker">Live visual effects</p><h2>Six real WebGL shader fields.</h2></div><p>Every field pauses off screen, caps device pixel ratio, honours reduced motion, follows Hara light/dark changes, and retains a matched 4K raster background if WebGL is unavailable.</p></header>
        <div class="graphics-lab-shaders">
          {shaderModes.map((shader, index) => (
            <article>
              <ShaderField
                mode={shader.id}
                atmosphere={shader.atmosphere}
                motion={true}
                interactive={true}
                fallback={rasterUrl(shader.fallback)}
                label={`${shader.label} procedural Hara shader`}
                plate={`${String(index + 1).padStart(2, "0")} / ${shader.id}`}
              />
              <div><h3>{shader.label}</h3><p>{shader.copy}</p><code>{shader.id} · {shader.atmosphere}</code></div>
            </article>
          ))}
        </div>
      </section>

      <section class="graphics-lab-contract hara-v2-material-surface">
        <div><p class="hara-v2-kicker">Implementation contract</p><h2>Raster imagery remains primary; motion is optional.</h2></div>
        <dl>
          <div><dt>Backgrounds</dt><dd>Six 4096 × 2304 WebP masters</dd></div>
          <div><dt>Textures</dt><dd>Four 4096 × 4096 WebP masters</dd></div>
          <div><dt>Motion</dt><dd>Opt in and reduced-motion safe</dd></div>
          <div><dt>Fallback</dt><dd>Matched high-resolution raster image</dd></div>
          <div><dt>Identity</dt><dd>H mark, type, and functional signal remain fixed</dd></div>
          <div><dt>Distribution</dt><dd>Package assets plus GitHub Pages delivery</dd></div>
        </dl>
      </section>

      <footer class="v2-lab-footer"><span>Hara v2 graphics contract</span><span><a href={`${basePath}`}>Interface catalogue</a> · <a href="https://github.com/hara-lang/visual-language/blob/main/V2-GRAPHICS.md">Graphics documentation</a> · <a href="https://github.com/hara-lang/visual-language">Source</a></span></footer>
    </main>

    <script>
      const stage = document.querySelector(".graphics-lab-stage-field");
      const plate = stage?.querySelector(".hara-v2-shader-field__plate");
      const controls = document.querySelectorAll("[data-graphics-mode]");
      controls.forEach((control) => control.addEventListener("click", () => {
        if (!stage) return;
        controls.forEach((item) => item.setAttribute("aria-pressed", "false"));
        control.setAttribute("aria-pressed", "true");
        stage.dataset.mode = control.dataset.graphicsMode;
        stage.dataset.atmosphere = control.dataset.atmosphere;
        stage.style.setProperty("--hara-shader-fallback", `url("${control.dataset.fallback}")`);
        if (plate) plate.textContent = `${control.dataset.graphicsMode} / live`;
      }));
    </script>
  </body>
</html>
